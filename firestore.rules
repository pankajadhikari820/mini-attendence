rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasProfile() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isActive() {
      return hasProfile() && myUser().status == 'active';
    }

    function isSuperAdmin() {
      return isActive() && myUser().role == 'super_admin';
    }

    function isOrgAdmin(orgId) {
      return isActive() && (
        myUser().role == 'super_admin' ||
        (myUser().orgId == orgId && myUser().role == 'admin')
      );
    }

    function isOrgManager(orgId) {
      return isActive() && myUser().orgId == orgId && myUser().role == 'manager';
    }

    function isParentOf(studentUid) {
      return isActive()
        && myUser().role == 'parent'
        && 'linkedStudentUids' in myUser()
        && myUser().linkedStudentUids is list
        && studentUid in myUser().linkedStudentUids;
    }

    function inSameOrg(orgId) {
      return hasProfile() && (myUser().role == 'super_admin' || myUser().orgId == orgId);
    }

    function selectedStudentsFieldValid() {
      return request.resource.data.get('selectedStudentUids', null) == resource.data.get('selectedStudentUids', null)
        || (
          resource.data.role in ['manager', 'admin', 'super_admin']
          && request.resource.data.selectedStudentUids is list
        );
    }

    function userImmutableFieldsUnchanged() {
      return request.resource.data.role == resource.data.role
        && request.resource.data.orgId == resource.data.orgId
        && request.resource.data.status == resource.data.status
        && request.resource.data.managerId == resource.data.managerId
        && request.resource.data.memberId == resource.data.memberId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.get('linkedStudentUids', null) == resource.data.get('linkedStudentUids', null)
        && selectedStudentsFieldValid();
    }

    // Eligibility check for submitting self-attendance to a Live Session
    function isEligibleForSession(sess) {
      return myUser().orgId == sess.orgId && (
        // Admin -> Manager session
        (sess.ownerRole == 'admin' && myUser().role == 'manager')
        // Multi-teacher class/subject session -> Students assigned to that classId
        || (
          sess.ownerRole == 'manager'
          && myUser().role == 'member'
          && 'classId' in sess && sess.classId is string && sess.classId != ''
          && 'classId' in myUser() && myUser().classId == sess.classId
        )
        // Legacy direct manager -> member session (when session has no classId or student has direct managerId)
        || (
          sess.ownerRole == 'manager'
          && myUser().role == 'member'
          && myUser().managerId == sess.ownerUid
        )
      );
    }

    function flatEarthDistanceOk(sess, lat, lng) {
      let dLat = (lat - sess.location.lat) * 111320.0;
      let dLng = (lng - sess.location.lng) * 111320.0 * sess.location.cosLat;
      let dist = math.sqrt(math.pow(dLat, 2) + math.pow(dLng, 2));
      return dist <= sess.location.radius;
    }

    // Strict 10-second server-clock validation on sessionSecrets
    function liveSecretValid(secret, data) {
      let within10s = secret.active == true
        && secret.tokenUpdatedAt is timestamp
        && request.time >= secret.tokenUpdatedAt
        && request.time <= secret.tokenUpdatedAt + duration.value(10, 's');
      return within10s && (
        (data.method == 'live_qr'
          && 'submittedToken' in data
          && secret.token is string
          && secret.token.size() >= 32
          && data.submittedToken == secret.token)
        ||
        (data.method == 'live_code'
          && 'submittedCode' in data
          && secret.code is string
          && secret.code.size() == 6
          && data.submittedCode == secret.code)
      );
    }

    // Globally unique 6-character user ID lookup (e.g. PAN482)
    match /userIds/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && hasProfile() && myUser().role in ['super_admin', 'admin'];
      allow create: if isSignedIn()
        && userId.matches('^[A-Z]{3}[0-9]{3}$')
        && !exists(/databases/$(database)/documents/userIds/$(userId));
      allow update: if false;
      allow delete: if isSignedIn() && (
        isOrgAdmin(resource.data.orgId) ||
        (isOrgManager(resource.data.orgId) && resource.data.role == 'member')
      );
    }

    // Public lookup tables for self-registration (get by exact code only, NO list)
    match /orgCodes/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && isOrgAdmin(resource.data.orgId);
    }

    match /managerCodes/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn() && (
        isOrgAdmin(request.resource.data.orgId) ||
        (isOrgManager(request.resource.data.orgId) && request.resource.data.managerUid == request.auth.uid)
      );
      allow update, delete: if isSignedIn() && (
        isOrgAdmin(resource.data.orgId) ||
        resource.data.managerUid == request.auth.uid
      );
    }

    // Public contact form messages (create-only for public)
    match /messages/{msgId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'email', 'message'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
        && request.resource.data.email is string && request.resource.data.email.size() > 3 && request.resource.data.email.size() <= 180
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 2000;
      allow read: if isSuperAdmin();
      allow update, delete: if false;
    }

    // Organizations
    match /organizations/{orgId} {
      allow read: if inSameOrg(orgId);
      allow create: if isSignedIn() && request.resource.data.adminUid == request.auth.uid;
      allow update: if isOrgAdmin(orgId)
        || (isOrgManager(orgId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['counters']));
      allow delete: if isOrgAdmin(orgId);
    }

    // Users (Super Admin, Org Admin, Manager/Teacher, Member/Student, Parent)
    match /users/{uid} {
      allow read: if isSignedIn() && (
        request.auth.uid == uid
        || isSuperAdmin()
        || (hasProfile() && myUser().role == 'admin' && myUser().orgId == resource.data.orgId)
        || (hasProfile() && myUser().role == 'manager' && myUser().orgId == resource.data.orgId && (
              resource.data.managerId == request.auth.uid
              || resource.data.role == 'admin'
              || resource.data.role == 'member'
           ))
        || (isParentOf(uid) && resource.data.orgId == myUser().orgId)
      );

      allow create: if isSignedIn() && (
        (request.auth.uid == uid && request.resource.data.uid == uid && request.resource.data.role == 'admin' && request.resource.data.status == 'active')
        || (request.auth.uid == uid && request.resource.data.uid == uid && request.resource.data.status == 'pending' && request.resource.data.role in ['manager', 'member', 'parent'])
        || isOrgAdmin(request.resource.data.orgId)
        || (isOrgManager(request.resource.data.orgId) && request.resource.data.role == 'member' && request.resource.data.managerId == request.auth.uid)
      );

      allow update: if isSignedIn() && (
        (request.auth.uid == uid && userImmutableFieldsUnchanged())
        || isOrgAdmin(resource.data.orgId)
        || (isOrgManager(resource.data.orgId)
            && resource.data.role == 'member'
            && resource.data.managerId == request.auth.uid
            && request.resource.data.role == 'member'
            && request.resource.data.orgId == resource.data.orgId
            && request.resource.data.managerId == request.auth.uid)
      );

      allow delete: if isSignedIn() && (
        isOrgAdmin(resource.data.orgId)
        || (isOrgManager(resource.data.orgId) && resource.data.role == 'member' && resource.data.managerId == request.auth.uid)
      );
    }

    // Academic Structure: Departments, Classes/Sections, Subjects, Faculty Assignments, Timetables
    match /departments/{deptId} {
      allow read: if isActive() && inSameOrg(resource.data.orgId);
      allow create: if isOrgAdmin(request.resource.data.orgId);
      allow update, delete: if isOrgAdmin(resource.data.orgId);
    }

    match /classes/{classId} {
      allow read: if isActive() && inSameOrg(resource.data.orgId);
      allow create: if isOrgAdmin(request.resource.data.orgId);
      allow update, delete: if isOrgAdmin(resource.data.orgId);
    }

    match /subjects/{subjectId} {
      allow read: if isActive() && inSameOrg(resource.data.orgId);
      allow create: if isOrgAdmin(request.resource.data.orgId);
      allow update, delete: if isOrgAdmin(resource.data.orgId);
    }

    match /facultyAssignments/{assignmentId} {
      allow read: if isActive() && inSameOrg(resource.data.orgId);
      allow create: if isOrgAdmin(request.resource.data.orgId);
      allow update, delete: if isOrgAdmin(resource.data.orgId);
    }

    match /timetables/{slotId} {
      allow read: if isActive() && inSameOrg(resource.data.orgId);
      allow create: if isOrgAdmin(request.resource.data.orgId);
      allow update, delete: if isOrgAdmin(resource.data.orgId);
    }

    // Parent-Student Link Requests (Admin verifies to grant read-only access)
    match /parentLinks/{linkId} {
      allow read: if isSignedIn() && (
        resource.data.parentUid == request.auth.uid
        || resource.data.studentUid == request.auth.uid
        || isOrgAdmin(resource.data.orgId)
      );
      allow create: if isSignedIn() && (
        (request.resource.data.parentUid == request.auth.uid && request.resource.data.status == 'pending')
        || isOrgAdmin(request.resource.data.orgId)
      );
      allow update, delete: if isOrgAdmin(resource.data.orgId);
    }

    // Live Attendance Sessions
    // NOTE: Contains NO secret tokens/codes. All secrets live in owner-only `sessionSecrets`.
    // Query-safe read rules: students query by (orgId + classId + status) OR (orgId + ownerUid + status),
    // managers query by (orgId + ownerRole == 'admin' + status) OR (orgId + ownerUid == uid).
    match /sessions/{sessionId} {
      allow read: if isActive() && (
        isSuperAdmin()
        || (myUser().orgId == resource.data.orgId && (
          myUser().role == 'admin'
          || resource.data.ownerUid == request.auth.uid
          || (myUser().role == 'manager' && resource.data.ownerRole == 'admin')
          || (myUser().role == 'member' && 'classId' in myUser() && myUser().classId != null && myUser().classId != '' && resource.data.classId == myUser().classId)
          || (myUser().role == 'member' && myUser().managerId != null && resource.data.ownerUid == myUser().managerId)
        ))
      );

      allow create: if isActive()
        && request.resource.data.orgId == myUser().orgId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerRole == myUser().role
        && myUser().role in ['admin', 'manager']
        && request.resource.data.status == 'open';

      allow update: if isActive() && resource.data.orgId == myUser().orgId && (
        resource.data.ownerUid == request.auth.uid
        || isOrgAdmin(resource.data.orgId)
      );

      allow delete: if isActive() && resource.data.orgId == myUser().orgId && (
        resource.data.ownerUid == request.auth.uid
        || isOrgAdmin(resource.data.orgId)
      );
    }

    // Session Secrets: STRICTLY owner-only. Students/scanners/parents can NEVER read or write.
    match /sessionSecrets/{sessionId} {
      allow read: if isActive() && resource.data.ownerUid == request.auth.uid;
      allow create: if isActive()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.orgId == myUser().orgId
        && myUser().role in ['admin', 'manager']
        && request.resource.data.tokenUpdatedAt == request.time;
      allow update: if isActive()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.orgId == resource.data.orgId
        && request.resource.data.tokenUpdatedAt == request.time;
      allow delete: if isActive() && resource.data.ownerUid == request.auth.uid;
    }

    // One device = one person per session (write-once per sessionId_deviceId)
    match /sessionDevices/{deviceDocId} {
      allow get: if isActive() && (resource == null || resource.data.orgId == myUser().orgId);
      allow list: if isActive() && myUser().role in ['super_admin', 'admin', 'manager'];
      allow create: if isActive()
        && request.resource.data.orgId == myUser().orgId
        && request.resource.data.personUid == request.auth.uid
        && deviceDocId == request.resource.data.sessionId + '_' + request.resource.data.deviceId
        && !exists(/databases/$(database)/documents/sessionDevices/$(deviceDocId));
      allow update: if false;
      allow delete: if isOrgAdmin(resource.data.orgId);
    }

    // Failed attendance attempts log (owner sees rejected attempts on session screen)
    match /attempts/{attemptId} {
      allow read: if isActive() && resource.data.orgId == myUser().orgId && (
        myUser().role in ['super_admin', 'admin']
        || resource.data.ownerUid == request.auth.uid
      );
      allow create: if isActive()
        && request.resource.data.orgId == myUser().orgId
        && request.resource.data.personUid == request.auth.uid;
      allow update: if false;
      allow delete: if isOrgAdmin(resource.data.orgId);
    }

    // Strictly validates self-marking via live rotating QR/code:
    // - Status MUST be 'present' (no 'late' status permitted)
    // - Deterministic ID: {orgId}_{sessionId}_{uid} so multiple subjects on the same day never overwrite each other
    // - Prevents duplicate attendance within the same session
    function canSelfMarkAttendance(recordId) {
      let sid = request.resource.data.sessionId;
      let sess = get(/databases/$(database)/documents/sessions/$(sid)).data;
      let secret = get(/databases/$(database)/documents/sessionSecrets/$(sid)).data;
      let devDocId = sid + '_' + request.resource.data.deviceId;
      return request.resource.data.method in ['live_qr', 'live_code']
        && request.resource.data.status == 'present'
        && request.resource.data.personUid == request.auth.uid
        && recordId == request.resource.data.orgId + '_' + sid + '_' + request.auth.uid
        && !exists(/databases/$(database)/documents/attendance/$(recordId))
        && request.resource.data.timestamp == request.time
        && sid is string
        && request.resource.data.deviceId is string
        && exists(/databases/$(database)/documents/sessions/$(sid))
        && exists(/databases/$(database)/documents/sessionSecrets/$(sid))
        && sess.orgId == request.resource.data.orgId
        && secret.orgId == sess.orgId
        && secret.ownerUid == sess.ownerUid
        && sess.status == 'open'
        && request.time <= sess.endsAt
        && isEligibleForSession(sess)
        && liveSecretValid(secret, request.resource.data)
        && (
          !sess.locationCheckEnabled
          || (
            request.resource.data.lat is number
            && request.resource.data.lng is number
            && flatEarthDistanceOk(sess, request.resource.data.lat, request.resource.data.lng)
          )
        )
        && existsAfter(/databases/$(database)/documents/sessionDevices/$(devDocId))
        && getAfter(/databases/$(database)/documents/sessionDevices/$(devDocId)).data.personUid == request.auth.uid;
    }

    // Attendance: strictly supports ONLY ['present', 'absent', 'leave']
    // Parents have strict READ-ONLY access to their linked students only.
    // Students can NEVER update or delete attendance records.
    match /attendance/{recordId} {
      allow get: if isSignedIn() && hasProfile() && (
        resource == null
        || isSuperAdmin()
        || (myUser().role == 'admin' && myUser().orgId == resource.data.orgId)
        || (myUser().role == 'manager' && myUser().orgId == resource.data.orgId && (
              resource.data.managerId == request.auth.uid
              || resource.data.teacherUid == request.auth.uid
              || resource.data.markedBy == request.auth.uid
              || resource.data.personUid == request.auth.uid
           ))
        || (myUser().role == 'member' && resource.data.personUid == request.auth.uid)
        || (isParentOf(resource.data.personUid) && myUser().orgId == resource.data.orgId)
      );

      allow list: if isSignedIn() && hasProfile() && (
        isSuperAdmin()
        || (myUser().role == 'admin' && myUser().orgId == resource.data.orgId)
        || (myUser().role == 'manager' && myUser().orgId == resource.data.orgId && (
              resource.data.managerId == request.auth.uid
              || resource.data.teacherUid == request.auth.uid
              || resource.data.markedBy == request.auth.uid
              || resource.data.personUid == request.auth.uid
           ))
        || (myUser().role == 'member' && resource.data.personUid == request.auth.uid)
        || (isParentOf(resource.data.personUid) && myUser().orgId == resource.data.orgId)
      );

      // Strictly ONLY ['present', 'absent', 'leave'] — 'late' is permanently rejected
      // ID-card QR codes can NEVER authorize self-marking (only live_qr / live_code with active 10s secret)
      allow create: if isActive()
        && request.resource.data.orgId == myUser().orgId
        && request.resource.data.status in ['present', 'absent', 'leave']
        && myUser().role != 'parent'
        && (
          (
            request.resource.data.method in ['live_qr', 'live_code']
            && 'sessionId' in request.resource.data
            && 'deviceId' in request.resource.data
            && canSelfMarkAttendance(recordId)
          )
          ||
          (
            request.resource.data.method in ['qr', 'manual']
            && exists(/databases/$(database)/documents/users/$(request.resource.data.personUid))
            && get(/databases/$(database)/documents/users/$(request.resource.data.personUid)).data.orgId == myUser().orgId
            && get(/databases/$(database)/documents/users/$(request.resource.data.personUid)).data.status == 'active'
            && (
              (myUser().role in ['super_admin', 'admin'])
              || (myUser().role == 'manager'
                  && get(/databases/$(database)/documents/users/$(request.resource.data.personUid)).data.role == 'member'
                  && (
                    get(/databases/$(database)/documents/users/$(request.resource.data.personUid)).data.managerId == request.auth.uid
                    || request.resource.data.teacherUid == request.auth.uid
                  ))
            )
          )
        );

      allow update: if isActive()
        && resource.data.orgId == myUser().orgId
        && request.resource.data.orgId == resource.data.orgId
        && request.resource.data.personUid == resource.data.personUid
        && request.resource.data.status in ['present', 'absent', 'leave']
        && myUser().role != 'member'
        && myUser().role != 'parent'
        && (
          myUser().role in ['super_admin', 'admin']
          || (myUser().role == 'manager' && (
              resource.data.managerId == request.auth.uid
              || resource.data.teacherUid == request.auth.uid
              || resource.data.markedBy == request.auth.uid
          ))
        );

      allow delete: if isOrgAdmin(resource.data.orgId);
    }

    // Leave Requests (Parents have read-only access to linked student's leave applications)
    match /leaves/{leaveId} {
      allow read: if isSignedIn() && hasProfile() && (
        isOrgAdmin(resource.data.orgId)
        || resource.data.personUid == request.auth.uid
        || resource.data.toUid == request.auth.uid
        || (isParentOf(resource.data.personUid) && myUser().orgId == resource.data.orgId)
      );

      allow create: if isActive()
        && request.resource.data.orgId == myUser().orgId
        && myUser().role != 'parent'
        && (
          (request.resource.data.personUid == request.auth.uid && request.resource.data.status == 'pending')
          || (myUser().role in ['super_admin', 'admin'] && request.resource.data.isDemo == true)
        );

      allow update: if isActive()
        && resource.data.orgId == myUser().orgId
        && myUser().role != 'parent'
        && (
          myUser().role in ['super_admin', 'admin']
          || resource.data.toUid == request.auth.uid
        );

      allow delete: if isOrgAdmin(resource.data.orgId) || resource.data.personUid == request.auth.uid;
    }

    // Announcements
    match /announcements/{annId} {
      allow read: if isActive() && myUser().orgId == resource.data.orgId && (
        myUser().role in ['super_admin', 'admin']
        || resource.data.audience == 'all'
        || (myUser().role == 'manager' && (resource.data.audience == 'managers' || resource.data.fromUid == request.auth.uid))
        || (myUser().role == 'member' && resource.data.audience == 'members' && (resource.data.managerId == null || resource.data.managerId == myUser().managerId))
        || (myUser().role == 'parent' && resource.data.audience in ['all', 'parents'])
      );

      allow create: if isActive()
        && request.resource.data.orgId == myUser().orgId
        && myUser().role in ['super_admin', 'admin', 'manager'];

      allow update, delete: if isActive()
        && resource.data.orgId == myUser().orgId
        && (myUser().role in ['super_admin', 'admin'] || resource.data.fromUid == request.auth.uid);
    }

    // Notifications (supports deterministic dedupe doc IDs for low-attendance alerts)
    match /notifications/{notifId} {
      allow get: if isSignedIn() && (
        resource == null
        || resource.data.toUid == request.auth.uid
        || isOrgAdmin(resource.data.orgId)
      );
      allow list: if isSignedIn() && (
        resource.data.toUid == request.auth.uid
        || isOrgAdmin(resource.data.orgId)
      );

      allow create: if isSignedIn() && (
        hasProfile() && myUser().orgId == request.resource.data.orgId
      );

      allow update: if isSignedIn() && (
        (resource.data.toUid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']))
        || isOrgAdmin(resource.data.orgId)
      );

      allow delete: if isSignedIn() && (
        resource.data.toUid == request.auth.uid
        || isOrgAdmin(resource.data.orgId)
      );
    }

    // Immutable Audit Logs: Append-only. NOBODY (not even Admin or Super Admin) can update or delete.
    match /auditLogs/{logId} {
      allow read: if isActive() && (
        isSuperAdmin()
        || (myUser().role == 'admin' && myUser().orgId == resource.data.orgId)
      );

      allow create: if isSignedIn()
        && hasProfile()
        && request.resource.data.orgId == myUser().orgId
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorRole == myUser().role
        && request.resource.data.timestamp == request.time
        && request.resource.data.action is string
        && request.resource.data.summary is string;

      allow update: if false;
      allow delete: if false;
    }
  }
}
