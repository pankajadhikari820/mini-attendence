      arguments_json: "{\"Description\":\"Update sidebar and mobile navigation for live sessions, /mark, and manual backup\", \"Instruction\":\"Update navItems and primary sidebar CTAs in Layout.tsx for Admin, Manager, and Member roles.\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":16, \"ReplacementContent\":\"import {\\n  BarChart3,\\n  Bell,\\n  CalendarClock,\\n  CheckCircle2,\\n  ClipboardList,\\n  LayoutDashboard,\\n  LogOut,\\n  Megaphone,\\n  QrCode,\\n  ScanLine,\\n  Settings,\\n  Users,\\n  UserCog,\\n} from \'lucide-react\';\", \"StartLine\":3, \"TargetContent\":\"import {\\n  BarChart3,\\n  Bell,\\n  CalendarClock,\\n  LayoutDashboard,\\n  LogOut,\\n  Megaphone,\\n  QrCode,\\n  ScanLine,\\n  Settings,\\n  Users,\\n  UserCog,\\n} from \'lucide-react\';\"}, {\"AllowMultiple\":false, \"EndLine\":102, \"ReplacementContent\":\"  const navItems: NavItem[] = (() => {\\n    if (profile?.role === \'admin\') {\\n      return [\\n        { to: \'/admin\', label: t(\'nav.dashboard\'), icon: LayoutDashboard, mobile: true },\\n        { to: \'/attendance\', label: t(\'nav.startAttendance\'), icon: ScanLine, mobile: true },\\n        { to: \'/attendance/manual\', label: t(\'nav.manualBackup\'), icon: ClipboardList },\\n        { to: \'/admin/managers\', label: managerLabel, icon: UserCog, mobile: true },\\n        { to: \'/admin/members\', label: memberLabel, icon: Users },\\n        { to: \'/reports\', label: t(\'nav.reports\'), icon: BarChart3, mobile: true },\\n        { to: \'/leaves\', label: t(\'nav.leaves\'), icon: CalendarClock },\\n        { to: \'/announcements\', label: t(\'nav.announcements\'), icon: Megaphone },\\n        { to: \'/settings\', label: t(\'nav.settings\'), icon: Settings, mobile: true },\\n      ];\\n    }\\n    if (profile?.role === \'manager\') {\\n      return [\\n        { to: \'/manager\', label: t(\'nav.dashboard\'), icon: LayoutDashboard, mobile: true },\\n        { to: \'/attendance\', label: t(\'nav.startAttendance\'), icon: ScanLine, mobile: true },\\n        { to: \'/mark\', label: t(\'nav.markYourAttendance\'), icon: CheckCircle2, mobile: true },\\n        { to: \'/attendance/manual\', label: t(\'nav.manualBackup\'), icon: ClipboardList },\\n        { to: \'/manager/members\', label: memberLabel, icon: Users },\\n        { to: \'/reports\', label: t(\'nav.reports\'), icon: BarChart3, mobile: true },\\n        { to: \'/leaves\', label: t(\'nav.leaves\'), icon: CalendarClock },\\n        { to: \'/announcements\', label: t(\'nav.announcements\'), icon: Megaphone },\\n        { to: \'/settings\', label: t(\'nav.settings\'), icon: Settings, mobile: true },\\n      ];\\n    }\\n    return [\\n      { to: \'/mark\', label: t(\'nav.markYourAttendance\'), icon: ScanLine, mobile: true },\\n      { to: \'/member\', label: t(\'nav.myQr\'), icon: QrCode, mobile: true },\\n      { to: \'/leaves\', label: t(\'nav.leaves\'), icon: CalendarClock, mobile: true },\\n      { to: \'/announcements\', label: t(\'nav.announcements\'), icon: Megaphone, mobile: true },\\n      { to: \'/settings\', label: t(\'nav.settings\'), icon: Settings, mobile: true },\\n    ];\\n  })();\", \"StartLine\":71, \"TargetContent\":\"  const navItems: NavItem[] = (() => {\\n    if (profile?.role === \'admin\') {\\n      return [\\n        { to: \'/admin\', label: t(\'nav.dashboard\'), icon: LayoutDashboard, mobile: true },\\n        { to: \'/attendance\', label: t(\'nav.markAttendance\'), icon: ScanLine, mobile: true },\\n        { to: \'/admin/managers\', label: managerLabel, icon: UserCog, mobile: true },\\n        { to: \'/admin/members\', label: memberLabel, icon: Users },\\n        { to: \'/reports\', label: t(\'nav.reports\'), icon: BarChart3, mobile: true },\\n        { to: \'/leaves\', label: t(\'nav.leaves\'), icon: CalendarClock },\\n        { to: \'/announcements\', label: t(\'nav.announcements\'), icon: Megaphone },\\n        { to: \'/settings\', label: t(\'nav.settings\'), icon: Settings, mobile: true },\\n      ];\\n    }\\n    if (profile?.role === \'manager\') {\\n      return [\\n        { to: \'/manager\', label: t(\'nav.dashboard\'), icon: LayoutDashboard, mobile: true },\\n        { to: \'/attendance\', label: t(\'nav.markAttendance\'), icon: ScanLine, mobile: true },\\n        { to: \'/manager/members\', label: memberLabel, icon: Users, mobile: true },\\n        { to: \'/reports\', label: t(\'nav.reports\'), icon: BarChart3, mobile: true },\\n        { to: \'/leaves\', label: t(\'nav.leaves\'), icon: CalendarClock },\\n        { to: \'/announcements\', label: t(\'nav.announcements\'), icon: Megaphone },\\n        { to: \'/settings\', label: t(\'nav.settings\'), icon: Settings, mobile: true },\\n      ];\\n    }\\n    return [\\n      { to: \'/member\', label: t(\'nav.myQr\'), icon: QrCode, mobile: true },\\n      { to: \'/leaves\', label: t(\'nav.leaves\'), icon: CalendarClock, mobile: true },\\n      { to: \'/announcements\', label: t(\'nav.announcements\'), icon: Megaphone, mobile: true },\\n      { to: \'/settings\', label: t(\'nav.settings\'), icon: Settings, mobile: true },\\n    ];\\n  })();\"}, {\"AllowMultiple\":false, \"EndLine\":160, \"ReplacementContent\":\"        <nav className=\\\"flex-1 overflow-y-auto px-3 py-4 space-y-1\\\">\\n          {profile?.role === \'admin\' || profile?.role === \'manager\' ? (\\n            <Link\\n              to=\\\"/attendance\\\"\\n              className=\\\"mb-3 flex items-center justify-center gap-2 rounded-xl bg-[#C25E00] hover:bg-[#A84F00] text-white px-4 py-2.5 text-sm font-medium transition-colors\\\"\\n            >\\n              <ScanLine className=\\\"w-4 h-4\\\" />\\n              <span className=\\\"whitespace-nowrap\\\">{t(\'nav.startAttendance\')}</span>\\n            </Link>\\n          ) : (\\n            <Link\\n              to=\\\"/mark\\\"\\n              className=\\\"mb-3 flex items-center justify-center gap-2 rounded-xl bg-[#C25E00] hover:bg-[#A84F00] text-white px-4 py-2.5 text-sm font-medium transition-colors\\\"\\n            >\\n              <ScanLine className=\\\"w-4 h-4\\\" />\\n              <span className=\\\"whitespace-nowrap\\\">{t(\'nav.markYourAttendance\')}</span>\\n            </Link>\\n          )}\\n\\n          {navItems.map((item) => {\\n            const Icon = item.icon;\\n            return (\\n              <NavLink\\n                key={item.to}\\n                to={item.to}\\n                end={\\n                  item.to === \'/admin\' ||\\n                  item.to === \'/manager\' ||\\n                  item.to === \'/member\' ||\\n                  item.to === \'/attendance\'\\n                }\", \"StartLine\":139, \"TargetContent\":\"        <nav className=\\\"flex-1 overflow-y-auto px-3 py-4 space-y-1\\\">\\n          {(profile?.role === \'admin\' || profile?.role === \'manager\') && (\\n            <Link\\n              to=\\\"/attendance\\\"\\n              className=\\\"mb-3 flex items-center justify-center gap-2 rounded-xl bg-[#C25E00] hover:bg-[#A84F00] text-white px-4 py-2.5 text-sm font-medium transition-colors\\\"\\n            >\\n              <ScanLine className=\\\"w-4 h-4\\\" />\\n              <span className=\\\"whitespace-nowrap\\\">{t(\'nav.markAttendance\')}</span>\\n            </Link>\\n          )}\\n\\n          {navItems.map((item) => {\\n            const Icon = item.icon;\\n            return (\\n              <NavLink\\n                key={item.to}\\n                to={item.to}\\n                end={item.to === \'/admin\' || item.to === \'/manager\' || item.to === \'/member\'}\"}, {\"AllowMultiple\":false, \"EndLine\":310, \"ReplacementContent\":\"              to={item.to}\\n              end={\\n                item.to === \'/admin\' ||\\n                item.to === \'/manager\' ||\\n                item.to === \'/member\' ||\\n                item.to === \'/attendance\'\\n              }\", \"StartLine\":303, \"TargetContent\":\"              to={item.to}\\n              end={item.to === \'/admin\' || item.to === \'/manager\' || item.to === \'/member\'}\"}], \"TargetFile\":\"/src/components/Layout.tsx\", \"toolAction\":\"Updating Layout navigation links\", \"toolSummary\":\"Update Layout.tsx\"}"
