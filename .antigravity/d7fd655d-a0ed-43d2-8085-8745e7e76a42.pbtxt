      thinking_signature: "\022\266\004\n\263\004\001i\024}\023\303j\340p0\032p\254\341\361\246\225\032b\236R\217J\211Ov\245P\3469 &\256\346\"\004\347\246f\304\230fa\257\3221\266\361\242\336p\212\361.v9\350R<\356:{\304\353\272\330\257\261\337\212qF \326\001\223\310\371\207\247\006Fz\361\301\376\220V\377q\247\220\33474\332\323\243\214\t\222\310\366\006\260\310$\016\372t\025\246\024\256\327\262\a\216\264\314/m\255Zo=\1779\307\305\376\347g\300E\344\276\261>\2509\036ah\024\310\340\235\336?KL\250B\241\224@`\205\312\017\333\\AYM\204\026\357\3427\351\177\036\030\251\366v\375\311nUI}\217\201\207%N\322p%\211\001\031\224\311\215\226r\372\265\250\366I\350\030\307)v$\266\365:^\265N\254\024\325\366\256\300d{\313\231h\326$+M\b\347\206eq\231\234\225\231r\266\"y\232s2\325\212\202\206\354\310\336#\357\312\271w\315\234\363\324\270=Ah_\314\016\r\343[\370u\267\345-~No`K\253\350\316\225D\336(\317\315\301\202\351\203*o\254\246\300\202\233CY\342\314\345\363\217\004\305@n\325\374\225\\\035\301\305v\334I\220f\315T>sd\344D\225-\021\355\200/\214\030\341\200\2058\364\362\346Q\270k\303\250\260u\r\255\266v\335\025\255\267Nk\241\367/\302P\243\235\274\366\243f\005\202|\250\305\227\242\001\235(\020E/\360\021\273\345\325\342\030\'\305\302\340\216\245F\300\342=a\365\262\022\372\000dt\324\220\275 \232\347\276\304\321\004ir(\330\200\374\247\327\250\312\313\223\252[U%r\027\277\341\234K\024\312Y\306\223n\277M\313?\262\245\300\361\001\\O\241j\300\256\245kQ^\020\317k\205S\237\324\327\213Wd~D\343ne\301\257L\303\333\256\025\361\365z\334\355\351h\030\257\207\305\300\316\271 \305\026xs\t\235\301\261f\'l\320\240\321p\226j\215\330\030\263\250\245\035$\344\226\2168;\322Y\025\240&\033\330W\274Q\263\024\rR\234\251\263Q\376\020\221\260\327"
