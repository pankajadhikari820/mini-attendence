            }
            lines {
              text: "    \"feat4Title\": \"Leave requests\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"feat4Desc\": \"Members apply for leave in seconds. Approved dates appear automatically on calendars and reports.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"feat5Title\": \"Works on phone and laptop\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"feat5Desc\": \"Installable web app that adapts cleanly from small phones to desktop screens.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"feat6Title\": \"Hindi and English\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"feat6Desc\": \"Switch the entire interface between English and Hindi anytime without reloading.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"whoHeading\": \"Who is it for\","
