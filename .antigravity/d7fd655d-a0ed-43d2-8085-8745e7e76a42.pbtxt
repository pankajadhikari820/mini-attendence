    command_line: "node -e \"\nconst en = require(\'./src/i18n/en.json\');\nconst hi = require(\'./src/i18n/hi.json\');\nconst flat = (obj, p = \'\') => Object.entries(obj).flatMap(([k, v]) => typeof v === \'object\' && v ? flat(v, p ? p + \'.\' + k : k) : [p ? p + \'.\' + k : k]);\nconst enK = new Set(flat(en));\nconst hiK = new Set(flat(hi));\nconst missingInHi = [...enK].filter(k => !hiK.has(k));\nconst missingInEn = [...hiK].filter(k => !enK.has(k));\nconsole.log(\'EN keys:\', enK.size, \'HI keys:\', hiK.size);\nconsole.log(\'Missing in HI:\', missingInHi);\nconsole.log(\'Missing in EN:\', missingInEn);\nif (missingInHi.length || missingInEn.length) process.exit(1);\n\""
    proposed_command_line: "node -e \"\nconst en = require(\'./src/i18n/en.json\');\nconst hi = require(\'./src/i18n/hi.json\');\nconst flat = (obj, p = \'\') => Object.entries(obj).flatMap(([k, v]) => typeof v === \'object\' && v ? flat(v, p ? p + \'.\' + k : k) : [p ? p + \'.\' + k : k]);\nconst enK = new Set(flat(en));\nconst hiK = new Set(flat(hi));\nconst missingInHi = [...enK].filter(k => !hiK.has(k));\nconst missingInEn = [...hiK].filter(k => !enK.has(k));\nconsole.log(\'EN keys:\', enK.size, \'HI keys:\', hiK.size);\nconsole.log(\'Missing in HI:\', missingInHi);\nconsole.log(\'Missing in EN:\', missingInEn);\nif (missingInHi.length || missingInEn.length) process.exit(1);\n\""
