              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  - Automatic GPS verification (`\"You are 12 m from the class \342\234\223\"` / `\"You are 340 m away \342\234\227\"`), rejecting readings with accuracy > 100 m."
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
