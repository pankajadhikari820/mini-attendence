              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  - Atomic one-device-per-session lock via `sessionDevices/{sessionId}_{deviceId}` written in the same `writeBatch` as the attendance record."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
