25\340\244\276\340\244\260\340\245\215\340\244\260\340\244\265\340\244\276\340\244\210 \340\244\225\340\245\200 \340\244\205\340\244\250\340\245\201\340\244\256\340\244\244\340\244\277 \340\244\250\340\244\271\340\245\200\340\244\202 \340\244\271\340\245\210\340\245\244\\\",\\n    \\\"passwordMismatch\\\": \\\"\340\244\246\340\245\213\340\244\250\340\245\213\340\244\202 \340\244\252\340\244\276\340\244\270\340\244\265\340\244\260\340\245\215\340\244\241 \340\244\217\340\244\225 \340\244\234\340\245\210\340\244\270\340\245\207 \340\244\250\340\244\271\340\245\200\340\244\202 \340\244\271\340\245\210\340\244\202\340\245\244\\\",\\n    \\\"invalidCode\\\": \\\"\340\244\225\340\245\213\340\244\241 \340\244\250\340\244\271\340\245\200\340\244\202 \340\244\256\340\244\277\340\244\262\340\244\276\340\245\244 \340\244\225\340\245\203\340\244\252\340\244\257\340\244\276 \340\244\234\340\244\276\340\244\201\340\244\232 \340\244\225\340\244\260 \340\244\246\340\245\213\340\244\254\340\244\276\340\244\260\340\244\276 \340\244\262\340\244\277\340\244\226\340\245\207\340\244\202\340\245\244\\\",\\n    \\\"requiredFields\\\": \\\"\340\244\225\340\245\203\340\244\252\340\244\257\340\244\276 \340\244\270\340\244\255\340\245\200 \340\244\234\340\244\274\340\244\260\340\245\202\340\244\260\340\245\200 \340\244\234\340\244\276\340\244\250\340\244\225\340\244\276\340\244\260\340\245\200 \340\244\255\340\244\260\340\245\207\340\244\202\340\245\244\\\",\\n    \\\"englishNameRequired\\\": \\\"6 \340\244\205\340\244\225\340\245\215\340\244\267\340\244\260\340\245\213\340\244\202 \340\244\225\340\245\200 \340\244\206\340\244\210\340\244\241\340\245\200 \340\244\254\340\244\250\340\244\276\340\244\250\340\245\207 \340\244\225\340\245\207 \340\244\262\340\244\277\340\244\217 \340\244\225\340\245\203\340\244\252\340\244\257\340\244\276 \340\244\250\340\244\276\340\244\256 \340\244\225\340\245\200 \340\244\205\340\244\202\340\244\227\340\245\215\340\244\260\340\245\207\340\244\234\340\244\274\340\245\200 \340\244\270\340\245\215\340\244\252\340\245\207\340\244\262\340\244\277\340\244\202\340\244\227 \340\244\262\340\244\277\340\244\226\340\245\207\340\244\202\340\245\244\\\",\\n    \\\"generic\\\": \\\"\340\244\225\340\245\201\340\244\233 \340\244\227\340\244\241\340\244\274\340\244\254\340\244\241\340\244\274 \340\244\271\340\245\213 \340\244\227\340\244\210\340\245\244 \340\244\225\340\245\203\340\244\252\340\244\257\340\244\276 \340\244\246\340\245\213\340\244\254\340\244\276\340\244\260\340\244\276 \340\244\225\340\245\213\340\244\266\340\244\277\340\244\266 \340\244\225\340\244\260\340\245\207\340\244\202\340\245\244\\\"\\n  },\\n  \\\"notFound\\\": {\\n    \\\"title\\\": \\\"\340\244\252\340\245\207\340\244\234 \340\244\250\340\244\271\340\245\200\340\244\202 \340\244\256\340\244\277\340\244\262\340\244\276\\\",\\n    \\\"desc\\\": \\\"\340\244\206\340\244\252 \340\244\234\340\245\213 \340\244\252\340\245\207\340\244\234 \340\244\242\340\245\202\340\244\201\340\244\242 \340\244\260\340\244\271\340\245\207 \340\244\271\340\245\210\340\244\202 \340\244\265\340\244\271 \340\244\256\340\245\214\340\244\234\340\245\202\340\244\246 \340\244\250\340\244\271\340\245\200\340\244\202 \340\244\271\340\245\210 \340\244\257\340\244\276 \340\244\271\340\244\237\340\244\276 \340\244\246\340\244\277\340\244\257\340\244\276 \340\244\227\340\244\257\340\244\276 \340\244\271\340\245\210\340\245\244\\\",\\n    \\\"goHome\\\": \\\"\340\244\256\340\245\201\340\244\226\340\245\215\340\244\257 \340\244\252\340\245\207\340\244\234 \340\244\252\340\244\260 \340\244\234\340\244\276\340\244\217\340\244\201\\\"\\n  }\\n}\\n\", \"Description\":\"Update hi.json removing all LATE keys and adding all 148 new Smart Campus Hindi translations with 100% EN parity\", \"Overwrite\":true, \"TargetFile\":\"/src/i18n/hi.json\", \"toolAction\":\"Updating hi.json dictionary\", \"toolSummary\":\"Update hi.json dictionary\"}"
      original_name: "write_to_file"
