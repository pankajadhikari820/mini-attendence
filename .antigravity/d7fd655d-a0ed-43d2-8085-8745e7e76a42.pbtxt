    tool_calls {
      id: "call_13684098957541944579"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { createUserWithEmailAndPassword } from \'firebase/auth\';\\nimport {\\n  collection,\\n  deleteDoc,\\n  doc,\\n  getDoc,\\n  getDocs,\\n  query,\\n  runTransaction,\\n  serverTimestamp,\\n  setDoc,\\n  updateDoc,\\n  where,\\n} from \'firebase/firestore\';\\nimport { auth, createSecondaryAccount, db } from \'../firebase\';\\nimport type { LanguageCode, Organization, UserProfile, UserStatus } from \'../types\';\\nimport { buildOrgPrefix, formatMemberId, generateCode } from \'../utils/helpers\';\\nimport { createNotification } from \'./communicationService\';\\n\\nexport async function generateUniqueManagerCode(): Promise<string> {\\n  for (let attempt = 0; attempt < 10; attempt++) {\\n    const code = generateCode(6);\\n    const snap = await getDoc(doc(db, \'managerCodes\', code));\\n    if (!snap.exists()) return code;\\n  }\\n  return generateCode(8);\\n}\\n\\n/**\\n * Atomically increments the org counter in a Firestore transaction\\n * and returns a unique readable ID like ORG-MGR-0001 or ORG-MEM-0001.\\n */\\nexport async function allocateMemberId(\\n  orgId: string,\\n  orgName: string,\\n  role: \'manager\' | \'member\'\\n): Promise<string> {\\n  const orgRef = doc(db, \'organizations\', orgId);\\n  const nextNumber = await runTransaction(db, async (tx) => {\\n    const snap = await tx.get(orgRef);\\n    if (!snap.exists()) throw new Error(\'Organization not found\');\\n    const data = snap.data() as Organization;\\n    const current = data.counters?.[role] ?? 0;\\n    const next = current + 1;\\n    tx.update(orgRef, {\\n      counters: {\\n        manager: role === \'manager\' ? next : data.counters?.manager ?? 0,\\n        member: role === \'member\' ? next : data.counters?.member ?? 0,\\n      },\\n    });\\n    return next;\\n  });\\n\\n  const prefix = buildOrgPrefix(orgName);\\n  return formatMemberId(prefix, role, nextNumber);\\n}\\n\\n/**\\n * Directly adds a Manager (by Admin) or Member (by Manager/Admin).\\n * Uses the secondary Firebase Auth instance so the current user stays signed in.\\n */\\nexport async function addPersonDirect(params: {\\n  org: Organization;\\n  role: \'manager\' | \'member\';\\n  managerId: string | null;\\n  name: string;\\n  email: string;\\n  phone: string;\\n  rollNumber?: string;\\n  language?: LanguageCode;\\n}): Promise<{ profile: UserProfile; resetEmailSent: boolean }> {\\n  const cleanEmail = params.email.trim().toLowerCase();\\n  const { uid, resetEmailSent } = await createSecondaryAccount(cleanEmail);\\n\\n  const memberId = await allocateMemberId(params.org.id, params.org.name, params.role);\\n  let managerCode: string | undefined;\\n\\n  if (params.role === \'manager\') {\\n    managerCode = await generateUniqueManagerCode();\\n    await setDoc(doc(db, \'managerCodes\', managerCode), {\\n      orgId: params.org.id,\\n      managerUid: uid,\\n      managerName: params.name.trim(),\\n      orgName: params.org.name,\\n      roleLabels: params.org.roleLabels,\\n    });\\n  }\\n\\n  const userDoc: Omit<UserProfile, \'createdAt\'> & { createdAt: ReturnType<typeof serverTimestamp> } = {\\n    uid,\\n    name: params.name.trim(),\\n    email: cleanEmail,\\n    phone: params.phone.trim(),\\n    rollNumber: params.rollNumber?.trim() || \'\',\\n    role: params.role,\\n    orgId: params.org.id,\\n    managerId: params.role === \'member\' ? params.managerId : null,\\n    memberId,\\n    status: \'active\',\\n    ...(managerCode ? { managerCode } : {}),\\n    language: params.language || \'en\',\\n    createdAt: serverTimestamp(),\\n  };\\n\\n  await setDoc(doc(db, \'users\', uid), userDoc);\\n\\n  return {\\n    profile: { ...userDoc, createdAt: null } as UserProfile,\\n    resetEmailSent,\\n  };\\n}\\n\\n/**\\n * Self-registration for a Manager (using Organization Code) or Member (using Manager Code).\\n * Status starts as \'pending\' until approved by parent.\\n */\\nexport async function selfRegisterUser(params: {\\n  role: \'manager\' | \'member\';\\n  orgId: string;\\n  managerId: string | null;\\n  parentNotifyUid: string | null;\\n  name: string;\\n  email: string;\\n  password: string;\\n  phone: string;\\n  rollNumber?: string;\\n  language: LanguageCode;\\n}): Promise<string> {\\n  const cleanEmail = params.email.trim().toLowerCase();\\n  const cred = await createUserWithEmailAndPassword(auth, cleanEmail, params.password);\\n  const uid = cred.user.uid;\\n\\n  await setDoc(doc(db, \'users\', uid), {\\n    uid,\\n    name: params.name.trim(),\\n    email: cleanEmail,\\n    phone: params.phone.trim(),\\n    rollNumber: params.rollNumber?.trim() || \'\',\\n    role: params.role,\\n    orgId: params.orgId,\\n    managerId: params.role === \'member\' ? params.managerId : null,\\n    memberId: \'\',\\n    status: \'pending\',\\n    language: params.language,\\n    createdAt: serverTimestamp(),\\n  });\\n\\n  if (params.parentNotifyUid) {\\n    try {\\n      await createNotification({\\n        orgId: params.orgId,\\n        toUid: params.parentNotifyUid,\\n        type: \'approval\',\\n        text: `${params.name.trim()} requested to join as ${params.role}.`,\\n      });\\n    } catch {\\n      // Non-fatal\\n    }\\n  }\\n\\n  return uid;\\n}\\n\\nexport async function approvePendingUser(org: Organization, person: UserProfile): Promise<void> {\\n  if (person.role === \'admin\') return;\\n  const memberId = person.memberId || (await allocateMemberId(org.id, org.name, person.role));\\n  const patch: Record<string, unknown> = {\\n    status: \'active\',\\n    memberId,\\n  };\\n\\n  if (person.role === \'manager\' && !person.managerCode) {\\n    const code = await generateUniqueManagerCode();\\n    patch.managerCode = code;\\n    await setDoc(doc(db, \'managerCodes\', code), {\\n      orgId: org.id,\\n      managerUid: person.uid,\\n      managerName: person.name,\\n      orgName: org.name,\\n      roleLabels: org.roleLabels,\\n    });\\n  }\\n\\n  await updateDoc(doc(db, \'users\', person.uid), patch);\\n\\n  await createNotification({\\n    orgId: org.id,\\n    toUid: person.uid,\\n    type: \'approval\',\\n    text: `Your account has been approved. Your ID is ${memberId}.`,\\n  });\\n}\\n\\nexport async function rejectPendingUser(orgId: string, person: UserProfile): Promise<void> {\\n  await updateDoc(doc(db, \'users\', person.uid), { status: \'inactive\' });\\n  await createNotification({\\n    orgId,\\n    toUid: person.uid,\\n    type: \'approval\',\\n    text: \'Your registration request was not approved.\',\\n  });\\n}\\n\\nexport async function updateUserDetails(\\n  uid: string,\\n  updates: Partial<Pick<UserProfile, \'name\' | \'phone\' | \'rollNumber\' | \'language\'>>\\n): Promise<void> {\\n  await updateDoc(doc(db, \'users\', uid), updates as Record<string, unknown>);\\n}\\n\\nexport async function setUserStatus(uid: string, status: UserStatus): Promise<void> {\\n  await updateDoc(doc(db, \'users\', uid), { status });\\n}\\n\\nexport async function deleteUserProfile(person: UserProfile): Promise<void> {\\n  if (person.managerCode) {\\n    try {\\n      await deleteDoc(doc(db, \'managerCodes\', person.managerCode));\\n    } catch {\\n      // Ignore if already removed\\n    }\\n  }\\n  await deleteDoc(doc(db, \'users\', person.uid));\\n}\\n\\nexport async function fetchOrgUsers(\\n  orgId: string,\\n  role?: \'manager\' | \'member\'\\n): Promise<UserProfile[]> {\\n  const constraints = [where(\'orgId\', \'==\', orgId)];\\n  if (role) constraints.push(where(\'role\', \'==\', role));\\n  const q = query(collection(db, \'users\'), ...constraints);\\n  const snap = await getDocs(q);\\n  return snap.docs\\n    .map((d) => ({ ...(d.data() as UserProfile), uid: d.id }))\\n    .sort((a, b) => a.name.localeCompare(b.name));\\n}\\n\\nexport async function fetchManagerMembers(\\n  orgId: string,\\n  managerUid: string\\n): Promise<UserProfile[]> {\\n  const q = query(\\n    collection(db, \'users\'),\\n    where(\'orgId\', \'==\', orgId),\\n    where(\'managerId\', \'==\', managerUid)\\n  );\\n  const snap = await getDocs(q);\\n  return snap.docs\\n    .map((d) => ({ ...(d.data() as UserProfile), uid: d.id }))\\n    .filter((u) => u.role === \'member\')\\n    .sort((a, b) => a.name.localeCompare(b.name));\\n}\\n\", \"Description\":\"Create userService handling atomic ID allocation, secondary-app account creation, self-registration, approvals, and scoped queries\", \"Overwrite\":true, \"TargetFile\":\"/src/services/userService.ts\", \"toolAction\":\"Creating user service\", \"toolSummary\":\"Create userService.ts\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_13684098957541942822"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import {\\n  collection,\\n  doc,\\n  getDoc,\\n  getDocs,\\n  query,\\n  serverTimestamp,\\n  setDoc,\\n  where,\\n  writeBatch,\\n} from \'firebase/firestore\';\\nimport { db } from \'../firebase\';\\nimport type {\\n  AttendanceMethod,\\n  AttendanceRecord,\\n  AttendanceStatus,\\n  Organization,\\n  QRPayload,\\n  UserProfile,\\n} from \'../types\';\\nimport {\\n  getCurrentPosition,\\n  getDistanceMeters,\\n  getOrgDateString,\\n  getOrgTimeHHMM,\\n  isAfterLateTime,\\n} from \'../utils/helpers\';\\n\\nexport function buildAttendanceDocId(orgId: string, date: string, personUid: string): string {\\n  return `${orgId}_${date}_${personUid}`;\\n}\\n\\nexport async function verifyLocationCheck(\\n  org: Organization\\n): Promise<{ ok: true } | { ok: false; reason: \'locationDenied\' | \'locationTooFar\'; distance?: number }> {\\n  if (!org.location?.enabled) return { ok: true };\\n  if (!org.location.lat && !org.location.lng) return { ok: true };\\n\\n  try {\\n    const pos = await getCurrentPosition();\\n    const distance = getDistanceMeters(pos.lat, pos.lng, org.location.lat, org.location.lng);\\n    if (distance > (org.location.radius || 200)) {\\n      return { ok: false, reason: \'locationTooFar\', distance };\\n    }\\n    return { ok: true };\\n  } catch {\\n    return { ok: false, reason: \'locationDenied\' };\\n  }\\n}\\n\\nexport interface QRScanResult {\\n  ok: boolean;\\n  code:\\n    | \'markedPresent\'\\n    | \'markedLate\'\\n    | \'alreadyMarked\'\\n    | \'invalidQr\'\\n    | \'wrongOrg\'\\n    | \'notYourPerson\'\\n    | \'userInactive\'\\n    | \'userNotFound\'\\n    | \'locationDenied\'\\n    | \'locationTooFar\';\\n  personName?: string;\\n  memberId?: string;\\n  status?: AttendanceStatus;\\n  timeStr?: string;\\n  distance?: number;\\n}\\n\\nexport async function markAttendanceViaQR(params: {\\n  rawText: string;\\n  org: Organization;\\n  marker: UserProfile;\\n  skipLocationCheck?: boolean;\\n}): Promise<QRScanResult> {\\n  let payload: QRPayload;\\n  try {\\n    const parsed = JSON.parse(params.rawText);\\n    if (!parsed || typeof parsed.orgId !== \'string\' || typeof parsed.uid !== \'string\') {\\n      return { ok: false, code: \'invalidQr\' };\\n    }\\n    payload = parsed as QRPayload;\\n  } catch {\\n    return { ok: false, code: \'invalidQr\' };\\n  }\\n\\n  if (payload.orgId !== params.org.id) {\\n    return { ok: false, code: \'wrongOrg\' };\\n  }\\n\\n  if (!params.skipLocationCheck) {\\n    const locCheck = await verifyLocationCheck(params.org);\\n    if (!locCheck.ok) {\\n      return { ok: false, code: locCheck.reason, distance: locCheck.distance };\\n    }\\n  }\\n\\n  const personSnap = await getDoc(doc(db, \'users\', payload.uid));\\n  if (!personSnap.exists()) {\\n    return { ok: false, code: \'userNotFound\' };\\n  }\\n  const person = { ...(personSnap.data() as UserProfile), uid: personSnap.id };\\n\\n  if (person.orgId !== params.org.id) {\\n    return { ok: false, code: \'wrongOrg\' };\\n  }\\n\\n  if (person.status !== \'active\') {\\n    return { ok: false, code: \'userInactive\', personName: person.name, memberId: person.memberId };\\n  }\\n\\n  // Strict hierarchy check: Admin -> Managers only; Manager -> own Members only\\n  const isDirectParent =\\n    (params.marker.role === \'admin\' && person.role === \'manager\') ||\\n    (params.marker.role === \'manager\' &&\\n      person.role === \'member\' &&\\n      person.managerId === params.marker.uid);\\n\\n  if (!isDirectParent) {\\n    return { ok: false, code: \'notYourPerson\', personName: person.name, memberId: person.memberId };\\n  }\\n\\n  const date = getOrgDateString(params.org.timezone || \'Asia/Kolkata\');\\n  const currentHHMM = getOrgTimeHHMM(params.org.timezone || \'Asia/Kolkata\');\\n  const docId = buildAttendanceDocId(params.org.id, date, person.uid);\\n  const existing = await getDoc(doc(db, \'attendance\', docId));\\n\\n  if (existing.exists()) {\\n    const existingData = existing.data() as AttendanceRecord;\\n    return {\\n      ok: false,\\n      code: \'alreadyMarked\',\\n      personName: person.name,\\n      memberId: person.memberId,\\n      status: existingData.status,\\n      timeStr: currentHHMM,\\n    };\\n  }\\n\\n  const status: AttendanceStatus = isAfterLateTime(currentHHMM, params.org.lateAfter)\\n    ? \'late\'\\n    : \'present\';\\n\\n  await setDoc(doc(db, \'attendance\', docId), {\\n    orgId: params.org.id,\\n    personUid: person.uid,\\n    personName: person.name,\\n    personMemberId: person.memberId,\\n    role: person.role,\\n    managerId: person.managerId || null,\\n    date,\\n    timestamp: serverTimestamp(),\\n    status,\\n    method: \'qr\' as AttendanceMethod,\\n    markedBy: params.marker.uid,\\n    note: \'\',\\n  });\\n\\n  return {\\n    ok: true,\\n    code: status === \'late\' ? \'markedLate\' : \'markedPresent\',\\n    personName: person.name,\\n    memberId: person.memberId,\\n    status,\\n    timeStr: currentHHMM,\\n  };\\n}\\n\\nexport async function markAttendanceManual(params: {\\n  org: Organization;\\n  marker: UserProfile;\\n  person: UserProfile;\\n  date: string;\\n  status: AttendanceStatus;\\n  note?: string;\\n}): Promise<void> {\\n  if (params.person.status !== \'active\') {\\n    throw new Error(\'Cannot mark inactive or pending user\');\\n  }\\n  const today = getOrgDateString(params.org.timezone || \'Asia/Kolkata\');\\n  if (params.marker.role !== \'admin\' && params.date !== today) {\\n    throw new Error(\'Only admins can edit past dates\');\\n  }\\n\\n  const docId = buildAttendanceDocId(params.org.id, params.date, params.person.uid);\\n  await setDoc(doc(db, \'attendance\', docId), {\\n    orgId: params.org.id,\\n    personUid: params.person.uid,\\n    personName: params.person.name,\\n    personMemberId: params.person.memberId,\\n    role: params.person.role === \'admin\' ? \'manager\' : params.person.role,\\n    managerId: params.person.managerId || null,\\n    date: params.date,\\n    timestamp: serverTimestamp(),\\n    status: params.status,\\n    method: \'manual\' as AttendanceMethod,\\n    markedBy: params.marker.uid,\\n    note: params.note?.trim() || \'\',\\n  });\\n}\\n\\nexport async function bulkMarkAttendance(params: {\\n  org: Organization;\\n  marker: UserProfile;\\n  entries: Array<{ person: UserProfile; status: AttendanceStatus; note?: string }>;\\n  date: string;\\n}): Promise<void> {\\n  const today = getOrgDateString(params.org.timezone || \'Asia/Kolkata\');\\n  if (params.marker.role !== \'admin\' && params.date !== today) {\\n    throw new Error(\'Only admins can edit past dates\');\\n  }\\n\\n  const CHUNK = 400;\\n  for (let i = 0; i < params.entries.length; i += CHUNK) {\\n    const slice = params.entries.slice(i, i + CHUNK);\\n    const batch = writeBatch(db);\\n    for (const entry of slice) {\\n      if (entry.person.status !== \'active\') continue;\\n      const docId = buildAttendanceDocId(params.org.id, params.date, entry.person.uid);\\n      batch.set(doc(db, \'attendance\', docId), {\\n        orgId: params.org.id,\\n        personUid: entry.person.uid,\\n        personName: entry.person.name,\\n        personMemberId: entry.person.memberId,\\n        role: entry.person.role === \'admin\' ? \'manager\' : entry.person.role,\\n        managerId: entry.person.managerId || null,\\n        date: params.date,\\n        timestamp: serverTimestamp(),\\n        status: entry.status,\\n        method: \'manual\' as AttendanceMethod,\\n        markedBy: params.marker.uid,\\n        note: entry.note?.trim() || \'\',\\n      });\\n    }\\n    await batch.commit();\\n  }\\n}\\n\\nexport async function fetchAttendanceForOrg(\\n  orgId: string,\\n  options?: { fromDate?: string; toDate?: string; date?: string }\\n): Promise<AttendanceRecord[]> {\\n  const constraints = [where(\'orgId\', \'==\', orgId)];\\n  if (options?.date) {\\n    constraints.push(where(\'date\', \'==\', options.date));\\n  }\\n  const snap = await getDocs(query(collection(db, \'attendance\'), ...constraints));\\n  let records = snap.docs.map((d) => ({ ...(d.data() as AttendanceRecord), id: d.id }));\\n  if (options?.fromDate) records = records.filter((r) => r.date >= options.fromDate!);\\n  if (options?.toDate) records = records.filter((r) => r.date <= options.toDate!);\\n  return records.sort((a, b) => b.date.localeCompare(a.date));\\n}\\n\\nexport async function fetchAttendanceForManager(\\n  orgId: string,\\n  managerUid: string,\\n  options?: { fromDate?: string; toDate?: string; date?: string; includeOwn?: boolean }\\n): Promise<AttendanceRecord[]> {\\n  const teamConstraints = [\\n    where(\'orgId\', \'==\', orgId),\\n    where(\'managerId\', \'==\', managerUid),\\n  ];\\n  if (options?.date) teamConstraints.push(where(\'date\', \'==\', options.date));\\n  const teamSnap = await getDocs(query(collection(db, \'attendance\'), ...teamConstraints));\\n  let records = teamSnap.docs.map((d) => ({ ...(d.data() as AttendanceRecord), id: d.id }));\\n\\n  if (options?.includeOwn) {\\n    const ownConstraints = [\\n      where(\'orgId\', \'==\', orgId),\\n      where(\'personUid\', \'==\', managerUid),\\n    ];\\n    if (options?.date) ownConstraints.push(where(\'date\', \'==\', options.date));\\n    const ownSnap = await getDocs(query(collection(db, \'attendance\'), ...ownConstraints));\\n    const ownRecs = ownSnap.docs.map((d) => ({ ...(d.data() as AttendanceRecord), id: d.id }));\\n    const seen = new Set(records.map((r) => r.id));\\n    for (const r of ownRecs) {\\n      if (!seen.has(r.id)) records.push(r);\\n    }\\n  }\\n\\n  if (options?.fromDate) records = records.filter((r) => r.date >= options.fromDate!);\\n  if (options?.toDate) records = records.filter((r) => r.date <= options.toDate!);\\n  return records.sort((a, b) => b.date.localeCompare(a.date));\\n}\\n\\nexport async function fetchAttendanceForPerson(\\n  orgId: string,\\n  personUid: string,\\n  options?: { fromDate?: string; toDate?: string }\\n): Promise<AttendanceRecord[]> {\\n  const snap = await getDocs(\\n    query(\\n      collection(db, \'attendance\'),\\n      where(\'orgId\', \'==\', orgId),\\n      where(\'personUid\', \'==\', personUid)\\n    )\\n  );\\n  let records = snap.docs.map((d) => ({ ...(d.data() as AttendanceRecord), id: d.id }));\\n  if (options?.fromDate) records = records.filter((r) => r.date >= options.fromDate!);\\n  if (options?.toDate) records = records.filter((r) => r.date <= options.toDate!);\\n  return records.sort((a, b) => b.date.localeCompare(a.date));\\n}\\n\", \"Description\":\"Create attendanceService with QR validation, location check, automatic late calculation, manual/bulk marking, and role-scoped queries\", \"Overwrite\":true, \"TargetFile\":\"/src/services/attendanceService.ts\", \"toolAction\":\"Creating attendance service\", \"toolSummary\":\"Create attendanceService.ts\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_13684098957541945161"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import {\\n  addDoc,\\n  collection,\\n  doc,\\n  getDocs,\\n  query,\\n  serverTimestamp,\\n  updateDoc,\\n  where,\\n  writeBatch,\\n} from \'firebase/firestore\';\\nimport { db } from \'../firebase\';\\nimport type { LeaveRequest, Organization, UserProfile } from \'../types\';\\nimport { eachDateBetween } from \'../utils/helpers\';\\nimport { buildAttendanceDocId } from \'./attendanceService\';\\nimport { createNotification } from \'./communicationService\';\\n\\nexport async function createLeaveRequest(params: {\\n  org: Organization;\\n  requester: UserProfile;\\n  fromDate: string;\\n  toDate: string;\\n  reason: string;\\n}): Promise<string> {\\n  const toUid =\\n    params.requester.role === \'member\' && params.requester.managerId\\n      ? params.requester.managerId\\n      : params.org.adminUid;\\n\\n  const ref = await addDoc(collection(db, \'leaves\'), {\\n    orgId: params.org.id,\\n    personUid: params.requester.uid,\\n    personName: params.requester.name,\\n    personRole: params.requester.role === \'admin\' ? \'manager\' : params.requester.role,\\n    personMemberId: params.requester.memberId,\\n    toUid,\\n    fromDate: params.fromDate,\\n    toDate: params.toDate,\\n    reason: params.reason.trim(),\\n    status: \'pending\',\\n    comment: \'\',\\n    createdAt: serverTimestamp(),\\n  });\\n\\n  await createNotification({\\n    orgId: params.org.id,\\n    toUid,\\n    type: \'leave\',\\n    text: `${params.requester.name} requested leave (${params.fromDate} to ${params.toDate}).`,\\n  });\\n\\n  return ref.id;\\n}\\n\\nexport async function decideLeaveRequest(params: {\\n  leave: LeaveRequest;\\n  decision: \'approved\' | \'rejected\';\\n  comment: string;\\n  decidedBy: UserProfile;\\n}): Promise<void> {\\n  await updateDoc(doc(db, \'leaves\', params.leave.id), {\\n    status: params.decision,\\n    comment: params.comment.trim(),\\n  });\\n\\n  // When approved, automatically mark each date as \\\"leave\\\" in attendance collection\\n  if (params.decision === \'approved\') {\\n    const dates = eachDateBetween(params.leave.fromDate, params.leave.toDate);\\n    if (dates.length > 0) {\\n      const batch = writeBatch(db);\\n      for (const date of dates) {\\n        const docId = buildAttendanceDocId(params.leave.orgId, date, params.leave.personUid);\\n        batch.set(doc(db, \'attendance\', docId), {\\n          orgId: params.leave.orgId,\\n          personUid: params.leave.personUid,\\n          personName: params.leave.personName,\\n          personMemberId: params.leave.personMemberId || \'\',\\n          role: params.leave.personRole,\\n          managerId:\\n            params.leave.personRole === \'member\' ? params.leave.toUid : null,\\n          date,\\n          timestamp: serverTimestamp(),\\n          status: \'leave\',\\n          method: \'manual\',\\n          markedBy: params.decidedBy.uid,\\n          note: params.leave.reason,\\n        });\\n      }\\n      await batch.commit();\\n    }\\n  }\\n\\n  await createNotification({\\n    orgId: params.leave.orgId,\\n    toUid: params.leave.personUid,\\n    type: \'leave\',\\n    text:\\n      params.decision === \'approved\'\\n        ? `Your leave (${params.leave.fromDate} to ${params.leave.toDate}) was approved.`\\n        : `Your leave (${params.leave.fromDate} to ${params.leave.toDate}) was rejected.`,\\n  });\\n}\\n\\nexport async function fetchLeavesForUser(profile: UserProfile): Promise<{\\n  myLeaves: LeaveRequest[];\\n  teamLeaves: LeaveRequest[];\\n}> {\\n  const sortByCreated = (list: LeaveRequest[]) =>\\n    list.sort((a, b) => {\\n      const ta = a.createdAt?.toMillis?.() ?? 0;\\n      const tb = b.createdAt?.toMillis?.() ?? 0;\\n      return tb - ta;\\n    });\\n\\n  if (profile.role === \'admin\') {\\n    const snap = await getDocs(\\n      query(collection(db, \'leaves\'), where(\'orgId\', \'==\', profile.orgId))\\n    );\\n    const all = snap.docs.map((d) => ({ ...(d.data() as LeaveRequest), id: d.id }));\\n    return {\\n      myLeaves: [],\\n      teamLeaves: sortByCreated(all),\\n    };\\n  }\\n\\n  if (profile.role === \'manager\') {\\n    const [ownSnap, teamSnap] = await Promise.all([\\n      getDocs(\\n        query(\\n          collection(db, \'leaves\'),\\n          where(\'orgId\', \'==\', profile.orgId),\\n          where(\'personUid\', \'==\', profile.uid)\\n        )\\n      ),\\n      getDocs(\\n        query(\\n          collection(db, \'leaves\'),\\n          where(\'orgId\', \'==\', profile.orgId),\\n          where(\'toUid\', \'==\', profile.uid)\\n        )\\n      ),\\n    ]);\\n    return {\\n      myLeaves: sortByCreated(\\n        ownSnap.docs.map((d) => ({ ...(d.data() as LeaveRequest), id: d.id }))\\n      ),\\n      teamLeaves: sortByCreated(\\n        teamSnap.docs.map((d) => ({ ...(d.data() as LeaveRequest), id: d.id }))\\n      ),\\n    };\\n  }\\n\\n  const snap = await getDocs(\\n    query(\\n      collection(db, \'leaves\'),\\n      where(\'orgId\', \'==\', profile.orgId),\\n      where(\'personUid\', \'==\', profile.uid)\\n    )\\n  );\\n  return {\\n    myLeaves: sortByCreated(\\n      snap.docs.map((d) => ({ ...(d.data() as LeaveRequest), id: d.id }))\\n    ),\\n    teamLeaves: [],\\n  };\\n}\\n\", \"Description\":\"Create leaveService for submitting requests, parent approvals/rejections, notifications, and automatic leave attendance records\", \"Overwrite\":true, \"TargetFile\":\"/src/services/leaveService.ts\", \"toolAction\":\"Creating leave service\", \"toolSummary\":\"Create leaveService.ts\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_13684098957541943404"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import {\\n  addDoc,\\n  collection,\\n  deleteDoc,\\n  doc,\\n  getDocs,\\n  onSnapshot,\\n  query,\\n  serverTimestamp,\\n  updateDoc,\\n  where,\\n  writeBatch,\\n} from \'firebase/firestore\';\\nimport { db } from \'../firebase\';\\nimport type { Announcement, AppNotification, UserProfile } from \'../types\';\\n\\nexport async function createNotification(params: {\\n  orgId: string;\\n  toUid: string;\\n  type: AppNotification[\'type\'];\\n  text: string;\\n  isDemo?: boolean;\\n}): Promise<void> {\\n  await addDoc(collection(db, \'notifications\'), {\\n    orgId: params.orgId,\\n    toUid: params.toUid,\\n    type: params.type,\\n    text: params.text,\\n    read: false,\\n    ...(params.isDemo ? { isDemo: true } : {}),\\n    createdAt: serverTimestamp(),\\n  });\\n}\\n\\nexport function subscribeNotifications(\\n  uid: string,\\n  callback: (items: AppNotification[]) => void\\n): () => void {\\n  const q = query(collection(db, \'notifications\'), where(\'toUid\', \'==\', uid));\\n  return onSnapshot(\\n    q,\\n    (snap) => {\\n      const items = snap.docs\\n        .map((d) => ({ ...(d.data() as AppNotification), id: d.id }))\\n        .sort((a, b) => (b.createdAt?.toMillis?.() ?? 0) - (a.createdAt?.toMillis?.() ?? 0))\\n        .slice(0, 30);\\n      callback(items);\\n    },\\n    () => {\\n      callback([]);\\n    }\\n  );\\n}\\n\\nexport async function markNotificationRead(id: string): Promise<void> {\\n  await updateDoc(doc(db, \'notifications\', id), { read: true });\\n}\\n\\nexport async function markAllNotificationsRead(items: AppNotification[]): Promise<void> {\\n  const unread = items.filter((n) => !n.read);\\n  if (unread.length === 0) return;\\n  const batch = writeBatch(db);\\n  for (const n of unread) {\\n    batch.update(doc(db, \'notifications\', n.id), { read: true });\\n  }\\n  await batch.commit();\\n}\\n\\nexport async function postAnnouncement(params: {\\n  author: UserProfile;\\n  audience: \'all\' | \'managers\' | \'members\';\\n  text: string;\\n  recipientUids?: string[];\\n}): Promise<string> {\\n  const ref = await addDoc(collection(db, \'announcements\'), {\\n    orgId: params.author.orgId,\\n    fromUid: params.author.uid,\\n    fromName: params.author.name,\\n    fromRole: params.author.role === \'admin\' ? \'admin\' : \'manager\',\\n    audience: params.author.role === \'manager\' ? \'members\' : params.audience,\\n    managerId: params.author.role === \'manager\' ? params.author.uid : null,\\n    text: params.text.trim(),\\n    createdAt: serverTimestamp(),\\n  });\\n\\n  if (params.recipientUids && params.recipientUids.length > 0) {\\n    const snippet =\\n      params.text.trim().length > 70\\n        ? `${params.text.trim().slice(0, 70)}...`\\n        : params.text.trim();\\n    const targets = params.recipientUids.slice(0, 80);\\n    const batch = writeBatch(db);\\n    for (const toUid of targets) {\\n      if (toUid === params.author.uid) continue;\\n      batch.set(doc(collection(db, \'notifications\')), {\\n        orgId: params.author.orgId,\\n        toUid,\\n        type: \'announcement\',\\n        text: `${params.author.name}: ${snippet}`,\\n        read: false,\\n        createdAt: serverTimestamp(),\\n      });\\n    }\\n    try {\\n      await batch.commit();\\n    } catch {\\n      // Non-fatal\\n    }\\n  }\\n\\n  return ref.id;\\n}\\n\\nexport async function deleteAnnouncement(id: string): Promise<void> {\\n  await deleteDoc(doc(db, \'announcements\', id));\\n}\\n\\nexport async function fetchAnnouncements(profile: UserProfile): Promise<Announcement[]> {\\n  const sortDesc = (list: Announcement[]) =>\\n    list.sort((a, b) => (b.createdAt?.toMillis?.() ?? 0) - (a.createdAt?.toMillis?.() ?? 0));\\n\\n  if (profile.role === \'admin\') {\\n    const snap = await getDocs(\\n      query(collection(db, \'announcements\'), where(\'orgId\', \'==\', profile.orgId))\\n    );\\n    return sortDesc(snap.docs.map((d) => ({ ...(d.data() as Announcement), id: d.id })));\\n  }\\n\\n  if (profile.role === \'manager\') {\\n    const [allSnap, mgrSnap, ownSnap] = await Promise.all([\\n      getDocs(\\n        query(\\n          collection(db, \'announcements\'),\\n          where(\'orgId\', \'==\', profile.orgId),\\n          where(\'audience\', \'==\', \'all\')\\n        )\\n      ),\\n      getDocs(\\n        query(\\n          collection(db, \'announcements\'),\\n          where(\'orgId\', \'==\', profile.orgId),\\n          where(\'audience\', \'==\', \'managers\')\\n        )\\n      ),\\n      getDocs(\\n        query(\\n          collection(db, \'announcements\'),\\n          where(\'orgId\', \'==\', profile.orgId),\\n          where(\'fromUid\', \'==\', profile.uid)\\n        )\\n      ),\\n    ]);\\n    const map = new Map<string, Announcement>();\\n    for (const s of [allSnap, mgrSnap, ownSnap]) {\\n      for (const d of s.docs) {\\n        map.set(d.id, { ...(d.data() as Announcement), id: d.id });\\n      }\\n    }\\n    return sortDesc(Array.from(map.values()));\\n  }\\n\\n  // Member: org-wide (\\\"all\\\") + manager\'s announcements (\\\"members\\\" with managerId == profile.managerId)\\n  const queries = [\\n    getDocs(\\n      query(\\n        collection(db, \'announcements\'),\\n        where(\'orgId\', \'==\', profile.orgId),\\n        where(\'audience\', \'==\', \'all\')\\n      )\\n    ),\\n  ];\\n  if (profile.managerId) {\\n    queries.push(\\n      getDocs(\\n        query(\\n          collection(db, \'announcements\'),\\n          where(\'orgId\', \'==\', profile.orgId),\\n          where(\'audience\', \'==\', \'members\'),\\n          where(\'managerId\', \'==\', profile.managerId)\\n        )\\n      )\\n    );\\n  }\\n  const snaps = await Promise.all(queries);\\n  const map = new Map<string, Announcement>();\\n  for (const s of snaps) {\\n    for (const d of s.docs) {\\n      map.set(d.id, { ...(d.data() as Announcement), id: d.id });\\n    }\\n  }\\n  return sortDesc(Array.from(map.values()));\\n}\\n\\nexport async function submitContactMessage(params: {\\n  name: string;\\n  email: string;\\n  message: string;\\n}): Promise<void> {\\n  await addDoc(collection(db, \'messages\'), {\\n    name: params.name.trim(),\\n    email: params.email.trim().toLowerCase(),\\n    message: params.message.trim(),\\n    createdAt: serverTimestamp(),\\n  });\\n}\\n\", \"Description\":\"Create communicationService for announcements, realtime notifications, and public contact messages\", \"Overwrite\":true, \"TargetFile\":\"/src/services/communicationService.ts\", \"toolAction\":\"Creating communication service\", \"toolSummary\":\"Create communicationService.ts\"}"
      original_name: "write_to_file"
    }
