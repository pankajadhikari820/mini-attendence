      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Label dedicated QR Scanner button clearly on ManagerDashboard\", \"EndLine\":208, \"Instruction\":\"Link ManagerDashboard QR Scanner button to /mark?tab=scan with QR Scanner label.\", \"ReplacementContent\":\"            <Link\\n              to=\\\"/mark?tab=scan\\\"\\n              className=\\\"inline-flex items-center gap-2 rounded-xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] hover:bg-stone-50 dark:hover:bg-stone-800 px-3.5 py-2.5 text-sm font-medium transition-colors whitespace-nowrap\\\"\\n            >\\n              <CheckCircle2 className=\\\"w-4 h-4 text-emerald-600\\\" />\\n              <span>{t(\'mark.qrScannerBtn\')}</span>\\n            </Link>\", \"StartLine\":196, \"TargetContent\":\"            <Link\\n              to=\\\"/mark\\\"\\n              className=\\\"inline-flex items-center gap-2 rounded-xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] hover:bg-stone-50 dark:hover:bg-stone-800 px-3.5 py-2.5 text-sm font-medium transition-colors whitespace-nowrap\\\"\\n            >\\n              <CheckCircle2 className=\\\"w-4 h-4 text-emerald-600\\\" />\\n              <span>{t(\'nav.markYourAttendance\')}</span>\\n            </Link>\", \"TargetFile\":\"/src/pages/ManagerDashboard.tsx\", \"toolAction\":\"Updating ManagerDashboard QR Scanner CTA\", \"toolSummary\":\"Update ManagerDashboard.tsx\"}"
