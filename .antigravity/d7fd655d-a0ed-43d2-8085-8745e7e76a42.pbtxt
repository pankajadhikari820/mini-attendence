      id: "call_5509662704455718249"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useCallback, useEffect, useMemo, useState } from \'react\';\\nimport { Link } from \'react-router-dom\';\\nimport { AlertTriangle, CalendarDays, Play, Plus, Trash2 } from \'lucide-react\';\\nimport { useAuth } from \'../context/AuthContext\';\\nimport { useTranslation } from \'../hooks/useTranslation\';\\nimport { useToast } from \'../context/ToastContext\';\\nimport type {\\n  AcademicClass,\\n  FacultyAssignment,\\n  Subject,\\n  TimetableSlot,\\n  UserProfile,\\n} from \'../types\';\\nimport {\\n  createTimetableSlot,\\n  deleteTimetableSlot,\\n  detectTimetableConflicts,\\n  fetchClasses,\\n  fetchFacultyAssignments,\\n  fetchLinkedStudentsForParent,\\n  fetchSubjects,\\n  fetchTimetableForOrg,\\n  subscribeTimetableForClass,\\n  subscribeTimetableForTeacher,\\n} from \'../services/academicService\';\\nimport { fetchOrgUsers } from \'../services/userService\';\\nimport {\\n  formatTimeRange12h,\\n  getFirebaseErrorKey,\\n  getOrgWeekdayIndex,\\n} from \'../utils/helpers\';\\nimport { Layout } from \'../components/Layout\';\\nimport { CardSkeleton, EmptyState } from \'../components/Skeletons\';\\n\\nconst WEEKDAYS = [\\n  { day: 1, en: \'Monday\', hi: \'\340\244\270\340\245\213\340\244\256\340\244\265\340\244\276\340\244\260\' },\\n  { day: 2, en: \'Tuesday\', hi: \'\340\244\256\340\244\202\340\244\227\340\244\262\340\244\265\340\244\276\340\244\260\' },\\n  { day: 3, en: \'Wednesday\', hi: \'\340\244\254\340\245\201\340\244\247\340\244\265\340\244\276\340\244\260\' },\\n  { day: 4, en: \'Thursday\', hi: \'\340\244\227\340\245\201\340\244\260\340\245\201\340\244\265\340\244\276\340\244\260\' },\\n  { day: 5, en: \'Friday\', hi: \'\340\244\266\340\245\201\340\244\225\340\245\215\340\244\260\340\244\265\340\244\276\340\244\260\' },\\n  { day: 6, en: \'Saturday\', hi: \'\340\244\266\340\244\250\340\244\277\340\244\265\340\244\276\340\244\260\' },\\n];\\n\\nexport const TimetablePage: React.FC = () => {\\n  const { profile, org } = useAuth();\\n  const { t, language } = useTranslation();\\n  const { showToast } = useToast();\\n\\n  const isAdmin = profile?.role === \'admin\' || profile?.role === \'super_admin\';\\n  const isTeacher = profile?.role === \'manager\';\\n  const todayWeekday = useMemo(\\n    () => getOrgWeekdayIndex(org?.timezone || \'Asia/Kolkata\'),\\n    [org?.timezone]\\n  );\\n\\n  const [loading, setLoading] = useState(true);\\n  const [slots, setSlots] = useState<TimetableSlot[]>([]);\\n  const [classes, setClasses] = useState<AcademicClass[]>([]);\\n  const [subjects, setSubjects] = useState<Subject[]>([]);\\n  const [teachers, setTeachers] = useState<UserProfile[]>([]);\\n  const [assignments, setAssignments] = useState<FacultyAssignment[]>([]);\\n  const [filterClassId, setFilterClassId] = useState<string>(\'all\');\\n  const [filterTeacherUid, setFilterTeacherUid] = useState<string>(\'all\');\\n\\n  // Admin add-slot form state\\n  const [dayOfWeek, setDayOfWeek] = useState<number>(todayWeekday === 0 ? 1 : todayWeekday);\\n  const [startTime, setStartTime] = useState(\'09:00\');\\n  const [endTime, setEndTime] = useState(\'10:00\');\\n  const [formClassId, setFormClassId] = useState(\'\');\\n  const [formSubjectId, setFormSubjectId] = useState(\'\');\\n  const [formTeacherUid, setFormTeacherUid] = useState(\'\');\\n  const [formRoom, setFormRoom] = useState(\'\');\\n  const [saving, setSaving] = useState(false);\\n\\n  const loadAdminMeta = useCallback(async () => {\\n    if (!org) return;\\n    setLoading(true);\\n    try {\\n      const [allSlots, clsList, subList, allUsers, asgns] = await Promise.all([\\n        fetchTimetableForOrg(org.id),\\n        fetchClasses(org.id),\\n        fetchSubjects(org.id),\\n        fetchOrgUsers(org.id, \'manager\'),\\n        fetchFacultyAssignments(org.id),\\n      ]);\\n      setSlots(allSlots);\\n      setClasses(clsList);\\n      setSubjects(subList);\\n      const activeMgrs = allUsers.filter((u) => u.status === \'active\');\\n      setTeachers(activeMgrs);\\n      setAssignments(asgns);\\n      if (!formClassId && clsList[0]) setFormClassId(clsList[0].id);\\n      if (!formSubjectId && subList[0]) setFormSubjectId(subList[0].id);\\n      if (!formTeacherUid && activeMgrs[0]) setFormTeacherUid(activeMgrs[0].uid);\\n    } catch (err) {\\n      showToast(t(getFirebaseErrorKey(err)), \'error\');\\n    } finally {\\n      setLoading(false);\\n    }\\n  }, [org, formClassId, formSubjectId, formTeacherUid, showToast, t]);\\n\\n  useEffect(() => {\\n    if (!org || !profile) return;\\n\\n    if (isAdmin) {\\n      loadAdminMeta();\\n      return;\\n    }\\n\\n    if (isTeacher) {\\n      setLoading(true);\\n      return subscribeTimetableForTeacher(org.id, profile.uid, (list) => {\\n        setSlots(list);\\n        setLoading(false);\\n      });\\n    }\\n\\n    if (profile.role === \'member\') {\\n      if (!profile.classId) {\\n        setSlots([]);\\n        setLoading(false);\\n        return;\\n      }\\n      setLoading(true);\\n      return subscribeTimetableForClass(org.id, profile.classId, (list) => {\\n        setSlots(list);\\n        setLoading(false);\\n      });\\n    }\\n\\n    if (profile.role === \'parent\') {\\n      setLoading(true);\\n      let unsub: (() => void) | undefined;\\n      fetchLinkedStudentsForParent(profile)\\n        .then((children) => {\\n          const firstClassId = children.find((c) => c.classId)?.classId;\\n          if (!firstClassId) {\\n            setSlots([]);\\n            setLoading(false);\\n            return;\\n          }\\n          unsub = subscribeTimetableForClass(org.id, firstClassId, (list) => {\\n            setSlots(list);\\n            setLoading(false);\\n          });\\n        })\\n        .catch(() => setLoading(false));\\n      return () => {\\n        if (unsub) unsub();\\n      };\\n    }\\n  }, [org, profile, isAdmin, isTeacher, loadAdminMeta]);\\n\\n  // Live conflict detection before Admin saves a new timetable slot\\n  const pendingConflicts = useMemo(() => {\\n    if (!isAdmin || !formClassId || !formTeacherUid || !startTime || !endTime) return [];\\n    return detectTimetableConflicts(slots, {\\n      dayOfWeek,\\n      startTime,\\n      endTime,\\n      classId: formClassId,\\n      teacherUid: formTeacherUid,\\n      classroom: formRoom,\\n    });\\n  }, [isAdmin, slots, dayOfWeek, startTime, endTime, formClassId, formTeacherUid, formRoom]);\\n\\n  const handleAddSlot = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    if (!org || !profile) return;\\n    if (pendingConflicts.length > 0) {\\n      showToast(t(\'timetable.conflictBlocked\'), \'error\');\\n      return;\\n    }\\n    const cls = classes.find((c) => c.id === formClassId);\\n    const sub = subjects.find((s) => s.id === formSubjectId);\\n    const te = teachers.find((x) => x.uid === formTeacherUid);\\n    if (!cls || !sub || !te) return;\\n\\n    setSaving(true);\\n    try {\\n      await createTimetableSlot({\\n        orgId: org.id,\\n        dayOfWeek,\\n        startTime,\\n        endTime,\\n        academicClass: cls,\\n        subject: sub,\\n        teacher: te,\\n        classroom: formRoom.trim() || cls.classroom || \'\',\\n        actor: profile,\\n      });\\n      showToast(t(\'common.saved\'), \'success\');\\n      await loadAdminMeta();\\n    } catch (err) {\\n      showToast(t(getFirebaseErrorKey(err)), \'error\');\\n    } finally {\\n      setSaving(false);\\n    }\\n  };\\n\\n  // Auto-fill teacher when Admin picks a Class + Subject that already has an assignment\\n  useEffect(() => {\\n    if (!isAdmin || !formClassId || !formSubjectId) return;\\n    const match = assignments.find(\\n      (a) => a.classId === formClassId && a.subjectId === formSubjectId\\n    );\\n    if (match) setFormTeacherUid(match.teacherUid);\\n  }, [isAdmin, formClassId, formSubjectId, assignments]);\\n\\n  const visibleSlots = useMemo(() => {\\n    return slots.filter((s) => {\\n      if (filterClassId !== \'all\' && s.classId !== filterClassId) return false;\\n      if (filterTeacherUid !== \'all\' && s.teacherUid !== filterTeacherUid) return false;\\n      return true;\\n    });\\n  }, [slots, filterClassId, filterTeacherUid]);\\n\\n  return (\\n    <Layout title={t(\'nav.timetable\')}>\\n      <div className=\\\"space-y-6\\\">\\n        <div className=\\\"flex flex-col sm:flex-row sm:items-end justify-between gap-4\\\">\\n          <div>\\n            <h2 className=\\\"text-2xl font-bold tracking-tight text-stone-900 dark:text-stone-50\\\">\\n              {t(\'timetable.title\')}\\n            </h2>\\n            <p className=\\\"mt-1 text-sm text-stone-500 dark:text-stone-400\\\">\\n              {t(\'timetable.subtitle\')}\\n            </p>\\n          </div>\\n\\n          {isAdmin && (classes.length > 0 || teachers.length > 0) && (\\n            <div className=\\\"flex flex-wrap gap-2\\\">\\n              <select\\n                value={filterClassId}\\n                onChange={(e) => setFilterClassId(e.target.value)}\\n                className=\\\"rounded-xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] px-3 py-2 text-xs sm:text-sm\\\"\\n              >\\n                <option value=\\\"all\\\">{t(\'academics.allClasses\')}</option>\\n                {classes.map((c) => (\\n                  <option key={c.id} value={c.id}>\\n                    {c.name}\\n                  </option>\\n                ))}\\n              </select>\\n              <select\\n                value={filterTeacherUid}\\n                onChange={(e) => setFilterTeacherUid(e.target.value)}\\n                className=\\\"rounded-xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] px-3 py-2 text-xs sm:text-sm\\\"\\n              >\\n                <option value=\\\"all\\\">{t(\'timetable.allTeachers\')}</option>\\n                {teachers.map((te) => (\\n                  <option key={te.uid} value={te.uid}>\\n                    {te.name}\\n                  </option>\\n                ))}\\n              </select>\\n            </div>\\n          )}\\n        </div>\\n\\n        {/* Admin Add Lecture Slot with Live Conflict Detection */}\\n        {isAdmin && (\\n          <form\\n            onSubmit={handleAddSlot}\\n            className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5 space-y-4\\\"\\n          >\\n            <h3 className=\\\"text-sm font-semibold text-stone-900 dark:text-stone-100\\\">\\n              {t(\'timetable.addSlotTitle\')}\\n            </h3>\\n            <div className=\\\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-3\\\">\\n              <div>\\n                <label className=\\\"block text-xs font-medium mb-1\\\">{t(\'timetable.day\')}</label>\\n                <select\\n                  value={dayOfWeek}\\n                  onChange={(e) => setDayOfWeek(Number(e.target.value))}\\n                  className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-900 px-3 py-2 text-xs sm:text-sm\\\"\\n                >\\n                  {WEEKDAYS.map((w) => (\\n                    <option key={w.day} value={w.day}>\\n                      {language === \'hi\' ? w.hi : w.en}\\n                    </option>\\n                  ))}\\n                </select>\\n              </div>\\n              <div>\\n                <label className=\\\"block text-xs font-medium mb-1\\\">{t(\'timetable.startTime\')}</label>\\n                <input\\n                  type=\\\"time\\\"\\n                  required\\n                  value={startTime}\\n                  onChange={(e) => setStartTime(e.target.value)}\\n                  className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-transparent px-3 py-2 text-xs sm:text-sm tabular-nums\\\"\\n                />\\n              </div>\\n              <div>\\n                <label className=\\\"block text-xs font-medium mb-1\\\">{t(\'timetable.endTime\')}</label>\\n                <input\\n                  type=\\\"time\\\"\\n                  required\\n                  value={endTime}\\n                  onChange={(e) => setEndTime(e.target.value)}\\n                  className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-transparent px-3 py-2 text-xs sm:text-sm tabular-nums\\\"\\n                />\\n              </div>\\n              <div>\\n                <label className=\\\"block text-xs font-medium mb-1\\\">{t(\'academics.classSection\')}</label>\\n                <select\\n                  required\\n                  value={formClassId}\\n                  onChange={(e) => setFormClassId(e.target.value)}\\n                  className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-900 px-3 py-2 text-xs sm:text-sm\\\"\\n                >\\n                  <option value=\\\"\\\">\342\200\224</option>\\n                  {classes.map((c) => (\\n                    <option key={c.id} value={c.id}>\\n                      {c.name}\\n                    </option>\\n                  ))}\\n                </select>\\n              </div>\\n              <div>\\n                <label className=\\\"block text-xs font-medium mb-1\\\">{t(\'academics.subject\')}</label>\\n                <select\\n                  required\\n                  value={formSubjectId}\\n                  onChange={(e) => setFormSubjectId(e.target.value)}\\n                  className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-900 px-3 py-2 text-xs sm:text-sm\\\"\\n                >\\n                  <option value=\\\"\\\">\342\200\224</option>\\n                  {subjects.map((s) => (\\n                    <option key={s.id} value={s.id}>\\n                      {s.name}\\n                    </option>\\n                  ))}\\n                </select>\\n              </div>\\n              <div>\\n                <label className=\\\"block text-xs font-medium mb-1\\\">{t(\'academics.teacher\')}</label>\\n                <select\\n                  required\\n                  value={formTeacherUid}\\n                  onChange={(e) => setFormTeacherUid(e.target.value)}\\n                  className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-900 px-3 py-2 text-xs sm:text-sm\\\"\\n                >\\n                  <option value=\\\"\\\">\342\200\224</option>\\n                  {teachers.map((te) => (\\n                    <option key={te.uid} value={te.uid}>\\n                      {te.name}\\n                    </option>\\n                  ))}\\n                </select>\\n              </div>\\n            </div>\\n\\n            <div className=\\\"flex flex-col sm:flex-row sm:items-center justify-between gap-3\\\">\\n              <input\\n                type=\\\"text\\\"\\n                value={formRoom}\\n                onChange={(e) => setFormRoom(e.target.value)}\\n                placeholder={t(\'academics.classroom\')}\\n                className=\\\"sm:w-56 rounded-xl border border-stone-300 dark:border-stone-700 bg-transparent px-3 py-2 text-xs sm:text-sm\\\"\\n              />\\n              <button\\n                type=\\\"submit\\\"\\n                disabled={saving || pendingConflicts.length > 0 || !formClassId || !formSubjectId || !formTeacherUid}\\n                className=\\\"inline-flex items-center justify-center gap-1.5 rounded-xl bg-[#C25E00] hover:bg-[#A84F00] disabled:opacity-50 text-white px-5 py-2 text-sm font-medium\\\"\\n              >\\n                <Plus className=\\\"w-4 h-4\\\" />\\n                <span>{t(\'timetable.addSlotBtn\')}</span>\\n              </button>\\n            </div>\\n\\n            {pendingConflicts.length > 0 && (\\n              <div\\n                role=\\\"alert\\\"\\n                className=\\\"rounded-xl border border-red-200 dark:border-red-900 bg-red-50 dark:bg-red-950/40 px-4 py-3 text-xs text-red-800 dark:text-red-300 space-y-1\\\"\\n              >\\n                <p className=\\\"font-semibold flex items-center gap-1.5\\\">\\n                  <AlertTriangle className=\\\"w-4 h-4 shrink-0\\\" />\\n                  <span>{t(\'timetable.conflictDetected\')}</span>\\n                </p>\\n                {pendingConflicts.map((c, idx) => (\\n                  <p key={idx}>\342\200\242 {c.message}</p>\\n                ))}\\n              </div>\\n            )}\\n          </form>\\n        )}\\n\\n        {/* Weekly Grid */}\\n        {loading ? (\\n          <CardSkeleton rows={4} />\\n        ) : visibleSlots.length === 0 ? (\\n          <EmptyState\\n            title={t(\'timetable.emptyTitle\')}\\n            description={t(\'timetable.emptyDesc\')}\\n          />\\n        ) : (\\n          <div className=\\\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\\\">\\n            {WEEKDAYS.map((w) => {\\n              const daySlots = visibleSlots.filter((s) => s.dayOfWeek === w.day);\\n              const isToday = todayWeekday === w.day;\\n              return (\\n                <section\\n                  key={w.day}\\n                  className={`rounded-2xl border bg-white dark:bg-[#161619] p-4 space-y-3 ${\\n                    isToday\\n                      ? \'border-[#C25E00] ring-1 ring-[#C25E00]/30\'\\n                      : \'border-stone-200 dark:border-stone-800\'\\n                  }`}\\n                >\\n                  <div className=\\\"flex items-center justify-between pb-2 border-b border-stone-100 dark:border-stone-800\\\">\\n                    <h3 className=\\\"text-sm font-bold text-stone-900 dark:text-stone-100 flex items-center gap-2\\\">\\n                      <CalendarDays className=\\\"w-4 h-4 text-[#C25E00]\\\" />\\n                      <span>{language === \'hi\' ? w.hi : w.en}</span>\\n                    </h3>\\n                    {isToday && (\\n                      <span className=\\\"text-[11px] font-semibold uppercase tracking-wider text-[#C25E00]\\\">\\n                        {t(\'common.today\')}\\n                      </span>\\n                    )}\\n                  </div>\\n\\n                  {daySlots.length === 0 ? (\\n                    <p className=\\\"text-xs text-stone-400 py-4 text-center\\\">\\n                      {t(\'timetable.noClassesDay\')}\\n                    </p>\\n                  ) : (\\n                    <div className=\\\"space-y-2.5\\\">\\n                      {daySlots.map((slot) => (\\n                        <div\\n                          key={slot.id}\\n                          className=\\\"rounded-xl border border-stone-200/80 dark:border-stone-800 bg-[#FAF9F6] dark:bg-stone-900/60 p-3 space-y-1.5\\\"\\n                        >\\n                          <div className=\\\"flex items-start justify-between gap-2\\\">\\n                            <div className=\\\"min-w-0\\\">\\n                              <p className=\\\"text-sm font-semibold text-stone-900 dark:text-stone-100 truncate\\\">\\n                                {slot.subjectName}\\n                              </p>\\n                              <p className=\\\"text-xs text-stone-500 dark:text-stone-400 truncate\\\">\\n                                {slot.className}\\n                              </p>\\n                            </div>\\n                            {isAdmin && (\\n                              <button\\n                                type=\\\"button\\\"\\n                                onClick={async () => {\\n                                  await deleteTimetableSlot(slot.id);\\n                                  showToast(t(\'common.deleted\'), \'info\');\\n                                  await loadAdminMeta();\\n                                }}\\n                                aria-label={t(\'common.delete\')}\\n                                className=\\\"text-stone-400 hover:text-red-600 p-1\\\"\\n                              >\\n                                <Trash2 className=\\\"w-3.5 h-3.5\\\" />\\n                              </button>\\n                            )}\\n                          </div>\\n\\n                          <div className=\\\"flex flex-wrap items-center justify-between gap-2 text-xs text-stone-500 dark:text-stone-400\\\">\\n                            <span className=\\\"font-mono tabular-nums text-[#C25E00]\\\">\\n                              {formatTimeRange12h(slot.startTime, slot.endTime)}\\n                            </span>\\n                            <span className=\\\"truncate\\\">\\n                              {slot.teacherName}\\n                              {slot.classroom ? ` \302\267 ${slot.classroom}` : \'\'}\\n                            </span>\\n                          </div>\\n\\n                          {(isTeacher || isAdmin) && isToday && (\\n                            <Link\\n                              to={`/attendance?slotId=${slot.id}`}\\n                              className=\\\"mt-1 inline-flex items-center gap-1.5 rounded-lg bg-[#C25E00] hover:bg-[#A84F00] text-white px-3 py-1.5 text-xs font-medium\\\"\\n                            >\\n                              <Play className=\\\"w-3 h-3 fill-current\\\" />\\n                              <span>{t(\'teacher.startLectureBtn\')}</span>\\n                            </Link>\\n                          )}\\n                        </div>\\n                      ))}\\n                    </div>\\n                  )}\\n                </section>\\n              );\\n            })}\\n          </div>\\n        )}\\n      </div>\\n    </Layout>\\n  );\\n};\\n\", \"Description\":\"Create TimetablePage with weekly schedule grid, live conflict detection, and one-click session launch\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/TimetablePage.tsx\", \"toolAction\":\"Creating TimetablePage.tsx\", \"toolSummary\":\"Create TimetablePage.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_5509662704455717088"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useEffect, useMemo, useState } from \'react\';\\nimport * as XLSX from \'xlsx\';\\nimport jsPDF from \'jspdf\';\\nimport autoTable from \'jspdf-autotable\';\\nimport {\\n  ResponsiveContainer,\\n  BarChart,\\n  Bar,\\n  XAxis,\\n  YAxis,\\n  Tooltip,\\n  CartesianGrid,\\n} from \'recharts\';\\nimport {\\n  AlertTriangle,\\n  BookOpen,\\n  Download,\\n  FileSpreadsheet,\\n  FileText,\\n  GraduationCap,\\n} from \'lucide-react\';\\nimport { useAuth } from \'../context/AuthContext\';\\nimport { useTranslation } from \'../hooks/useTranslation\';\\nimport type { AttendanceRecord, LeaveRequest, UserProfile } from \'../types\';\\nimport { fetchLinkedStudentsForParent } from \'../services/academicService\';\\nimport { fetchAttendanceForPerson } from \'../services/attendanceService\';\\nimport { fetchLeavesForStudent } from \'../services/leaveService\';\\nimport { computeStudentAttendanceAnalysis } from \'../services/lowAttendanceService\';\\nimport { Layout } from \'../components/Layout\';\\nimport { CardSkeleton, EmptyState } from \'../components/Skeletons\';\\n\\nexport const ParentDashboard: React.FC = () => {\\n  const { profile, org } = useAuth();\\n  const { t, formatDate, formatNumber } = useTranslation();\\n\\n  const [loading, setLoading] = useState(true);\\n  const [children, setChildren] = useState<UserProfile[]>([]);\\n  const [selectedChildUid, setSelectedChildUid] = useState<string>(\'\');\\n  const [records, setRecords] = useState<AttendanceRecord[]>([]);\\n  const [leaves, setLeaves] = useState<LeaveRequest[]>([]);\\n\\n  const threshold = org?.lowAttendanceThreshold ?? 75;\\n\\n  useEffect(() => {\\n    if (!profile) return;\\n    setLoading(true);\\n    fetchLinkedStudentsForParent(profile)\\n      .then((list) => {\\n        setChildren(list);\\n        if (list[0]) setSelectedChildUid(list[0].uid);\\n      })\\n      .finally(() => setLoading(false));\\n  }, [profile]);\\n\\n  const selectedChild = useMemo(\\n    () => children.find((c) => c.uid === selectedChildUid) || children[0] || null,\\n    [children, selectedChildUid]\\n  );\\n\\n  useEffect(() => {\\n    if (!org || !selectedChild) {\\n      setRecords([]);\\n      setLeaves([]);\\n      return;\\n    }\\n    setLoading(true);\\n    Promise.all([\\n      fetchAttendanceForPerson(org.id, selectedChild.uid),\\n      fetchLeavesForStudent(org.id, selectedChild.uid),\\n    ])\\n      .then(([att, lv]) => {\\n        setRecords(att);\\n        setLeaves(lv);\\n      })\\n      .finally(() => setLoading(false));\\n  }, [org, selectedChild]);\\n\\n  const analysis = useMemo(() => {\\n    if (!selectedChild) return null;\\n    return computeStudentAttendanceAnalysis(selectedChild, records, threshold);\\n  }, [selectedChild, records, threshold]);\\n\\n  const handleExportPDF = () => {\\n    if (!selectedChild || !org || !analysis) return;\\n    const pdf = new jsPDF({ orientation: \'portrait\', unit: \'mm\', format: \'a4\' });\\n    pdf.setFont(\'helvetica\', \'bold\');\\n    pdf.setFontSize(14);\\n    pdf.text(org.name, 14, 16);\\n    pdf.setFont(\'helvetica\', \'normal\');\\n    pdf.setFontSize(10);\\n    pdf.text(\\n      `Student Attendance Report \342\200\224 ${selectedChild.name} (${selectedChild.memberId})`,\\n      14,\\n      23\\n    );\\n    pdf.text(\\n      `Class: ${selectedChild.className || \'\342\200\224\'} \302\267 Overall: ${analysis.overallPercent}% (${analysis.presentCount}/${analysis.totalClasses})`,\\n      14,\\n      29\\n    );\\n\\n    autoTable(pdf, {\\n      startY: 36,\\n      head: [[\'Date\', \'Subject\', \'Teacher\', \'Status\', \'Method\']],\\n      body: records.map((r) => [\\n        r.date,\\n        r.subjectName || \'General\',\\n        r.teacherName || \'\342\200\224\',\\n        r.status.toUpperCase(),\\n        r.method,\\n      ]),\\n      styles: { fontSize: 8.5 },\\n      headStyles: { fillColor: [194, 94, 0] },\\n    });\\n\\n    pdf.save(`${selectedChild.memberId || \'student\'}_attendance_report.pdf`);\\n  };\\n\\n  const handleExportExcel = () => {\\n    if (!selectedChild || !analysis) return;\\n    const wb = XLSX.utils.book_new();\\n    const summarySheet = XLSX.utils.json_to_sheet(\\n      analysis.subjects.map((s) => ({\\n        Subject: s.subjectName,\\n        Code: s.subjectCode,\\n        Present: s.present,\\n        Absent: s.absent,\\n        Leave: s.leave,\\n        Total: s.total,\\n        Percentage: `${s.percentage}%`,\\n      }))\\n    );\\n    XLSX.utils.book_append_sheet(wb, summarySheet, \'Subject Summary\');\\n\\n    const detailSheet = XLSX.utils.json_to_sheet(\\n      records.map((r) => ({\\n        Date: r.date,\\n        Subject: r.subjectName || \'General\',\\n        Teacher: r.teacherName || \'\',\\n        Status: r.status.toUpperCase(),\\n        Method: r.method,\\n        Note: r.note || \'\',\\n      }))\\n    );\\n    XLSX.utils.book_append_sheet(wb, detailSheet, \'Attendance History\');\\n    XLSX.writeFile(wb, `${selectedChild.memberId || \'student\'}_attendance.xlsx`);\\n  };\\n\\n  return (\\n    <Layout title={t(\'nav.parentPortal\')}>\\n      <div className=\\\"space-y-6\\\">\\n        <div className=\\\"flex flex-col sm:flex-row sm:items-end justify-between gap-4\\\">\\n          <div>\\n            <h2 className=\\\"text-2xl font-bold tracking-tight text-stone-900 dark:text-stone-50\\\">\\n              {t(\'parent.title\')}\\n            </h2>\\n            <p className=\\\"mt-1 text-sm text-stone-500 dark:text-stone-400\\\">\\n              {t(\'parent.subtitle\')}\\n            </p>\\n          </div>\\n\\n          {selectedChild && (\\n            <div className=\\\"flex flex-wrap items-center gap-2\\\">\\n              {children.length > 1 && (\\n                <select\\n                  value={selectedChild.uid}\\n                  onChange={(e) => setSelectedChildUid(e.target.value)}\\n                  className=\\\"rounded-xl border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-900 px-3 py-2 text-sm\\\"\\n                >\\n                  {children.map((c) => (\\n                    <option key={c.uid} value={c.uid}>\\n                      {c.name} ({c.memberId})\\n                    </option>\\n                  ))}\\n                </select>\\n              )}\\n              <button\\n                type=\\\"button\\\"\\n                onClick={handleExportExcel}\\n                className=\\\"inline-flex items-center gap-1.5 rounded-xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] hover:bg-stone-50 dark:hover:bg-stone-800 px-3.5 py-2 text-xs font-medium\\\"\\n              >\\n                <FileSpreadsheet className=\\\"w-4 h-4 text-emerald-600\\\" />\\n                <span>Excel</span>\\n              </button>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={handleExportPDF}\\n                className=\\\"inline-flex items-center gap-1.5 rounded-xl bg-[#C25E00] hover:bg-[#A84F00] text-white px-3.5 py-2 text-xs font-medium\\\"\\n              >\\n                <FileText className=\\\"w-4 h-4\\\" />\\n                <span>PDF</span>\\n              </button>\\n            </div>\\n          )}\\n        </div>\\n\\n        {loading ? (\\n          <CardSkeleton rows={4} />\\n        ) : !selectedChild || !analysis ? (\\n          <EmptyState\\n            title={t(\'parent.noLinkedStudentTitle\')}\\n            description={t(\'parent.noLinkedStudentDesc\')}\\n          />\\n        ) : (\\n          <>\\n            {/* Student Banner */}\\n            <div className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5 flex flex-wrap items-center justify-between gap-4\\\">\\n              <div className=\\\"flex items-center gap-3.5\\\">\\n                <div className=\\\"w-12 h-12 rounded-xl bg-amber-100 dark:bg-amber-950/60 text-[#C25E00] flex items-center justify-center\\\">\\n                  <GraduationCap className=\\\"w-6 h-6\\\" />\\n                </div>\\n                <div>\\n                  <h3 className=\\\"text-lg font-bold text-stone-900 dark:text-stone-100\\\">\\n                    {selectedChild.name}\\n                  </h3>\\n                  <p className=\\\"text-xs text-stone-500 dark:text-stone-400 font-mono\\\">\\n                    ID: {selectedChild.memberId}\\n                    {selectedChild.className ? ` \302\267 ${selectedChild.className}` : \'\'}\\n                    {selectedChild.enrollmentNumber ? ` \302\267 #${selectedChild.enrollmentNumber}` : \'\'}\\n                  </p>\\n                </div>\\n              </div>\\n              <span className=\\\"text-xs text-stone-500 dark:text-stone-400\\\">\\n                {t(\'parent.readOnlyNote\')}\\n              </span>\\n            </div>\\n\\n            {/* 75% Shortage Warning */}\\n            {analysis.totalClasses > 0 && analysis.hasShortage && (\\n              <div\\n                role=\\\"alert\\\"\\n                className=\\\"rounded-2xl border border-red-200 dark:border-red-900 bg-red-50/75 dark:bg-red-950/30 p-4 flex items-start gap-3\\\"\\n              >\\n                <AlertTriangle className=\\\"w-5 h-5 text-red-600 shrink-0 mt-0.5\\\" />\\n                <div>\\n                  <p className=\\\"text-sm font-bold text-red-900 dark:text-red-200\\\">\\n                    {t(\'alerts.shortageWarningTitle\')} ({threshold}%)\\n                  </p>\\n                  <p className=\\\"text-xs text-red-800 dark:text-red-300 mt-0.5\\\">\\n                    {t(\'alerts.overallShortageDesc\')\\n                      .replace(\'{pct}\', String(analysis.overallPercent))\\n                      .replace(\'{threshold}\', String(threshold))}\\n                  </p>\\n                </div>\\n              </div>\\n            )}\\n\\n            {/* KPI Summary */}\\n            <div className=\\\"grid grid-cols-2 sm:grid-cols-4 gap-4\\\">\\n              <div className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5\\\">\\n                <p className=\\\"text-xs text-stone-500\\\">{t(\'student.overallRate\')}</p>\\n                <p\\n                  className={`mt-1.5 text-3xl font-bold tabular-nums ${\\n                    analysis.overallPercent < threshold && analysis.totalClasses > 0\\n                      ? \'text-red-600\'\\n                      : \'text-emerald-700 dark:text-emerald-400\'\\n                  }`}\\n                >\\n                  {formatNumber(analysis.overallPercent)}%\\n                </p>\\n              </div>\\n              <div className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5\\\">\\n                <p className=\\\"text-xs text-stone-500\\\">{t(\'common.present\')}</p>\\n                <p className=\\\"mt-1.5 text-3xl font-bold tabular-nums text-emerald-700 dark:text-emerald-400\\\">\\n                  {formatNumber(analysis.presentCount)}\\n                </p>\\n              </div>\\n              <div className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5\\\">\\n                <p className=\\\"text-xs text-stone-500\\\">{t(\'common.absent\')}</p>\\n                <p className=\\\"mt-1.5 text-3xl font-bold tabular-nums text-red-700 dark:text-red-400\\\">\\n                  {formatNumber(analysis.absentCount)}\\n                </p>\\n              </div>\\n              <div className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5\\\">\\n                <p className=\\\"text-xs text-stone-500\\\">{t(\'common.leave\')}</p>\\n                <p className=\\\"mt-1.5 text-3xl font-bold tabular-nums text-sky-700 dark:text-sky-400\\\">\\n                  {formatNumber(analysis.leaveCount)}\\n                </p>\\n              </div>\\n            </div>\\n\\n            {/* Subject-wise Chart */}\\n            {analysis.subjects.length > 0 && (\\n              <section className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5 sm:p-6\\\">\\n                <h3 className=\\\"text-base font-semibold flex items-center gap-2 mb-5\\\">\\n                  <BookOpen className=\\\"w-4 h-4 text-[#C25E00]\\\" />\\n                  <span>{t(\'student.subjectWiseTitle\')}</span>\\n                </h3>\\n                <div className=\\\"h-56 w-full\\\">\\n                  <ResponsiveContainer width=\\\"100%\\\" height=\\\"100%\\\">\\n                    <BarChart\\n                      data={analysis.subjects.map((s) => ({\\n                        name: s.subjectName,\\n                        percentage: s.percentage,\\n                      }))}\\n                      margin={{ top: 4, right: 8, left: -16, bottom: 0 }}\\n                    >\\n                      <CartesianGrid strokeDasharray=\\\"3 3\\\" stroke=\\\"#E7E5E4\\\" opacity={0.4} vertical={false} />\\n                      <XAxis dataKey=\\\"name\\\" tick={{ fontSize: 11, fill: \'#78716C\' }} axisLine={false} tickLine={false} />\\n                      <YAxis domain={[0, 100]} tick={{ fontSize: 11, fill: \'#78716C\' }} axisLine={false} tickLine={false} />\\n                      <Tooltip />\\n                      <Bar dataKey=\\\"percentage\\\" name=\\\"Attendance %\\\" fill=\\\"#C25E00\\\" radius={[4, 4, 0, 0]} />\\n                    </BarChart>\\n                  </ResponsiveContainer>\\n                </div>\\n              </section>\\n            )}\\n\\n            {/* Attendance History & Leave Status */}\\n            <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6\\\">\\n              <section className=\\\"lg:col-span-7 rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5 sm:p-6\\\">\\n                <h3 className=\\\"text-base font-semibold mb-4\\\">{t(\'dashboard.recentHistory\')}</h3>\\n                {records.length === 0 ? (\\n                  <p className=\\\"text-sm text-stone-500\\\">{t(\'common.noData\')}</p>\\n                ) : (\\n                  <div className=\\\"divide-y divide-stone-100 dark:divide-stone-800\\\">\\n                    {records.slice(0, 15).map((r) => (\\n                      <div key={r.id} className=\\\"py-3 flex items-center justify-between gap-2 text-sm\\\">\\n                        <div className=\\\"min-w-0\\\">\\n                          <p className=\\\"font-medium text-stone-900 dark:text-stone-100 truncate\\\">\\n                            {r.subjectName ? `${r.subjectName} \302\267 ` : \'\'}\\n                            {formatDate(r.date)}\\n                          </p>\\n                          <p className=\\\"text-xs text-stone-500 truncate\\\">\\n                            {r.teacherName || t(`common.${r.method}`)}\\n                          </p>\\n                        </div>\\n                        <span\\n                          className={`text-xs font-semibold uppercase ${\\n                            r.status === \'present\'\\n                              ? \'text-emerald-700 dark:text-emerald-400\'\\n                              : r.status === \'absent\'\\n                              ? \'text-red-700 dark:text-red-400\'\\n                              : \'text-sky-700 dark:text-sky-400\'\\n                          }`}\\n                        >\\n                          {t(`common.${r.status}`)}\\n                        </span>\\n                      </div>\\n                    ))}\\n                  </div>\\n                )}\\n              </section>\\n\\n              <section className=\\\"lg:col-span-5 rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5 sm:p-6\\\">\\n                <h3 className=\\\"text-base font-semibold mb-4\\\">{t(\'parent.leaveStatusTitle\')}</h3>\\n                {leaves.length === 0 ? (\\n                  <p className=\\\"text-sm text-stone-500\\\">{t(\'leaves.empty\')}</p>\\n                ) : (\\n                  <div className=\\\"divide-y divide-stone-100 dark:divide-stone-800\\\">\\n                    {leaves.map((l) => (\\n                      <div key={l.id} className=\\\"py-3 flex items-start justify-between gap-2 text-xs\\\">\\n                        <div className=\\\"min-w-0\\\">\\n                          <p className=\\\"font-medium text-stone-900 dark:text-stone-100\\\">\\n                            {formatDate(l.fromDate)} \342\200\223 {formatDate(l.toDate)}\\n                          </p>\\n                          <p className=\\\"text-stone-500 mt-0.5\\\">{l.reason}</p>\\n                        </div>\\n                        <span\\n                          className={`font-semibold uppercase shrink-0 ${\\n                            l.status === \'approved\'\\n                              ? \'text-emerald-700\'\\n                              : l.status === \'rejected\'\\n                              ? \'text-red-600\'\\n                              : \'text-amber-600\'\\n                          }`}\\n                        >\\n                          {t(`leaves.${l.status}`)}\\n                        </span>\\n                      </div>\\n                    ))}\\n                  </div>\\n                )}\\n              </section>\\n            </div>\\n          </>\\n        )}\\n      </div>\\n    </Layout>\\n  );\\n};\\n\", \"Description\":\"Create read-only ParentDashboard portal with linked child attendance, shortage alerts, subject chart, leaves, and PDF/Excel export\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/ParentDashboard.tsx\", \"toolAction\":\"Creating ParentDashboard.tsx\", \"toolSummary\":\"Create ParentDashboard.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_5509662704455720023"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useCallback, useEffect, useMemo, useState } from \'react\';\\nimport * as XLSX from \'xlsx\';\\nimport { FileSpreadsheet, RefreshCw, Search, ShieldCheck } from \'lucide-react\';\\nimport { useAuth } from \'../context/AuthContext\';\\nimport { useTranslation } from \'../hooks/useTranslation\';\\nimport { useToast } from \'../context/ToastContext\';\\nimport type { AuditLog } from \'../types\';\\nimport { fetchAuditLogs } from \'../services/auditService\';\\nimport { getFirebaseErrorKey } from \'../utils/helpers\';\\nimport { Layout } from \'../components/Layout\';\\nimport { CardSkeleton, EmptyState } from \'../components/Skeletons\';\\n\\nexport const AuditLogsPage: React.FC = () => {\\n  const { org } = useAuth();\\n  const { t, formatTime } = useTranslation();\\n  const { showToast } = useToast();\\n\\n  const [loading, setLoading] = useState(true);\\n  const [logs, setLogs] = useState<AuditLog[]>([]);\\n  const [search, setSearch] = useState(\'\');\\n  const [category, setCategory] = useState<string>(\'all\');\\n\\n  const loadLogs = useCallback(async () => {\\n    if (!org) return;\\n    setLoading(true);\\n    try {\\n      const list = await fetchAuditLogs(org.id, 250);\\n      setLogs(list);\\n    } catch (err) {\\n      showToast(t(getFirebaseErrorKey(err)), \'error\');\\n    } finally {\\n      setLoading(false);\\n    }\\n  }, [org, showToast, t]);\\n\\n  useEffect(() => {\\n    loadLogs();\\n  }, [loadLogs]);\\n\\n  const filtered = useMemo(() => {\\n    const q = search.trim().toLowerCase();\\n    return logs.filter((log) => {\\n      if (category !== \'all\' && !log.action.startsWith(category)) return false;\\n      if (!q) return true;\\n      return (\\n        log.actorName.toLowerCase().includes(q) ||\\n        log.action.toLowerCase().includes(q) ||\\n        log.summary.toLowerCase().includes(q)\\n      );\\n    });\\n  }, [logs, search, category]);\\n\\n  const handleExportExcel = () => {\\n    const wb = XLSX.utils.book_new();\\n    const ws = XLSX.utils.json_to_sheet(\\n      filtered.map((l) => ({\\n        Timestamp: l.createdAt?.toDate ? l.createdAt.toDate().toISOString() : \'\',\\n        Actor: l.actorName,\\n        Role: l.actorRole,\\n        Action: l.action,\\n        TargetType: l.targetType,\\n        TargetId: l.targetId,\\n        Summary: l.summary,\\n      }))\\n    );\\n    XLSX.utils.book_append_sheet(wb, ws, \'Audit Logs\');\\n    XLSX.writeFile(wb, `audit_logs_${org?.orgCode || \'org\'}.xlsx`);\\n  };\\n\\n  return (\\n    <Layout title={t(\'nav.auditLogs\')}>\\n      <div className=\\\"space-y-6\\\">\\n        <div className=\\\"flex flex-col sm:flex-row sm:items-end justify-between gap-4\\\">\\n          <div>\\n            <h2 className=\\\"text-2xl font-bold tracking-tight text-stone-900 dark:text-stone-50 flex items-center gap-2\\\">\\n              <ShieldCheck className=\\\"w-6 h-6 text-[#C25E00]\\\" />\\n              <span>{t(\'audit.title\')}</span>\\n            </h2>\\n            <p className=\\\"mt-1 text-sm text-stone-500 dark:text-stone-400\\\">\\n              {t(\'audit.subtitle\')}\\n            </p>\\n          </div>\\n          <div className=\\\"flex items-center gap-2\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={loadLogs}\\n              className=\\\"inline-flex items-center gap-1.5 rounded-xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] hover:bg-stone-50 dark:hover:bg-stone-800 px-3.5 py-2 text-xs font-medium\\\"\\n            >\\n              <RefreshCw className=\\\"w-3.5 h-3.5\\\" />\\n              <span>{t(\'mark.refreshSession\')}</span>\\n            </button>\\n            <button\\n              type=\\\"button\\\"\\n              disabled={filtered.length === 0}\\n              onClick={handleExportExcel}\\n              className=\\\"inline-flex items-center gap-1.5 rounded-xl bg-[#C25E00] hover:bg-[#A84F00] disabled:opacity-50 text-white px-3.5 py-2 text-xs font-medium\\\"\\n            >\\n              <FileSpreadsheet className=\\\"w-3.5 h-3.5\\\" />\\n              <span>Excel</span>\\n            </button>\\n          </div>\\n        </div>\\n\\n        {/* Filters */}\\n        <div className=\\\"flex flex-col sm:flex-row gap-3\\\">\\n          <div className=\\\"relative flex-1\\\">\\n            <Search className=\\\"w-4 h-4 text-stone-400 absolute left-3.5 top-1/2 -translate-y-1/2\\\" />\\n            <input\\n              type=\\\"text\\\"\\n              value={search}\\n              onChange={(e) => setSearch(e.target.value)}\\n              placeholder={t(\'audit.searchPlaceholder\')}\\n              className=\\\"w-full rounded-xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] pl-10 pr-4 py-2.5 text-sm\\\"\\n            />\\n          </div>\\n          <select\\n            value={category}\\n            onChange={(e) => setCategory(e.target.value)}\\n            className=\\\"rounded-xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] px-3 py-2.5 text-sm\\\"\\n          >\\n            <option value=\\\"all\\\">{t(\'audit.allActions\')}</option>\\n            <option value=\\\"session.\\\">Sessions</option>\\n            <option value=\\\"attendance.\\\">Attendance</option>\\n            <option value=\\\"user.\\\">Users</option>\\n            <option value=\\\"leave.\\\">Leaves</option>\\n            <option value=\\\"academic.\\\">Academics</option>\\n            <option value=\\\"timetable.\\\">Timetable</option>\\n            <option value=\\\"parent.\\\">Parent Links</option>\\n            <option value=\\\"alert.\\\">Low Attendance Alerts</option>\\n            <option value=\\\"settings.\\\">Settings</option>\\n          </select>\\n        </div>\\n\\n        {loading ? (\\n          <CardSkeleton rows={6} />\\n        ) : filtered.length === 0 ? (\\n          <EmptyState title={t(\'audit.emptyTitle\')} description={t(\'audit.subtitle\')} />\\n        ) : (\\n          <div className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] overflow-hidden\\\">\\n            <div className=\\\"overflow-x-auto\\\">\\n              <table className=\\\"w-full text-left text-sm\\\">\\n                <thead className=\\\"border-b border-stone-200 dark:border-stone-800 bg-stone-50/70 dark:bg-stone-900/50 text-xs text-stone-500\\\">\\n                  <tr>\\n                    <th className=\\\"py-3 px-4 font-medium\\\">{t(\'audit.time\')}</th>\\n                    <th className=\\\"py-3 px-4 font-medium\\\">{t(\'audit.actor\')}</th>\\n                    <th className=\\\"py-3 px-4 font-medium\\\">{t(\'audit.action\')}</th>\\n                    <th className=\\\"py-3 px-4 font-medium\\\">{t(\'audit.summary\')}</th>\\n                  </tr>\\n                </thead>\\n                <tbody className=\\\"divide-y divide-stone-100 dark:divide-stone-800\\\">\\n                  {filtered.map((log) => (\\n                    <tr key={log.id} className=\\\"hover:bg-stone-50/50 dark:hover:bg-stone-800/30\\\">\\n                      <td className=\\\"py-3 px-4 text-xs font-mono text-stone-500 whitespace-nowrap tabular-nums\\\">\\n                        {log.createdAt?.toDate\\n                          ? `${log.createdAt.toDate().toLocaleDateString()} ${formatTime(log.createdAt.toDate())}`\\n                          : \'\342\200\224\'}\\n                      </td>\\n                      <td className=\\\"py-3 px-4 text-xs whitespace-nowrap\\\">\\n                        <p className=\\\"font-medium text-stone-900 dark:text-stone-100\\\">\\n                          {log.actorName}\\n                        </p>\\n                        <p className=\\\"text-stone-400 uppercase text-[10px]\\\">{log.actorRole}</p>\\n                      </td>\\n                      <td className=\\\"py-3 px-4 font-mono text-xs text-[#C25E00] whitespace-nowrap\\\">\\n                        {log.action}\\n                      </td>\\n                      <td className=\\\"py-3 px-4 text-xs text-stone-700 dark:text-stone-300\\\">\\n                        {log.summary}\\n                      </td>\\n                    </tr>\\n                  ))}\\n                </tbody>\\n              </table>\\n            </div>\\n          </div>\\n        )}\\n      </div>\\n    </Layout>\\n  );\\n};\\n\", \"Description\":\"Create AuditLogsPage for viewing and exporting immutable audit trail records\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/AuditLogsPage.tsx\", \"toolAction\":\"Creating AuditLogsPage.tsx\", \"toolSummary\":\"Create AuditLogsPage.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_5509662704455718862"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useEffect, useState } from \'react\';\\nimport { Link } from \'react-router-dom\';\\nimport { ArrowRight, Building2, ShieldCheck } from \'lucide-react\';\\nimport { useAuth } from \'../context/AuthContext\';\\nimport { useTranslation } from \'../hooks/useTranslation\';\\nimport type { Organization } from \'../types\';\\nimport { fetchAllOrganizations } from \'../services/academicService\';\\nimport { Layout } from \'../components/Layout\';\\nimport { CardSkeleton, EmptyState } from \'../components/Skeletons\';\\n\\nexport const SuperAdminDashboard: React.FC = () => {\\n  const { org } = useAuth();\\n  const { t, formatNumber } = useTranslation();\\n  const [loading, setLoading] = useState(true);\\n  const [orgs, setOrgs] = useState<Organization[]>([]);\\n\\n  useEffect(() => {\\n    setLoading(true);\\n    fetchAllOrganizations()\\n      .then(setOrgs)\\n      .catch(() => {\\n        if (org) setOrgs([org]);\\n      })\\n      .finally(() => setLoading(false));\\n  }, [org]);\\n\\n  return (\\n    <Layout title={t(\'nav.organizations\')}>\\n      <div className=\\\"space-y-6\\\">\\n        <div className=\\\"flex flex-col sm:flex-row sm:items-end justify-between gap-4\\\">\\n          <div>\\n            <h2 className=\\\"text-2xl font-bold tracking-tight text-stone-900 dark:text-stone-50\\\">\\n              {t(\'superAdmin.title\')}\\n            </h2>\\n            <p className=\\\"mt-1 text-sm text-stone-500 dark:text-stone-400\\\">\\n              {t(\'superAdmin.subtitle\')}\\n            </p>\\n          </div>\\n          <div className=\\\"flex items-center gap-2.5\\\">\\n            <Link\\n              to=\\\"/audit-logs\\\"\\n              className=\\\"inline-flex items-center gap-1.5 rounded-xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] px-3.5 py-2 text-xs font-medium\\\"\\n            >\\n              <ShieldCheck className=\\\"w-4 h-4 text-[#C25E00]\\\" />\\n              <span>{t(\'nav.auditLogs\')}</span>\\n            </Link>\\n            <Link\\n              to=\\\"/admin\\\"\\n              className=\\\"inline-flex items-center gap-1.5 rounded-xl bg-[#C25E00] hover:bg-[#A84F00] text-white px-4 py-2 text-xs font-medium\\\"\\n            >\\n              <span>{t(\'superAdmin.openCurrentOrg\')}</span>\\n              <ArrowRight className=\\\"w-3.5 h-3.5\\\" />\\n            </Link>\\n          </div>\\n        </div>\\n\\n        <div className=\\\"grid grid-cols-1 sm:grid-cols-3 gap-4\\\">\\n          <div className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5\\\">\\n            <p className=\\\"text-xs text-stone-500\\\">{t(\'superAdmin.totalOrgs\')}</p>\\n            <p className=\\\"mt-2 text-3xl font-bold tabular-nums\\\">{formatNumber(orgs.length)}</p>\\n          </div>\\n          <div className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5\\\">\\n            <p className=\\\"text-xs text-stone-500\\\">{t(\'superAdmin.activeWorkspace\')}</p>\\n            <p className=\\\"mt-2 text-lg font-bold truncate\\\">{org?.name || \'\342\200\224\'}</p>\\n          </div>\\n          <div className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5\\\">\\n            <p className=\\\"text-xs text-stone-500\\\">{t(\'dashboard.yourOrgCode\')}</p>\\n            <p className=\\\"mt-2 text-2xl font-mono font-bold text-[#C25E00]\\\">\\n              {org?.orgCode || \'\342\200\224\'}\\n            </p>\\n          </div>\\n        </div>\\n\\n        {loading ? (\\n          <CardSkeleton rows={4} />\\n        ) : orgs.length === 0 ? (\\n          <EmptyState title={t(\'common.noData\')} description={t(\'superAdmin.subtitle\')} />\\n        ) : (\\n          <div className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] overflow-hidden\\\">\\n            <div className=\\\"overflow-x-auto\\\">\\n              <table className=\\\"w-full text-left text-sm\\\">\\n                <thead className=\\\"border-b border-stone-200 dark:border-stone-800 bg-stone-50/70 dark:bg-stone-900/50 text-xs text-stone-500\\\">\\n                  <tr>\\n                    <th className=\\\"py-3 px-4 font-medium\\\">{t(\'auth.orgNameLabel\')}</th>\\n                    <th className=\\\"py-3 px-4 font-medium\\\">{t(\'auth.orgTypeLabel\')}</th>\\n                    <th className=\\\"py-3 px-4 font-medium\\\">{t(\'dashboard.yourOrgCode\')}</th>\\n                    <th className=\\\"py-3 px-4 font-medium\\\">{t(\'settings.lowAttendanceThreshold\')}</th>\\n                    <th className=\\\"py-3 px-4 font-medium\\\">{t(\'common.status\')}</th>\\n                  </tr>\\n                </thead>\\n                <tbody className=\\\"divide-y divide-stone-100 dark:divide-stone-800\\\">\\n                  {orgs.map((o) => (\\n                    <tr key={o.id} className=\\\"hover:bg-stone-50/50 dark:hover:bg-stone-800/30\\\">\\n                      <td className=\\\"py-3 px-4 font-medium flex items-center gap-2\\\">\\n                        <Building2 className=\\\"w-4 h-4 text-[#C25E00] shrink-0\\\" />\\n                        <span>{o.name}</span>\\n                      </td>\\n                      <td className=\\\"py-3 px-4 text-xs text-stone-500\\\">{o.type}</td>\\n                      <td className=\\\"py-3 px-4 font-mono text-xs\\\">{o.orgCode}</td>\\n                      <td className=\\\"py-3 px-4 font-mono text-xs tabular-nums\\\">\\n                        {o.lowAttendanceThreshold ?? 75}%\\n                      </td>\\n                      <td className=\\\"py-3 px-4 text-xs font-semibold text-emerald-700 dark:text-emerald-400 uppercase\\\">\\n                        {o.status || \'active\'}\\n                      </td>\\n                    </tr>\\n                  ))}\\n                </tbody>\\n              </table>\\n            </div>\\n          </div>\\n        )}\\n      </div>\\n    </Layout>\\n  );\\n};\\n\", \"Description\":\"Create SuperAdminDashboard for multi-organization overview and governance\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/SuperAdminDashboard.tsx\", \"toolAction\":\"Creating SuperAdminDashboard.tsx\", \"toolSummary\":\"Create SuperAdminDashboard.tsx\"}"
      original_name: "write_to_file"
    }
