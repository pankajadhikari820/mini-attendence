    end_line: 527
    content: "{\n  \"brand\": \"Smart Attendance\",\n  \"brandFull\": \"Smart Attendance System\",\n  \"common\": {\n    \"loading\": \"Loading...\",\n    \"save\": \"Save\",\n    \"saving\": \"Saving...\",\n    \"cancel\": \"Cancel\",\n    \"delete\": \"Delete\",\n    \"edit\": \"Edit\",\n    \"add\": \"Add\",\n    \"close\": \"Close\",\n    \"confirm\": \"Confirm\",\n    \"search\": \"Search...\",\n    \"filter\": \"Filter\",\n    \"all\": \"All\",\n    \"status\": \"Status\",\n    \"actions\": \"Actions\",\n    \"date\": \"Date\",\n    \"time\": \"Time\",\n    \"name\": \"Name\",\n    \"englishNameLabel\": \"English spelling for ID\",\n    \"englishNameHint\": \"Used to create your 6-character unique ID (e.g. PAN482).\",\n    \"email\": \"Email\",\n    \"phone\": \"Phone\",\n    \"note\": \"Note\",\n    \"optional\": \"Optional\",\n    \"copy\": \"Copy\",\n    \"copied\": \"Copied\",\n    \"download\": \"Download\",\n    \"print\": \"Print\",\n    \"back\": \"Back\",\n    \"next\": \"Next\",\n    \"previous\": \"Previous\",\n    \"page\": \"Page\",\n    \"of\": \"of\",\n    \"showing\": \"Showing\",\n    \"noData\": \"No records found.\",\n    \"yes\": \"Yes\",\n    \"no\": \"No\",\n    \"demo\": \"Demo\",\n    \"today\": \"Today\",\n    \"thisMonth\": \"This month\",\n    \"logout\": \"Log out\",\n    \"login\": \"Login\",\n    \"register\": \"Sign up\",\n    \"installApp\": \"Install app\",\n    \"installOnIOS\": \"Install on iOS\",\n    \"offlineBanner\": \"No internet connection. Changes will not be saved until you reconnect.\",\n    \"active\": \"Active\",\n    \"inactive\": \"Inactive\",\n    \"pending\": \"Pending\",\n    \"approved\": \"Approved\",\n    \"rejected\": \"Rejected\",\n    \"present\": \"Present\",\n    \"absent\": \"Absent\",\n    \"late\": \"Late\",\n    \"leave\": \"Leave\",\n    \"unmarked\": \"Not marked\",\n    \"qr\": \"ID Card QR\",\n    \"live_qr\": \"Live QR\",\n    \"live_code\": \"Live Code\",\n    \"manual\": \"Manual\",\n    \"days\": \"days\",\n    \"minutes\": \"min\",\n    \"meters\": \"m\",\n    \"rollNumber\": \"Roll / Employee ID\",\n    \"memberId\": \"ID\",\n    \"role\": \"Role\",\n    \"admin\": \"Admin\",\n    \"manager\": \"Manager\",\n    \"member\": \"Member\"\n  },\n  \"nav\": {\n    \"howItWorks\": \"How it works\",\n    \"features\": \"Features\",\n    \"whoItsFor\": \"Who it is for\",\n    \"faq\": \"FAQ\",\n    \"contact\": \"Contact\",\n    \"dashboard\": \"Dashboard\",\n    \"startAttendance\": \"Start attendance\",\n    \"markAttendance\": \"Mark Attendance\",\n    \"markYourAttendance\": \"Mark attendance\",\n    \"manualBackup\": \"Manual backup\",\n    \"managers\": \"Managers\",\n    \"members\": \"Members\",\n    \"leaves\": \"Leaves\",\n    \"announcements\": \"Notices\",\n    \"reports\": \"Reports\",\n    \"settings\": \"Settings\",\n    \"myQr\": \"My QR & History\"\n  },\n  \"landing\": {\n    \"heroTitle\": \"Attendance in one scan.\",\n    \"heroSubtitle\": \"A calm, reliable QR attendance system for colleges, schools, coaching institutes, and teams. Works right in the browser.\",\n    \"ctaStart\": \"Sign up\",\n    \"ctaHow\": \"See how it works\",\n    \"ctaDashboard\": \"Go to dashboard\",\n    \"markCardTitle\": \"Mark your attendance\",\n    \"markCardSubtitle\": \"Scan the live rotating QR on screen or enter your 6-character ID and live code.\",\n    \"markCardScanBtn\": \"Scan QR\",\n    \"markCardIdBtn\": \"Enter ID\",\n    \"stepsHeading\": \"How it works\",\n    \"stepsSub\": \"Three simple steps to move off paper registers.\",\n    \"step1Title\": \"Create your organization\",\n    \"step1Desc\": \"Sign up in a minute, name your roles, and get a unique organization code.\",\n    \"step2Title\": \"Add your people\",\n    \"step2Desc\": \"Add people one by one, upload a CSV sheet, or let them join using your code. Each person gets a unique 6-character ID and QR.\",\n    \"step3Title\": \"Start a live QR session\",\n    \"step3Desc\": \"Open projector mode with a QR that rotates every 10 seconds and location verification. Everyone marks attendance in seconds.\",\n    \"featuresHeading\": \"What you get\",\n    \"featuresSub\": \"Everything your team needs every morning, nothing extra.\",\n    \"feat1Title\": \"Live rotating QR\",\n    \"feat1Desc\": \"Project a QR and 6-digit code that refresh every 10 seconds with GPS radius verification.\",\n    \"feat2Title\": \"Manual backup\",\n    \"feat2Desc\": \"Mark people by ID or personal QR card whenever someone has a dead phone or no GPS.\",\n    \"feat3Title\": \"Clear reports\",\n    \"feat3Desc\": \"Daily trends, monthly register sheets, per-person percentages, and one-click CSV or PDF exports.\",\n    \"feat4Title\": \"Leave requests\",\n    \"feat4Desc\": \"Members apply for leave in seconds. Approved dates appear automatically on calendars and reports.\",\n    \"feat5Title\": \"Works on phone and laptop\",\n    \"feat5Desc\": \"Installable web app that adapts cleanly from small phones to desktop screens.\",\n    \"feat6Title\": \"Hindi and English\",\n    \"feat6Desc\": \"Switch the entire interface between English and Hindi anytime without reloading.\",\n    \"whoHeading\": \"Who is it for\",\n    \"whoSub\": \"One clean hierarchy that adapts to your organization\'s language.\",\n    \"whoCollege\": \"College\",\n    \"whoCollegeFlow\": \"College \342\206\222 Teachers \342\206\222 Students\",\n    \"whoCollegeDesc\": \"Track lecture attendance across departments without passing sheets around.\",\n    \"whoSchool\": \"School\",\n    \"whoSchoolFlow\": \"School \342\206\222 Class Teachers \342\206\222 Students\",\n    \"whoSchoolDesc\": \"Fast morning roll call with instant monthly registers and parent-ready PDFs.\",\n    \"whoCoaching\": \"Coaching\",\n    \"whoCoachingFlow\": \"Institute \342\206\222 Faculty \342\206\222 Students\",\n    \"whoCoachingDesc\": \"Spot low-attendance students early and keep batch records organized.\",\n    \"whoCompany\": \"Company\",\n    \"whoCompanyFlow\": \"Company \342\206\222 Team Leads \342\206\222 Employees\",\n    \"whoCompanyDesc\": \"Simple check-ins with live location checks and clean leave approvals.\",\n    \"whyHeading\": \"Simple. Fast. Safe.\",\n    \"whySub\": \"Built for everyday reliability.\",\n    \"why1Title\": \"Simple\",\n    \"why1Desc\": \"No training manual required. Clear labels, calm screens, and direct actions.\",\n    \"why2Title\": \"Fast\",\n    \"why2Desc\": \"Mark an entire class or team in under a minute with live rotating QR sessions.\",\n    \"why3Title\": \"Safe\",\n    \"why3Desc\": \"Rotating 10-second tokens, one-device-per-session lock, and strict organization isolation.\",\n    \"faqHeading\": \"Common questions\",\n    \"faqSub\": \"Straight answers before you begin.\",\n    \"faq1Q\": \"Is it free?\",\n    \"faq1A\": \"Yes. You can create your organization, add your team, and run live attendance sessions at no cost.\",\n    \"faq2Q\": \"Do members need to install an app?\",\n    \"faq2A\": \"No. They can open it in any browser, scan the live QR or enter their ID, and install to their home screen if they like.\",\n    \"faq3Q\": \"How is the unique ID made?\",\n    \"faq3A\": \"Every person receives a globally unique 6-character ID made from 3 letters of their name and 3 random digits (like PAN482).\",\n    \"faq4Q\": \"Can someone share a screenshot of the QR?\",\n    \"faq4A\": \"No. The live QR and 6-digit code rotate every 10 seconds, expire within 15 seconds, check GPS distance, and allow only one person per device.\",\n    \"faq5Q\": \"Does it work on mobile?\",\n    \"faq5A\": \"Yes. It is designed mobile-first so members can scan QR codes directly using their phone\'s camera.\",\n    \"contactHeading\": \"Get in touch\",\n    \"contactSub\": \"Questions or feedback? Send us a short message.\",\n    \"contactName\": \"Your name\",\n    \"contactEmail\": \"Email address\",\n    \"contactMessage\": \"Message\",\n    \"contactSend\": \"Send message\",\n    \"contactSent\": \"Thank you. Your message has been sent.\",\n    \"footerTagline\": \"Calm QR attendance for everyday organizations.\",\n    \"footerRights\": \"Smart Attendance System\"\n  },\n  \"auth\": {\n    \"loginTitle\": \"Welcome back\",\n    \"loginSubtitle\": \"Sign in to your organization account.\",\n    \"emailLabel\": \"Email address\",\n    \"passwordLabel\": \"Password\",\n    \"forgotLink\": \"Forgot password?\",\n    \"loginBtn\": \"Login\",\n    \"noAccount\": \"New here?\",\n    \"createAccountLink\": \"Sign up\",\n    \"registerTitle\": \"Sign up\",\n    \"registerSubtitle\": \"Create a new organization or join an existing one.\",\n    \"tabCreateOrg\": \"Create organization\",\n    \"tabJoinOrg\": \"Join organization\",\n    \"orgNameLabel\": \"Organization name\",\n    \"orgNamePlaceholder\": \"e.g. Greenfield College\",\n    \"orgTypeLabel\": \"Organization type\",\n    \"yourNameLabel\": \"Your full name\",\n    \"phoneLabel\": \"Phone number\",\n    \"confirmPasswordLabel\": \"Confirm password\",\n    \"createOrgBtn\": \"Sign up\",\n    \"joinAsLabel\": \"I am joining as\",\n    \"joinRoleManager\": \"Manager / Teacher / Team Lead\",\n    \"joinRoleMember\": \"Member / Student / Employee\",\n    \"orgCodeLabel\": \"Organization code (6 characters)\",\n    \"managerCodeLabel\": \"Manager code (6 characters)\",\n    \"verifyCodeBtn\": \"Check code\",\n    \"codeVerified\": \"Code verified\",\n    \"joiningOrg\": \"Joining\",\n    \"underManager\": \"Under\",\n    \"joinBtn\": \"Submit request\",\n    \"haveAccount\": \"Already have an account?\",\n    \"signInLink\": \"Login\",\n    \"forgotTitle\": \"Reset password\",\n    \"forgotSubtitle\": \"Enter your email and we will send you a password reset link.\",\n    \"sendResetBtn\": \"Send reset link\",\n    \"resetSent\": \"Password reset email sent. Please check your inbox.\",\n    \"backToLogin\": \"Back to login\",\n    \"pendingTitle\": \"Waiting for approval\",\n    \"pendingSubtitle\": \"Your registration request has been submitted.\",\n    \"pendingDesc\": \"Once your administrator approves your request, your 6-character ID and QR code will be ready automatically.\",\n    \"inactiveTitle\": \"Account inactive\",\n    \"inactiveDesc\": \"Your account is currently deactivated. Please contact your organization administrator.\",\n    \"orgTypes\": {\n      \"College\": \"College\",\n      \"School\": \"School\",\n      \"Coaching\": \"Coaching\",\n      \"Company\": \"Company\",\n      \"Other\": \"Other\"\n    }\n  },\n  \"dashboard\": {\n    \"welcome\": \"Hello\",\n    \"totalManagers\": \"Total\",\n    \"totalMembers\": \"Total\",\n    \"presentToday\": \"Present today\",\n    \"absentToday\": \"Absent today\",\n    \"lateToday\": \"Late today\",\n    \"onLeaveToday\": \"On leave\",\n    \"attendanceTrend\": \"Attendance trend\",\n    \"last7Days\": \"7 days\",\n    \"last30Days\": \"30 days\",\n    \"todayStatus\": \"Today\'s status\",\n    \"pendingApprovals\": \"Pending approvals\",\n    \"noPendingApprovals\": \"No pending requests right now.\",\n    \"approve\": \"Approve\",\n    \"reject\": \"Reject\",\n    \"lowAttendance\": \"Low attendance\",\n    \"belowThreshold\": \"Below\",\n    \"noLowAttendance\": \"Everyone is above the attendance threshold.\",\n    \"pendingLeaves\": \"Pending leave requests\",\n    \"noPendingLeaves\": \"No pending leave requests.\",\n    \"recentAnnouncements\": \"Recent notices\",\n    \"noAnnouncements\": \"No notices posted yet.\",\n    \"yourOrgCode\": \"Organization code\",\n    \"yourManagerCode\": \"Your invite code\",\n    \"shareCodeHint\": \"Share this code so people can request to join.\",\n    \"myAttendanceRate\": \"This month\",\n    \"currentStreak\": \"Current streak\",\n    \"attendanceCalendar\": \"Monthly calendar\",\n    \"recentHistory\": \"Recent history\",\n    \"showQr\": \"Show QR & ID\",\n    \"viewAll\": \"View all\",\n    \"markNow\": \"Start attendance\"\n  },\n  \"session\": {\n    \"startTitle\": \"Start attendance\",\n    \"startSubtitle\": \"Open a live rotating QR session with location verification.\",\n    \"sessionTitleLabel\": \"Session title (optional)\",\n    \"sessionTitlePlaceholder\": \"e.g. Morning Lecture \302\267 Room 204\",\n    \"durationLabel\": \"Duration\",\n    \"radiusLabel\": \"Allowed radius\",\n    \"locationLabel\": \"Session location\",\n    \"locationHint\": \"Drag the pin or tap the map to fine-tune the center point.\",\n    \"refreshGps\": \"Use my current GPS\",\n    \"locatingGps\": \"Reading high-accuracy GPS...\",\n    \"gpsReady\": \"GPS accuracy\",\n    \"gpsError\": \"Could not read GPS. Drag the pin on the map or allow location access.\",\n    \"startBtn\": \"Start live session\",\n    \"starting\": \"Starting session...\",\n    \"openBackupLink\": \"Manual / ID-card backup\",\n    \"projectorMode\": \"Projector mode\",\n    \"liveBadge\": \"LIVE\",\n    \"sessionIdLabel\": \"Session\",\n    \"rotatingToken\": \"Refreshing QR...\",\n    \"fullscreen\": \"Full screen\",\n    \"exitFullscreen\": \"Exit full screen\",\n    \"liveCodeLabel\": \"Live 6-digit code\",\n    \"rotatesIn\": \"Changes in\",\n    \"seconds\": \"s\",\n    \"markedCounter\": \"Marked\",\n    \"endsIn\": \"Ends in\",\n    \"extendBtn\": \"Extend 10 min\",\n    \"closeBtn\": \"Stop session\",\n    \"extendedToast\": \"Session extended by 10 minutes.\",\n    \"closedToast\": \"Live session stopped.\",\n    \"wakeLockActive\": \"Screen kept awake\",\n    \"markedListTitle\": \"Marked attendance\",\n    \"noMarkedYet\": \"Waiting for people to scan or enter the live code...\",\n    \"rejectedTitle\": \"Rejected attempts\",\n    \"noRejectedYet\": \"No rejected attempts.\",\n    \"awayLabel\": \"away\",\n    \"locationCheckOffNote\": \"Location check is turned off in Organization Settings.\"\n  },\n  \"mark\": {\n    \"title\": \"Mark your attendance\",\n    \"subtitle\": \"Scan the live rotating QR on screen or enter your ID and live code.\",\n    \"qrScannerBtn\": \"QR Scanner\",\n    \"liveSessionActive\": \"LIVE session active\",\n    \"scanFrameHint\": \"Align the live QR code inside the frame\",\n    \"findingSession\": \"Checking for an active session...\",\n    \"noActiveSession\": \"No active session right now\",\n    \"noActiveSessionHint\": \"Ask your organizer to start a live attendance session. This screen updates automatically.\",\n    \"refreshSession\": \"Check again\",\n    \"step1Title\": \"Location check\",\n    \"readingGps\": \"Reading your GPS location...\",\n    \"retryGps\": \"Try again\",\n    \"lowAccuracy\": \"GPS accuracy is too low (more than 100 m). Move near a window or outdoors and try again.\",\n    \"locationDenied\": \"Location permission is required to verify you are at the venue.\",\n    \"withinRadius\": \"You are {distance} m from the class \342\234\223\",\n    \"outsideRadius\": \"You are {distance} m away \342\234\227\",\n    \"locationCheckDisabled\": \"Location check is disabled for this session.\",\n    \"tabScanQr\": \"Scan QR\",\n    \"tabEnterId\": \"Enter ID\",\n    \"yourIdLabel\": \"Your ID (6 characters)\",\n    \"yourIdPlaceholder\": \"e.g. PAN482\",\n    \"idMismatch\": \"Enter your own 6-character ID\",\n    \"liveCodeLabel\": \"Live code (6 digits)\",\n    \"liveCodePlaceholder\": \"000000\",\n    \"submitBtn\": \"Mark attendance\",\n    \"submitting\": \"Verifying...\",\n    \"successTitle\": \"Attendance marked\",\n    \"distanceLabel\": \"Distance\",\n    \"errExpired\": \"QR expired (valid for 10 seconds only). Please scan the current QR.\",\n    \"errInvalidCode\": \"Code expired or incorrect, try the latest code\",\n    \"errOutsideArea\": \"You are outside the allowed area\",\n    \"errSessionClosed\": \"This live session has ended\",\n    \"errAlreadyMarked\": \"Attendance already recorded for today / this session\",\n    \"errDeviceUsed\": \"This device was already used by someone else in this session\",\n    \"errWrongSession\": \"This QR belongs to a different session\",\n    \"errUnauthorized\": \"You are not authorized to mark attendance for this session\",\n    \"errNetwork\": \"Network error. Check your internet connection and try again.\",\n    \"reasonOutside\": \"Outside allowed radius\",\n    \"reasonExpired\": \"Expired or invalid token/code\",\n    \"reasonDevice\": \"Device already used\"\n  },\n  \"people\": {\n    \"addPerson\": \"Add\",\n    \"bulkImport\": \"Import CSV\",\n    \"editPerson\": \"Edit details\",\n    \"deactivate\": \"Deactivate\",\n    \"activate\": \"Activate\",\n    \"remove\": \"Remove\",\n    \"confirmRemove\": \"Remove this person from the organization? Their profile will be deleted.\",\n    \"viewQr\": \"View QR\",\n    \"inviteCode\": \"Invite code\",\n    \"statusAll\": \"All statuses\",\n    \"emptyTitle\": \"No people added yet\",\n    \"emptyDesc\": \"Add your first person directly, upload a CSV file, or share your invite code.\",\n    \"passwordResetNote\": \"A password setup link will be sent to their email automatically.\",\n    \"personAdded\": \"Added successfully. Password setup email sent.\",\n    \"personAddedNoEmail\": \"Added successfully. Ask them to use Forgot Password to set a password.\",\n    \"personUpdated\": \"Details updated.\",\n    \"personRemoved\": \"Removed successfully.\",\n    \"approvedToast\": \"Approved and 6-character ID generated.\",\n    \"rejectedToast\": \"Request rejected.\",\n    \"csvTitle\": \"Bulk CSV import\",\n    \"csvHint\": \"Upload a CSV file with columns: name, email, phone (optional: rollNumber, englishName).\",\n    \"csvSelectFile\": \"Choose CSV file\",\n    \"csvDownloadSample\": \"Download sample CSV\",\n    \"csvPreview\": \"Preview rows\",\n    \"csvValid\": \"Valid\",\n    \"csvInvalid\": \"Issues\",\n    \"csvImportBtn\": \"Import valid rows\",\n    \"csvImporting\": \"Importing...\",\n    \"csvDone\": \"Import complete.\",\n    \"csvMissingName\": \"Missing name\",\n    \"csvInvalidEmail\": \"Invalid email\"\n  },\n  \"attendance\": {\n    \"title\": \"Manual / Backup Attendance\",\n    \"backupNotice\": \"Backup mode for dead phones or no GPS. Records marked here are tagged as manual in reports.\",\n    \"backToLive\": \"Back to Live Session\",\n    \"tabScan\": \"Scan ID Card QR\",\n    \"tabManual\": \"Manual\",\n    \"scannedToday\": \"Marked today\",\n    \"startCamera\": \"Start camera\",\n    \"stopCamera\": \"Stop camera\",\n    \"switchCamera\": \"Switch camera\",\n    \"cameraPermissionTitle\": \"Camera permission required\",\n    \"cameraPermissionDesc\": \"Allow camera access in your browser to scan QR codes. Camera scanning requires a secure HTTPS connection.\",\n    \"cameraActiveHint\": \"Point the camera at a QR code. Scanning stays open continuously.\",\n    \"markedPresent\": \"Marked Present\",\n    \"markedLate\": \"Marked Late\",\n    \"alreadyMarked\": \"Already marked today\",\n    \"invalidQr\": \"Invalid QR code\",\n    \"wrongOrg\": \"QR belongs to another organization\",\n    \"notYourPerson\": \"You can only mark your own assigned people\",\n    \"userInactive\": \"Cannot mark inactive or pending person\",\n    \"userNotFound\": \"Person not found\",\n    \"locationChecking\": \"Checking your location...\",\n    \"locationTooFar\": \"You are outside the allowed area.\",\n    \"locationDenied\": \"Location check is enabled. Please allow GPS access to mark attendance.\",\n    \"manualSearchPlaceholder\": \"Search by name or 6-character ID...\",\n    \"markAllPresent\": \"Mark all present\",\n    \"markSelectedBtn\": \"Save selected\",\n    \"selectedCount\": \"selected\",\n    \"selectDate\": \"Date\",\n    \"canCorrectToday\": \"You can update today\'s records anytime.\",\n    \"adminCanCorrectAny\": \"Admins can view or correct records for any date.\",\n    \"cannotCorrectPast\": \"Only Admins can edit past dates.\",\n    \"notePlaceholder\": \"Optional note...\",\n    \"savedToast\": \"Attendance saved.\",\n    \"bulkSavedToast\": \"Attendance saved for selected people.\",\n    \"noActivePeople\": \"No active people available to mark.\"\n  },\n  \"leaves\": {\n    \"title\": \"Leave Requests\",\n    \"requestLeave\": \"Request leave\",\n    \"fromDate\": \"From date\",\n    \"toDate\": \"To date\",\n    \"reason\": \"Reason\",\n    \"reasonPlaceholder\": \"Brief reason for leave...\",\n    \"submitRequest\": \"Submit request\",\n    \"submittedToast\": \"Leave request submitted.\",\n    \"myRequests\": \"My requests\",\n    \"teamRequests\": \"Requests to review\",\n    \"commentLabel\": \"Comment (optional)\",\n    \"commentPlaceholder\": \"Add a short note...\",\n    \"approvedToast\": \"Leave approved and added to attendance.\",\n    \"rejectedToast\": \"Leave request rejected.\",\n    \"emptyTitle\": \"No leave requests\",\n    \"emptyDesc\": \"Leave requests submitted by you or your team will appear here.\",\n    \"invalidRange\": \"End date must be on or after start date.\"\n  },\n  \"announcements\": {\n    \"title\": \"Notices\",\n    \"postTitle\": \"Post a notice\",\n    \"placeholder\": \"Write a short announcement for your team...\",\n    \"audienceLabel\": \"Send to\",\n    \"audienceAll\": \"Everyone in organization\",\n    \"audienceManagers\": \"Managers only\",\n    \"audienceMembers\": \"My members\",\n    \"postBtn\": \"Post notice\",\n    \"postedToast\": \"Notice published.\",\n    \"deletedToast\": \"Notice deleted.\",\n    \"emptyTitle\": \"No notices yet\",\n    \"emptyDesc\": \"Important updates and reminders will appear here.\"\n  },\n  \"reports\": {\n    \"title\": \"Reports\",\n    \"tabRecords\": \"Records\",\n    \"tabSummary\": \"Summary\",\n    \"tabRegister\": \"Monthly register\",\n    \"from\": \"From\",\n    \"to\": \"To\",\n    \"person\": \"Person\",\n    \"exportCsv\": \"Export CSV\",\n    \"exportPdf\": \"Export PDF\",\n    \"month\": \"Month\",\n    \"presentDays\": \"Present\",\n    \"absentDays\": \"Absent\",\n    \"lateDays\": \"Late\",\n    \"leaveDays\": \"Leave\",\n    \"totalDays\": \"Total\",\n    \"percentage\": \"Rate\",\n    \"method\": \"Method\",\n    \"manualHighlightHint\": \"Rows highlighted in yellow were marked using manual backup.\",\n    \"chartTitle\": \"Daily attendance breakdown\",\n    \"emptyTitle\": \"No attendance records\",\n    \"emptyDesc\": \"Adjust your date range or start marking attendance to see reports.\"\n  },\n  \"qr\": {\n    \"title\": \"Attendance QR & ID Card\",\n    \"downloadQr\": \"Download QR\",\n    \"printCard\": \"Print ID Card\",\n    \"scanHint\": \"Show this ID card for backup QR scanning.\"\n  },\n  \"notifications\": {\n    \"title\": \"Notifications\",\n    \"markAllRead\": \"Mark all read\",\n    \"empty\": \"You are all caught up.\"\n  },\n  \"settings\": {\n    \"title\": \"Profile & Settings\",\n    \"profileSection\": \"Your profile\",\n    \"orgSection\": \"Organization settings\",\n    \"orgName\": \"Organization name\",\n    \"orgType\": \"Organization type\",\n    \"managerLabel\": \"Label for Manager role\",\n    \"memberLabel\": \"Label for Member role\",\n    \"lateAfter\": \"Mark late after\",\n    \"lateAfterHint\": \"Attendance marked after this time is saved as Late automatically.\",\n    \"timezone\": \"Timezone\",\n    \"lowThreshold\": \"Low attendance alert threshold (%)\",\n    \"sessionDefaultsSection\": \"Live session & location defaults\",\n    \"defaultDuration\": \"Default session duration\",\n    \"defaultRadius\": \"Default allowed radius (meters)\",\n    \"locationSection\": \"Location check\",\n    \"locationDesc\": \"Require people to be inside the session radius when marking attendance.\",\n    \"enableLocation\": \"Enable location check\",\n    \"radiusMeters\": \"Allowed radius (20 \342\200\223 500 m)\",\n    \"setCurrentLocation\": \"Set default org location\",\n    \"locationSet\": \"Location saved\",\n    \"noLocationSaved\": \"No default location saved yet.\",\n    \"preferencesSection\": \"Preferences\",\n    \"languageLabel\": \"Language\",\n    \"themeLabel\": \"Appearance\",\n    \"lightMode\": \"Light\",\n    \"darkMode\": \"Dark\",\n    \"demoSection\": \"Demo data\",\n    \"demoDesc\": \"Load sample people (with 6-character IDs) and 30 days of realistic attendance to explore dashboards and reports. Clearly marked and removable anytime.\",\n    \"loadDemoBtn\": \"Load demo data\",\n    \"deleteDemoBtn\": \"Delete demo data\",\n    \"loadingDemo\": \"Loading demo data...\",\n    \"deletingDemo\": \"Deleting demo data...\",\n    \"demoLoadedToast\": \"Demo data loaded (3 managers, 15 members, 30 days).\",\n    \"demoDeletedToast\": \"All demo data has been removed.\",\n    \"savedToast\": \"Settings saved.\"\n  },\n  \"errors\": {\n    \"emailInUse\": \"This email is already registered.\",\n    \"invalidEmail\": \"Please enter a valid email address.\",\n    \"weakPassword\": \"Password must be at least 6 characters.\",\n    \"wrongCredentials\": \"Incorrect email or password.\",\n    \"tooManyRequests\": \"Too many attempts. Please wait a moment and try again.\",\n    \"noInternet\": \"No internet connection. Please check your network.\",\n    \"permissionDenied\": \"You do not have permission to perform this action.\",\n    \"passwordMismatch\": \"Passwords do not match.\",\n    \"invalidCode\": \"Code not found. Please check and try again.\",\n    \"requiredFields\": \"Please fill in all required fields.\",\n    \"englishNameRequired\": \"Please enter the English spelling of the name to generate the 6-character ID.\",\n    \"generic\": \"Something went wrong. Please try again.\"\n  },\n  \"notFound\": {\n    \"title\": \"Page not found\",\n    \"desc\": \"The page you are looking for does not exist or has moved.\",\n    \"goHome\": \"Back to home\"\n  }\n}\n"
