  view_file {
    absolute_path_uri: "file:///src/services/auditService.ts"
    end_line: 63
    content: "import {\n  addDoc,\n  collection,\n  getDocs,\n  limit,\n  orderBy,\n  query,\n  serverTimestamp,\n  where,\n} from \'firebase/firestore\';\nimport { db } from \'../firebase\';\nimport type { AuditLog, UserProfile } from \'../types\';\n\nexport async function recordAuditLog(params: {\n  actor: Pick<UserProfile, \'uid\' | \'name\' | \'role\' | \'orgId\'>;\n  action: AuditLog[\'action\'];\n  targetCollection: string;\n  targetId: string;\n  summary: string;\n  metadata?: Record<string, string | number | boolean | null>;\n}): Promise<void> {\n  if (!params.actor?.uid || !params.actor?.orgId) return;\n  try {\n    await addDoc(collection(db, \'auditLogs\'), {\n      orgId: params.actor.orgId,\n      actorUid: params.actor.uid,\n      actorName: params.actor.name || \'User\',\n      actorRole: params.actor.role,\n      action: params.action,\n      targetCollection: params.targetCollection,\n      targetId: params.targetId,\n      summary: params.summary,\n      metadata: params.metadata || {},\n      timestamp: serverTimestamp(),\n    });\n  } catch {\n    // Non-blocking: audit log failure must not crash user flow if offline/rules not yet deployed\n  }\n}\n\nexport async function fetchAuditLogs(\n  orgId: string,\n  maxItems = 150\n): Promise<AuditLog[]> {\n  try {\n    const q = query(\n      collection(db, \'auditLogs\'),\n      where(\'orgId\', \'==\', orgId),\n      orderBy(\'timestamp\', \'desc\'),\n      limit(maxItems)\n    );\n    const snap = await getDocs(q);\n    return snap.docs.map((d) => ({ ...(d.data() as Omit<AuditLog, \'id\'>), id: d.id }));\n  } catch {\n    // Fallback without orderBy in case composite index is still building\n    const q = query(collection(db, \'auditLogs\'), where(\'orgId\', \'==\', orgId));\n    const snap = await getDocs(q);\n    return snap.docs\n      .map((d) => ({ ...(d.data() as Omit<AuditLog, \'id\'>), id: d.id }))\n      .sort((a, b) => (b.timestamp?.toMillis?.() ?? 0) - (a.timestamp?.toMillis?.() ?? 0))\n      .slice(0, maxItems);\n  }\n}\n"
    num_lines: 64
    num_bytes: 1917
    line_range_bytes: 1917
  }
}
