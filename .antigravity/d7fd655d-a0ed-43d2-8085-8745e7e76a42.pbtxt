              text: "    \"step1Title\": \"Create your organization\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    \"step1Desc\": \"Sign up in a minute, name your roles, and get a unique organization code.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    \"step2Title\": \"Add your people\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    \"step2Desc\": \"Add people one by one, upload a CSV sheet, or let them join using your code. Each person gets a unique 6-character ID and QR.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    \"step3Title\": \"Start a live QR session\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    \"step3Desc\": \"Open projector mode with a QR that rotates every 10 seconds and location verification. Everyone marks attendance in seconds.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    \"featuresHeading\": \"What you get\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    \"featuresSub\": \"Everything your team needs every morning, nothing extra.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    \"feat1Title\": \"Live rotating QR\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    \"feat1Desc\": \"Project a QR and 6-digit code that refresh every 10 seconds with GPS radius verification.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    \"feat2Title\": \"Manual backup\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    \"feat2Desc\": \"Mark people by ID or personal QR card whenever someone has a dead phone or no GPS.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    \"feat3Title\": \"Clear reports\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    \"feat3Desc\": \"Daily trends, monthly register sheets, per-person percentages, and one-click CSV or PDF exports.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    \"feat4Title\": \"Leave requests\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    \"feat4Desc\": \"Members apply for leave in seconds. Approved dates appear automatically on calendars and reports.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
