    tool_calls {
      id: "call_8879165683277231724"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useCallback, useEffect, useMemo, useState } from \'react\';\\nimport { Link } from \'react-router-dom\';\\nimport {\\n  ResponsiveContainer,\\n  BarChart,\\n  Bar,\\n  XAxis,\\n  YAxis,\\n  Tooltip,\\n  CartesianGrid,\\n} from \'recharts\';\\nimport {\\n  BellRing,\\n  BookOpen,\\n  CalendarClock,\\n  Check,\\n  CheckCircle2,\\n  Copy,\\n  Play,\\n  QrCode,\\n  Radio,\\n  ScanLine,\\n  X,\\n} from \'lucide-react\';\\nimport { useAuth } from \'../context/AuthContext\';\\nimport { useTranslation } from \'../hooks/useTranslation\';\\nimport { useToast } from \'../context/ToastContext\';\\nimport type {\\n  Announcement,\\n  AttendanceRecord,\\n  AttendanceSession,\\n  FacultyAssignment,\\n  LeaveRequest,\\n  TimetableSlot,\\n  UserProfile,\\n} from \'../types\';\\nimport {\\n  approvePendingUser,\\n  fetchManagerMembers,\\n  fetchUsersByClass,\\n  rejectPendingUser,\\n} from \'../services/userService\';\\nimport { fetchAttendanceForManager } from \'../services/attendanceService\';\\nimport { fetchLeavesForUser } from \'../services/leaveService\';\\nimport { fetchAnnouncements } from \'../services/communicationService\';\\nimport {\\n  subscribeFacultyAssignments,\\n  subscribeTimetableForTeacher,\\n} from \'../services/academicService\';\\nimport { subscribeOwnerOpenSessions } from \'../services/sessionService\';\\nimport {\\n  computeStudentAttendanceAnalysis,\\n  dispatchLowAttendanceAlerts,\\n} from \'../services/lowAttendanceService\';\\nimport {\\n  formatTimeRange12h,\\n  getFirebaseErrorKey,\\n  getOrgDateString,\\n  getOrgWeekdayIndex,\\n  getPastDates,\\n} from \'../utils/helpers\';\\nimport { Layout } from \'../components/Layout\';\\nimport { QRCardModal } from \'../components/QRCardModal\';\\nimport { CardSkeleton, StatGridSkeleton } from \'../components/Skeletons\';\\n\\nexport const ManagerDashboard: React.FC = () => {\\n  const { profile, org, getRoleLabel } = useAuth();\\n  const { t, formatDate, formatNumber } = useTranslation();\\n  const { showToast } = useToast();\\n\\n  const [loading, setLoading] = useState(true);\\n  const [members, setMembers] = useState<UserProfile[]>([]);\\n  const [attendance, setAttendance] = useState<AttendanceRecord[]>([]);\\n  const [pendingLeaves, setPendingLeaves] = useState<LeaveRequest[]>([]);\\n  const [announcements, setAnnouncements] = useState<Announcement[]>([]);\\n  const [assignments, setAssignments] = useState<FacultyAssignment[]>([]);\\n  const [timetable, setTimetable] = useState<TimetableSlot[]>([]);\\n  const [openSessions, setOpenSessions] = useState<AttendanceSession[]>([]);\\n  const [showQrModal, setShowQrModal] = useState(false);\\n  const [copied, setCopied] = useState(false);\\n  const [sendingAlerts, setSendingAlerts] = useState(false);\\n\\n  const today = useMemo(() => getOrgDateString(org?.timezone || \'Asia/Kolkata\'), [org?.timezone]);\\n  const todayWeekday = useMemo(\\n    () => getOrgWeekdayIndex(org?.timezone || \'Asia/Kolkata\'),\\n    [org?.timezone]\\n  );\\n  const managerLabel = getRoleLabel(\'manager\');\\n  const memberLabel = getRoleLabel(\'member\');\\n  const threshold = org?.lowAttendanceThreshold ?? 75;\\n\\n  // Real-time subscriptions: My Assigned Subjects, My Timetable, My Active Live Sessions\\n  useEffect(() => {\\n    if (!org || !profile) return;\\n    const unsubAsgn = subscribeFacultyAssignments(org.id, setAssignments, profile.uid);\\n    const unsubTT = subscribeTimetableForTeacher(org.id, profile.uid, setTimetable);\\n    const unsubSess = subscribeOwnerOpenSessions(org.id, profile.uid, setOpenSessions);\\n    return () => {\\n      unsubAsgn();\\n      unsubTT();\\n      unsubSess();\\n    };\\n  }, [org, profile]);\\n\\n  const loadData = useCallback(async () => {\\n    if (!org || !profile) return;\\n    setLoading(true);\\n    try {\\n      const fromDate = getPastDates(30, org.timezone)[0];\\n      const assignedClassIds = Array.from(new Set(assignments.map((a) => a.classId)));\\n\\n      const [directMembers, classMembersNested, attRecs, leavesRes, notices] = await Promise.all([\\n        fetchManagerMembers(org.id, profile.uid),\\n        Promise.all(assignedClassIds.map((cid) => fetchUsersByClass(org.id, cid))),\\n        fetchAttendanceForManager(org.id, profile.uid, { fromDate, toDate: today }),\\n        fetchLeavesForUser(profile),\\n        fetchAnnouncements(profile),\\n      ]);\\n\\n      // Deduplicate students across assigned classes + legacy direct managerId\\n      const studentMap = new Map<string, UserProfile>();\\n      for (const m of directMembers) studentMap.set(m.uid, m);\\n      for (const batch of classMembersNested) {\\n        for (const m of batch) studentMap.set(m.uid, m);\\n      }\\n\\n      setMembers(Array.from(studentMap.values()).sort((a, b) => a.name.localeCompare(b.name)));\\n      setAttendance(attRecs);\\n      setPendingLeaves(leavesRes.teamLeaves.filter((l) => l.status === \'pending\'));\\n      setAnnouncements(notices.slice(0, 4));\\n    } catch (err) {\\n      showToast(t(getFirebaseErrorKey(err)), \'error\');\\n    } finally {\\n      setLoading(false);\\n    }\\n  }, [org, profile, assignments, today, showToast, t]);\\n\\n  useEffect(() => {\\n    loadData();\\n  }, [loadData]);\\n\\n  const activeMembers = useMemo(() => members.filter((m) => m.status === \'active\'), [members]);\\n  const pendingMembers = useMemo(() => members.filter((m) => m.status === \'pending\'), [members]);\\n  const todayLectures = useMemo(\\n    () => timetable.filter((slot) => slot.dayOfWeek === todayWeekday),\\n    [timetable, todayWeekday]\\n  );\\n\\n  // Strictly PRESENT, LEAVE, ABSENT (ZERO LATE)\\n  const todayStats = useMemo(() => {\\n    let present = 0;\\n    let leave = 0;\\n    let absent = 0;\\n    for (const r of attendance) {\\n      if (r.date !== today) continue;\\n      if (r.status === \'present\') present++;\\n      else if (r.status === \'leave\') leave++;\\n      else if (r.status === \'absent\') absent++;\\n    }\\n    return { present, leave, absent };\\n  }, [attendance, today]);\\n\\n  const weeklyChart = useMemo(() => {\\n    const dates = getPastDates(7, org?.timezone || \'Asia/Kolkata\');\\n    const byDate = new Map<string, { present: number; leave: number; absent: number }>();\\n    for (const d of dates) byDate.set(d, { present: 0, leave: 0, absent: 0 });\\n    for (const r of attendance) {\\n      const b = byDate.get(r.date);\\n      if (!b) continue;\\n      if (r.status === \'present\') b.present++;\\n      else if (r.status === \'leave\') b.leave++;\\n      else if (r.status === \'absent\') b.absent++;\\n    }\\n    return dates.map((d) => ({\\n      date: formatDate(d, { weekday: \'short\', day: \'numeric\' }),\\n      ...byDate.get(d)!,\\n    }));\\n  }, [attendance, org?.timezone, formatDate]);\\n\\n  // Low Attendance Analysis (< threshold)\\n  const lowAttendanceAnalyses = useMemo(() => {\\n    const recordsByStudent = new Map<string, AttendanceRecord[]>();\\n    for (const r of attendance) {\\n      const list = recordsByStudent.get(r.personUid) || [];\\n      list.push(r);\\n      recordsByStudent.set(r.personUid, list);\\n    }\\n    return activeMembers\\n      .map((student) =>\\n        computeStudentAttendanceAnalysis(\\n          student,\\n          recordsByStudent.get(student.uid) || [],\\n          threshold\\n        )\\n      )\\n      .filter((a) => a.totalClasses > 0 && a.hasShortage)\\n      .sort((a, b) => a.overallPercent - b.overallPercent);\\n  }, [activeMembers, attendance, threshold]);\\n\\n  const handleSendAlerts = async () => {\\n    if (!org || !profile || lowAttendanceAnalyses.length === 0) return;\\n    setSendingAlerts(true);\\n    try {\\n      const res = await dispatchLowAttendanceAlerts({\\n        org,\\n        actor: profile,\\n        analyses: lowAttendanceAnalyses,\\n        parentLinks: [],\\n      });\\n      showToast(\\n        t(\'alerts.dispatchedToast\').replace(\'{count}\', String(res.sent)),\\n        res.sent > 0 ? \'success\' : \'info\'\\n      );\\n    } catch (err) {\\n      showToast(t(getFirebaseErrorKey(err)), \'error\');\\n    } finally {\\n      setSendingAlerts(false);\\n    }\\n  };\\n\\n  const handleCopyCode = () => {\\n    if (!profile?.managerCode) return;\\n    navigator.clipboard.writeText(profile.managerCode);\\n    setCopied(true);\\n    setTimeout(() => setCopied(false), 1800);\\n  };\\n\\n  const handleApprove = async (m: UserProfile) => {\\n    if (!org) return;\\n    try {\\n      await approvePendingUser(org, m, profile);\\n      showToast(t(\'people.approvedToast\'), \'success\');\\n      await loadData();\\n    } catch (err) {\\n      showToast(t(getFirebaseErrorKey(err)), \'error\');\\n    }\\n  };\\n\\n  const handleReject = async (m: UserProfile) => {\\n    if (!org) return;\\n    try {\\n      await rejectPendingUser(org.id, m, profile);\\n      showToast(t(\'people.rejectedToast\'), \'info\');\\n      await loadData();\\n    } catch (err) {\\n      showToast(t(getFirebaseErrorKey(err)), \'error\');\\n    }\\n  };\\n\\n  return (\\n    <Layout title={t(\'teacher.dashboardTitle\')}>\\n      <div className=\\\"space-y-8\\\">\\n        {/* Header */}\\n        <div className=\\\"flex flex-col sm:flex-row sm:items-end justify-between gap-4\\\">\\n          <div>\\n            <p className=\\\"text-sm text-stone-500 dark:text-stone-400\\\">\\n              {formatDate(today, { weekday: \'long\', day: \'numeric\', month: \'long\' })}\\n            </p>\\n            <h2 className=\\\"mt-1 text-2xl sm:text-3xl font-bold tracking-tight text-stone-900 dark:text-stone-50\\\">\\n              {t(\'dashboard.welcome\')}, {profile?.name}\\n            </h2>\\n          </div>\\n\\n          <div className=\\\"flex flex-wrap items-center gap-2.5\\\">\\n            {profile?.managerCode && (\\n              <div className=\\\"flex items-center gap-2 rounded-xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] px-3 py-2\\\">\\n                <span className=\\\"text-xs text-stone-500 dark:text-stone-400\\\">\\n                  {t(\'dashboard.yourManagerCode\')}\\n                </span>\\n                <span className=\\\"font-mono text-sm font-semibold text-stone-900 dark:text-stone-100\\\">\\n                  {profile.managerCode}\\n                </span>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={handleCopyCode}\\n                  aria-label={t(\'common.copy\')}\\n                  className=\\\"text-stone-400 hover:text-[#C25E00]\\\"\\n                >\\n                  {copied ? <Check className=\\\"w-4 h-4 text-emerald-600\\\" /> : <Copy className=\\\"w-4 h-4\\\" />}\\n                </button>\\n              </div>\\n            )}\\n\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => setShowQrModal(true)}\\n              className=\\\"inline-flex items-center gap-2 rounded-xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] hover:bg-stone-50 dark:hover:bg-stone-800 px-3.5 py-2.5 text-sm font-medium transition-colors\\\"\\n            >\\n              <QrCode className=\\\"w-4 h-4 text-[#C25E00]\\\" />\\n              <span>{t(\'dashboard.showQr\')}</span>\\n            </button>\\n\\n            <Link\\n              to=\\\"/mark?tab=scan\\\"\\n              className=\\\"inline-flex items-center gap-2 rounded-xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] hover:bg-stone-50 dark:hover:bg-stone-800 px-3.5 py-2.5 text-sm font-medium transition-colors whitespace-nowrap\\\"\\n            >\\n              <CheckCircle2 className=\\\"w-4 h-4 text-emerald-600\\\" />\\n              <span>{t(\'mark.qrScannerBtn\')}</span>\\n            </Link>\\n\\n            <Link\\n              to=\\\"/attendance\\\"\\n              className=\\\"inline-flex items-center gap-2 rounded-xl bg-[#C25E00] hover:bg-[#A84F00] text-white px-4 py-2.5 text-sm font-medium transition-colors whitespace-nowrap\\\"\\n            >\\n              <ScanLine className=\\\"w-4 h-4\\\" />\\n              <span>{t(\'dashboard.markNow\')}</span>\\n            </Link>\\n          </div>\\n        </div>\\n\\n        {/* Active Live Sessions Strip */}\\n        {openSessions.length > 0 && (\\n          <section className=\\\"rounded-2xl border border-emerald-200 dark:border-emerald-900 bg-emerald-50/70 dark:bg-emerald-950/30 p-5 space-y-3\\\">\\n            <div className=\\\"flex items-center gap-2 text-sm font-semibold text-emerald-900 dark:text-emerald-200\\\">\\n              <Radio className=\\\"w-4 h-4 text-emerald-600 animate-pulse\\\" />\\n              <span>\\n                {t(\'teacher.activeSessions\')} ({formatNumber(openSessions.length)})\\n              </span>\\n            </div>\\n            <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-3\\\">\\n              {openSessions.map((sess) => (\\n                <div\\n                  key={sess.id}\\n                  className=\\\"rounded-xl border border-emerald-200 dark:border-emerald-800 bg-white dark:bg-[#161619] p-4 flex items-center justify-between gap-3\\\"\\n                >\\n                  <div className=\\\"min-w-0\\\">\\n                    <p className=\\\"text-sm font-semibold text-stone-900 dark:text-stone-100 truncate\\\">\\n                      {sess.subjectName || sess.title}\\n                    </p>\\n                    <p className=\\\"text-xs text-stone-500 dark:text-stone-400 truncate mt-0.5\\\">\\n                      {sess.className || memberLabel}\\n                    </p>\\n                  </div>\\n                  <Link\\n                    to=\\\"/attendance\\\"\\n                    className=\\\"rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white px-3 py-1.5 text-xs font-medium shrink-0\\\"\\n                  >\\n                    {t(\'teacher.openLiveView\')}\\n                  </Link>\\n                </div>\\n              ))}\\n            </div>\\n          </section>\\n        )}\\n\\n        {/* Stats (Strictly PRESENT / LEAVE / ABSENT) */}\\n        {loading ? (\\n          <StatGridSkeleton />\\n        ) : (\\n          <div className=\\\"grid grid-cols-2 lg:grid-cols-4 gap-4\\\">\\n            <div className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5\\\">\\n              <p className=\\\"text-xs font-medium text-stone-500 dark:text-stone-400\\\">\\n                {memberLabel}\\n              </p>\\n              <p className=\\\"mt-2 text-3xl font-bold tabular-nums text-stone-900 dark:text-stone-50\\\">\\n                {formatNumber(activeMembers.length)}\\n              </p>\\n            </div>\\n            <div className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5\\\">\\n              <p className=\\\"text-xs font-medium text-stone-500 dark:text-stone-400\\\">\\n                {t(\'dashboard.presentToday\')}\\n              </p>\\n              <p className=\\\"mt-2 text-3xl font-bold tabular-nums text-emerald-700 dark:text-emerald-400\\\">\\n                {formatNumber(todayStats.present)}\\n              </p>\\n            </div>\\n            <div className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5\\\">\\n              <p className=\\\"text-xs font-medium text-stone-500 dark:text-stone-400\\\">\\n                {t(\'dashboard.leaveToday\')}\\n              </p>\\n              <p className=\\\"mt-2 text-3xl font-bold tabular-nums text-sky-700 dark:text-sky-400\\\">\\n                {formatNumber(todayStats.leave)}\\n              </p>\\n            </div>\\n            <div className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5\\\">\\n              <p className=\\\"text-xs font-medium text-stone-500 dark:text-stone-400\\\">\\n                {t(\'dashboard.absentToday\')}\\n              </p>\\n              <p className=\\\"mt-2 text-3xl font-bold tabular-nums text-red-700 dark:text-red-400\\\">\\n                {formatNumber(todayStats.absent)}\\n              </p>\\n            </div>\\n          </div>\\n        )}\\n\\n        {/* My Lectures Today + My Assigned Classes & Subjects */}\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6\\\">\\n          <section className=\\\"lg:col-span-7 rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5 sm:p-6\\\">\\n            <div className=\\\"flex items-center justify-between mb-4\\\">\\n              <h3 className=\\\"text-base font-semibold text-stone-900 dark:text-stone-100 flex items-center gap-2\\\">\\n                <CalendarClock className=\\\"w-4 h-4 text-[#C25E00]\\\" />\\n                <span>{t(\'teacher.myLecturesToday\')}</span>\\n              </h3>\\n              <Link to=\\\"/timetable\\\" className=\\\"text-xs font-medium text-[#C25E00] hover:underline\\\">\\n                {t(\'nav.timetable\')}\\n              </Link>\\n            </div>\\n\\n            {todayLectures.length === 0 ? (\\n              <p className=\\\"text-sm text-stone-500 dark:text-stone-400 py-4\\\">\\n                {t(\'teacher.noLecturesToday\')}\\n              </p>\\n            ) : (\\n              <div className=\\\"divide-y divide-stone-100 dark:divide-stone-800\\\">\\n                {todayLectures.map((slot) => {\\n                  const isLive = openSessions.some(\\n                    (s) => s.classId === slot.classId && s.subjectId === slot.subjectId\\n                  );\\n                  return (\\n                    <div\\n                      key={slot.id}\\n                      className=\\\"py-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-3\\\"\\n                    >\\n                      <div className=\\\"min-w-0\\\">\\n                        <p className=\\\"text-sm font-semibold text-stone-900 dark:text-stone-100 truncate\\\">\\n                          {slot.subjectName}\\n                          {slot.subjectCode ? (\\n                            <span className=\\\"ml-1.5 font-mono text-xs text-stone-400\\\">\\n                              {slot.subjectCode}\\n                            </span>\\n                          ) : null}\\n                        </p>\\n                        <p className=\\\"text-xs text-stone-500 dark:text-stone-400 mt-0.5 tabular-nums\\\">\\n                          {slot.className}\\n                          {slot.classroom ? ` \302\267 ${slot.classroom}` : \'\'} \302\267{\' \'}\\n                          {formatTimeRange12h(slot.startTime, slot.endTime)}\\n                        </p>\\n                      </div>\\n                      <Link\\n                        to={`/attendance?slotId=${slot.id}`}\\n                        className={`inline-flex items-center gap-1.5 rounded-xl px-3.5 py-2 text-xs font-medium shrink-0 self-start sm:self-center ${\\n                          isLive\\n                            ? \'bg-emerald-600 hover:bg-emerald-700 text-white\'\\n                            : \'bg-[#C25E00] hover:bg-[#A84F00] text-white\'\\n                        }`}\\n                      >\\n                        <Play className=\\\"w-3.5 h-3.5 fill-current\\\" />\\n                        <span>{isLive ? t(\'teacher.openLiveView\') : t(\'teacher.startLectureBtn\')}</span>\\n                      </Link>\\n                    </div>\\n                  );\\n                })}\\n              </div>\\n            )}\\n          </section>\\n\\n          <section className=\\\"lg:col-span-5 rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5 sm:p-6\\\">\\n            <div className=\\\"flex items-center justify-between mb-4\\\">\\n              <h3 className=\\\"text-base font-semibold text-stone-900 dark:text-stone-100 flex items-center gap-2\\\">\\n                <BookOpen className=\\\"w-4 h-4 text-[#C25E00]\\\" />\\n                <span>{t(\'teacher.myAssignedSubjects\')}</span>\\n              </h3>\\n              <Link to=\\\"/reports\\\" className=\\\"text-xs font-medium text-[#C25E00] hover:underline\\\">\\n                {t(\'nav.reports\')}\\n              </Link>\\n            </div>\\n\\n            {assignments.length === 0 ? (\\n              <p className=\\\"text-sm text-stone-500 dark:text-stone-400 py-4\\\">\\n                {t(\'teacher.noAssignedSubjects\')}\\n              </p>\\n            ) : (\\n              <div className=\\\"divide-y divide-stone-100 dark:divide-stone-800\\\">\\n                {assignments.map((asgn) => (\\n                  <div\\n                    key={asgn.id}\\n                    className=\\\"py-3 flex items-center justify-between gap-3\\\"\\n                  >\\n                    <div className=\\\"min-w-0\\\">\\n                      <p className=\\\"text-sm font-medium text-stone-900 dark:text-stone-100 truncate\\\">\\n                        {asgn.subjectName}\\n                      </p>\\n                      <p className=\\\"text-xs text-stone-500 dark:text-stone-400 truncate mt-0.5\\\">\\n                        {asgn.className}\\n                      </p>\\n                    </div>\\n                    <Link\\n                      to={`/attendance?assignmentId=${asgn.id}`}\\n                      className=\\\"rounded-lg border border-stone-200 dark:border-stone-700 hover:border-[#C25E00] hover:text-[#C25E00] px-3 py-1.5 text-xs font-medium shrink-0\\\"\\n                    >\\n                      {t(\'teacher.startShort\')}\\n                    </Link>\\n                  </div>\\n                ))}\\n              </div>\\n            )}\\n          </section>\\n        </div>\\n\\n        {/* Weekly Chart (Strictly PRESENT / LEAVE / ABSENT) */}\\n        <section className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5 sm:p-6\\\">\\n          <h3 className=\\\"text-base font-semibold text-stone-900 dark:text-stone-100 mb-5\\\">\\n            {t(\'dashboard.attendanceTrend\')} \302\267 {t(\'dashboard.last7Days\')}\\n          </h3>\\n          <div className=\\\"h-60 w-full\\\">\\n            <ResponsiveContainer width=\\\"100%\\\" height=\\\"100%\\\">\\n              <BarChart data={weeklyChart} margin={{ top: 4, right: 8, left: -20, bottom: 0 }}>\\n                <CartesianGrid strokeDasharray=\\\"3 3\\\" stroke=\\\"#E7E5E4\\\" opacity={0.4} vertical={false} />\\n                <XAxis dataKey=\\\"date\\\" tick={{ fontSize: 11, fill: \'#78716C\' }} axisLine={false} tickLine={false} />\\n                <YAxis allowDecimals={false} tick={{ fontSize: 11, fill: \'#78716C\' }} axisLine={false} tickLine={false} />\\n                <Tooltip contentStyle={{ borderRadius: \'12px\', border: \'1px solid #E7E5E4\', fontSize: \'12px\' }} />\\n                <Bar dataKey=\\\"present\\\" name={t(\'common.present\')} stackId=\\\"a\\\" fill=\\\"#15803D\\\" />\\n                <Bar dataKey=\\\"leave\\\" name={t(\'common.leave\')} stackId=\\\"a\\\" fill=\\\"#0284C7\\\" />\\n                <Bar dataKey=\\\"absent\\\" name={t(\'common.absent\')} stackId=\\\"a\\\" fill=\\\"#DC2626\\\" radius={[4, 4, 0, 0]} />\\n              </BarChart>\\n            </ResponsiveContainer>\\n          </div>\\n        </section>\\n\\n        {/* Bottom 2-column grid */}\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6\\\">\\n          {/* Low Attendance List */}\\n          <section className=\\\"lg:col-span-6 rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5 sm:p-6\\\">\\n            <div className=\\\"flex flex-wrap items-center justify-between gap-2 mb-4\\\">\\n              <div>\\n                <h3 className=\\\"text-base font-semibold text-stone-900 dark:text-stone-100\\\">\\n                  {t(\'dashboard.lowAttendance\')}\\n                </h3>\\n                <p className=\\\"text-xs text-stone-500 dark:text-stone-400 tabular-nums\\\">\\n                  {t(\'dashboard.belowThreshold\')} {threshold}%\\n                </p>\\n              </div>\\n              {lowAttendanceAnalyses.length > 0 && (\\n                <button\\n                  type=\\\"button\\\"\\n                  disabled={sendingAlerts}\\n                  onClick={handleSendAlerts}\\n                  className=\\\"inline-flex items-center gap-1.5 rounded-xl bg-red-600 hover:bg-red-700 disabled:opacity-60 text-white px-3 py-1.5 text-xs font-medium\\\"\\n                >\\n                  <BellRing className=\\\"w-3.5 h-3.5\\\" />\\n                  <span>{sendingAlerts ? t(\'common.saving\') : t(\'alerts.sendAlertsBtn\')}</span>\\n                </button>\\n              )}\\n            </div>\\n\\n            {loading ? (\\n              <CardSkeleton rows={3} />\\n            ) : lowAttendanceAnalyses.length === 0 ? (\\n              <p className=\\\"text-sm text-stone-500 dark:text-stone-400 py-4\\\">\\n                {t(\'dashboard.noLowAttendance\')}\\n              </p>\\n            ) : (\\n              <div className=\\\"divide-y divide-stone-100 dark:divide-stone-800\\\">\\n                {lowAttendanceAnalyses.map((item) => (\\n                  <div key={item.student.uid} className=\\\"py-3 flex items-center justify-between gap-3\\\">\\n                    <div className=\\\"min-w-0\\\">\\n                      <p className=\\\"text-sm font-medium text-stone-900 dark:text-stone-100 truncate\\\">\\n                        {item.student.name}\\n                      </p>\\n                      <p className=\\\"text-xs font-mono text-stone-500 dark:text-stone-400\\\">\\n                        {item.student.memberId} \302\267 {item.presentCount}/{item.totalClasses}\\n                      </p>\\n                    </div>\\n                    <span className=\\\"text-sm font-semibold tabular-nums text-red-700 dark:text-red-400\\\">\\n                      {item.overallPercent}%\\n                    </span>\\n                  </div>\\n                ))}\\n              </div>\\n            )}\\n          </section>\\n\\n          {/* Pending Approvals, Leaves & Notices */}\\n          <div className=\\\"lg:col-span-6 space-y-6\\\">\\n            {pendingMembers.length > 0 && (\\n              <section className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5 sm:p-6\\\">\\n                <h3 className=\\\"text-base font-semibold text-stone-900 dark:text-stone-100 mb-3\\\">\\n                  {t(\'dashboard.pendingApprovals\')} ({pendingMembers.length})\\n                </h3>\\n                <div className=\\\"divide-y divide-stone-100 dark:divide-stone-800\\\">\\n                  {pendingMembers.map((m) => (\\n                    <div key={m.uid} className=\\\"py-2.5 flex items-center justify-between gap-2\\\">\\n                      <div className=\\\"min-w-0\\\">\\n                        <p className=\\\"text-sm font-medium truncate\\\">{m.name}</p>\\n                        <p className=\\\"text-xs text-stone-500 truncate\\\">{m.email}</p>\\n                      </div>\\n                      <div className=\\\"flex items-center gap-1.5\\\">\\n                        <button\\n                          type=\\\"button\\\"\\n                          onClick={() => handleApprove(m)}\\n                          className=\\\"rounded-lg bg-emerald-600 text-white px-2.5 py-1 text-xs font-medium\\\"\\n                        >\\n                          {t(\'dashboard.approve\')}\\n                        </button>\\n                        <button\\n                          type=\\\"button\\\"\\n                          onClick={() => handleReject(m)}\\n                          className=\\\"rounded-lg border border-stone-200 dark:border-stone-700 p-1 text-stone-500 hover:text-red-600\\\"\\n                        >\\n                          <X className=\\\"w-3.5 h-3.5\\\" />\\n                        </button>\\n                      </div>\\n                    </div>\\n                  ))}\\n                </div>\\n              </section>\\n            )}\\n\\n            <section className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5 sm:p-6\\\">\\n              <div className=\\\"flex items-center justify-between mb-3\\\">\\n                <h3 className=\\\"text-base font-semibold text-stone-900 dark:text-stone-100\\\">\\n                  {t(\'dashboard.pendingLeaves\')}\\n                </h3>\\n                <Link to=\\\"/leaves\\\" className=\\\"text-xs font-medium text-[#C25E00] hover:underline\\\">\\n                  {t(\'dashboard.viewAll\')}\\n                </Link>\\n              </div>\\n              {pendingLeaves.length === 0 ? (\\n                <p className=\\\"text-sm text-stone-500 dark:text-stone-400\\\">\\n                  {t(\'dashboard.noPendingLeaves\')}\\n                </p>\\n              ) : (\\n                <div className=\\\"divide-y divide-stone-100 dark:divide-stone-800\\\">\\n                  {pendingLeaves.slice(0, 4).map((l) => (\\n                    <div key={l.id} className=\\\"py-2.5\\\">\\n                      <p className=\\\"text-sm font-medium text-stone-900 dark:text-stone-100\\\">\\n                        {l.personName}\\n                      </p>\\n                      <p className=\\\"text-xs text-stone-500 dark:text-stone-400 mt-0.5\\\">\\n                        {formatDate(l.fromDate)} \342\200\223 {formatDate(l.toDate)} \302\267 {l.reason}\\n                      </p>\\n                    </div>\\n                  ))}\\n                </div>\\n              )}\\n            </section>\\n\\n            <section className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5 sm:p-6\\\">\\n              <div className=\\\"flex items-center justify-between mb-3\\\">\\n                <h3 className=\\\"text-base font-semibold text-stone-900 dark:text-stone-100\\\">\\n                  {t(\'dashboard.recentAnnouncements\')}\\n                </h3>\\n                <Link to=\\\"/announcements\\\" className=\\\"text-xs font-medium text-[#C25E00] hover:underline\\\">\\n                  {t(\'dashboard.viewAll\')}\\n                </Link>\\n              </div>\\n              {announcements.length === 0 ? (\\n                <p className=\\\"text-sm text-stone-500 dark:text-stone-400\\\">\\n                  {t(\'dashboard.noAnnouncements\')}\\n                </p>\\n              ) : (\\n                <div className=\\\"space-y-3\\\">\\n                  {announcements.map((a) => (\\n                    <div\\n                      key={a.id}\\n                      className=\\\"pb-3 border-b last:border-b-0 border-stone-100 dark:border-stone-800\\\"\\n                    >\\n                      <p className=\\\"text-sm text-stone-800 dark:text-stone-200\\\">{a.text}</p>\\n                      <p className=\\\"mt-1 text-xs text-stone-400\\\">{a.fromName}</p>\\n                    </div>\\n                  ))}\\n                </div>\\n              )}\\n            </section>\\n          </div>\\n        </div>\\n      </div>\\n\\n      {showQrModal && profile && org && (\\n        <QRCardModal\\n          person={profile}\\n          org={org}\\n          roleLabel={managerLabel}\\n          onClose={() => setShowQrModal(false)}\\n        />\\n      )}\\n    </Layout>\\n  );\\n};\\n\", \"Description\":\"Upgrade ManagerDashboard into full Teacher Dashboard with live sessions, today\'s lectures, assigned subjects, and zero LATE\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/ManagerDashboard.tsx\", \"toolAction\":\"Updating ManagerDashboard.tsx\", \"toolSummary\":\"Update ManagerDashboard.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_8879165683277233623"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useEffect, useMemo, useState } from \'react\';\\nimport { Link } from \'react-router-dom\';\\nimport { QRCodeSVG } from \'qrcode.react\';\\nimport {\\n  AlertTriangle,\\n  BookOpen,\\n  CalendarClock,\\n  ChevronLeft,\\n  ChevronRight,\\n  KeyRound,\\n  QrCode,\\n  Radio,\\n  RefreshCw,\\n  ScanLine,\\n} from \'lucide-react\';\\nimport { useAuth } from \'../context/AuthContext\';\\nimport { useTranslation } from \'../hooks/useTranslation\';\\nimport type {\\n  Announcement,\\n  AttendanceRecord,\\n  AttendanceSession,\\n  LeaveRequest,\\n  TimetableSlot,\\n} from \'../types\';\\nimport { subscribeAttendanceForPerson } from \'../services/attendanceService\';\\nimport {\\n  findEligibleLiveSessions,\\n  subscribeEligibleLiveSessions,\\n  type SessionStreamError,\\n} from \'../services/sessionService\';\\nimport { subscribeTimetableForClass } from \'../services/academicService\';\\nimport { fetchLeavesForStudent } from \'../services/leaveService\';\\nimport { fetchAnnouncements } from \'../services/communicationService\';\\nimport { computeStudentAttendanceAnalysis } from \'../services/lowAttendanceService\';\\nimport {\\n  formatTimeRange12h,\\n  getInitials,\\n  getOrgDateString,\\n  getOrgWeekdayIndex,\\n} from \'../utils/helpers\';\\nimport { Layout } from \'../components/Layout\';\\nimport { QRCardModal } from \'../components/QRCardModal\';\\nimport { CardSkeleton } from \'../components/Skeletons\';\\n\\nexport const MemberDashboard: React.FC = () => {\\n  const { profile, org, getRoleLabel } = useAuth();\\n  const { t, formatDate, formatNumber, language } = useTranslation();\\n\\n  const [loading, setLoading] = useState(true);\\n  const [records, setRecords] = useState<AttendanceRecord[]>([]);\\n  const [liveSessions, setLiveSessions] = useState<AttendanceSession[]>([]);\\n  const [sessionError, setSessionError] = useState<SessionStreamError | null>(null);\\n  const [recheckingSessions, setRecheckingSessions] = useState(false);\\n  const [timetable, setTimetable] = useState<TimetableSlot[]>([]);\\n  const [leaves, setLeaves] = useState<LeaveRequest[]>([]);\\n  const [announcements, setAnnouncements] = useState<Announcement[]>([]);\\n  const [showQrModal, setShowQrModal] = useState(false);\\n\\n  const today = useMemo(() => getOrgDateString(org?.timezone || \'Asia/Kolkata\'), [org?.timezone]);\\n  const todayWeekday = useMemo(\\n    () => getOrgWeekdayIndex(org?.timezone || \'Asia/Kolkata\'),\\n    [org?.timezone]\\n  );\\n  const [calYear, setCalYear] = useState(() => Number(today.slice(0, 4)));\\n  const [calMonth, setCalMonth] = useState(() => Number(today.slice(5, 7)) - 1);\\n\\n  const memberLabel = getRoleLabel(\'member\');\\n  const threshold = org?.lowAttendanceThreshold ?? 75;\\n\\n  // Real-time Attendance, Live Sessions & Timetable listeners\\n  useEffect(() => {\\n    if (!org || !profile) return;\\n    setLoading(true);\\n\\n    const unsubAtt = subscribeAttendanceForPerson(org.id, profile.uid, (list) => {\\n      setRecords(list);\\n      setLoading(false);\\n    });\\n\\n    const unsubSessions = subscribeEligibleLiveSessions(\\n      profile,\\n      org,\\n      (list) => {\\n        setLiveSessions(list);\\n        setSessionError(null);\\n      },\\n      (err) => {\\n        setSessionError(err);\\n      }\\n    );\\n\\n    const unsubTT = profile.classId\\n      ? subscribeTimetableForClass(org.id, profile.classId, setTimetable)\\n      : () => {};\\n\\n    Promise.all([\\n      fetchLeavesForStudent(org.id, profile.uid).catch(() => [] as LeaveRequest[]),\\n      fetchAnnouncements(profile).catch(() => [] as Announcement[]),\\n    ]).then(([lv, notices]) => {\\n      setLeaves(lv.slice(0, 5));\\n      setAnnouncements(notices.slice(0, 4));\\n    });\\n\\n    return () => {\\n      unsubAtt();\\n      unsubSessions();\\n      unsubTT();\\n    };\\n  }, [org, profile]);\\n\\n  const handleRecheckSessions = async () => {\\n    if (!profile || !org) return;\\n    setRecheckingSessions(true);\\n    try {\\n      const res = await findEligibleLiveSessions(profile, org);\\n      setLiveSessions(res.sessions);\\n      setSessionError(res.error);\\n    } finally {\\n      setRecheckingSessions(false);\\n    }\\n  };\\n\\n  // Student Performance Analysis (Overall % + Subject-wise % + 75% Shortage Detection)\\n  const analysis = useMemo(() => {\\n    if (!profile) return null;\\n    return computeStudentAttendanceAnalysis(profile, records, threshold);\\n  }, [profile, records, threshold]);\\n\\n  // Today\'s Scheduled Lectures merged with attendance & live sessions\\n  const todayLectures = useMemo(() => {\\n    const todaySlots = timetable.filter((s) => s.dayOfWeek === todayWeekday);\\n    const todayRecs = records.filter((r) => r.date === today);\\n\\n    return todaySlots.map((slot) => {\\n      const rec = todayRecs.find((r) => r.subjectId === slot.subjectId);\\n      const liveSess = liveSessions.find(\\n        (s) => s.subjectId === slot.subjectId && (!s.classId || s.classId === slot.classId)\\n      );\\n      return {\\n        slot,\\n        status: rec ? rec.status : (\'not_started\' as const),\\n        liveSession: liveSess || null,\\n      };\\n    });\\n  }, [timetable, todayWeekday, records, today, liveSessions]);\\n\\n  // Calendar aggregation by date (if multiple subjects on same day: present wins over leave, absent if all absent)\\n  const statusByDate = useMemo(() => {\\n    const map = new Map<string, \'present\' | \'leave\' | \'absent\'>();\\n    for (const r of records) {\\n      const cur = map.get(r.date);\\n      if (!cur) {\\n        map.set(r.date, r.status);\\n      } else if (r.status === \'present\') {\\n        map.set(r.date, \'present\');\\n      } else if (r.status === \'leave\' && cur === \'absent\') {\\n        map.set(r.date, \'leave\');\\n      }\\n    }\\n    return map;\\n  }, [records]);\\n\\n  const calendarDays = useMemo(() => {\\n    const firstDay = new Date(calYear, calMonth, 1);\\n    const startWeekday = firstDay.getDay();\\n    const daysInMonth = new Date(calYear, calMonth + 1, 0).getDate();\\n    const cells: Array<{ day: number | null; dateStr?: string }> = [];\\n    for (let i = 0; i < startWeekday; i++) cells.push({ day: null });\\n    for (let d = 1; d <= daysInMonth; d++) {\\n      const m = String(calMonth + 1).padStart(2, \'0\');\\n      const dayStr = String(d).padStart(2, \'0\');\\n      cells.push({ day: d, dateStr: `${calYear}-${m}-${dayStr}` });\\n    }\\n    return cells;\\n  }, [calYear, calMonth]);\\n\\n  const monthHeading = new Intl.DateTimeFormat(language === \'hi\' ? \'hi-IN\' : \'en-IN\', {\\n    month: \'long\',\\n    year: \'numeric\',\\n  }).format(new Date(calYear, calMonth, 1));\\n\\n  const prevMonth = () => {\\n    if (calMonth === 0) {\\n      setCalMonth(11);\\n      setCalYear((y) => y - 1);\\n    } else {\\n      setCalMonth((m) => m - 1);\\n    }\\n  };\\n\\n  const nextMonth = () => {\\n    if (calMonth === 11) {\\n      setCalMonth(0);\\n      setCalYear((y) => y + 1);\\n    } else {\\n      setCalMonth((m) => m + 1);\\n    }\\n  };\\n\\n  const qrValue =\\n    org && profile\\n      ? JSON.stringify({ type: \'student_id\', orgId: org.id, uid: profile.uid, id: profile.memberId })\\n      : \'\';\\n\\n  const cellColors = (status?: string) => {\\n    if (status === \'present\')\\n      return \'bg-emerald-100 dark:bg-emerald-950/60 text-emerald-900 dark:text-emerald-200 border-emerald-200 dark:border-emerald-800\';\\n    if (status === \'absent\')\\n      return \'bg-red-100 dark:bg-red-950/60 text-red-900 dark:text-red-200 border-red-200 dark:border-red-800\';\\n    if (status === \'leave\')\\n      return \'bg-sky-100 dark:bg-sky-950/60 text-sky-900 dark:text-sky-200 border-sky-200 dark:border-sky-800\';\\n    return \'bg-stone-50 dark:bg-stone-900/50 text-stone-600 dark:text-stone-400 border-stone-200/70 dark:border-stone-800\';\\n  };\\n\\n  const weekdayLabels =\\n    language === \'hi\'\\n      ? [\'\340\244\260\340\244\265\340\244\277\', \'\340\244\270\340\245\213\340\244\256\', \'\340\244\256\340\244\202\340\244\227\340\244\262\', \'\340\244\254\340\245\201\340\244\247\', \'\340\244\227\340\245\201\340\244\260\340\245\201\', \'\340\244\266\340\245\201\340\244\225\340\245\215\340\244\260\', \'\340\244\266\340\244\250\340\244\277\']\\n      : [\'Sun\', \'Mon\', \'Tue\', \'Wed\', \'Thu\', \'Fri\', \'Sat\'];\\n\\n  return (\\n    <Layout title={t(\'student.dashboardTitle\')}>\\n      <div className=\\\"space-y-7\\\">\\n        {/* REAL-TIME ACTIVE SESSIONS BANNER (Auto-updates instantly when any teacher starts/ends a session) */}\\n        {liveSessions.length > 0 ? (\\n          <section className=\\\"rounded-2xl border border-emerald-300 dark:border-emerald-800 bg-emerald-50/75 dark:bg-emerald-950/30 p-5 space-y-3\\\">\\n            <div className=\\\"flex items-center justify-between gap-2\\\">\\n              <div className=\\\"flex items-center gap-2 text-sm font-bold text-emerald-900 dark:text-emerald-200\\\">\\n                <Radio className=\\\"w-4 h-4 text-emerald-600 animate-pulse\\\" />\\n                <span>\\n                  {t(\'student.activeLiveSessionsTitle\')} ({formatNumber(liveSessions.length)})\\n                </span>\\n              </div>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={handleRecheckSessions}\\n                className=\\\"inline-flex items-center gap-1 text-xs font-medium text-emerald-800 dark:text-emerald-300 hover:underline\\\"\\n              >\\n                <RefreshCw className={`w-3.5 h-3.5 ${recheckingSessions ? \'animate-spin\' : \'\'}`} />\\n                <span>{t(\'mark.refreshSession\')}</span>\\n              </button>\\n            </div>\\n            <div className=\\\"grid grid-cols-1 md:grid-cols-2 gap-3\\\">\\n              {liveSessions.map((sess) => (\\n                <div\\n                  key={sess.id}\\n                  className=\\\"rounded-xl border border-emerald-200 dark:border-emerald-800 bg-white dark:bg-[#161619] p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3\\\"\\n                >\\n                  <div className=\\\"min-w-0\\\">\\n                    <p className=\\\"text-sm font-semibold text-stone-900 dark:text-stone-100 truncate\\\">\\n                      {sess.subjectName || sess.title}\\n                    </p>\\n                    <p className=\\\"text-xs text-stone-500 dark:text-stone-400 truncate mt-0.5\\\">\\n                      {sess.teacherName || sess.ownerName}\\n                      {sess.classroom ? ` \302\267 ${sess.classroom}` : \'\'}\\n                    </p>\\n                  </div>\\n                  <div className=\\\"flex items-center gap-2 shrink-0\\\">\\n                    <Link\\n                      to={`/mark?tab=scan&sessionId=${sess.id}`}\\n                      className=\\\"inline-flex items-center gap-1.5 rounded-lg bg-[#C25E00] hover:bg-[#A84F00] text-white px-3 py-1.5 text-xs font-medium\\\"\\n                    >\\n                      <ScanLine className=\\\"w-3.5 h-3.5\\\" />\\n                      <span>{t(\'landing.markCardScanBtn\')}</span>\\n                    </Link>\\n                    <Link\\n                      to={`/mark?tab=code&sessionId=${sess.id}`}\\n                      className=\\\"inline-flex items-center gap-1.5 rounded-lg border border-stone-300 dark:border-stone-700 px-2.5 py-1.5 text-xs font-medium\\\"\\n                    >\\n                      <KeyRound className=\\\"w-3.5 h-3.5\\\" />\\n                      <span>{t(\'mark.codeShort\')}</span>\\n                    </Link>\\n                  </div>\\n                </div>\\n              ))}\\n            </div>\\n          </section>\\n        ) : (\\n          <div className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4\\\">\\n            <div>\\n              <h2 className=\\\"text-base font-semibold text-stone-900 dark:text-stone-50\\\">\\n                {sessionError ? t(\'mark.sessionNetworkErrorTitle\') : t(\'mark.noActiveSession\')}\\n              </h2>\\n              <p className=\\\"mt-0.5 text-xs text-stone-500 dark:text-stone-400\\\">\\n                {sessionError ? sessionError.message : t(\'mark.noActiveSessionHint\')}\\n              </p>\\n            </div>\\n            <div className=\\\"flex flex-wrap items-center gap-2 shrink-0\\\">\\n              <button\\n                type=\\\"button\\\"\\n                disabled={recheckingSessions}\\n                onClick={handleRecheckSessions}\\n                className=\\\"inline-flex items-center gap-1.5 rounded-xl border border-stone-300 dark:border-stone-700 hover:bg-stone-50 dark:hover:bg-stone-800 px-3.5 py-2 text-xs font-medium\\\"\\n              >\\n                <RefreshCw className={`w-3.5 h-3.5 ${recheckingSessions ? \'animate-spin\' : \'\'}`} />\\n                <span>{t(\'mark.refreshSession\')}</span>\\n              </button>\\n              <Link\\n                to=\\\"/mark?tab=scan\\\"\\n                className=\\\"inline-flex items-center gap-1.5 rounded-xl bg-[#C25E00] hover:bg-[#A84F00] text-white px-4 py-2 text-xs font-medium\\\"\\n              >\\n                <ScanLine className=\\\"w-3.5 h-3.5\\\" />\\n                <span>{t(\'landing.markCardScanBtn\')}</span>\\n              </Link>\\n            </div>\\n          </div>\\n        )}\\n\\n        {/* 75% ATTENDANCE SHORTAGE WARNING BANNER */}\\n        {analysis && analysis.totalClasses > 0 && analysis.hasShortage && (\\n          <div\\n            role=\\\"alert\\\"\\n            className=\\\"rounded-2xl border border-red-200 dark:border-red-900/80 bg-red-50/75 dark:bg-red-950/30 p-4 sm:p-5 flex items-start gap-3\\\"\\n          >\\n            <AlertTriangle className=\\\"w-5 h-5 text-red-600 shrink-0 mt-0.5\\\" />\\n            <div>\\n              <h3 className=\\\"text-sm font-bold text-red-900 dark:text-red-200\\\">\\n                {t(\'alerts.shortageWarningTitle\')} ({threshold}%)\\n              </h3>\\n              <p className=\\\"mt-1 text-xs text-red-800 dark:text-red-300 leading-relaxed\\\">\\n                {analysis.isOverallShortage\\n                  ? t(\'alerts.overallShortageDesc\')\\n                      .replace(\'{pct}\', String(analysis.overallPercent))\\n                      .replace(\'{threshold}\', String(threshold))\\n                  : t(\'alerts.subjectShortageDesc\').replace(\\n                      \'{subjects}\',\\n                      analysis.shortageSubjects\\n                        .map((s) => `${s.subjectName} (${s.percentage}%)`)\\n                        .join(\', \')\\n                    )}\\n              </p>\\n            </div>\\n          </div>\\n        )}\\n\\n        {/* Top Row: Digital Student ID Card + Performance Overview */}\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch\\\">\\n          {/* Digital Student ID Card Preview */}\\n          <div className=\\\"lg:col-span-5 rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] overflow-hidden flex flex-col justify-between\\\">\\n            <div className=\\\"bg-[#C25E00] px-5 py-3.5 text-white flex items-center justify-between gap-2\\\">\\n              <div className=\\\"min-w-0\\\">\\n                <p className=\\\"text-xs font-bold truncate\\\">{org?.name}</p>\\n                <p className=\\\"text-[10px] uppercase tracking-wider text-white/85\\\">\\n                  {t(\'qr.officialCardLabel\')}\\n                </p>\\n              </div>\\n              <span className=\\\"font-mono text-xs font-bold bg-white/15 px-2 py-0.5 rounded\\\">\\n                {profile?.memberId}\\n              </span>\\n            </div>\\n\\n            <div className=\\\"p-5 flex flex-col items-center text-center flex-1 justify-between\\\">\\n              <div className=\\\"flex items-center gap-3.5 w-full text-left\\\">\\n                {profile?.photoUrl ? (\\n                  <img\\n                    src={profile.photoUrl}\\n                    alt={profile.name}\\n                    className=\\\"w-14 h-14 rounded-xl object-cover border border-stone-200 dark:border-stone-700 shrink-0\\\"\\n                  />\\n                ) : (\\n                  <div className=\\\"w-14 h-14 rounded-xl bg-stone-200 dark:bg-stone-800 text-stone-700 dark:text-stone-200 flex items-center justify-center text-base font-bold shrink-0\\\">\\n                    {getInitials(profile?.name || \'\')}\\n                  </div>\\n                )}\\n                <div className=\\\"min-w-0\\\">\\n                  <h2 className=\\\"text-lg font-bold text-stone-900 dark:text-stone-100 truncate\\\">\\n                    {profile?.name}\\n                  </h2>\\n                  <p className=\\\"text-xs text-stone-500 dark:text-stone-400 truncate\\\">\\n                    {profile?.className || memberLabel}\\n                  </p>\\n                  {(profile?.enrollmentNumber || profile?.rollNumber) && (\\n                    <p className=\\\"text-[11px] font-mono text-stone-400 mt-0.5\\\">\\n                      {t(\'qr.enrollmentNo\')}: {profile.enrollmentNumber || profile.rollNumber}\\n                    </p>\\n                  )}\\n                </div>\\n              </div>\\n\\n              <div className=\\\"my-4 p-3 rounded-xl bg-white border border-stone-200\\\">\\n                {qrValue && <QRCodeSVG value={qrValue} size={148} level=\\\"M\\\" />}\\n              </div>\\n\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setShowQrModal(true)}\\n                className=\\\"w-full inline-flex items-center justify-center gap-2 rounded-xl bg-[#C25E00] hover:bg-[#A84F00] text-white px-4 py-2.5 text-sm font-medium transition-colors\\\"\\n              >\\n                <QrCode className=\\\"w-4 h-4\\\" />\\n                <span>{t(\'qr.openDigitalIdBtn\')}</span>\\n              </button>\\n            </div>\\n          </div>\\n\\n          {/* Performance Metrics + Today\'s Lectures */}\\n          <div className=\\\"lg:col-span-7 flex flex-col gap-5\\\">\\n            <div className=\\\"grid grid-cols-2 sm:grid-cols-4 gap-3\\\">\\n              <div className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-4\\\">\\n                <p className=\\\"text-xs text-stone-500 dark:text-stone-400\\\">{t(\'student.overallRate\')}</p>\\n                <p\\n                  className={`mt-1.5 text-2xl font-bold tabular-nums ${\\n                    (analysis?.overallPercent ?? 100) < threshold && (analysis?.totalClasses ?? 0) > 0\\n                      ? \'text-red-600 dark:text-red-400\'\\n                      : \'text-emerald-700 dark:text-emerald-400\'\\n                  }`}\\n                >\\n                  {formatNumber(analysis?.overallPercent ?? 0)}%\\n                </p>\\n              </div>\\n              <div className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-4\\\">\\n                <p className=\\\"text-xs text-stone-500 dark:text-stone-400\\\">{t(\'common.present\')}</p>\\n                <p className=\\\"mt-1.5 text-2xl font-bold tabular-nums text-emerald-700 dark:text-emerald-400\\\">\\n                  {formatNumber(analysis?.presentCount ?? 0)}\\n                </p>\\n              </div>\\n              <div className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-4\\\">\\n                <p className=\\\"text-xs text-stone-500 dark:text-stone-400\\\">{t(\'common.absent\')}</p>\\n                <p className=\\\"mt-1.5 text-2xl font-bold tabular-nums text-red-700 dark:text-red-400\\\">\\n                  {formatNumber(analysis?.absentCount ?? 0)}\\n                </p>\\n              </div>\\n              <div className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-4\\\">\\n                <p className=\\\"text-xs text-stone-500 dark:text-stone-400\\\">{t(\'common.leave\')}</p>\\n                <p className=\\\"mt-1.5 text-2xl font-bold tabular-nums text-sky-700 dark:text-sky-400\\\">\\n                  {formatNumber(analysis?.leaveCount ?? 0)}\\n                </p>\\n              </div>\\n            </div>\\n\\n            {/* Today\'s Lectures Schedule */}\\n            <section className=\\\"flex-1 rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5\\\">\\n              <div className=\\\"flex items-center justify-between mb-3.5\\\">\\n                <h3 className=\\\"text-base font-semibold text-stone-900 dark:text-stone-100 flex items-center gap-2\\\">\\n                  <CalendarClock className=\\\"w-4 h-4 text-[#C25E00]\\\" />\\n                  <span>{t(\'student.todaysLectures\')}</span>\\n                </h3>\\n                <Link to=\\\"/timetable\\\" className=\\\"text-xs font-medium text-[#C25E00] hover:underline\\\">\\n                  {t(\'nav.timetable\')}\\n                </Link>\\n              </div>\\n\\n              {todayLectures.length === 0 ? (\\n                <p className=\\\"text-sm text-stone-500 dark:text-stone-400 py-4\\\">\\n                  {t(\'student.noLecturesToday\')}\\n                </p>\\n              ) : (\\n                <div className=\\\"divide-y divide-stone-100 dark:divide-stone-800\\\">\\n                  {todayLectures.map(({ slot, status, liveSession }) => (\\n                    <div\\n                      key={slot.id}\\n                      className=\\\"py-3 flex flex-wrap items-center justify-between gap-2\\\"\\n                    >\\n                      <div className=\\\"min-w-0\\\">\\n                        <p className=\\\"text-sm font-semibold text-stone-900 dark:text-stone-100 truncate\\\">\\n                          {slot.subjectName}\\n                        </p>\\n                        <p className=\\\"text-xs text-stone-500 dark:text-stone-400 tabular-nums mt-0.5\\\">\\n                          {slot.teacherName} \302\267 {formatTimeRange12h(slot.startTime, slot.endTime)}\\n                          {slot.classroom ? ` \302\267 ${slot.classroom}` : \'\'}\\n                        </p>\\n                      </div>\\n\\n                      <div className=\\\"flex items-center gap-2 shrink-0\\\">\\n                        {liveSession && status === \'not_started\' && (\\n                          <Link\\n                            to={`/mark?tab=scan&sessionId=${liveSession.id}`}\\n                            className=\\\"inline-flex items-center gap-1 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white px-2.5 py-1 text-xs font-medium\\\"\\n                          >\\n                            <span className=\\\"w-1.5 h-1.5 rounded-full bg-white animate-pulse\\\" />\\n                            <span>{t(\'session.liveBadge\')}</span>\\n                          </Link>\\n                        )}\\n                        <span\\n                          className={`text-xs font-semibold uppercase ${\\n                            status === \'present\'\\n                              ? \'text-emerald-700 dark:text-emerald-400\'\\n                              : status === \'absent\'\\n                              ? \'text-red-700 dark:text-red-400\'\\n                              : status === \'leave\'\\n                              ? \'text-sky-700 dark:text-sky-400\'\\n                              : \'text-stone-400\'\\n                          }`}\\n                        >\\n                          {status === \'not_started\'\\n                            ? t(\'student.notStarted\')\\n                            : t(`common.${status}`)}\\n                        </span>\\n                      </div>\\n                    </div>\\n                  ))}\\n                </div>\\n              )}\\n            </section>\\n          </div>\\n        </div>\\n\\n        {/* Subject-Wise Attendance Breakdown + Monthly Calendar */}\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6\\\">\\n          {/* Subject-wise Breakdown */}\\n          <section className=\\\"lg:col-span-6 rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5 sm:p-6\\\">\\n            <h3 className=\\\"text-base font-semibold text-stone-900 dark:text-stone-100 flex items-center gap-2 mb-4\\\">\\n              <BookOpen className=\\\"w-4 h-4 text-[#C25E00]\\\" />\\n              <span>{t(\'student.subjectWiseTitle\')}</span>\\n            </h3>\\n\\n            {loading ? (\\n              <CardSkeleton rows={3} />\\n            ) : !analysis || analysis.subjects.length === 0 ? (\\n              <p className=\\\"text-sm text-stone-500 py-4\\\">{t(\'common.noData\')}</p>\\n            ) : (\\n              <div className=\\\"space-y-4\\\">\\n                {analysis.subjects.map((sub) => (\\n                  <div key={sub.subjectId} className=\\\"space-y-1.5\\\">\\n                    <div className=\\\"flex items-center justify-between text-sm\\\">\\n                      <span className=\\\"font-medium text-stone-900 dark:text-stone-100 truncate\\\">\\n                        {sub.subjectName}\\n                        {sub.subjectCode ? (\\n                          <span className=\\\"ml-1.5 font-mono text-xs text-stone-400\\\">\\n                            {sub.subjectCode}\\n                          </span>\\n                        ) : null}\\n                      </span>\\n                      <span\\n                        className={`font-mono text-xs font-bold tabular-nums ${\\n                          sub.isShortage\\n                            ? \'text-red-600 dark:text-red-400\'\\n                            : \'text-emerald-700 dark:text-emerald-400\'\\n                        }`}\\n                      >\\n                        {sub.percentage}% ({sub.present}/{sub.total})\\n                      </span>\\n                    </div>\\n                    <div className=\\\"h-2 rounded-full bg-stone-100 dark:bg-stone-800 overflow-hidden\\\">\\n                      <div\\n                        className={`h-full rounded-full ${\\n                          sub.isShortage ? \'bg-red-500\' : \'bg-emerald-600\'\\n                        }`}\\n                        style={{ width: `${Math.min(100, sub.percentage)}%` }}\\n                      />\\n                    </div>\\n                  </div>\\n                ))}\\n              </div>\\n            )}\\n          </section>\\n\\n          {/* Monthly Calendar (Strictly Present / Absent / Leave) */}\\n          <section className=\\\"lg:col-span-6 rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5 sm:p-6\\\">\\n            <div className=\\\"flex items-center justify-between mb-4\\\">\\n              <h3 className=\\\"text-base font-semibold text-stone-900 dark:text-stone-100\\\">\\n                {monthHeading}\\n              </h3>\\n              <div className=\\\"flex items-center gap-1\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={prevMonth}\\n                  aria-label={t(\'common.previous\')}\\n                  className=\\\"p-1.5 rounded-lg border border-stone-200 dark:border-stone-800 hover:bg-stone-50 dark:hover:bg-stone-800\\\"\\n                >\\n                  <ChevronLeft className=\\\"w-4 h-4\\\" />\\n                </button>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={nextMonth}\\n                  aria-label={t(\'common.next\')}\\n                  className=\\\"p-1.5 rounded-lg border border-stone-200 dark:border-stone-800 hover:bg-stone-50 dark:hover:bg-stone-800\\\"\\n                >\\n                  <ChevronRight className=\\\"w-4 h-4\\\" />\\n                </button>\\n              </div>\\n            </div>\\n\\n            <div className=\\\"grid grid-cols-7 gap-1.5 text-center text-[11px] font-medium text-stone-500 mb-2\\\">\\n              {weekdayLabels.map((w) => (\\n                <div key={w}>{w}</div>\\n              ))}\\n            </div>\\n\\n            <div className=\\\"grid grid-cols-7 gap-1.5\\\">\\n              {calendarDays.map((cell, idx) => {\\n                if (!cell.day || !cell.dateStr) return <div key={idx} />;\\n                const st = statusByDate.get(cell.dateStr);\\n                return (\\n                  <div\\n                    key={cell.dateStr}\\n                    title={st ? `${cell.dateStr}: ${t(`common.${st}`)}` : cell.dateStr}\\n                    className={`h-10 rounded-lg border flex flex-col items-center justify-center text-xs font-medium tabular-nums ${cellColors(\\n                      st\\n                    )} ${cell.dateStr === today ? \'ring-2 ring-[#C25E00]\' : \'\'}`}\\n                  >\\n                    <span>{cell.day}</span>\\n                  </div>\\n                );\\n              })}\\n            </div>\\n\\n            <div className=\\\"mt-4 flex flex-wrap items-center gap-4 text-xs text-stone-600 dark:text-stone-400\\\">\\n              <span className=\\\"inline-flex items-center gap-1.5\\\">\\n                <span className=\\\"w-3 h-3 rounded bg-emerald-200 dark:bg-emerald-900 border border-emerald-400\\\" />\\n                {t(\'common.present\')}\\n              </span>\\n              <span className=\\\"inline-flex items-center gap-1.5\\\">\\n                <span className=\\\"w-3 h-3 rounded bg-red-200 dark:bg-red-900 border border-red-400\\\" />\\n                {t(\'common.absent\')}\\n              </span>\\n              <span className=\\\"inline-flex items-center gap-1.5\\\">\\n                <span className=\\\"w-3 h-3 rounded bg-sky-200 dark:bg-sky-900 border border-sky-400\\\" />\\n                {t(\'common.leave\')}\\n              </span>\\n            </div>\\n          </section>\\n        </div>\\n\\n        {/* Attendance History + Leave History + Notices */}\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6\\\">\\n          <section className=\\\"lg:col-span-7 rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5 sm:p-6\\\">\\n            <h3 className=\\\"text-base font-semibold text-stone-900 dark:text-stone-100 mb-4\\\">\\n              {t(\'dashboard.recentHistory\')}\\n            </h3>\\n            {loading ? (\\n              <CardSkeleton rows={4} />\\n            ) : records.length === 0 ? (\\n              <p className=\\\"text-sm text-stone-500 py-4\\\">{t(\'common.noData\')}</p>\\n            ) : (\\n              <div className=\\\"divide-y divide-stone-100 dark:divide-stone-800\\\">\\n                {records.slice(0, 14).map((r) => (\\n                  <div key={r.id} className=\\\"py-3 flex items-center justify-between gap-3 text-sm\\\">\\n                    <div className=\\\"min-w-0\\\">\\n                      <p className=\\\"font-medium text-stone-900 dark:text-stone-100 truncate\\\">\\n                        {r.subjectName ? `${r.subjectName} \302\267 ` : \'\'}\\n                        {formatDate(r.date)}\\n                      </p>\\n                      <p className=\\\"text-xs text-stone-500 truncate\\\">\\n                        {t(`common.${r.method}`)}\\n                        {r.teacherName ? ` \302\267 ${r.teacherName}` : \'\'}\\n                        {r.note ? ` \302\267 ${r.note}` : \'\'}\\n                      </p>\\n                    </div>\\n                    <span\\n                      className={`text-xs font-semibold shrink-0 uppercase ${\\n                        r.status === \'present\'\\n                          ? \'text-emerald-700 dark:text-emerald-400\'\\n                          : r.status === \'absent\'\\n                          ? \'text-red-700 dark:text-red-400\'\\n                          : \'text-sky-700 dark:text-sky-400\'\\n                      }`}\\n                    >\\n                      {t(`common.${r.status}`)}\\n                    </span>\\n                  </div>\\n                ))}\\n              </div>\\n            )}\\n          </section>\\n\\n          <div className=\\\"lg:col-span-5 space-y-6\\\">\\n            <section className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5 sm:p-6\\\">\\n              <div className=\\\"flex items-center justify-between mb-3\\\">\\n                <h3 className=\\\"text-base font-semibold text-stone-900 dark:text-stone-100\\\">\\n                  {t(\'leaves.myRequests\')}\\n                </h3>\\n                <Link to=\\\"/leaves\\\" className=\\\"text-xs font-medium text-[#C25E00] hover:underline\\\">\\n                  {t(\'dashboard.viewAll\')}\\n                </Link>\\n              </div>\\n              {leaves.length === 0 ? (\\n                <p className=\\\"text-sm text-stone-500\\\">{t(\'leaves.empty\')}</p>\\n              ) : (\\n                <div className=\\\"divide-y divide-stone-100 dark:divide-stone-800\\\">\\n                  {leaves.map((l) => (\\n                    <div key={l.id} className=\\\"py-2.5 flex items-center justify-between gap-2 text-xs\\\">\\n                      <div className=\\\"min-w-0\\\">\\n                        <p className=\\\"font-medium text-stone-800 dark:text-stone-200 truncate\\\">\\n                          {formatDate(l.fromDate)} \342\200\223 {formatDate(l.toDate)}\\n                        </p>\\n                        <p className=\\\"text-stone-500 truncate mt-0.5\\\">{l.reason}</p>\\n                      </div>\\n                      <span\\n                        className={`font-semibold uppercase shrink-0 ${\\n                          l.status === \'approved\'\\n                            ? \'text-emerald-700 dark:text-emerald-400\'\\n                            : l.status === \'rejected\'\\n                            ? \'text-red-700 dark:text-red-400\'\\n                            : \'text-amber-700 dark:text-amber-400\'\\n                        }`}\\n                      >\\n                        {t(`leaves.${l.status}`)}\\n                      </span>\\n                    </div>\\n                  ))}\\n                </div>\\n              )}\\n            </section>\\n\\n            <section className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5 sm:p-6\\\">\\n              <div className=\\\"flex items-center justify-between mb-3\\\">\\n                <h3 className=\\\"text-base font-semibold text-stone-900 dark:text-stone-100\\\">\\n                  {t(\'dashboard.recentAnnouncements\')}\\n                </h3>\\n                <Link to=\\\"/announcements\\\" className=\\\"text-xs font-medium text-[#C25E00] hover:underline\\\">\\n                  {t(\'dashboard.viewAll\')}\\n                </Link>\\n              </div>\\n              {announcements.length === 0 ? (\\n                <p className=\\\"text-sm text-stone-500\\\">{t(\'dashboard.noAnnouncements\')}</p>\\n              ) : (\\n                <div className=\\\"space-y-3\\\">\\n                  {announcements.map((a) => (\\n                    <div\\n                      key={a.id}\\n                      className=\\\"pb-3 border-b last:border-b-0 border-stone-100 dark:border-stone-800\\\"\\n                    >\\n                      <p className=\\\"text-sm text-stone-800 dark:text-stone-200\\\">{a.text}</p>\\n                      <p className=\\\"mt-1 text-xs text-stone-400\\\">{a.fromName}</p>\\n                    </div>\\n                  ))}\\n                </div>\\n              )}\\n            </section>\\n          </div>\\n        </div>\\n      </div>\\n\\n      {showQrModal && profile && org && (\\n        <QRCardModal\\n          person={profile}\\n          org={org}\\n          roleLabel={memberLabel}\\n          onClose={() => setShowQrModal(false)}\\n        />\\n      )}\\n    </Layout>\\n  );\\n};\\n\", \"Description\":\"Upgrade MemberDashboard into full Student Performance Dashboard with real-time live sessions, today\'s lectures, subject-wise %, 75% shortage warning, Digital ID card, and zero LATE\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/MemberDashboard.tsx\", \"toolAction\":\"Updating MemberDashboard.tsx\", \"toolSummary\":\"Update MemberDashboard.tsx\"}"
      original_name: "write_to_file"
