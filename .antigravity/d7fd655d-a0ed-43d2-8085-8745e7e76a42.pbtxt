              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  - Dedicated camera **QR Scanner** with scanning frame overlay (mobile back/front camera + desktop webcam fallback) and **Enter ID** (6-char own ID + 6-digit live code) tab."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
