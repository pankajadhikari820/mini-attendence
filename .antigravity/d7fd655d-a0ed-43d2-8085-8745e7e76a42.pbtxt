      arguments_json: "{\"CodeContent\":\"import React, { useCallback, useEffect, useMemo, useRef, useState } from \'react\';\\nimport { Link } from \'react-router-dom\';\\nimport { QRCodeSVG } from \'qrcode.react\';\\nimport {\\n  AlertTriangle,\\n  Clock,\\n  Crosshair,\\n  Maximize2,\\n  Minimize2,\\n  Play,\\n  PlusCircle,\\n  Square,\\n  Users,\\n  Wrench,\\n} from \'lucide-react\';\\nimport { useAuth } from \'../context/AuthContext\';\\nimport { useTranslation } from \'../hooks/useTranslation\';\\nimport { useToast } from \'../context/ToastContext\';\\nimport type {\\n  AttendanceAttempt,\\n  AttendanceRecord,\\n  AttendanceSession,\\n} from \'../types\';\\nimport {\\n  closeAttendanceSession,\\n  extendAttendanceSession,\\n  fetchOpenSessionByOwner,\\n  rotateSessionSecret,\\n  startAttendanceSession,\\n  subscribeSession,\\n  subscribeSessionAttendance,\\n  subscribeSessionAttempts,\\n} from \'../services/sessionService\';\\nimport { fetchManagerMembers, fetchOrgUsers } from \'../services/userService\';\\nimport { getCurrentPosition, getFirebaseErrorKey } from \'../utils/helpers\';\\nimport { Layout } from \'../components/Layout\';\\nimport { LocationPickerMap } from \'../components/LocationPickerMap\';\\n\\nconst DURATIONS = [15, 30, 60, 120];\\nconst ROTATION_SECONDS = 10;\\n\\ninterface WakeLockSentinelLike {\\n  release: () => Promise<void>;\\n}\\n\\nexport const StartAttendancePage: React.FC = () => {\\n  const { profile, org, getRoleLabel } = useAuth();\\n  const { t, formatNumber, formatTime } = useTranslation();\\n  const { showToast } = useToast();\\n\\n  // Setup state\\n  const [title, setTitle] = useState(\'\');\\n  const [duration, setDuration] = useState<number>(org?.defaultSessionDuration ?? 30);\\n  const [radius, setRadius] = useState<number>(\\n    Math.max(20, Math.min(500, org?.location?.radius ?? 50))\\n  );\\n  const [lat, setLat] = useState<number>(org?.location?.lat || 28.6139);\\n  const [lng, setLng] = useState<number>(org?.location?.lng || 77.209);\\n  const [gpsAccuracy, setGpsAccuracy] = useState<number | null>(null);\\n  const [locating, setLocating] = useState(false);\\n  const [gpsError, setGpsError] = useState(\'\');\\n  const [starting, setStarting] = useState(false);\\n\\n  // Active live session state\\n  const [activeSession, setActiveSession] = useState<AttendanceSession | null>(null);\\n  const [currentToken, setCurrentToken] = useState(\'\');\\n  const [currentCode, setCurrentCode] = useState(\'\');\\n  const [secondsLeft, setSecondsLeft] = useState(ROTATION_SECONDS);\\n  const [sessionRemainingSec, setSessionRemainingSec] = useState(0);\\n  const [markedRecords, setMarkedRecords] = useState<AttendanceRecord[]>([]);\\n  const [attempts, setAttempts] = useState<AttendanceAttempt[]>([]);\\n  const [totalExpected, setTotalExpected] = useState(0);\\n  const [isFullscreen, setIsFullscreen] = useState(false);\\n  const [wakeLockOn, setWakeLockOn] = useState(false);\\n\\n  const tokenRef = useRef(\'\');\\n  const codeRef = useRef(\'\');\\n  const projectorRef = useRef<HTMLDivElement | null>(null);\\n  const wakeLockRef = useRef<WakeLockSentinelLike | null>(null);\\n\\n  const targetRoleLabel =\\n    profile?.role === \'admin\' ? getRoleLabel(\'manager\') : getRoleLabel(\'member\');\\n\\n  // Sync org defaults when loaded\\n  useEffect(() => {\\n    if (!org) return;\\n    setDuration(org.defaultSessionDuration ?? 30);\\n    setRadius(Math.max(20, Math.min(500, org.location?.radius ?? 50)));\\n  }, [org]);\\n\\n  // Read high-accuracy GPS\\n  const refreshGPS = useCallback(async () => {\\n    setLocating(true);\\n    setGpsError(\'\');\\n    try {\\n      const reading = await getCurrentPosition();\\n      setLat(Number(reading.lat.toFixed(6)));\\n      setLng(Number(reading.lng.toFixed(6)));\\n      setGpsAccuracy(reading.accuracy);\\n    } catch {\\n      setGpsError(t(\'session.gpsError\'));\\n    } finally {\\n      setLocating(false);\\n    }\\n  }, [t]);\\n\\n  // On mount: check for an already open session, count expected subordinates, and read GPS\\n  useEffect(() => {\\n    if (!org || !profile) return;\\n    let mounted = true;\\n\\n    const init = async () => {\\n      try {\\n        const [existing, people] = await Promise.all([\\n          fetchOpenSessionByOwner(org.id, profile.uid),\\n          profile.role === \'admin\'\\n            ? fetchOrgUsers(org.id, \'manager\')\\n            : fetchManagerMembers(org.id, profile.uid),\\n        ]);\\n        if (!mounted) return;\\n        setTotalExpected(people.filter((p) => p.status === \'active\').length);\\n\\n        if (existing) {\\n          // Immediately rotate token so our client has the live secret in memory\\n          const fresh = await rotateSessionSecret({\\n            sessionId: existing.id,\\n            prevToken: \'\',\\n            prevCode: \'\',\\n          });\\n          if (!mounted) return;\\n          tokenRef.current = fresh.token;\\n          codeRef.current = fresh.code;\\n          setCurrentToken(fresh.token);\\n          setCurrentCode(fresh.code);\\n          setSecondsLeft(ROTATION_SECONDS);\\n          setActiveSession(existing);\\n        } else {\\n          refreshGPS();\\n        }\\n      } catch {\\n        refreshGPS();\\n      }\\n    };\\n\\n    init();\\n    return () => {\\n      mounted = false;\\n    };\\n  }, [org, profile, refreshGPS]);\\n\\n  // Subscribe to session doc, attendance list, and rejected attempts while active\\n  useEffect(() => {\\n    if (!activeSession || !org) return;\\n    const unsubSess = subscribeSession(activeSession.id, (s) => {\\n      if (!s || s.status === \'closed\') {\\n        setActiveSession(null);\\n      } else {\\n        setActiveSession(s);\\n      }\\n    });\\n    const unsubAtt = subscribeSessionAttendance(org.id, activeSession.id, setMarkedRecords);\\n    const unsubAttempts = subscribeSessionAttempts(org.id, activeSession.id, setAttempts);\\n\\n    return () => {\\n      unsubSess();\\n      unsubAtt();\\n      unsubAttempts();\\n    };\\n  }, [activeSession?.id, org]);\\n\\n  // Screen Wake Lock API while a session is live\\n  useEffect(() => {\\n    if (!activeSession) return;\\n    let released = false;\\n\\n    const requestWakeLock = async () => {\\n      try {\\n        const nav = navigator as unknown as {\\n          wakeLock?: { request: (type: \'screen\') => Promise<WakeLockSentinelLike> };\\n        };\\n        if (nav.wakeLock && !released) {\\n          wakeLockRef.current = await nav.wakeLock.request(\'screen\');\\n          setWakeLockOn(true);\\n        }\\n      } catch {\\n        setWakeLockOn(false);\\n      }\\n    };\\n\\n    requestWakeLock();\\n\\n    const handleVis = () => {\\n      if (document.visibilityState === \'visible\') {\\n        requestWakeLock();\\n      }\\n    };\\n    document.addEventListener(\'visibilitychange\', handleVis);\\n\\n    return () => {\\n      released = true;\\n      document.removeEventListener(\'visibilitychange\', handleVis);\\n      wakeLockRef.current?.release().catch(() => {});\\n      wakeLockRef.current = null;\\n      setWakeLockOn(false);\\n    };\\n  }, [activeSession?.id]);\\n\\n  // 10-second QR & 6-digit code rotation timer + session countdown\\n  useEffect(() => {\\n    if (!activeSession) return;\\n\\n    let tick = ROTATION_SECONDS;\\n    setSecondsLeft(ROTATION_SECONDS);\\n\\n    const interval = window.setInterval(async () => {\\n      // Update remaining session duration\\n      const endMs = activeSession.endsAt?.toMillis?.() ?? 0;\\n      const rem = Math.max(0, Math.floor((endMs - Date.now()) / 1000));\\n      setSessionRemainingSec(rem);\\n\\n      if (endMs > 0 && rem <= 0) {\\n        window.clearInterval(interval);\\n        try {\\n          await closeAttendanceSession(activeSession.id);\\n        } catch {\\n          // Ignore\\n        }\\n        setActiveSession(null);\\n        return;\\n      }\\n\\n      tick -= 1;\\n      if (tick <= 0) {\\n        tick = ROTATION_SECONDS;\\n        setSecondsLeft(ROTATION_SECONDS);\\n        try {\\n          const next = await rotateSessionSecret({\\n            sessionId: activeSession.id,\\n            prevToken: tokenRef.current,\\n            prevCode: codeRef.current,\\n          });\\n          tokenRef.current = next.token;\\n          codeRef.current = next.code;\\n          setCurrentToken(next.token);\\n          setCurrentCode(next.code);\\n        } catch {\\n          // Will retry on next cycle\\n        }\\n      } else {\\n        setSecondsLeft(tick);\\n      }\\n    }, 1000);\\n\\n    return () => window.clearInterval(interval);\\n  }, [activeSession?.id, activeSession?.endsAt]);\\n\\n  // Fullscreen listener\\n  useEffect(() => {\\n    const onFsChange = () => setIsFullscreen(!!document.fullscreenElement);\\n    document.addEventListener(\'fullscreenchange\', onFsChange);\\n    return () => document.removeEventListener(\'fullscreenchange\', onFsChange);\\n  }, []);\\n\\n  const toggleFullscreen = async () => {\\n    try {\\n      if (!document.fullscreenElement) {\\n        await (projectorRef.current || document.documentElement).requestFullscreen();\\n      } else {\\n        await document.exitFullscreen();\\n      }\\n    } catch {\\n      // Ignore fullscreen denial\\n    }\\n  };\\n\\n  const handleStartSession = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    if (!org || !profile) return;\\n    setStarting(true);\\n    try {\\n      const { session, token, code } = await startAttendanceSession({\\n        org,\\n        owner: profile,\\n        title,\\n        durationMinutes: duration,\\n        lat,\\n        lng,\\n        radius,\\n      });\\n      tokenRef.current = token;\\n      codeRef.current = code;\\n      setCurrentToken(token);\\n      setCurrentCode(code);\\n      setSecondsLeft(ROTATION_SECONDS);\\n      setSessionRemainingSec(duration * 60);\\n      setActiveSession(session);\\n    } catch (err) {\\n      showToast(t(getFirebaseErrorKey(err)), \'error\');\\n    } finally {\\n      setStarting(false);\\n    }\\n  };\\n\\n  const handleExtend = async () => {\\n    if (!activeSession) return;\\n    try {\\n      const nextEnds = await extendAttendanceSession(activeSession.id, activeSession.endsAt, 10);\\n      setActiveSession((prev) => (prev ? { ...prev, endsAt: nextEnds } : prev));\\n      showToast(t(\'session.extendedToast\'), \'success\');\\n    } catch (err) {\\n      showToast(t(getFirebaseErrorKey(err)), \'error\');\\n    }\\n  };\\n\\n  const handleClose = async () => {\\n    if (!activeSession) return;\\n    try {\\n      if (document.fullscreenElement) {\\n        await document.exitFullscreen().catch(() => {});\\n      }\\n      await closeAttendanceSession(activeSession.id);\\n      setActiveSession(null);\\n      showToast(t(\'session.closedToast\'), \'info\');\\n    } catch (err) {\\n      showToast(t(getFirebaseErrorKey(err)), \'error\');\\n    }\\n  };\\n\\n  const qrPayload = useMemo(() => {\\n    if (!activeSession || !currentToken) return \'\';\\n    return JSON.stringify({ s: activeSession.id, t: currentToken });\\n  }, [activeSession, currentToken]);\\n\\n  const formattedRemaining = useMemo(() => {\\n    const mins = Math.floor(sessionRemainingSec / 60);\\n    const secs = sessionRemainingSec % 60;\\n    return `${String(mins).padStart(2, \'0\')}:${String(secs).padStart(2, \'0\')}`;\\n  }, [sessionRemainingSec]);\\n\\n  // Countdown ring SVG math\\n  const ringRadius = 158;\\n  const ringCircumference = 2 * Math.PI * ringRadius;\\n  const ringOffset = ringCircumference * (1 - secondsLeft / ROTATION_SECONDS);\\n\\n  const attemptReasonLabel = (reason: string) => {\\n    if (reason === \'outside_radius\') return t(\'mark.reasonOutside\');\\n    if (reason === \'device_already_used\') return t(\'mark.reasonDevice\');\\n    return t(\'mark.reasonExpired\');\\n  };\\n\\n  // LIVE PROJECTOR SCREEN\\n  if (activeSession) {\\n    return (\\n      <Layout title={t(\'session.projectorMode\')}>\\n        <div\\n          ref={projectorRef}\\n          className={`${\\n            isFullscreen\\n              ? \'min-h-screen bg-[#FAF9F6] dark:bg-[#0F0F11] p-6 sm:p-10 overflow-y-auto\'\\n              : \'\'\\n          } space-y-6`}\\n        >\\n          {/* Top Bar */}\\n          <div className=\\\"flex flex-wrap items-center justify-between gap-4\\\">\\n            <div>\\n              <h2 className=\\\"text-2xl font-bold tracking-tight text-stone-900 dark:text-stone-50\\\">\\n                {activeSession.title || t(\'session.startTitle\')}\\n              </h2>\\n              <p className=\\\"mt-1 text-xs text-stone-500 dark:text-stone-400 flex flex-wrap items-center gap-2 tabular-nums\\\">\\n                <span>{targetRoleLabel}</span>\\n                <span>\302\267</span>\\n                <span>\\n                  {t(\'session.endsIn\')}: <strong>{formattedRemaining}</strong>\\n                </span>\\n                <span>\302\267</span>\\n                <span>\\n                  {t(\'session.radiusLabel\')}: {activeSession.location.radius} {t(\'common.meters\')}\\n                </span>\\n                {wakeLockOn && (\\n                  <>\\n                    <span>\302\267</span>\\n                    <span>{t(\'session.wakeLockActive\')}</span>\\n                  </>\\n                )}\\n              </p>\\n            </div>\\n\\n            <div className=\\\"flex flex-wrap items-center gap-2\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={toggleFullscreen}\\n                className=\\\"inline-flex items-center gap-1.5 rounded-xl border border-stone-300 dark:border-stone-700 bg-white dark:bg-[#161619] hover:bg-stone-50 dark:hover:bg-stone-800 px-3.5 py-2 text-xs font-medium\\\"\\n              >\\n                {isFullscreen ? (\\n                  <Minimize2 className=\\\"w-4 h-4\\\" />\\n                ) : (\\n                  <Maximize2 className=\\\"w-4 h-4\\\" />\\n                )}\\n                <span>{isFullscreen ? t(\'session.exitFullscreen\') : t(\'session.fullscreen\')}</span>\\n              </button>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={handleExtend}\\n                className=\\\"inline-flex items-center gap-1.5 rounded-xl border border-stone-300 dark:border-stone-700 bg-white dark:bg-[#161619] hover:bg-stone-50 dark:hover:bg-stone-800 px-3.5 py-2 text-xs font-medium\\\"\\n              >\\n                <PlusCircle className=\\\"w-4 h-4 text-[#C25E00]\\\" />\\n                <span>{t(\'session.extendBtn\')}</span>\\n              </button>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={handleClose}\\n                className=\\\"inline-flex items-center gap-1.5 rounded-xl bg-red-600 hover:bg-red-700 text-white px-4 py-2 text-xs font-medium\\\"\\n              >\\n                <Square className=\\\"w-3.5 h-3.5 fill-current\\\" />\\n                <span>{t(\'session.closeBtn\')}</span>\\n              </button>\\n            </div>\\n          </div>\\n\\n          <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-start\\\">\\n            {/* Projector QR + 6-digit Live Code */}\\n            <div className=\\\"lg:col-span-7 rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-6 sm:p-10 flex flex-col items-center text-center\\\">\\n              <div className=\\\"relative flex items-center justify-center\\\">\\n                <svg\\n                  width=\\\"340\\\"\\n                  height=\\\"340\\\"\\n                  viewBox=\\\"0 0 340 340\\\"\\n                  className=\\\"-rotate-90 w-[280px] h-[280px] sm:w-[340px] sm:h-[340px]\\\"\\n                  aria-hidden=\\\"true\\\"\\n                >\\n                  <circle\\n                    cx=\\\"170\\\"\\n                    cy=\\\"170\\\"\\n                    r={ringRadius}\\n                    fill=\\\"none\\\"\\n                    stroke=\\\"currentColor\\\"\\n                    strokeWidth=\\\"6\\\"\\n                    className=\\\"text-stone-200 dark:text-stone-800\\\"\\n                  />\\n                  <circle\\n                    cx=\\\"170\\\"\\n                    cy=\\\"170\\\"\\n                    r={ringRadius}\\n                    fill=\\\"none\\\"\\n                    stroke=\\\"#C25E00\\\"\\n                    strokeWidth=\\\"6\\\"\\n                    strokeLinecap=\\\"round\\\"\\n                    strokeDasharray={ringCircumference}\\n                    strokeDashoffset={ringOffset}\\n                    style={{ transition: \'stroke-dashoffset 0.9s linear\' }}\\n                  />\\n                </svg>\\n\\n                <div className=\\\"absolute inset-0 flex items-center justify-center\\\">\\n                  <div className=\\\"rounded-2xl bg-white p-4 sm:p-5 border border-stone-200 shadow-xs\\\">\\n                    {qrPayload && (\\n                      <QRCodeSVG\\n                        value={qrPayload}\\n                        size={isFullscreen ? 230 : 200}\\n                        level=\\\"M\\\"\\n                        fgColor=\\\"#1C1917\\\"\\n                        bgColor=\\\"#FFFFFF\\\"\\n                      />\\n                    )}\\n                  </div>\\n                </div>\\n              </div>\\n\\n              <p className=\\\"mt-4 text-xs text-stone-500 dark:text-stone-400 tabular-nums\\\">\\n                {t(\'session.rotatesIn\')}{\' \'}\\n                <strong className=\\\"text-stone-900 dark:text-stone-100\\\">\\n                  {secondsLeft}\\n                  {t(\'session.seconds\')}\\n                </strong>\\n              </p>\\n\\n              {/* 6-digit Live Code */}\\n              <div className=\\\"mt-6 w-full max-w-sm rounded-2xl border border-stone-200 dark:border-stone-800 bg-[#FAF9F6] dark:bg-stone-900/70 px-6 py-5\\\">\\n                <p className=\\\"text-xs font-medium text-stone-500 dark:text-stone-400\\\">\\n                  {t(\'session.liveCodeLabel\')}\\n                </p>\\n                <p className=\\\"mt-2 font-mono text-4xl sm:text-5xl font-bold tracking-[0.22em] text-stone-900 dark:text-stone-50 tabular-nums\\\">\\n                  {currentCode ? `${currentCode.slice(0, 3)} ${currentCode.slice(3)}` : \'--- ---\'}\\n                </p>\\n              </div>\\n            </div>\\n\\n            {/* Live Counter + Marked List + Rejected Attempts */}\\n            <div className=\\\"lg:col-span-5 space-y-5\\\">\\n              {/* Counter Card */}\\n              <div className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5 flex items-center justify-between\\\">\\n                <div className=\\\"flex items-center gap-3\\\">\\n                  <Users className=\\\"w-5 h-5 text-[#C25E00]\\\" />\\n                  <span className=\\\"text-sm font-medium text-stone-600 dark:text-stone-400\\\">\\n                    {t(\'session.markedCounter\')}\\n                  </span>\\n                </div>\\n                <p className=\\\"text-2xl font-bold tabular-nums text-stone-900 dark:text-stone-50\\\">\\n                  {formatNumber(markedRecords.length)}\\n                  <span className=\\\"text-base font-normal text-stone-400\\\">\\n                    {\' \'}\\n                    / {formatNumber(totalExpected)}\\n                  </span>\\n                </p>\\n              </div>\\n\\n              {/* Marked Names Live Feed */}\\n              <section className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5\\\">\\n                <h3 className=\\\"text-sm font-semibold text-stone-900 dark:text-stone-100 mb-3\\\">\\n                  {t(\'session.markedListTitle\')} ({formatNumber(markedRecords.length)})\\n                </h3>\\n                {markedRecords.length === 0 ? (\\n                  <p className=\\\"text-xs text-stone-500 dark:text-stone-400 py-6 text-center\\\">\\n                    {t(\'session.noMarkedYet\')}\\n                  </p>\\n                ) : (\\n                  <div className=\\\"max-h-72 overflow-y-auto divide-y divide-stone-100 dark:divide-stone-800\\\">\\n                    {markedRecords.map((rec) => (\\n                      <div\\n                        key={rec.id}\\n                        className=\\\"py-2.5 flex items-center justify-between gap-2 text-sm\\\"\\n                      >\\n                        <div className=\\\"min-w-0\\\">\\n                          <p className=\\\"font-medium text-stone-900 dark:text-stone-100 truncate\\\">\\n                            {rec.personName}\\n                          </p>\\n                          <p className=\\\"text-xs font-mono text-stone-500 tabular-nums\\\">\\n                            {rec.personMemberId}\\n                            {rec.distanceMeters !== undefined ? ` \302\267 ${rec.distanceMeters}m` : \'\'}\\n                            {rec.timestamp ? ` \302\267 ${formatTime(rec.timestamp.toDate())}` : \'\'}\\n                          </p>\\n                        </div>\\n                        <span\\n                          className={`text-xs font-semibold shrink-0 ${\\n                            rec.status === \'late\'\\n                              ? \'text-amber-700 dark:text-amber-400\'\\n                              : \'text-emerald-700 dark:text-emerald-400\'\\n                          }`}\\n                        >\\n                          {t(`common.${rec.status}`)}\\n                        </span>\\n                      </div>\\n                    ))}\\n                  </div>\\n                )}\\n              </section>\\n\\n              {/* Rejected Attempts List */}\\n              <section className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5\\\">\\n                <div className=\\\"flex items-center justify-between mb-3\\\">\\n                  <h3 className=\\\"text-sm font-semibold text-stone-900 dark:text-stone-100 flex items-center gap-2\\\">\\n                    <AlertTriangle className=\\\"w-4 h-4 text-amber-600\\\" />\\n                    <span>\\n                      {t(\'session.rejectedTitle\')} ({formatNumber(attempts.length)})\\n                    </span>\\n                  </h3>\\n                </div>\\n                {attempts.length === 0 ? (\\n                  <p className=\\\"text-xs text-stone-500 dark:text-stone-400 py-3\\\">\\n                    {t(\'session.noRejectedYet\')}\\n                  </p>\\n                ) : (\\n                  <div className=\\\"max-h-52 overflow-y-auto divide-y divide-stone-100 dark:divide-stone-800\\\">\\n                    {attempts.map((a) => (\\n                      <div key={a.id} className=\\\"py-2.5 text-xs\\\">\\n                        <div className=\\\"flex items-center justify-between gap-2\\\">\\n                          <span className=\\\"font-medium text-stone-900 dark:text-stone-100\\\">\\n                            {a.personName} ({a.personId || \'\342\200\224\'})\\n                          </span>\\n                          <span className=\\\"text-stone-400 tabular-nums\\\">\\n                            {formatTime(a.time?.toDate?.())}\\n                          </span>\\n                        </div>\\n                        <p className=\\\"mt-0.5 text-red-700 dark:text-red-400\\\">\\n                          {attemptReasonLabel(a.reason)}\\n                          {a.distance !== null && a.distance !== undefined\\n                            ? ` \302\267 ${a.distance} ${t(\'common.meters\')} ${t(\'session.awayLabel\')}`\\n                            : \'\'}\\n                        </p>\\n                      </div>\\n                    ))}\\n                  </div>\\n                )}\\n              </section>\\n            </div>\\n          </div>\\n        </div>\\n      </Layout>\\n    );\\n  }\\n\\n  // SESSION SETUP FORM\\n  return (\\n    <Layout title={t(\'session.startTitle\')}>\\n      <div className=\\\"max-w-3xl space-y-6\\\">\\n        <div className=\\\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\\\">\\n          <div>\\n            <h2 className=\\\"text-2xl font-bold tracking-tight text-stone-900 dark:text-stone-50\\\">\\n              {t(\'session.startTitle\')}\\n            </h2>\\n            <p className=\\\"mt-1 text-sm text-stone-500 dark:text-stone-400\\\">\\n              {t(\'session.startSubtitle\')}\\n            </p>\\n          </div>\\n\\n          <Link\\n            to=\\\"/attendance/manual\\\"\\n            className=\\\"inline-flex items-center gap-2 rounded-xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] hover:bg-stone-50 dark:hover:bg-stone-800 px-3.5 py-2 text-xs font-medium text-stone-700 dark:text-stone-300 whitespace-nowrap self-start\\\"\\n          >\\n            <Wrench className=\\\"w-3.5 h-3.5 text-amber-600\\\" />\\n            <span>{t(\'session.openBackupLink\')}</span>\\n          </Link>\\n        </div>\\n\\n        <form\\n          onSubmit={handleStartSession}\\n          className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5 sm:p-7 space-y-6\\\"\\n        >\\n          {/* Title */}\\n          <div>\\n            <label className=\\\"block text-sm font-medium text-stone-700 dark:text-stone-300 mb-1.5\\\">\\n              {t(\'session.sessionTitleLabel\')}\\n            </label>\\n            <input\\n              type=\\\"text\\\"\\n              value={title}\\n              onChange={(e) => setTitle(e.target.value)}\\n              placeholder={t(\'session.sessionTitlePlaceholder\')}\\n              className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-transparent px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#C25E00]/30 focus:border-[#C25E00]\\\"\\n            />\\n          </div>\\n\\n          {/* Duration & Radius */}\\n          <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-6\\\">\\n            <div>\\n              <label className=\\\"block text-sm font-medium text-stone-700 dark:text-stone-300 mb-2\\\">\\n                {t(\'session.durationLabel\')}\\n              </label>\\n              <div className=\\\"grid grid-cols-4 gap-2\\\">\\n                {DURATIONS.map((mins) => (\\n                  <button\\n                    key={mins}\\n                    type=\\\"button\\\"\\n                    onClick={() => setDuration(mins)}\\n                    className={`py-2.5 rounded-xl border text-xs font-medium tabular-nums transition-colors ${\\n                      duration === mins\\n                        ? \'border-[#C25E00] bg-amber-50/70 dark:bg-amber-950/30 text-[#C25E00]\'\\n                        : \'border-stone-200 dark:border-stone-800 text-stone-600 dark:text-stone-400 hover:bg-stone-50 dark:hover:bg-stone-800\'\\n                    }`}\\n                  >\\n                    {mins} {t(\'common.minutes\')}\\n                  </button>\\n                ))}\\n              </div>\\n            </div>\\n\\n            <div>\\n              <div className=\\\"flex items-center justify-between mb-2\\\">\\n                <label className=\\\"text-sm font-medium text-stone-700 dark:text-stone-300\\\">\\n                  {t(\'session.radiusLabel\')}\\n                </label>\\n                <span className=\\\"font-mono text-sm font-semibold text-[#C25E00] tabular-nums\\\">\\n                  {radius} {t(\'common.meters\')}\\n                </span>\\n              </div>\\n              <input\\n                type=\\\"range\\\"\\n                min={20}\\n                max={500}\\n                step={5}\\n                value={radius}\\n                onChange={(e) => setRadius(Number(e.target.value))}\\n                className=\\\"w-full accent-[#C25E00] cursor-pointer\\\"\\n              />\\n              <div className=\\\"mt-1 flex justify-between text-[11px] text-stone-400 tabular-nums\\\">\\n                <span>20 {t(\'common.meters\')}</span>\\n                <span>250 {t(\'common.meters\')}</span>\\n                <span>500 {t(\'common.meters\')}</span>\\n              </div>\\n            </div>\\n          </div>\\n\\n          {/* Interactive Leaflet Map */}\\n          <div className=\\\"space-y-3\\\">\\n            <div className=\\\"flex flex-wrap items-center justify-between gap-2\\\">\\n              <div>\\n                <label className=\\\"block text-sm font-medium text-stone-700 dark:text-stone-300\\\">\\n                  {t(\'session.locationLabel\')}\\n                </label>\\n                <p className=\\\"text-xs text-stone-500 dark:text-stone-400 mt-0.5\\\">\\n                  {t(\'session.locationHint\')}\\n                </p>\\n              </div>\\n              <button\\n                type=\\\"button\\\"\\n                disabled={locating}\\n                onClick={refreshGPS}\\n                className=\\\"inline-flex items-center gap-1.5 rounded-xl border border-stone-300 dark:border-stone-700 hover:bg-stone-50 dark:hover:bg-stone-800 px-3 py-1.5 text-xs font-medium\\\"\\n              >\\n                <Crosshair className=\\\"w-3.5 h-3.5 text-[#C25E00]\\\" />\\n                <span>{locating ? t(\'session.locatingGps\') : t(\'session.refreshGps\')}</span>\\n              </button>\\n            </div>\\n\\n            {gpsError && (\\n              <p className=\\\"text-xs text-amber-700 dark:text-amber-400\\\">{gpsError}</p>\\n            )}\\n\\n            <LocationPickerMap\\n              lat={lat}\\n              lng={lng}\\n              radius={radius}\\n              onChange={(nextLat, nextLng) => {\\n                setLat(nextLat);\\n                setLng(nextLng);\\n              }}\\n            />\\n\\n            <div className=\\\"flex flex-wrap items-center justify-between gap-2 text-xs text-stone-500 dark:text-stone-400 font-mono tabular-nums\\\">\\n              <span>\\n                {lat.toFixed(5)}, {lng.toFixed(5)}\\n              </span>\\n              {gpsAccuracy !== null && (\\n                <span>\\n                  {t(\'session.gpsReady\')}: \302\261{gpsAccuracy} {t(\'common.meters\')}\\n                </span>\\n              )}\\n            </div>\\n\\n            {org && !org.location?.enabled && (\\n              <p className=\\\"text-xs text-amber-700 dark:text-amber-400\\\">\\n                {t(\'session.locationCheckOffNote\')}\\n              </p>\\n            )}\\n          </div>\\n\\n          <div className=\\\"pt-2 flex items-center justify-between gap-4\\\">\\n            <span className=\\\"text-xs text-stone-500 dark:text-stone-400 flex items-center gap-1.5\\\">\\n              <Clock className=\\\"w-3.5 h-3.5\\\" />\\n              <span>\\n                {targetRoleLabel}: {formatNumber(totalExpected)}\\n              </span>\\n            </span>\\n\\n            <button\\n              type=\\\"submit\\\"\\n              disabled={starting}\\n              className=\\\"inline-flex items-center gap-2 rounded-xl bg-[#C25E00] hover:bg-[#A84F00] disabled:opacity-60 text-white px-6 py-3 text-sm font-medium transition-colors\\\"\\n            >\\n              <Play className=\\\"w-4 h-4 fill-current\\\" />\\n              <span>{starting ? t(\'session.starting\') : t(\'session.startBtn\')}</span>\\n            </button>\\n          </div>\\n        </form>\\n      </div>\\n    </Layout>\\n  );\\n};\\n\", \"Description\":\"Create StartAttendancePage with Leaflet draggable pin + radius setup, 10s rotating QR & 6-digit code projector mode, Wake Lock API, live marked feed, and rejected attempts log\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/StartAttendancePage.tsx\", \"toolAction\":\"Creating StartAttendancePage\", \"toolSummary\":\"Create StartAttendancePage.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_9119630132065927327"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useCallback, useEffect, useMemo, useRef, useState } from \'react\';\\nimport { useSearchParams } from \'react-router-dom\';\\nimport { Html5Qrcode } from \'html5-qrcode\';\\nimport {\\n  AlertCircle,\\n  Camera,\\n  CameraOff,\\n  CheckCircle2,\\n  Crosshair,\\n  MapPin,\\n  RefreshCw,\\n} from \'lucide-react\';\\nimport { useAuth } from \'../context/AuthContext\';\\nimport { useTranslation } from \'../hooks/useTranslation\';\\nimport type { AttendanceSession, LiveSessionQRPayload } from \'../types\';\\nimport {\\n  findActiveParentSession,\\n  submitSelfAttendance,\\n  type SelfMarkResult,\\n} from \'../services/sessionService\';\\nimport {\\n  getCurrentPosition,\\n  getFlatEarthDistanceMeters,\\n  playBeep,\\n  triggerVibration,\\n} from \'../utils/helpers\';\\nimport { Layout } from \'../components/Layout\';\\n\\nexport const MarkYourAttendancePage: React.FC = () => {\\n  const { profile, org } = useAuth();\\n  const { t, formatNumber } = useTranslation();\\n  const [searchParams, setSearchParams] = useSearchParams();\\n\\n  const initialTab = searchParams.get(\'tab\') === \'code\' ? \'code\' : \'scan\';\\n  const [tab, setTab] = useState<\'scan\' | \'code\'>(initialTab);\\n\\n  // Active parent session state\\n  const [loadingSession, setLoadingSession] = useState(true);\\n  const [session, setSession] = useState<AttendanceSession | null>(null);\\n\\n  // Step 1: GPS state\\n  const [readingGps, setReadingGps] = useState(false);\\n  const [gps, setGps] = useState<{ lat: number; lng: number; accuracy: number } | null>(null);\\n  const [gpsError, setGpsError] = useState<\'denied\' | \'low_accuracy\' | null>(null);\\n\\n  // Step 2A: QR scanner state\\n  const [cameraRunning, setCameraRunning] = useState(false);\\n  const [facingMode, setFacingMode] = useState<\'environment\' | \'user\'>(\'environment\');\\n  const [cameraError, setCameraError] = useState(\'\');\\n  const scannerRef = useRef<Html5Qrcode | null>(null);\\n  const scanBusyRef = useRef(false);\\n\\n  // Step 2B: Enter ID + Live Code state\\n  const [enteredId, setEnteredId] = useState(\'\');\\n  const [liveCode, setLiveCode] = useState(\'\');\\n\\n  // Submission & outcome state\\n  const [submitting, setSubmitting] = useState(false);\\n  const [errorMessage, setErrorMessage] = useState(\'\');\\n  const [successResult, setSuccessResult] = useState<SelfMarkResult | null>(null);\\n\\n  // Find active parent session\\n  const loadActiveSession = useCallback(async () => {\\n    if (!profile || !org) return;\\n    setLoadingSession(true);\\n    setErrorMessage(\'\');\\n    try {\\n      const active = await findActiveParentSession(profile, org);\\n      setSession(active);\\n    } catch {\\n      setSession(null);\\n    } finally {\\n      setLoadingSession(false);\\n    }\\n  }, [profile, org]);\\n\\n  // Step 1: Automatically read high-accuracy GPS\\n  const readGpsLocation = useCallback(async () => {\\n    setReadingGps(true);\\n    setGpsError(null);\\n    try {\\n      const pos = await getCurrentPosition();\\n      setGps(pos);\\n      if (pos.accuracy > 100) {\\n        setGpsError(\'low_accuracy\');\\n      }\\n    } catch {\\n      setGps(null);\\n      setGpsError(\'denied\');\\n    } finally {\\n      setReadingGps(false);\\n    }\\n  }, []);\\n\\n  useEffect(() => {\\n    loadActiveSession();\\n    readGpsLocation();\\n  }, [loadActiveSession, readGpsLocation]);\\n\\n  // Computed distance to active session\\n  const distanceMeters = useMemo(() => {\\n    if (!session || !gps) return null;\\n    return getFlatEarthDistanceMeters(\\n      gps.lat,\\n      gps.lng,\\n      session.location.lat,\\n      session.location.lng,\\n      session.location.cosLat\\n    );\\n  }, [session, gps]);\\n\\n  const locationRequired = session ? session.locationCheckEnabled : org?.location?.enabled ?? true;\\n  const locationOk = useMemo(() => {\\n    if (!locationRequired) return true;\\n    if (!gps || gpsError) return false;\\n    if (distanceMeters === null || !session) return false;\\n    return distanceMeters <= session.location.radius;\\n  }, [locationRequired, gps, gpsError, distanceMeters, session]);\\n\\n  const stopCamera = useCallback(async () => {\\n    const inst = scannerRef.current;\\n    scannerRef.current = null;\\n    if (inst) {\\n      try {\\n        if (inst.isScanning) await inst.stop();\\n        inst.clear();\\n      } catch {\\n        // Ignore\\n      }\\n    }\\n    setCameraRunning(false);\\n  }, []);\\n\\n  const handleSubmitTokenOrCode = useCallback(\\n    async (mode: \'live_qr\' | \'live_code\', value: string, scannedSessionId?: string) => {\\n      if (!org || !profile || !session) return;\\n      setErrorMessage(\'\');\\n\\n      if (scannedSessionId && scannedSessionId !== session.id) {\\n        playBeep(false);\\n        triggerVibration(false);\\n        setErrorMessage(t(\'mark.errWrongSession\'));\\n        return;\\n      }\\n\\n      if (locationRequired) {\\n        if (!gps) {\\n          setErrorMessage(t(\'mark.locationDenied\'));\\n          return;\\n        }\\n        if (gps.accuracy > 100) {\\n          setErrorMessage(t(\'mark.lowAccuracy\'));\\n          return;\\n        }\\n      }\\n\\n      setSubmitting(true);\\n      try {\\n        const res = await submitSelfAttendance({\\n          org,\\n          profile,\\n          session,\\n          method: mode,\\n          token: mode === \'live_qr\' ? value : undefined,\\n          code: mode === \'live_code\' ? value : undefined,\\n          lat: gps?.lat ?? 0,\\n          lng: gps?.lng ?? 0,\\n          accuracy: gps?.accuracy ?? 0,\\n        });\\n\\n        if (res.ok) {\\n          playBeep(true);\\n          triggerVibration(true);\\n          await stopCamera();\\n          setSuccessResult(res);\\n        } else {\\n          playBeep(false);\\n          triggerVibration(false);\\n          const key = res.errorCode === \'generic\' ? \'errors.generic\' : `mark.${res.errorCode}`;\\n          setErrorMessage(t(key));\\n        }\\n      } finally {\\n        setSubmitting(false);\\n      }\\n    },\\n    [org, profile, session, locationRequired, gps, stopCamera, t]\\n  );\\n\\n  const handleDecodedLiveQR = useCallback(\\n    async (raw: string) => {\\n      if (scanBusyRef.current) return;\\n      let parsed: LiveSessionQRPayload;\\n      try {\\n        const obj = JSON.parse(raw);\\n        if (!obj || typeof obj.s !== \'string\' || typeof obj.t !== \'string\') {\\n          setErrorMessage(t(\'attendance.invalidQr\'));\\n          return;\\n        }\\n        parsed = obj as LiveSessionQRPayload;\\n      } catch {\\n        setErrorMessage(t(\'attendance.invalidQr\'));\\n        return;\\n      }\\n\\n      scanBusyRef.current = true;\\n      await handleSubmitTokenOrCode(\'live_qr\', parsed.t, parsed.s);\\n      window.setTimeout(() => {\\n        scanBusyRef.current = false;\\n      }, 1500);\\n    },\\n    [handleSubmitTokenOrCode, t]\\n  );\\n\\n  const startCamera = useCallback(\\n    async (mode: \'environment\' | \'user\' = facingMode) => {\\n      setCameraError(\'\');\\n      await stopCamera();\\n\\n      if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {\\n        setCameraError(t(\'attendance.cameraPermissionDesc\'));\\n        return;\\n      }\\n\\n      try {\\n        const scanner = new Html5Qrcode(\'mark-qr-reader\');\\n        scannerRef.current = scanner;\\n        await scanner.start(\\n          { facingMode: mode },\\n          { fps: 10, qrbox: { width: 230, height: 230 }, aspectRatio: 1 },\\n          (text) => {\\n            handleDecodedLiveQR(text);\\n          },\\n          () => {}\\n        );\\n        setCameraRunning(true);\\n      } catch {\\n        setCameraError(t(\'attendance.cameraPermissionDesc\'));\\n        setCameraRunning(false);\\n      }\\n    },\\n    [facingMode, stopCamera, handleDecodedLiveQR, t]\\n  );\\n\\n  const handleSwitchCamera = async () => {\\n    const next = facingMode === \'environment\' ? \'user\' : \'environment\';\\n    setFacingMode(next);\\n    if (cameraRunning) await startCamera(next);\\n  };\\n\\n  useEffect(() => {\\n    if (tab !== \'scan\' && cameraRunning) {\\n      stopCamera();\\n    }\\n  }, [tab, cameraRunning, stopCamera]);\\n\\n  useEffect(() => {\\n    return () => {\\n      stopCamera();\\n    };\\n  }, [stopCamera]);\\n\\n  const handleCodeFormSubmit = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    setErrorMessage(\'\');\\n\\n    const cleanId = enteredId.trim().toUpperCase();\\n    const myId = (profile?.memberId || \'\').trim().toUpperCase();\\n    if (!cleanId || cleanId !== myId) {\\n      setErrorMessage(t(\'mark.idMismatch\'));\\n      return;\\n    }\\n\\n    const cleanCode = liveCode.replace(/\\\\s+/g, \'\');\\n    if (!/^\\\\d{6}$/.test(cleanCode)) {\\n      setErrorMessage(t(\'mark.errInvalidCode\'));\\n      return;\\n    }\\n\\n    await handleSubmitTokenOrCode(\'live_code\', cleanCode);\\n  };\\n\\n  const handleTabSwitch = (next: \'scan\' | \'code\') => {\\n    setTab(next);\\n    setErrorMessage(\'\');\\n    setSearchParams({ tab: next }, { replace: true });\\n  };\\n\\n  return (\\n    <Layout title={t(\'mark.title\')}>\\n      <div className=\\\"max-w-xl mx-auto space-y-6\\\">\\n        <div>\\n          <h2 className=\\\"text-2xl font-bold tracking-tight text-stone-900 dark:text-stone-50\\\">\\n            {t(\'mark.title\')}\\n          </h2>\\n          <p className=\\\"mt-1 text-sm text-stone-500 dark:text-stone-400\\\">\\n            {t(\'mark.subtitle\')}\\n          </p>\\n        </div>\\n\\n        {/* SUCCESS SCREEN */}\\n        {successResult ? (\\n          <div className=\\\"rounded-2xl border border-emerald-300 dark:border-emerald-800 bg-emerald-50/70 dark:bg-emerald-950/30 p-8 text-center space-y-4\\\">\\n            <div className=\\\"w-16 h-16 rounded-full bg-emerald-600 text-white mx-auto flex items-center justify-center\\\">\\n              <CheckCircle2 className=\\\"w-9 h-9\\\" />\\n            </div>\\n            <div>\\n              <h3 className=\\\"text-2xl font-bold text-emerald-900 dark:text-emerald-200\\\">\\n                {t(\'mark.successTitle\')}\\n              </h3>\\n              <p className=\\\"mt-1.5 text-base font-semibold text-stone-900 dark:text-stone-100\\\">\\n                {profile?.name} \302\267 <span className=\\\"font-mono\\\">{profile?.memberId}</span>\\n              </p>\\n            </div>\\n\\n            <div className=\\\"flex items-center justify-center gap-4 text-sm text-emerald-900/80 dark:text-emerald-300 tabular-nums pt-2\\\">\\n              <span>{t(`common.${successResult.status || \'present\'}`)}</span>\\n              <span>\302\267</span>\\n              <span>{successResult.timeStr}</span>\\n              {successResult.distanceMeters !== undefined && locationRequired && (\\n                <>\\n                  <span>\302\267</span>\\n                  <span>\\n                    {formatNumber(successResult.distanceMeters)} {t(\'common.meters\')}\\n                  </span>\\n                </>\\n              )}\\n            </div>\\n          </div>\\n        ) : loadingSession ? (\\n          <div className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-8 text-center text-sm text-stone-500\\\">\\n            {t(\'mark.findingSession\')}\\n          </div>\\n        ) : !session ? (\\n          <div className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-8 text-center space-y-3\\\">\\n            <h3 className=\\\"text-lg font-semibold text-stone-900 dark:text-stone-100\\\">\\n              {t(\'mark.noActiveSession\')}\\n            </h3>\\n            <p className=\\\"text-sm text-stone-500 dark:text-stone-400\\\">\\n              {t(\'mark.noActiveSessionHint\')}\\n            </p>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={loadActiveSession}\\n              className=\\\"mt-2 inline-flex items-center gap-2 rounded-xl bg-[#C25E00] hover:bg-[#A84F00] text-white px-5 py-2.5 text-sm font-medium\\\"\\n            >\\n              <RefreshCw className=\\\"w-4 h-4\\\" />\\n              <span>{t(\'mark.refreshSession\')}</span>\\n            </button>\\n          </div>\\n        ) : (\\n          <>\\n            {/* Active Session Header + Step 1 Location Status */}\\n            <section className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5 space-y-4\\\">\\n              <div className=\\\"flex items-center justify-between gap-2 text-xs text-stone-500 dark:text-stone-400\\\">\\n                <span className=\\\"font-medium text-stone-900 dark:text-stone-100 text-sm\\\">\\n                  {session.title || session.ownerName}\\n                </span>\\n                <span className=\\\"font-mono\\\">\\n                  {t(\'common.memberId\')}: {profile?.memberId}\\n                </span>\\n              </div>\\n\\n              {/* Step 1: GPS Distance Banner */}\\n              {!locationRequired ? (\\n                <div className=\\\"rounded-xl border border-stone-200 dark:border-stone-800 bg-stone-50 dark:bg-stone-900/50 px-4 py-3 text-xs text-stone-600 dark:text-stone-400\\\">\\n                  {t(\'mark.locationCheckDisabled\')}\\n                </div>\\n              ) : readingGps ? (\\n                <div className=\\\"rounded-xl border border-stone-200 dark:border-stone-800 bg-stone-50 dark:bg-stone-900/50 px-4 py-3 flex items-center gap-2.5 text-sm text-stone-600 dark:text-stone-300\\\">\\n                  <Crosshair className=\\\"w-4 h-4 animate-spin text-[#C25E00]\\\" />\\n                  <span>{t(\'mark.readingGps\')}</span>\\n                </div>\\n              ) : gpsError === \'low_accuracy\' ? (\\n                <div className=\\\"rounded-xl border border-amber-300 dark:border-amber-800 bg-amber-50 dark:bg-amber-950/30 px-4 py-3 flex items-start justify-between gap-3\\\">\\n                  <p className=\\\"text-xs text-amber-900 dark:text-amber-200 leading-relaxed\\\">\\n                    {t(\'mark.lowAccuracy\')} (\302\261{gps?.accuracy} {t(\'common.meters\')})\\n                  </p>\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={readGpsLocation}\\n                    className=\\\"shrink-0 rounded-lg bg-amber-700 text-white px-3 py-1.5 text-xs font-medium\\\"\\n                  >\\n                    {t(\'mark.retryGps\')}\\n                  </button>\\n                </div>\\n              ) : gpsError === \'denied\' || !gps ? (\\n                <div className=\\\"rounded-xl border border-red-200 dark:border-red-900 bg-red-50 dark:bg-red-950/30 px-4 py-3 flex items-start justify-between gap-3\\\">\\n                  <p className=\\\"text-xs text-red-800 dark:text-red-300 leading-relaxed\\\">\\n                    {t(\'mark.locationDenied\')}\\n                  </p>\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={readGpsLocation}\\n                    className=\\\"shrink-0 rounded-lg bg-red-600 text-white px-3 py-1.5 text-xs font-medium\\\"\\n                  >\\n                    {t(\'mark.retryGps\')}\\n                  </button>\\n                </div>\\n              ) : (\\n                <div\\n                  className={`rounded-xl border px-4 py-3 flex items-center justify-between gap-3 ${\\n                    locationOk\\n                      ? \'border-emerald-200 dark:border-emerald-800 bg-emerald-50/70 dark:bg-emerald-950/30 text-emerald-900 dark:text-emerald-200\'\\n                      : \'border-red-200 dark:border-red-900 bg-red-50/70 dark:bg-red-950/30 text-red-900 dark:text-red-200\'\\n                  }`}\\n                >\\n                  <div className=\\\"flex items-center gap-2.5 text-sm font-medium tabular-nums\\\">\\n                    <MapPin className=\\\"w-4 h-4 shrink-0\\\" />\\n                    <span>\\n                      {(locationOk ? t(\'mark.withinRadius\') : t(\'mark.outsideRadius\')).replace(\\n                        \'{distance}\',\\n                        formatNumber(distanceMeters ?? 0)\\n                      )}\\n                    </span>\\n                  </div>\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={readGpsLocation}\\n                    aria-label={t(\'mark.retryGps\')}\\n                    className=\\\"p-1.5 rounded-lg hover:bg-black/5 dark:hover:bg-white/10\\\"\\n                  >\\n                    <RefreshCw className=\\\"w-4 h-4\\\" />\\n                  </button>\\n                </div>\\n              )}\\n            </section>\\n\\n            {/* Step 2: Two Tabs (Scan QR | Enter ID) */}\\n            <section className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5 sm:p-6 space-y-5\\\">\\n              <div className=\\\"grid grid-cols-2 gap-1 p-1 rounded-xl bg-stone-100 dark:bg-stone-900 border border-stone-200 dark:border-stone-800\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => handleTabSwitch(\'scan\')}\\n                  className={`py-2.5 rounded-lg text-sm font-medium transition-colors ${\\n                    tab === \'scan\'\\n                      ? \'bg-white dark:bg-stone-800 text-stone-900 dark:text-stone-100 shadow-xs\'\\n                      : \'text-stone-600 dark:text-stone-400\'\\n                  }`}\\n                >\\n                  {t(\'mark.tabScanQr\')}\\n                </button>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => handleTabSwitch(\'code\')}\\n                  className={`py-2.5 rounded-lg text-sm font-medium transition-colors ${\\n                    tab === \'code\'\\n                      ? \'bg-white dark:bg-stone-800 text-stone-900 dark:text-stone-100 shadow-xs\'\\n                      : \'text-stone-600 dark:text-stone-400\'\\n                  }`}\\n                >\\n                  {t(\'mark.tabEnterId\')}\\n                </button>\\n              </div>\\n\\n              {errorMessage && (\\n                <div\\n                  role=\\\"alert\\\"\\n                  className=\\\"rounded-xl border border-red-200 dark:border-red-900 bg-red-50 dark:bg-red-950/40 px-4 py-3 flex items-start gap-2.5 text-sm text-red-800 dark:text-red-300\\\"\\n                >\\n                  <AlertCircle className=\\\"w-4 h-4 shrink-0 mt-0.5\\\" />\\n                  <span>{errorMessage}</span>\\n                </div>\\n              )}\\n\\n              {tab === \'scan\' ? (\\n                <div className=\\\"space-y-4\\\">\\n                  <div className=\\\"relative overflow-hidden rounded-xl bg-stone-950 min-h-[280px] flex items-center justify-center\\\">\\n                    <div id=\\\"mark-qr-reader\\\" className=\\\"w-full\\\" />\\n                    {!cameraRunning && (\\n                      <div className=\\\"absolute inset-0 flex flex-col items-center justify-center p-6 text-center bg-stone-100 dark:bg-stone-900\\\">\\n                        <Camera className=\\\"w-9 h-9 text-stone-400 mb-3\\\" />\\n                        <p className=\\\"text-sm text-stone-700 dark:text-stone-300 max-w-xs\\\">\\n                          {cameraError || t(\'attendance.cameraActiveHint\')}\\n                        </p>\\n                        <button\\n                          type=\\\"button\\\"\\n                          onClick={() => startCamera(facingMode)}\\n                          className=\\\"mt-4 inline-flex items-center gap-2 rounded-xl bg-[#C25E00] hover:bg-[#A84F00] text-white px-5 py-2.5 text-sm font-medium\\\"\\n                        >\\n                          <Camera className=\\\"w-4 h-4\\\" />\\n                          <span>{t(\'attendance.startCamera\')}</span>\\n                        </button>\\n                      </div>\\n                    )}\\n                  </div>\\n\\n                  <div className=\\\"grid grid-cols-2 gap-3\\\">\\n                    {cameraRunning ? (\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={stopCamera}\\n                        className=\\\"inline-flex items-center justify-center gap-2 rounded-xl border border-stone-300 dark:border-stone-700 py-3 text-sm font-medium\\\"\\n                      >\\n                        <CameraOff className=\\\"w-4 h-4\\\" />\\n                        <span>{t(\'attendance.stopCamera\')}</span>\\n                      </button>\\n                    ) : (\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() => startCamera(facingMode)}\\n                        className=\\\"inline-flex items-center justify-center gap-2 rounded-xl bg-[#C25E00] text-white py-3 text-sm font-medium\\\"\\n                      >\\n                        <Camera className=\\\"w-4 h-4\\\" />\\n                        <span>{t(\'attendance.startCamera\')}</span>\\n                      </button>\\n                    )}\\n\\n                    <button\\n                      type=\\\"button\\\"\\n                      onClick={handleSwitchCamera}\\n                      className=\\\"inline-flex items-center justify-center gap-2 rounded-xl border border-stone-300 dark:border-stone-700 py-3 text-sm font-medium\\\"\\n                    >\\n                      <RefreshCw className=\\\"w-4 h-4\\\" />\\n                      <span>{t(\'attendance.switchCamera\')}</span>\\n                    </button>\\n                  </div>\\n                </div>\\n              ) : (\\n                <form onSubmit={handleCodeFormSubmit} className=\\\"space-y-4\\\">\\n                  <div>\\n                    <label className=\\\"block text-sm font-medium text-stone-700 dark:text-stone-300 mb-1.5\\\">\\n                      {t(\'mark.yourIdLabel\')}\\n                    </label>\\n                    <input\\n                      type=\\\"text\\\"\\n                      required\\n                      maxLength={6}\\n                      value={enteredId}\\n                      onChange={(e) => setEnteredId(e.target.value.toUpperCase())}\\n                      placeholder={profile?.memberId || t(\'mark.yourIdPlaceholder\')}\\n                      className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-transparent px-4 py-3 text-base font-mono uppercase tracking-[0.2em] focus:outline-none focus:ring-2 focus:ring-[#C25E00]/30 focus:border-[#C25E00]\\\"\\n                    />\\n                  </div>\\n\\n                  <div>\\n                    <label className=\\\"block text-sm font-medium text-stone-700 dark:text-stone-300 mb-1.5\\\">\\n                      {t(\'mark.liveCodeLabel\')}\\n                    </label>\\n                    <input\\n                      type=\\\"text\\\"\\n                      inputMode=\\\"numeric\\\"\\n                      required\\n                      maxLength={6}\\n                      value={liveCode}\\n                      onChange={(e) => setLiveCode(e.target.value.replace(/\\\\D/g, \'\').slice(0, 6))}\\n                      placeholder={t(\'mark.liveCodePlaceholder\')}\\n                      className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-transparent px-4 py-3 text-2xl font-mono tracking-[0.3em] text-center tabular-nums focus:outline-none focus:ring-2 focus:ring-[#C25E00]/30 focus:border-[#C25E00]\\\"\\n                    />\\n                  </div>\\n\\n                  <button\\n                    type=\\\"submit\\\"\\n                    disabled={submitting}\\n                    className=\\\"w-full rounded-xl bg-[#C25E00] hover:bg-[#A84F00] disabled:opacity-60 text-white py-3 text-sm font-medium transition-colors\\\"\\n                  >\\n                    {submitting ? t(\'mark.submitting\') : t(\'mark.submitBtn\')}\\n                  </button>\\n                </form>\\n              )}\\n            </section>\\n          </>\\n        )}\\n      </div>\\n    </Layout>\\n  );\\n};\\n\", \"Description\":\"Create MarkYourAttendancePage (/mark) with automatic GPS distance verification, 100m accuracy guard, Scan QR & Enter ID + Live Code tabs, and translated outcomes\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/MarkYourAttendancePage.tsx\", \"toolAction\":\"Creating MarkYourAttendancePage\", \"toolSummary\":\"Create MarkYourAttendancePage.tsx\"}"
      original_name: "write_to_file"
