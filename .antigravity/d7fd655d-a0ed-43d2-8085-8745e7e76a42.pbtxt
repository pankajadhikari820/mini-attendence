    tool_calls {
      id: "call_1001176352380844423"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Configure Plus Jakarta Sans for display headings, DM Sans for body prose, JetBrains Mono for metrics, and Noto Sans Devanagari for Hindi\", \"EndLine\":31, \"Instruction\":\"Update base typography tokens in src/index.css\", \"ReplacementContent\":\"@layer base {\\n  :root {\\n    --font-display: \'Plus Jakarta Sans\', \'Noto Sans Devanagari\', -apple-system, BlinkMacSystemFont, sans-serif;\\n    --font-sans: \'DM Sans\', \'Noto Sans Devanagari\', -apple-system, BlinkMacSystemFont, sans-serif;\\n    --font-mono: \'JetBrains Mono\', ui-monospace, SFMono-Regular, Menlo, monospace;\\n  }\\n\\n  html {\\n    font-family: var(--font-sans);\\n    scroll-behavior: smooth;\\n  }\\n\\n  html[lang=\\\"hi\\\"] {\\n    font-family: \'Noto Sans Devanagari\', \'DM Sans\', -apple-system, BlinkMacSystemFont, sans-serif;\\n  }\\n\\n  .dark body {\\n    letter-spacing: 0.008em;\\n  }\\n\\n  h1, h2, h3, h4 {\\n    font-family: var(--font-display);\\n    text-wrap: balance;\\n  }\\n\\n  .tabular-nums {\\n    font-variant-numeric: tabular-nums;\\n  }\\n}\", \"StartLine\":5, \"TargetContent\":\"@layer base {\\n  :root {\\n    --font-sans: \'Inter\', \'Noto Sans Devanagari\', -apple-system, BlinkMacSystemFont, sans-serif;\\n    --font-mono: \'JetBrains Mono\', ui-monospace, SFMono-Regular, Menlo, monospace;\\n  }\\n\\n  html {\\n    font-family: var(--font-sans);\\n    scroll-behavior: smooth;\\n  }\\n\\n  html[lang=\\\"hi\\\"] {\\n    font-family: \'Noto Sans Devanagari\', \'Inter\', -apple-system, BlinkMacSystemFont, sans-serif;\\n  }\\n\\n  .dark body {\\n    letter-spacing: 0.005em;\\n  }\\n\\n  h1, h2, h3 {\\n    text-wrap: balance;\\n  }\\n\\n  .tabular-nums {\\n    font-variant-numeric: tabular-nums;\\n  }\\n}\", \"TargetFile\":\"/src/index.css\", \"toolAction\":\"Updating typography in src/index.css\", \"toolSummary\":\"Update src/index.css\"}"
      original_name: "replace_file_content"
    }
    tool_calls {
      id: "call_1001176352380843436"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import type { Timestamp } from \'firebase/firestore\';\\n\\nexport type UserRole = \'super_admin\' | \'admin\' | \'manager\' | \'member\' | \'parent\';\\nexport type UserStatus = \'pending\' | \'active\' | \'inactive\';\\nexport type OrgType = \'College\' | \'School\' | \'Coaching\' | \'Company\' | \'Other\';\\n// Strictly 3 attendance statuses across the entire platform (no LATE status)\\nexport type AttendanceStatus = \'present\' | \'absent\' | \'leave\';\\nexport type AttendanceMethod = \'live_qr\' | \'live_code\' | \'qr\' | \'manual\';\\nexport type LeaveStatus = \'pending\' | \'approved\' | \'rejected\';\\nexport type LanguageCode = \'en\' | \'hi\';\\nexport type SessionStatus = \'open\' | \'closed\';\\n\\nexport interface RoleLabels {\\n  manager: string;\\n  member: string;\\n}\\n\\nexport interface OrgLocation {\\n  lat: number;\\n  lng: number;\\n  radius: number; // default radius in meters (20-500)\\n  enabled: boolean; // default ON (true)\\n}\\n\\nexport interface Organization {\\n  id: string;\\n  name: string;\\n  type: OrgType;\\n  orgCode: string;\\n  adminUid: string;\\n  logoUrl?: string;\\n  address?: string;\\n  roleLabels: RoleLabels;\\n  timezone: string; // e.g. \\\"Asia/Kolkata\\\"\\n  location: OrgLocation;\\n  defaultSessionDuration?: number; // 15 | 30 | 60 | 120 minutes\\n  lowAttendanceThreshold: number; // default 75\\n  status?: \'active\' | \'suspended\';\\n  counters: {\\n    manager: number;\\n    member: number;\\n  };\\n  hasDemoData?: boolean;\\n  createdAt?: Timestamp | null;\\n}\\n\\nexport interface UserProfile {\\n  uid: string;\\n  name: string;\\n  englishName?: string;\\n  email: string;\\n  phone: string;\\n  rollNumber?: string;\\n  enrollmentNumber?: string;\\n  photoUrl?: string;\\n  role: UserRole;\\n  orgId: string;\\n  managerId: string | null;\\n  memberId: string; // 6-char unique ID e.g. PAN482\\n  status: UserStatus;\\n  managerCode?: string;\\n  language: LanguageCode;\\n  // Academic metadata (for Students & Faculty)\\n  departmentId?: string;\\n  departmentName?: string;\\n  courseName?: string;\\n  classId?: string;\\n  className?: string;\\n  semester?: string;\\n  section?: string;\\n  enrolledSubjectIds?: string[];\\n  // Parent portal links\\n  linkedStudentUids?: string[]; // on Parent profile\\n  parentUids?: string[]; // on Student profile\\n  isDemo?: boolean;\\n  createdAt?: Timestamp | null;\\n}\\n\\nexport interface Department {\\n  id: string;\\n  orgId: string;\\n  name: string;\\n  code: string;\\n  createdAt?: Timestamp | null;\\n}\\n\\nexport interface AcademicClass {\\n  id: string;\\n  orgId: string;\\n  departmentId: string;\\n  departmentName: string;\\n  courseName: string; // e.g. \\\"BCA AI & DS\\\"\\n  semester: string; // e.g. \\\"2\\\"\\n  section: string; // e.g. \\\"C\\\"\\n  roomNumber?: string; // e.g. \\\"Room 204\\\"\\n  name: string; // formatted e.g. \\\"BCA AI & DS - Sem 2 - Sec C\\\"\\n  createdAt?: Timestamp | null;\\n}\\n\\nexport interface Subject {\\n  id: string;\\n  orgId: string;\\n  departmentId: string;\\n  classId: string;\\n  className: string;\\n  name: string; // e.g. \\\"Mathematics\\\"\\n  code: string; // e.g. \\\"MTH201\\\"\\n  credits?: number;\\n  createdAt?: Timestamp | null;\\n}\\n\\nexport interface FacultyAssignment {\\n  id: string;\\n  orgId: string;\\n  teacherUid: string;\\n  teacherName: string;\\n  teacherMemberId: string;\\n  departmentId: string;\\n  classId: string;\\n  className: string;\\n  courseName: string;\\n  semester: string;\\n  section: string;\\n  subjectId: string;\\n  subjectName: string;\\n  subjectCode: string;\\n  createdAt?: Timestamp | null;\\n}\\n\\nexport interface TimetableSlot {\\n  id: string;\\n  orgId: string;\\n  dayOfWeek: number; // 0 = Sun, 1 = Mon, ..., 6 = Sat\\n  startTime: string; // \\\"09:00\\\"\\n  endTime: string; // \\\"10:00\\\"\\n  classId: string;\\n  className: string;\\n  courseName: string;\\n  semester: string;\\n  section: string;\\n  subjectId: string;\\n  subjectName: string;\\n  subjectCode: string;\\n  teacherUid: string;\\n  teacherName: string;\\n  roomNumber: string;\\n  createdAt?: Timestamp | null;\\n}\\n\\nexport interface ParentLink {\\n  id: string;\\n  orgId: string;\\n  parentUid: string;\\n  parentName: string;\\n  parentEmail: string;\\n  studentUid: string;\\n  studentName: string;\\n  studentMemberId: string;\\n  status: \'pending\' | \'verified\' | \'rejected\';\\n  createdAt?: Timestamp | null;\\n  verifiedAt?: Timestamp | null;\\n}\\n\\nexport interface AuditLog {\\n  id: string;\\n  orgId: string;\\n  actorUid: string;\\n  actorName: string;\\n  actorRole: UserRole;\\n  action:\\n    | \'attendance.created\'\\n    | \'attendance.updated\'\\n    | \'attendance.bulk_marked\'\\n    | \'session.started\'\\n    | \'session.closed\'\\n    | \'leave.requested\'\\n    | \'leave.approved\'\\n    | \'leave.rejected\'\\n    | \'user.created\'\\n    | \'user.updated\'\\n    | \'user.status_changed\'\\n    | \'user.role_changed\'\\n    | \'user.deleted\'\\n    | \'parent.linked\'\\n    | \'academic.updated\'\\n    | \'timetable.updated\'\\n    | \'settings.updated\'\\n    | \'alert.low_attendance_sent\';\\n  targetCollection: string;\\n  targetId: string;\\n  summary: string;\\n  metadata?: Record<string, string | number | boolean | null>;\\n  timestamp?: Timestamp | null;\\n}\\n\\nexport interface AttendanceRecord {\\n  id: string; // Session-scoped: `${orgId}_${sessionId}_${personUid}` or Manual: `${orgId}_${date}_${subjectId || \'general\'}_${personUid}`\\n  orgId: string;\\n  personUid: string;\\n  personName: string;\\n  personMemberId?: string;\\n  role: \'manager\' | \'member\';\\n  managerId: string | null;\\n  teacherUid?: string | null;\\n  teacherName?: string;\\n  departmentId?: string;\\n  classId?: string;\\n  className?: string;\\n  semester?: string;\\n  section?: string;\\n  subjectId?: string;\\n  subjectName?: string;\\n  subjectCode?: string;\\n  date: string; // YYYY-MM-DD in org timezone\\n  timestamp?: Timestamp | null;\\n  status: AttendanceStatus;\\n  method: AttendanceMethod;\\n  markedBy: string;\\n  note: string;\\n  sessionId?: string;\\n  lat?: number;\\n  lng?: number;\\n  accuracy?: number;\\n  distanceMeters?: number;\\n  deviceId?: string;\\n  submittedToken?: string;\\n  submittedCode?: string;\\n  isDemo?: boolean;\\n}\\n\\nexport interface SessionLocation {\\n  lat: number;\\n  lng: number;\\n  cosLat: number;\\n  radius: number; // meters (20-500)\\n}\\n\\nexport interface AttendanceSession {\\n  id: string;\\n  orgId: string;\\n  ownerUid: string;\\n  ownerName: string;\\n  ownerRole: \'admin\' | \'manager\';\\n  title: string;\\n  date?: string; // YYYY-MM-DD\\n  status: SessionStatus;\\n  durationMinutes: number;\\n  locationCheckEnabled: boolean;\\n  location: SessionLocation;\\n  markedCount: number;\\n  // Subject / Class scoping for multi-teacher lectures\\n  departmentId?: string;\\n  classId?: string;\\n  className?: string;\\n  courseName?: string;\\n  semester?: string;\\n  section?: string;\\n  subjectId?: string;\\n  subjectName?: string;\\n  subjectCode?: string;\\n  roomNumber?: string;\\n  timetableSlotId?: string;\\n  startTimeLabel?: string;\\n  endTimeLabel?: string;\\n  startedAt?: Timestamp | null;\\n  endsAt?: Timestamp | null;\\n  closedAt?: Timestamp | null;\\n}\\n\\nexport interface SessionSecret {\\n  ownerUid: string;\\n  orgId: string;\\n  active: boolean;\\n  token: string;\\n  code: string;\\n  rotationSeq?: number;\\n  tokenUpdatedAt?: Timestamp | null;\\n}\\n\\nexport interface AttendanceAttempt {\\n  id: string;\\n  orgId: string;\\n  sessionId: string;\\n  ownerUid: string;\\n  personUid: string;\\n  personName: string;\\n  personId: string;\\n  reason: string;\\n  distance: number | null;\\n  time?: Timestamp | null;\\n}\\n\\nexport interface LeaveRequest {\\n  id: string;\\n  orgId: string;\\n  personUid: string;\\n  personName: string;\\n  personRole: \'manager\' | \'member\';\\n  personMemberId?: string;\\n  classId?: string;\\n  toUid: string;\\n  fromDate: string;\\n  toDate: string;\\n  reason: string;\\n  status: LeaveStatus;\\n  comment: string;\\n  isDemo?: boolean;\\n  createdAt?: Timestamp | null;\\n}\\n\\nexport interface Announcement {\\n  id: string;\\n  orgId: string;\\n  fromUid: string;\\n  fromName: string;\\n  fromRole: \'admin\' | \'manager\';\\n  audience: \'all\' | \'managers\' | \'members\' | \'parents\';\\n  managerId: string | null;\\n  classId?: string | null;\\n  text: string;\\n  isDemo?: boolean;\\n  createdAt?: Timestamp | null;\\n}\\n\\nexport interface AppNotification {\\n  id: string;\\n  orgId: string;\\n  toUid: string;\\n  type: \'approval\' | \'leave\' | \'announcement\' | \'attendance\' | \'low_attendance\' | \'timetable\';\\n  text: string;\\n  read: boolean;\\n  dedupeKey?: string;\\n  isDemo?: boolean;\\n  createdAt?: Timestamp | null;\\n}\\n\\nexport interface ContactMessage {\\n  name: string;\\n  email: string;\\n  message: string;\\n  createdAt?: Timestamp | null;\\n}\\n\\nexport interface QRPayload {\\n  type?: \'student_id\';\\n  orgId: string;\\n  uid: string;\\n  id?: string;\\n  memberId?: string;\\n}\\n\\nexport interface LiveSessionQRPayload {\\n  s: string; // sessionId\\n  t: string; // rotating 128-bit token\\n}\\n\\nexport interface OrgCodeLookup {\\n  orgId: string;\\n  orgName: string;\\n  roleLabels: RoleLabels;\\n}\\n\\nexport interface ManagerCodeLookup {\\n  orgId: string;\\n  managerUid: string;\\n  managerName: string;\\n  orgName: string;\\n  roleLabels: RoleLabels;\\n}\\n\", \"Description\":\"Update domain types to strictly support PRESENT/ABSENT/LEAVE only, add 5-role RBAC, academic entities, timetable, parent links, and immutable audit logs\", \"Overwrite\":true, \"TargetFile\":\"/src/types/index.ts\", \"toolAction\":\"Updating TypeScript domain types\", \"toolSummary\":\"Update src/types/index.ts\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_1001176352380842449"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import type { AttendanceStatus, LanguageCode } from \'../types\';\\n\\nconst CODE_CHARS = \'ABCDEFGHJKLMNPQRSTUVWXYZ23456789\';\\n\\nexport function generateCode(length = 6): string {\\n  let out = \'\';\\n  for (let i = 0; i < length; i++) {\\n    out += CODE_CHARS[Math.floor(Math.random() * CODE_CHARS.length)];\\n  }\\n  return out;\\n}\\n\\n/**\\n * Generates a cryptographically strong 128-bit hex token using crypto.getRandomValues.\\n */\\nexport function generateSessionToken(): string {\\n  const bytes = new Uint8Array(16);\\n  crypto.getRandomValues(bytes);\\n  return Array.from(bytes, (b) => b.toString(16).padStart(2, \'0\')).join(\'\');\\n}\\n\\n/**\\n * Generates a random 6-digit numeric code (000000 - 999999) using crypto.getRandomValues.\\n */\\nexport function generateSixDigitCode(): string {\\n  const arr = new Uint32Array(1);\\n  crypto.getRandomValues(arr);\\n  return String(arr[0] % 1000000).padStart(6, \'0\');\\n}\\n\\n/**\\n * Normalizes any legacy attendance record status safely into strictly PRESENT, ABSENT, or LEAVE.\\n * Any legacy \'late\' record from prior versions is treated as \'present\' so LATE never appears anywhere.\\n */\\nexport function normalizeAttendanceStatus(raw: unknown): AttendanceStatus {\\n  if (raw === \'absent\') return \'absent\';\\n  if (raw === \'leave\') return \'leave\';\\n  return \'present\';\\n}\\n\\n/**\\n * Extracts first 3 uppercase English letters from a name (ignoring spaces/symbols, padding with X).\\n */\\nexport function extractIdPrefixFromName(name: string): string {\\n  const letters = name.replace(/[^A-Za-z]/g, \'\').toUpperCase();\\n  return letters.slice(0, 3).padEnd(3, \'X\');\\n}\\n\\n/**\\n * Checks whether a name contains no English letters (e.g., typed in Hindi/Devanagari)\\n * so the UI can prompt for English spelling to generate the 6-char ID.\\n */\\nexport function needsEnglishNameForId(name: string): boolean {\\n  const trimmed = name.trim();\\n  if (!trimmed) return false;\\n  return trimmed.replace(/[^A-Za-z]/g, \'\').length === 0;\\n}\\n\\n/**\\n * Generates a candidate 6-char ID like PAN482 (3 uppercase letters + 3 digits).\\n */\\nexport function generateCandidateUserId(prefix: string): string {\\n  const cleanPrefix = prefix.replace(/[^A-Z]/g, \'\').slice(0, 3).padEnd(3, \'X\');\\n  const arr = new Uint32Array(1);\\n  crypto.getRandomValues(arr);\\n  const digits = String(arr[0] % 1000).padStart(3, \'0\');\\n  return `${cleanPrefix}${digits}`;\\n}\\n\\n/**\\n * Stable random device identifier stored in localStorage to enforce\\n * \\\"one device = one person per session\\\".\\n */\\nexport function getOrCreateDeviceId(): string {\\n  const key = \'sas_device_id\';\\n  let id = localStorage.getItem(key);\\n  if (!id || id.length < 16) {\\n    id = generateSessionToken();\\n    localStorage.setItem(key, id);\\n  }\\n  return id;\\n}\\n\\nexport function getOrgDateString(timezone = \'Asia/Kolkata\', dateObj = new Date()): string {\\n  try {\\n    const formatter = new Intl.DateTimeFormat(\'en-CA\', {\\n      timeZone: timezone,\\n      year: \'numeric\',\\n      month: \'2-digit\',\\n      day: \'2-digit\',\\n    });\\n    return formatter.format(dateObj);\\n  } catch {\\n    return dateObj.toISOString().slice(0, 10);\\n  }\\n}\\n\\nexport function getOrgTimeHHMM(timezone = \'Asia/Kolkata\', dateObj = new Date()): string {\\n  try {\\n    const formatter = new Intl.DateTimeFormat(\'en-GB\', {\\n      timeZone: timezone,\\n      hour: \'2-digit\',\\n      minute: \'2-digit\',\\n      hour12: false,\\n    });\\n    return formatter.format(dateObj);\\n  } catch {\\n    return dateObj.toTimeString().slice(0, 5);\\n  }\\n}\\n\\nexport function getOrgWeekdayIndex(timezone = \'Asia/Kolkata\', dateObj = new Date()): number {\\n  const dateStr = getOrgDateString(timezone, dateObj);\\n  return new Date(`${dateStr}T00:00:00Z`).getUTCDay(); // 0=Sun..6=Sat\\n}\\n\\nexport function parseHHMMToMinutes(hhmm: string): number {\\n  const [h, m] = (hhmm || \'00:00\').split(\':\').map(Number);\\n  return (Number.isFinite(h) ? h : 0) * 60 + (Number.isFinite(m) ? m : 0);\\n}\\n\\nexport function timesOverlap(startA: string, endA: string, startB: string, endB: string): boolean {\\n  const sA = parseHHMMToMinutes(startA);\\n  const eA = parseHHMMToMinutes(endA);\\n  const sB = parseHHMMToMinutes(startB);\\n  const eB = parseHHMMToMinutes(endB);\\n  return sA < eB && sB < eA;\\n}\\n\\nexport function formatTimeRange12h(startHHMM: string, endHHMM: string): string {\\n  const fmt = (hhmm: string) => {\\n    const [hStr, mStr] = (hhmm || \'00:00\').split(\':\');\\n    const h = Number(hStr);\\n    if (!Number.isFinite(h)) return hhmm;\\n    const period = h >= 12 ? \'PM\' : \'AM\';\\n    const hour12 = h % 12 === 0 ? 12 : h % 12;\\n    return `${String(hour12).padStart(2, \'0\')}:${mStr || \'00\'} ${period}`;\\n  };\\n  return `${fmt(startHHMM)} \342\200\223 ${fmt(endHHMM)}`;\\n}\\n\\n/**\\n * Compresses an uploaded image file to a lightweight JPEG data URL (max 240x240)\\n * so student photos and college logos work 100% on Firebase Spark plan without Storage billing.\\n */\\nexport function compressImageToDataUrl(file: File, maxSize = 240): Promise<string> {\\n  return new Promise((resolve, reject) => {\\n    const reader = new FileReader();\\n    reader.onerror = () => reject(new Error(\'Failed to read image file\'));\\n    reader.onload = () => {\\n      const img = new Image();\\n      img.onerror = () => reject(new Error(\'Invalid image file\'));\\n      img.onload = () => {\\n        const canvas = document.createElement(\'canvas\');\\n        let { width, height } = img;\\n        if (width > height) {\\n          if (width > maxSize) {\\n            height = Math.round((height * maxSize) / width);\\n            width = maxSize;\\n          }\\n        } else if (height > maxSize) {\\n          width = Math.round((width * maxSize) / height);\\n          height = maxSize;\\n        }\\n        canvas.width = width;\\n        canvas.height = height;\\n        const ctx = canvas.getContext(\'2d\');\\n        if (!ctx) {\\n          reject(new Error(\'Canvas unavailable\'));\\n          return;\\n        }\\n        ctx.drawImage(img, 0, 0, width, height);\\n        resolve(canvas.toDataURL(\'image/jpeg\', 0.8));\\n      };\\n      img.src = reader.result as string;\\n    };\\n    reader.readAsDataURL(file);\\n  });\\n}\\n\\nexport function getDistanceMeters(\\n  lat1: number,\\n  lng1: number,\\n  lat2: number,\\n  lng2: number\\n): number {\\n  const R = 6371000;\\n  const toRad = (deg: number) => (deg * Math.PI) / 180;\\n  const dLat = toRad(lat2 - lat1);\\n  const dLng = toRad(lng2 - lng1);\\n  const a =\\n    Math.sin(dLat / 2) * Math.sin(dLat / 2) +\\n    Math.cos(toRad(lat1)) *\\n      Math.cos(toRad(lat2)) *\\n      Math.sin(dLng / 2) *\\n      Math.sin(dLng / 2);\\n  const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));\\n  return Math.round(R * c);\\n}\\n\\n/**\\n * Matches the flat-earth distance calculation performed inside Firestore rules.\\n */\\nexport function getFlatEarthDistanceMeters(\\n  lat1: number,\\n  lng1: number,\\n  lat2: number,\\n  lng2: number,\\n  cosLat: number\\n): number {\\n  const dLat = (lat1 - lat2) * 111320;\\n  const dLng = (lng1 - lng2) * 111320 * cosLat;\\n  return Math.round(Math.sqrt(dLat * dLat + dLng * dLng));\\n}\\n\\nexport interface GeoReading {\\n  lat: number;\\n  lng: number;\\n  accuracy: number;\\n}\\n\\nexport function getCurrentPosition(): Promise<GeoReading> {\\n  return new Promise((resolve, reject) => {\\n    if (!navigator.geolocation) {\\n      reject(new Error(\'GEOLOCATION_UNSUPPORTED\'));\\n      return;\\n    }\\n    navigator.geolocation.getCurrentPosition(\\n      (pos) =>\\n        resolve({\\n          lat: pos.coords.latitude,\\n          lng: pos.coords.longitude,\\n          accuracy: Math.round(pos.coords.accuracy || 0),\\n        }),\\n      (err) => reject(err),\\n      { enableHighAccuracy: true, timeout: 12000, maximumAge: 5000 }\\n    );\\n  });\\n}\\n\\nexport function playBeep(success = true): void {\\n  try {\\n    const AudioCtx =\\n      window.AudioContext ||\\n      (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;\\n    if (!AudioCtx) return;\\n    const ctx = new AudioCtx();\\n    const osc = ctx.createOscillator();\\n    const gain = ctx.createGain();\\n    osc.type = success ? \'sine\' : \'triangle\';\\n    osc.frequency.setValueAtTime(success ? 880 : 280, ctx.currentTime);\\n    if (success) {\\n      osc.frequency.setValueAtTime(1174, ctx.currentTime + 0.08);\\n    }\\n    gain.gain.setValueAtTime(0.14, ctx.currentTime);\\n    gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.22);\\n    osc.connect(gain);\\n    gain.connect(ctx.destination);\\n    osc.start();\\n    osc.stop(ctx.currentTime + 0.24);\\n  } catch {\\n    // Ignore audio context restriction\\n  }\\n}\\n\\nexport function triggerVibration(success = true): void {\\n  try {\\n    if (navigator.vibrate) {\\n      navigator.vibrate(success ? [80] : [120, 60, 120]);\\n    }\\n  } catch {\\n    // Ignore unsupported vibration\\n  }\\n}\\n\\nexport function getInitials(name: string): string {\\n  if (!name) return \'?\';\\n  const parts = name.trim().split(/\\\\s+/);\\n  if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();\\n  return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();\\n}\\n\\nexport function eachDateBetween(fromDate: string, toDate: string): string[] {\\n  const dates: string[] = [];\\n  const start = new Date(`${fromDate}T00:00:00Z`);\\n  const end = new Date(`${toDate}T00:00:00Z`);\\n  if (Number.isNaN(start.getTime()) || Number.isNaN(end.getTime()) || start > end) {\\n    return dates;\\n  }\\n  const cur = new Date(start);\\n  let guard = 0;\\n  while (cur <= end && guard < 90) {\\n    dates.push(cur.toISOString().slice(0, 10));\\n    cur.setUTCDate(cur.getUTCDate() + 1);\\n    guard++;\\n  }\\n  return dates;\\n}\\n\\nexport function getPastDates(days: number, timezone = \'Asia/Kolkata\'): string[] {\\n  const todayStr = getOrgDateString(timezone);\\n  const base = new Date(`${todayStr}T00:00:00Z`);\\n  const list: string[] = [];\\n  for (let i = days - 1; i >= 0; i--) {\\n    const d = new Date(base);\\n    d.setUTCDate(d.getUTCDate() - i);\\n    list.push(d.toISOString().slice(0, 10));\\n  }\\n  return list;\\n}\\n\\nexport function formatLocaleDate(\\n  dateStr: string,\\n  lang: LanguageCode,\\n  options: Intl.DateTimeFormatOptions = { day: \'numeric\', month: \'short\', year: \'numeric\' }\\n): string {\\n  if (!dateStr) return \'\342\200\224\';\\n  const d = new Date(`${dateStr}T00:00:00`);\\n  if (Number.isNaN(d.getTime())) return dateStr;\\n  return new Intl.DateTimeFormat(lang === \'hi\' ? \'hi-IN\' : \'en-IN\', options).format(d);\\n}\\n\\nexport function formatLocaleTime(date: Date | null | undefined, lang: LanguageCode): string {\\n  if (!date) return \'\342\200\224\';\\n  return new Intl.DateTimeFormat(lang === \'hi\' ? \'hi-IN\' : \'en-IN\', {\\n    hour: \'2-digit\',\\n    minute: \'2-digit\',\\n  }).format(date);\\n}\\n\\nexport function formatLocaleNumber(num: number, lang: LanguageCode): string {\\n  return new Intl.NumberFormat(lang === \'hi\' ? \'hi-IN\' : \'en-IN\').format(num);\\n}\\n\\nexport function getFirebaseErrorKey(error: unknown): string {\\n  const code = (error as { code?: string })?.code || \'\';\\n  const msg = (error as { message?: string })?.message || \'\';\\n  if (!navigator.onLine || code === \'auth/network-request-failed\' || code === \'unavailable\') {\\n    return \'errors.noInternet\';\\n  }\\n  switch (code) {\\n    case \'auth/email-already-in-use\':\\n      return \'errors.emailInUse\';\\n    case \'auth/invalid-email\':\\n      return \'errors.invalidEmail\';\\n    case \'auth/weak-password\':\\n      return \'errors.weakPassword\';\\n    case \'auth/user-not-found\':\\n    case \'auth/wrong-password\':\\n    case \'auth/invalid-credential\':\\n      return \'errors.wrongCredentials\';\\n    case \'auth/too-many-requests\':\\n      return \'errors.tooManyRequests\';\\n    case \'permission-denied\':\\n      return \'errors.permissionDenied\';\\n    default:\\n      if (msg.includes(\'permission\') || msg.includes(\'PERMISSION_DENIED\')) {\\n        return \'errors.permissionDenied\';\\n      }\\n      return \'errors.generic\';\\n  }\\n}\\n\\nexport function getDefaultRoleLabels(type: string): { manager: string; member: string } {\\n  switch (type) {\\n    case \'College\':\\n      return { manager: \'Teacher\', member: \'Student\' };\\n    case \'School\':\\n      return { manager: \'Teacher\', member: \'Student\' };\\n    case \'Coaching\':\\n      return { manager: \'Faculty\', member: \'Student\' };\\n    case \'Company\':\\n      return { manager: \'Team Lead\', member: \'Employee\' };\\n    default:\\n      return { manager: \'Manager\', member: \'Member\' };\\n  }\\n}\\n\", \"Description\":\"Remove isAfterLateTime, add normalizeAttendanceStatus, timetable overlap helpers, and Spark-compatible image compressor\", \"Overwrite\":true, \"TargetFile\":\"/src/utils/helpers.ts\", \"toolAction\":\"Updating helper utilities\", \"toolSummary\":\"Update src/utils/helpers.ts\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_1001176352380845558"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"rules_version = \'2\';\\nservice cloud.firestore {\\n  match /databases/{database}/documents {\\n\\n    function isSignedIn() {\\n      return request.auth != null;\\n    }\\n\\n    function myUser() {\\n      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;\\n    }\\n\\n    function hasProfile() {\\n      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));\\n    }\\n\\n    function isActive() {\\n      return hasProfile() && myUser().status == \'active\';\\n    }\\n\\n    function isSuperAdmin() {\\n      return isActive() && myUser().role == \'super_admin\';\\n    }\\n\\n    function isOrgAdmin(orgId) {\\n      return isActive() && (\\n        myUser().role == \'super_admin\' ||\\n        (myUser().orgId == orgId && myUser().role == \'admin\')\\n      );\\n    }\\n\\n    function isOrgManager(orgId) {\\n      return isActive() && myUser().orgId == orgId && myUser().role == \'manager\';\\n    }\\n\\n    function isParentOf(studentUid) {\\n      return isActive()\\n        && myUser().role == \'parent\'\\n        && \'linkedStudentUids\' in myUser()\\n        && myUser().linkedStudentUids is list\\n        && studentUid in myUser().linkedStudentUids;\\n    }\\n\\n    function inSameOrg(orgId) {\\n      return hasProfile() && (myUser().role == \'super_admin\' || myUser().orgId == orgId);\\n    }\\n\\n    function userImmutableFieldsUnchanged() {\\n      return request.resource.data.role == resource.data.role\\n        && request.resource.data.orgId == resource.data.orgId\\n        && request.resource.data.status == resource.data.status\\n        && request.resource.data.managerId == resource.data.managerId\\n        && request.resource.data.memberId == resource.data.memberId\\n        && request.resource.data.uid == resource.data.uid\\n        && request.resource.data.get(\'linkedStudentUids\', null) == resource.data.get(\'linkedStudentUids\', null);\\n    }\\n\\n    // Eligibility check for submitting self-attendance to a Live Session\\n    function isEligibleForSession(sess) {\\n      return myUser().orgId == sess.orgId && (\\n        // Admin -> Manager session\\n        (sess.ownerRole == \'admin\' && myUser().role == \'manager\')\\n        // Multi-teacher class/subject session -> Students assigned to that classId\\n        || (\\n          sess.ownerRole == \'manager\'\\n          && myUser().role == \'member\'\\n          && \'classId\' in sess && sess.classId is string && sess.classId != \'\'\\n          && \'classId\' in myUser() && myUser().classId == sess.classId\\n        )\\n        // Legacy direct manager -> member session (when session has no classId or student has direct managerId)\\n        || (\\n          sess.ownerRole == \'manager\'\\n          && myUser().role == \'member\'\\n          && myUser().managerId == sess.ownerUid\\n        )\\n      );\\n    }\\n\\n    function flatEarthDistanceOk(sess, lat, lng) {\\n      let dLat = (lat - sess.location.lat) * 111320.0;\\n      let dLng = (lng - sess.location.lng) * 111320.0 * sess.location.cosLat;\\n      let dist = math.sqrt(math.pow(dLat, 2) + math.pow(dLng, 2));\\n      return dist <= sess.location.radius;\\n    }\\n\\n    // Strict 10-second server-clock validation on sessionSecrets\\n    function liveSecretValid(secret, data) {\\n      let within10s = secret.active == true\\n        && secret.tokenUpdatedAt is timestamp\\n        && request.time >= secret.tokenUpdatedAt\\n        && request.time <= secret.tokenUpdatedAt + duration.value(10, \'s\');\\n      return within10s && (\\n        (data.method == \'live_qr\'\\n          && \'submittedToken\' in data\\n          && secret.token is string\\n          && secret.token.size() >= 32\\n          && data.submittedToken == secret.token)\\n        ||\\n        (data.method == \'live_code\'\\n          && \'submittedCode\' in data\\n          && secret.code is string\\n          && secret.code.size() == 6\\n          && data.submittedCode == secret.code)\\n      );\\n    }\\n\\n    // Globally unique 6-character user ID lookup (e.g. PAN482)\\n    match /userIds/{userId} {\\n      allow get: if isSignedIn();\\n      allow list: if isSignedIn() && hasProfile() && myUser().role in [\'super_admin\', \'admin\'];\\n      allow create: if isSignedIn()\\n        && userId.matches(\'^[A-Z]{3}[0-9]{3}$\')\\n        && !exists(/databases/$(database)/documents/userIds/$(userId));\\n      allow update: if false;\\n      allow delete: if isSignedIn() && (\\n        isOrgAdmin(resource.data.orgId) ||\\n        (isOrgManager(resource.data.orgId) && resource.data.role == \'member\')\\n      );\\n    }\\n\\n    // Public lookup tables for self-registration (get by exact code only, NO list)\\n    match /orgCodes/{code} {\\n      allow get: if true;\\n      allow list: if false;\\n      allow create: if isSignedIn();\\n      allow update, delete: if isSignedIn() && isOrgAdmin(resource.data.orgId);\\n    }\\n\\n    match /managerCodes/{code} {\\n      allow get: if true;\\n      allow list: if false;\\n      allow create: if isSignedIn() && (\\n        isOrgAdmin(request.resource.data.orgId) ||\\n        (isOrgManager(request.resource.data.orgId) && request.resource.data.managerUid == request.auth.uid)\\n      );\\n      allow update, delete: if isSignedIn() && (\\n        isOrgAdmin(resource.data.orgId) ||\\n        resource.data.managerUid == request.auth.uid\\n      );\\n    }\\n\\n    // Public contact form messages (create-only for public)\\n    match /messages/{msgId} {\\n      allow create: if request.resource.data.keys().hasAll([\'name\', \'email\', \'message\'])\\n        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120\\n        && request.resource.data.email is string && request.resource.data.email.size() > 3 && request.resource.data.email.size() <= 180\\n        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 2000;\\n      allow read: if isSuperAdmin();\\n      allow update, delete: if false;\\n    }\\n\\n    // Organizations\\n    match /organizations/{orgId} {\\n      allow read: if inSameOrg(orgId);\\n      allow create: if isSignedIn() && request.resource.data.adminUid == request.auth.uid;\\n      allow update: if isOrgAdmin(orgId)\\n        || (isOrgManager(orgId)\\n            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\'counters\']));\\n      allow delete: if isOrgAdmin(orgId);\\n    }\\n\\n    // Users (Super Admin, Org Admin, Manager/Teacher, Member/Student, Parent)\\n    match /users/{uid} {\\n      allow read: if isSignedIn() && (\\n        request.auth.uid == uid\\n        || isSuperAdmin()\\n        || (hasProfile() && myUser().role == \'admin\' && myUser().orgId == resource.data.orgId)\\n        || (hasProfile() && myUser().role == \'manager\' && myUser().orgId == resource.data.orgId && (\\n              resource.data.managerId == request.auth.uid\\n              || resource.data.role == \'admin\'\\n              || resource.data.role == \'member\'\\n           ))\\n        || (isParentOf(uid) && resource.data.orgId == myUser().orgId)\\n      );\\n\\n      allow create: if isSignedIn() && (\\n        (request.auth.uid == uid && request.resource.data.uid == uid && request.resource.data.role == \'admin\' && request.resource.data.status == \'active\')\\n        || (request.auth.uid == uid && request.resource.data.uid == uid && request.resource.data.status == \'pending\' && request.resource.data.role in [\'manager\', \'member\', \'parent\'])\\n        || isOrgAdmin(request.resource.data.orgId)\\n        || (isOrgManager(request.resource.data.orgId) && request.resource.data.role == \'member\' && request.resource.data.managerId == request.auth.uid)\\n      );\\n\\n      allow update: if isSignedIn() && (\\n        (request.auth.uid == uid && userImmutableFieldsUnchanged())\\n        || isOrgAdmin(resource.data.orgId)\\n        || (isOrgManager(resource.data.orgId)\\n            && resource.data.role == \'member\'\\n            && resource.data.managerId == request.auth.uid\\n            && request.resource.data.role == \'member\'\\n            && request.resource.data.orgId == resource.data.orgId\\n            && request.resource.data.managerId == request.auth.uid)\\n      );\\n\\n      allow delete: if isSignedIn() && (\\n        isOrgAdmin(resource.data.orgId)\\n        || (isOrgManager(resource.data.orgId) && resource.data.role == \'member\' && resource.data.managerId == request.auth.uid)\\n      );\\n    }\\n\\n    // Academic Structure: Departments, Classes/Sections, Subjects, Faculty Assignments, Timetables\\n    match /departments/{deptId} {\\n      allow read: if isActive() && inSameOrg(resource.data.orgId);\\n      allow create: if isOrgAdmin(request.resource.data.orgId);\\n      allow update, delete: if isOrgAdmin(resource.data.orgId);\\n    }\\n\\n    match /classes/{classId} {\\n      allow read: if isActive() && inSameOrg(resource.data.orgId);\\n      allow create: if isOrgAdmin(request.resource.data.orgId);\\n      allow update, delete: if isOrgAdmin(resource.data.orgId);\\n    }\\n\\n    match /subjects/{subjectId} {\\n      allow read: if isActive() && inSameOrg(resource.data.orgId);\\n      allow create: if isOrgAdmin(request.resource.data.orgId);\\n      allow update, delete: if isOrgAdmin(resource.data.orgId);\\n    }\\n\\n    match /facultyAssignments/{assignmentId} {\\n      allow read: if isActive() && inSameOrg(resource.data.orgId);\\n      allow create: if isOrgAdmin(request.resource.data.orgId);\\n      allow update, delete: if isOrgAdmin(resource.data.orgId);\\n    }\\n\\n    match /timetables/{slotId} {\\n      allow read: if isActive() && inSameOrg(resource.data.orgId);\\n      allow create: if isOrgAdmin(request.resource.data.orgId);\\n      allow update, delete: if isOrgAdmin(resource.data.orgId);\\n    }\\n\\n    // Parent-Student Link Requests (Admin verifies to grant read-only access)\\n    match /parentLinks/{linkId} {\\n      allow read: if isSignedIn() && (\\n        resource.data.parentUid == request.auth.uid\\n        || resource.data.studentUid == request.auth.uid\\n        || isOrgAdmin(resource.data.orgId)\\n      );\\n      allow create: if isSignedIn() && (\\n        (request.resource.data.parentUid == request.auth.uid && request.resource.data.status == \'pending\')\\n        || isOrgAdmin(request.resource.data.orgId)\\n      );\\n      allow update, delete: if isOrgAdmin(resource.data.orgId);\\n    }\\n\\n    // Live Attendance Sessions\\n    // NOTE: Contains NO secret tokens/codes. All secrets live in owner-only `sessionSecrets`.\\n    // Query-safe read rules: students query by (orgId + classId + status) OR (orgId + ownerUid + status),\\n    // managers query by (orgId + ownerRole == \'admin\' + status) OR (orgId + ownerUid == uid).\\n    match /sessions/{sessionId} {\\n      allow read: if isActive() && (\\n        isSuperAdmin()\\n        || (myUser().orgId == resource.data.orgId && (\\n          myUser().role == \'admin\'\\n          || resource.data.ownerUid == request.auth.uid\\n          || (myUser().role == \'manager\' && resource.data.ownerRole == \'admin\')\\n          || (myUser().role == \'member\' && \'classId\' in myUser() && myUser().classId != null && myUser().classId != \'\' && resource.data.classId == myUser().classId)\\n          || (myUser().role == \'member\' && myUser().managerId != null && resource.data.ownerUid == myUser().managerId)\\n        ))\\n      );\\n\\n      allow create: if isActive()\\n        && request.resource.data.orgId == myUser().orgId\\n        && request.resource.data.ownerUid == request.auth.uid\\n        && request.resource.data.ownerRole == myUser().role\\n        && myUser().role in [\'admin\', \'manager\']\\n        && request.resource.data.status == \'open\';\\n\\n      allow update: if isActive() && resource.data.orgId == myUser().orgId && (\\n        resource.data.ownerUid == request.auth.uid\\n        || isOrgAdmin(resource.data.orgId)\\n      );\\n\\n      allow delete: if isActive() && resource.data.orgId == myUser().orgId && (\\n        resource.data.ownerUid == request.auth.uid\\n        || isOrgAdmin(resource.data.orgId)\\n      );\\n    }\\n\\n    // Session Secrets: STRICTLY owner-only. Students/scanners/parents can NEVER read or write.\\n    match /sessionSecrets/{sessionId} {\\n      allow read: if isActive() && resource.data.ownerUid == request.auth.uid;\\n      allow create: if isActive()\\n        && request.resource.data.ownerUid == request.auth.uid\\n        && request.resource.data.orgId == myUser().orgId\\n        && myUser().role in [\'admin\', \'manager\']\\n        && request.resource.data.tokenUpdatedAt == request.time;\\n      allow update: if isActive()\\n        && resource.data.ownerUid == request.auth.uid\\n        && request.resource.data.ownerUid == resource.data.ownerUid\\n        && request.resource.data.orgId == resource.data.orgId\\n        && request.resource.data.tokenUpdatedAt == request.time;\\n      allow delete: if isActive() && resource.data.ownerUid == request.auth.uid;\\n    }\\n\\n    // One device = one person per session (write-once per sessionId_deviceId)\\n    match /sessionDevices/{deviceDocId} {\\n      allow get: if isActive() && (resource == null || resource.data.orgId == myUser().orgId);\\n      allow list: if isActive() && myUser().role in [\'super_admin\', \'admin\', \'manager\'];\\n      allow create: if isActive()\\n        && request.resource.data.orgId == myUser().orgId\\n        && request.resource.data.personUid == request.auth.uid\\n        && deviceDocId == request.resource.data.sessionId + \'_\' + request.resource.data.deviceId\\n        && !exists(/databases/$(database)/documents/sessionDevices/$(deviceDocId));\\n      allow update: if false;\\n      allow delete: if isOrgAdmin(resource.data.orgId);\\n    }\\n\\n    // Failed attendance attempts log (owner sees rejected attempts on session screen)\\n    match /attempts/{attemptId} {\\n      allow read: if isActive() && resource.data.orgId == myUser().orgId && (\\n        myUser().role in [\'super_admin\', \'admin\']\\n        || resource.data.ownerUid == request.auth.uid\\n      );\\n      allow create: if isActive()\\n        && request.resource.data.orgId == myUser().orgId\\n        && request.resource.data.personUid == request.auth.uid;\\n      allow update: if false;\\n      allow delete: if isOrgAdmin(resource.data.orgId);\\n    }\\n\\n    // Strictly validates self-marking via live rotating QR/code:\\n    // - Status MUST be \'present\' (no \'late\' status permitted)\\n    // - Deterministic ID: {orgId}_{sessionId}_{uid} so multiple subjects on the same day never overwrite each other\\n    // - Prevents duplicate attendance within the same session\\n    function canSelfMarkAttendance(recordId) {\\n      let sid = request.resource.data.sessionId;\\n      let sess = get(/databases/$(database)/documents/sessions/$(sid)).data;\\n      let secret = get(/databases/$(database)/documents/sessionSecrets/$(sid)).data;\\n      let devDocId = sid + \'_\' + request.resource.data.deviceId;\\n      return request.resource.data.method in [\'live_qr\', \'live_code\']\\n        && request.resource.data.status == \'present\'\\n        && request.resource.data.personUid == request.auth.uid\\n        && recordId == request.resource.data.orgId + \'_\' + sid + \'_\' + request.auth.uid\\n        && !exists(/databases/$(database)/documents/attendance/$(recordId))\\n        && request.resource.data.timestamp == request.time\\n        && sid is string\\n        && request.resource.data.deviceId is string\\n        && exists(/databases/$(database)/documents/sessions/$(sid))\\n        && exists(/databases/$(database)/documents/sessionSecrets/$(sid))\\n        && sess.orgId == request.resource.data.orgId\\n        && secret.orgId == sess.orgId\\n        && secret.ownerUid == sess.ownerUid\\n        && sess.status == \'open\'\\n        && request.time <= sess.endsAt\\n        && isEligibleForSession(sess)\\n        && liveSecretValid(secret, request.resource.data)\\n        && (\\n          !sess.locationCheckEnabled\\n          || (\\n            request.resource.data.lat is number\\n            && request.resource.data.lng is number\\n            && flatEarthDistanceOk(sess, request.resource.data.lat, request.resource.data.lng)\\n          )\\n        )\\n        && existsAfter(/databases/$(database)/documents/sessionDevices/$(devDocId))\\n        && getAfter(/databases/$(database)/documents/sessionDevices/$(devDocId)).data.personUid == request.auth.uid;\\n    }\\n\\n    // Attendance: strictly supports ONLY [\'present\', \'absent\', \'leave\']\\n    // Parents have strict READ-ONLY access to their linked students only.\\n    // Students can NEVER update or delete attendance records.\\n    match /attendance/{recordId} {\\n      allow get: if isSignedIn() && hasProfile() && (\\n        resource == null\\n        || isSuperAdmin()\\n        || (myUser().role == \'admin\' && myUser().orgId == resource.data.orgId)\\n        || (myUser().role == \'manager\' && myUser().orgId == resource.data.orgId && (\\n              resource.data.managerId == request.auth.uid\\n              || resource.data.teacherUid == request.auth.uid\\n              || resource.data.markedBy == request.auth.uid\\n              || resource.data.personUid == request.auth.uid\\n           ))\\n        || (myUser().role == \'member\' && resource.data.personUid == request.auth.uid)\\n        || (isParentOf(resource.data.personUid) && myUser().orgId == resource.data.orgId)\\n      );\\n\\n      allow list: if isSignedIn() && hasProfile() && (\\n        isSuperAdmin()\\n        || (myUser().role == \'admin\' && myUser().orgId == resource.data.orgId)\\n        || (myUser().role == \'manager\' && myUser().orgId == resource.data.orgId && (\\n              resource.data.managerId == request.auth.uid\\n              || resource.data.teacherUid == request.auth.uid\\n              || resource.data.markedBy == request.auth.uid\\n              || resource.data.personUid == request.auth.uid\\n           ))\\n        || (myUser().role == \'member\' && resource.data.personUid == request.auth.uid)\\n        || (isParentOf(resource.data.personUid) && myUser().orgId == resource.data.orgId)\\n      );\\n\\n      // Strictly ONLY [\'present\', \'absent\', \'leave\'] \342\200\224 \'late\' is permanently rejected\\n      // ID-card QR codes can NEVER authorize self-marking (only live_qr / live_code with active 10s secret)\\n      allow create: if isActive()\\n        && request.resource.data.orgId == myUser().orgId\\n        && request.resource.data.status in [\'present\', \'absent\', \'leave\']\\n        && myUser().role != \'parent\'\\n        && (\\n          (\\n            request.resource.data.method in [\'live_qr\', \'live_code\']\\n            && \'sessionId\' in request.resource.data\\n            && \'deviceId\' in request.resource.data\\n            && canSelfMarkAttendance(recordId)\\n          )\\n          ||\\n          (\\n            request.resource.data.method in [\'qr\', \'manual\']\\n            && exists(/databases/$(database)/documents/users/$(request.resource.data.personUid))\\n            && get(/databases/$(database)/documents/users/$(request.resource.data.personUid)).data.orgId == myUser().orgId\\n            && get(/databases/$(database)/documents/users/$(request.resource.data.personUid)).data.status == \'active\'\\n            && (\\n              (myUser().role in [\'super_admin\', \'admin\'])\\n              || (myUser().role == \'manager\'\\n                  && get(/databases/$(database)/documents/users/$(request.resource.data.personUid)).data.role == \'member\'\\n                  && (\\n                    get(/databases/$(database)/documents/users/$(request.resource.data.personUid)).data.managerId == request.auth.uid\\n                    || request.resource.data.teacherUid == request.auth.uid\\n                  ))\\n            )\\n          )\\n        );\\n\\n      allow update: if isActive()\\n        && resource.data.orgId == myUser().orgId\\n        && request.resource.data.orgId == resource.data.orgId\\n        && request.resource.data.personUid == resource.data.personUid\\n        && request.resource.data.status in [\'present\', \'absent\', \'leave\']\\n        && myUser().role != \'member\'\\n        && myUser().role != \'parent\'\\n        && (\\n          myUser().role in [\'super_admin\', \'admin\']\\n          || (myUser().role == \'manager\' && (\\n              resource.data.managerId == request.auth.uid\\n              || resource.data.teacherUid == request.auth.uid\\n              || resource.data.markedBy == request.auth.uid\\n          ))\\n        );\\n\\n      allow delete: if isOrgAdmin(resource.data.orgId);\\n    }\\n\\n    // Leave Requests (Parents have read-only access to linked student\'s leave applications)\\n    match /leaves/{leaveId} {\\n      allow read: if isSignedIn() && hasProfile() && (\\n        isOrgAdmin(resource.data.orgId)\\n        || resource.data.personUid == request.auth.uid\\n        || resource.data.toUid == request.auth.uid\\n        || (isParentOf(resource.data.personUid) && myUser().orgId == resource.data.orgId)\\n      );\\n\\n      allow create: if isActive()\\n        && request.resource.data.orgId == myUser().orgId\\n        && myUser().role != \'parent\'\\n        && (\\n          (request.resource.data.personUid == request.auth.uid && request.resource.data.status == \'pending\')\\n          || (myUser().role in [\'super_admin\', \'admin\'] && request.resource.data.isDemo == true)\\n        );\\n\\n      allow update: if isActive()\\n        && resource.data.orgId == myUser().orgId\\n        && myUser().role != \'parent\'\\n        && (\\n          myUser().role in [\'super_admin\', \'admin\']\\n          || resource.data.toUid == request.auth.uid\\n        );\\n\\n      allow delete: if isOrgAdmin(resource.data.orgId) || resource.data.personUid == request.auth.uid;\\n    }\\n\\n    // Announcements\\n    match /announcements/{annId} {\\n      allow read: if isActive() && myUser().orgId == resource.data.orgId && (\\n        myUser().role in [\'super_admin\', \'admin\']\\n        || resource.data.audience == \'all\'\\n        || (myUser().role == \'manager\' && (resource.data.audience == \'managers\' || resource.data.fromUid == request.auth.uid))\\n        || (myUser().role == \'member\' && resource.data.audience == \'members\' && (resource.data.managerId == null || resource.data.managerId == myUser().managerId))\\n        || (myUser().role == \'parent\' && resource.data.audience in [\'all\', \'parents\'])\\n      );\\n\\n      allow create: if isActive()\\n        && request.resource.data.orgId == myUser().orgId\\n        && myUser().role in [\'super_admin\', \'admin\', \'manager\'];\\n\\n      allow update, delete: if isActive()\\n        && resource.data.orgId == myUser().orgId\\n        && (myUser().role in [\'super_admin\', \'admin\'] || resource.data.fromUid == request.auth.uid);\\n    }\\n\\n    // Notifications (supports deterministic dedupe doc IDs for low-attendance alerts)\\n    match /notifications/{notifId} {\\n      allow get: if isSignedIn() && (\\n        resource == null\\n        || resource.data.toUid == request.auth.uid\\n        || isOrgAdmin(resource.data.orgId)\\n      );\\n      allow list: if isSignedIn() && (\\n        resource.data.toUid == request.auth.uid\\n        || isOrgAdmin(resource.data.orgId)\\n      );\\n\\n      allow create: if isSignedIn() && (\\n        hasProfile() && myUser().orgId == request.resource.data.orgId\\n      );\\n\\n      allow update: if isSignedIn() && (\\n        (resource.data.toUid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\'read\']))\\n        || isOrgAdmin(resource.data.orgId)\\n      );\\n\\n      allow delete: if isSignedIn() && (\\n        resource.data.toUid == request.auth.uid\\n        || isOrgAdmin(resource.data.orgId)\\n      );\\n    }\\n\\n    // Immutable Audit Logs: Append-only. NOBODY (not even Admin or Super Admin) can update or delete.\\n    match /auditLogs/{logId} {\\n      allow read: if isActive() && (\\n        isSuperAdmin()\\n        || (myUser().role == \'admin\' && myUser().orgId == resource.data.orgId)\\n      );\\n\\n      allow create: if isSignedIn()\\n        && hasProfile()\\n        && request.resource.data.orgId == myUser().orgId\\n        && request.resource.data.actorUid == request.auth.uid\\n        && request.resource.data.actorRole == myUser().role\\n        && request.resource.data.timestamp == request.time\\n        && request.resource.data.action is string\\n        && request.resource.data.summary is string;\\n\\n      allow update: if false;\\n      allow delete: if false;\\n    }\\n  }\\n}\\n\", \"Description\":\"Harden firestore.rules: strictly PRESENT/ABSENT/LEAVE only, fix multi-teacher & class-based live session query rules, session-scoped attendance doc IDs, parent read-only RBAC, academic collections, and immutable audit logs\", \"Overwrite\":true, \"TargetFile\":\"/firestore.rules\", \"toolAction\":\"Updating Firestore Security Rules\", \"toolSummary\":\"Update firestore.rules\"}"
      original_name: "write_to_file"
    }
    tool_calls {
