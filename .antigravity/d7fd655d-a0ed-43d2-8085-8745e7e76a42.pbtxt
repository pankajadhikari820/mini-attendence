  run_command {
    cwd: "/app/applet"
    exit_code: 0
    blocking: true
    wait_ms_before_async: 5000
    combined_output {
      full: "Generated PWA PNG icons successfully"
    }
    command_line: "node -e \'\nconst fs = require(\"fs\");\nconst zlib = require(\"zlib\");\nconst path = require(\"path\");\n\nfunction crc32(buf) {\n  let c = -1;\n  for (let i = 0; i < buf.length; i++) {\n    c = (c >>> 8) ^ crcTable[(c ^ buf[i]) & 0xff];\n  }\n  return (c ^ -1) >>> 0;\n}\nconst crcTable = new Uint32Array(256);\nfor (let n = 0; n < 256; n++) {\n  let c = n;\n  for (let k = 0; k < 8; k++) c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1;\n  crcTable[n] = c >>> 0;\n}\n\nfunction makeChunk(type, data) {\n  const len = Buffer.alloc(4);\n  len.writeUInt32BE(data.length, 0);\n  const t = Buffer.from(type, \"ascii\");\n  const crcBuf = Buffer.concat([t, data]);\n  const crc = Buffer.alloc(4);\n  crc.writeUInt32BE(crc32(crcBuf), 0);\n  return Buffer.concat([len, t, data, crc]);\n}\n\nfunction generatePNG(size, maskable) {\n  const raw = Buffer.alloc((size * 4 + 1) * size);\n  const bgR = 194, bgG = 94, bgB = 0; // #C25E00 warm amber\n  const fgR = 250, fgG = 249, fgB = 246; // #FAF9F6 off-white\n  const pad = maskable ? 0.22 : 0.16;\n  const inner = 1 - pad * 2;\n\n  function inRect(u, v, x, y, w, h) {\n    return u >= x && u <= x + w && v >= y && v <= y + h;\n  }\n  function inFinder(u, v, x, y, s) {\n    const t = s * 0.22;\n    const outer = inRect(u, v, x, y, s, s);\n    const hole = inRect(u, v, x + t, y + t, s - 2 * t, s - 2 * t);\n    const dot = inRect(u, v, x + s * 0.34, y + s * 0.34, s * 0.32, s * 0.32);\n    return (outer && !hole) || dot;\n  }\n  function distToSegment(px, py, x1, y1, x2, y2) {\n    const dx = x2 - x1, dy = y2 - y1;\n    const l2 = dx * dx + dy * dy;\n    let t = l2 === 0 ? 0 : ((px - x1) * dx + (py - y1) * dy) / l2;\n    t = Math.max(0, Math.min(1, t));\n    const projX = x1 + t * dx, projY = y1 + t * dy;\n    return Math.hypot(px - projX, py - projY);\n  }\n\n  for (let y = 0; y < size; y++) {\n    const rowStart = y * (size * 4 + 1);\n    raw[rowStart] = 0;\n    const ny = y / size;\n    for (let x = 0; x < size; x++) {\n      const nx = x / size;\n      const idx = rowStart + 1 + x * 4;\n      let r = bgR, g = bgG, b = bgB, a = 255;\n\n      // Rounded corners for non-maskable\n      if (!maskable) {\n        const cr = 0.2;\n        let cx = nx < cr ? cr : nx > 1 - cr ? 1 - cr : nx;\n        let cy = ny < cr ? cr : ny > 1 - cr ? 1 - cr : ny;\n        if (Math.hypot(nx - cx, ny - cy) > cr) {\n          a = 0;\n        }\n      }\n\n      const u = (nx - pad) / inner;\n      const v = (ny - pad) / inner;\n\n      const isFinder =\n        inFinder(u, v, 0.0, 0.0, 0.38) ||\n        inFinder(u, v, 0.62, 0.0, 0.38) ||\n        inFinder(u, v, 0.0, 0.62, 0.38);\n\n      const d1 = distToSegment(u, v, 0.58, 0.78, 0.72, 0.92);\n      const d2 = distToSegment(u, v, 0.72, 0.92, 0.98, 0.60);\n      const isCheck = Math.min(d1, d2) < 0.065;\n\n      if (a > 0 && (isFinder || isCheck)) {\n        r = fgR; g = fgG; b = fgB;\n      }\n\n      raw[idx] = r;\n      raw[idx + 1] = g;\n      raw[idx + 2] = b;\n      raw[idx + 3] = a;\n    }\n  }\n\n  const ihdr = Buffer.alloc(13);\n  ihdr.writeUInt32BE(size, 0);\n  ihdr.writeUInt32BE(size, 4);\n  ihdr[8] = 8; // bit depth\n  ihdr[9] = 6; // RGBA\n  ihdr[10] = 0; ihdr[11] = 0; ihdr[12] = 0;\n\n  const idat = zlib.deflateSync(raw);\n  const sig = Buffer.from([137, 80, 78, 71, 13, 10, 26, 10]);\n  return Buffer.concat([\n    sig,\n    makeChunk(\"IHDR\", ihdr),\n    makeChunk(\"IDAT\", idat),\n    makeChunk(\"IEND\", Buffer.alloc(0)),\n  ]);\n}\n\nfs.mkdirSync(\"public\", { recursive: true });\nfs.writeFileSync(path.join(\"public\", \"pwa-192x192.png\"), generatePNG(192, false));\nfs.writeFileSync(path.join(\"public\", \"pwa-512x512.png\"), generatePNG(512, false));\nfs.writeFileSync(path.join(\"public\", \"pwa-maskable-512x512.png\"), generatePNG(512, true));\nfs.writeFileSync(path.join(\"public\", \"apple-touch-icon.png\"), generatePNG(180, true));\nconsole.log(\"Generated PWA PNG icons successfully\");\n\'"
    proposed_command_line: "node -e \'\nconst fs = require(\"fs\");\nconst zlib = require(\"zlib\");\nconst path = require(\"path\");\n\nfunction crc32(buf) {\n  let c = -1;\n  for (let i = 0; i < buf.length; i++) {\n    c = (c >>> 8) ^ crcTable[(c ^ buf[i]) & 0xff];\n  }\n  return (c ^ -1) >>> 0;\n}\nconst crcTable = new Uint32Array(256);\nfor (let n = 0; n < 256; n++) {\n  let c = n;\n  for (let k = 0; k < 8; k++) c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1;\n  crcTable[n] = c >>> 0;\n}\n\nfunction makeChunk(type, data) {\n  const len = Buffer.alloc(4);\n  len.writeUInt32BE(data.length, 0);\n  const t = Buffer.from(type, \"ascii\");\n  const crcBuf = Buffer.concat([t, data]);\n  const crc = Buffer.alloc(4);\n  crc.writeUInt32BE(crc32(crcBuf), 0);\n  return Buffer.concat([len, t, data, crc]);\n}\n\nfunction generatePNG(size, maskable) {\n  const raw = Buffer.alloc((size * 4 + 1) * size);\n  const bgR = 194, bgG = 94, bgB = 0; // #C25E00 warm amber\n  const fgR = 250, fgG = 249, fgB = 246; // #FAF9F6 off-white\n  const pad = maskable ? 0.22 : 0.16;\n  const inner = 1 - pad * 2;\n\n  function inRect(u, v, x, y, w, h) {\n    return u >= x && u <= x + w && v >= y && v <= y + h;\n  }\n  function inFinder(u, v, x, y, s) {\n    const t = s * 0.22;\n    const outer = inRect(u, v, x, y, s, s);\n    const hole = inRect(u, v, x + t, y + t, s - 2 * t, s - 2 * t);\n    const dot = inRect(u, v, x + s * 0.34, y + s * 0.34, s * 0.32, s * 0.32);\n    return (outer && !hole) || dot;\n  }\n  function distToSegment(px, py, x1, y1, x2, y2) {\n    const dx = x2 - x1, dy = y2 - y1;\n    const l2 = dx * dx + dy * dy;\n    let t = l2 === 0 ? 0 : ((px - x1) * dx + (py - y1) * dy) / l2;\n    t = Math.max(0, Math.min(1, t));\n    const projX = x1 + t * dx, projY = y1 + t * dy;\n    return Math.hypot(px - projX, py - projY);\n  }\n\n  for (let y = 0; y < size; y++) {\n    const rowStart = y * (size * 4 + 1);\n    raw[rowStart] = 0;\n    const ny = y / size;\n    for (let x = 0; x < size; x++) {\n      const nx = x / size;\n      const idx = rowStart + 1 + x * 4;\n      let r = bgR, g = bgG, b = bgB, a = 255;\n\n      // Rounded corners for non-maskable\n      if (!maskable) {\n        const cr = 0.2;\n        let cx = nx < cr ? cr : nx > 1 - cr ? 1 - cr : nx;\n        let cy = ny < cr ? cr : ny > 1 - cr ? 1 - cr : ny;\n        if (Math.hypot(nx - cx, ny - cy) > cr) {\n          a = 0;\n        }\n      }\n\n      const u = (nx - pad) / inner;\n      const v = (ny - pad) / inner;\n\n      const isFinder =\n        inFinder(u, v, 0.0, 0.0, 0.38) ||\n        inFinder(u, v, 0.62, 0.0, 0.38) ||\n        inFinder(u, v, 0.0, 0.62, 0.38);\n\n      const d1 = distToSegment(u, v, 0.58, 0.78, 0.72, 0.92);\n      const d2 = distToSegment(u, v, 0.72, 0.92, 0.98, 0.60);\n      const isCheck = Math.min(d1, d2) < 0.065;\n\n      if (a > 0 && (isFinder || isCheck)) {\n        r = fgR; g = fgG; b = fgB;\n      }\n\n      raw[idx] = r;\n      raw[idx + 1] = g;\n      raw[idx + 2] = b;\n      raw[idx + 3] = a;\n    }\n  }\n\n  const ihdr = Buffer.alloc(13);\n  ihdr.writeUInt32BE(size, 0);\n  ihdr.writeUInt32BE(size, 4);\n  ihdr[8] = 8; // bit depth\n  ihdr[9] = 6; // RGBA\n  ihdr[10] = 0; ihdr[11] = 0; ihdr[12] = 0;\n\n  const idat = zlib.deflateSync(raw);\n  const sig = Buffer.from([137, 80, 78, 71, 13, 10, 26, 10]);\n  return Buffer.concat([\n    sig,\n    makeChunk(\"IHDR\", ihdr),\n    makeChunk(\"IDAT\", idat),\n    makeChunk(\"IEND\", Buffer.alloc(0)),\n  ]);\n}\n\nfs.mkdirSync(\"public\", { recursive: true });\nfs.writeFileSync(path.join(\"public\", \"pwa-192x192.png\"), generatePNG(192, false));\nfs.writeFileSync(path.join(\"public\", \"pwa-512x512.png\"), generatePNG(512, false));\nfs.writeFileSync(path.join(\"public\", \"pwa-maskable-512x512.png\"), generatePNG(512, true));\nfs.writeFileSync(path.join(\"public\", \"apple-touch-icon.png\"), generatePNG(180, true));\nconsole.log(\"Generated PWA PNG icons successfully\");\n\'"
    shell_name: "bash"
