    command_line: "node -e \"\nconst fs = require(\'fs\');\nconst path = require(\'path\');\n\nfunction flatten(obj, prefix = \'\') {\n  const out = [];\n  for (const [k, v] of Object.entries(obj)) {\n    const full = prefix ? prefix + \'.\' + k : k;\n    if (v && typeof v === \'object\' && !Array.isArray(v)) out.push(...flatten(v, full));\n    else out.push(full);\n  }\n  return out.sort();\n}\n\nconst en = JSON.parse(fs.readFileSync(\'src/i18n/en.json\', \'utf8\'));\nconst hi = JSON.parse(fs.readFileSync(\'src/i18n/hi.json\', \'utf8\'));\nconst enKeys = new Set(flatten(en));\nconst hiKeys = new Set(flatten(hi));\n\nconst onlyEn = [...enKeys].filter(k => !hiKeys.has(k));\nconst onlyHi = [...hiKeys].filter(k => !enKeys.has(k));\n\nconst usedKeys = new Set();\nfunction walk(dir) {\n  for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {\n    const p = path.join(dir, entry.name);\n    if (entry.isDirectory()) walk(p);\n    else if (/\\.(ts|tsx)$/.test(entry.name)) {\n      const content = fs.readFileSync(p, \'utf8\');\n      for (const m of content.matchAll(/\\bt\\(\\s*[\'\\\"]([a-zA-Z0-9_.]+)[\'\\\"]/g)) {\n        usedKeys.add(m[1]);\n      }\n    }\n  }\n}\nwalk(\'src\');\nconst missingEn = [...usedKeys].filter(k => !enKeys.has(k));\nconst missingHi = [...usedKeys].filter(k => !hiKeys.has(k));\n\nconsole.log(\'EN keys:\', enKeys.size, \'| HI keys:\', hiKeys.size);\nconsole.log(\'Only in EN:\', onlyEn.length, onlyEn);\nconsole.log(\'Only in HI:\', onlyHi.length, onlyHi);\nconsole.log(\'Missing from EN:\', missingEn.length, missingEn);\nconsole.log(\'Missing from HI:\', missingHi.length, missingHi);\n\" && grep -rnEi \'\\blate\\b|lateAfter|markedLate|lateDays|lateToday|biometric|liveness|embedding|faceRecog\' src/ firestore.rules || true"
    proposed_command_line: "node -e \"\nconst fs = require(\'fs\');\nconst path = require(\'path\');\n\nfunction flatten(obj, prefix = \'\') {\n  const out = [];\n  for (const [k, v] of Object.entries(obj)) {\n    const full = prefix ? prefix + \'.\' + k : k;\n    if (v && typeof v === \'object\' && !Array.isArray(v)) out.push(...flatten(v, full));\n    else out.push(full);\n  }\n  return out.sort();\n}\n\nconst en = JSON.parse(fs.readFileSync(\'src/i18n/en.json\', \'utf8\'));\nconst hi = JSON.parse(fs.readFileSync(\'src/i18n/hi.json\', \'utf8\'));\nconst enKeys = new Set(flatten(en));\nconst hiKeys = new Set(flatten(hi));\n\nconst onlyEn = [...enKeys].filter(k => !hiKeys.has(k));\nconst onlyHi = [...hiKeys].filter(k => !enKeys.has(k));\n\nconst usedKeys = new Set();\nfunction walk(dir) {\n  for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {\n    const p = path.join(dir, entry.name);\n    if (entry.isDirectory()) walk(p);\n    else if (/\\.(ts|tsx)$/.test(entry.name)) {\n      const content = fs.readFileSync(p, \'utf8\');\n      for (const m of content.matchAll(/\\bt\\(\\s*[\'\\\"]([a-zA-Z0-9_.]+)[\'\\\"]/g)) {\n        usedKeys.add(m[1]);\n      }\n    }\n  }\n}\nwalk(\'src\');\nconst missingEn = [...usedKeys].filter(k => !enKeys.has(k));\nconst missingHi = [...usedKeys].filter(k => !hiKeys.has(k));\n\nconsole.log(\'EN keys:\', enKeys.size, \'| HI keys:\', hiKeys.size);\nconsole.log(\'Only in EN:\', onlyEn.length, onlyEn);\nconsole.log(\'Only in HI:\', onlyHi.length, onlyHi);\nconsole.log(\'Missing from EN:\', missingEn.length, missingEn);\nconsole.log(\'Missing from HI:\', missingHi.length, missingHi);\n\" && grep -rnEi \'\\blate\\b|lateAfter|markedLate|lateDays|lateToday|biometric|liveness|embedding|faceRecog\' src/ firestore.rules || true"
