ct({\\n        org,\\n        role: targetRole,\\n        managerId: assignedManagerId,\\n        name: formName,\\n        email: formEmail,\\n        phone: formPhone,\\n        rollNumber: formRoll,\\n      });\"}, {\"AllowMultiple\":false, \"EndLine\":322, \"ReplacementContent\":\"        const parsed: CsvPreviewRow[] = res.data.map((row, idx) => {\\n          const name = (row.name || row.Name || \'\').trim();\\n          const englishName = (row.englishName || row.english_name || row[\'English Name\'] || \'\').trim();\\n          const email = (row.email || row.Email || \'\').trim().toLowerCase();\\n          const phone = (row.phone || row.Phone || \'\').trim();\\n          const rollNumber = (row.rollNumber || row.roll || row.employeeId || \'\').trim();\\n\\n          let error: string | undefined;\\n          if (!name) error = t(\'people.csvMissingName\');\\n          else if (needsEnglishNameForId(name) && needsEnglishNameForId(englishName)) {\\n            error = t(\'errors.englishNameRequired\');\\n          } else if (!email || !/^[^\\\\s@]+@[^\\\\s@]+\\\\.[^\\\\s@]+$/.test(email)) {\\n            error = t(\'people.csvInvalidEmail\');\\n          } else if (seenEmails.has(email)) {\\n            error = t(\'errors.emailInUse\');\\n          } else {\\n            seenEmails.add(email);\\n          }\\n\\n          return { rowNum: idx + 1, name, englishName, email, phone, rollNumber, error };\\n        });\\n        setCsvRows(parsed);\\n      },\\n    });\\n  };\\n\\n  const handleDownloadSampleCsv = () => {\\n    const csv =\\n      \'name,email,phone,rollNumber,englishName\\\\nAarav Sharma,aarav@example.com,9810012345,101,\\\\n\340\244\246\340\245\200\340\244\257\340\244\276 \340\244\252\340\244\237\340\245\207\340\244\262,diya@example.com,9810012346,102,Diya Patel\\\\n\';\", \"StartLine\":295, \"TargetContent\":\"        const parsed: CsvPreviewRow[] = res.data.map((row, idx) => {\\n          const name = (row.name || row.Name || \'\').trim();\\n