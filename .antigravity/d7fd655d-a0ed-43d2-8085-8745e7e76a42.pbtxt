  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { Link } from \'react-router-dom\';\nimport { sendPasswordResetEmail } from \'firebase/auth\';\nimport { auth } from \'../firebase\';\nimport { useTranslation } from \'../hooks/useTranslation\';\nimport { getFirebaseErrorKey } from \'../utils/helpers\';\nimport { Logo } from \'../components/Logo\';\nimport { LanguageToggle } from \'../components/LanguageToggle\';\nimport { ThemeToggle } from \'../components/ThemeToggle\';\n\nexport const ForgotPasswordPage: React.FC = () => {\n  const { t } = useTranslation();\n  const [email, setEmail] = useState(\'\');\n  const [sent, setSent] = useState(false);\n  const [error, setError] = useState(\'\');\n  const [loading, setLoading] = useState(false);\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setError(\'\');\n    setLoading(true);\n    try {\n      await sendPasswordResetEmail(auth, email.trim().toLowerCase());\n      setSent(true);\n    } catch (err) {\n      setError(t(getFirebaseErrorKey(err)));\n    } finally {\n      setLoading(false);\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen bg-[#FAF9F6] dark:bg-[#0F0F11] flex flex-col\">\n      <header className=\"max-w-6xl w-full mx-auto px-4 sm:px-6 h-16 flex items-center justify-between\">\n        <Link to=\"/\">\n          <Logo />\n        </Link>\n        <div className=\"flex items-center gap-2\">\n          <LanguageToggle />\n          <ThemeToggle />\n        </div>\n      </header>\n\n      <main className=\"flex-1 flex items-center justify-center px-4 py-12\">\n        <div className=\"w-full max-w-md rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-6 sm:p-8 shadow-xs\">\n          <h1 className=\"text-2xl font-bold tracking-tight text-stone-900 dark:text-stone-100\">\n            {t(\'auth.forgotTitle\')}\n          </h1>\n          <p className=\"mt-1.5 text-sm text-stone-500 dark:text-stone-400\">\n            {t(\'auth.forgotSubtitle\')}\n          </p>\n\n          {error && (\n            <div className=\"mt-5 rounded-xl border border-red-200 dark:border-red-900 bg-red-50 dark:bg-red-950/40 px-4 py-3 text-sm text-red-700 dark:text-red-300\">\n              {error}\n            </div>\n          )}\n\n          {sent ? (\n            <div className=\"mt-6 rounded-xl border border-emerald-200 dark:border-emerald-900 bg-emerald-50 dark:bg-emerald-950/30 px-4 py-4 text-sm text-emerald-800 dark:text-emerald-300\">\n              {t(\'auth.resetSent\')}\n            </div>\n          ) : (\n            <form onSubmit={handleSubmit} className=\"mt-6 space-y-4\">\n              <div>\n                <label className=\"block text-sm font-medium text-stone-700 dark:text-stone-300 mb-1.5\">\n                  {t(\'auth.emailLabel\')}\n                </label>\n                <input\n                  type=\"email\"\n                  required\n                  value={email}\n                  onChange={(e) => setEmail(e.target.value)}\n                  className=\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-transparent px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#C25E00]/30 focus:border-[#C25E00]\"\n                />\n              </div>\n              <button\n                type=\"submit\"\n                disabled={loading}\n                className=\"w-full rounded-xl bg-[#C25E00] hover:bg-[#A84F00] disabled:opacity-60 text-white py-2.5 text-sm font-medium transition-colors\"\n              >\n                {loading ? t(\'common.loading\') : t(\'auth.sendResetBtn\')}\n              </button>\n            </form>\n          )}\n\n          <p className=\"mt-6 text-center text-sm\">\n            <Link to=\"/login\" className=\"font-medium text-[#C25E00] hover:underline\">\n              {t(\'auth.backToLogin\')}\n            </Link>\n          </p>\n        </div>\n      </main>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/pages/ForgotPasswordPage.tsx"
        }
        overwrite: true
      }
    }
