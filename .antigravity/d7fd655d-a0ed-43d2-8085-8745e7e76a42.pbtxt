      arguments_json: "{\"CodeContent\":\"{\\n  \\\"brand\\\": \\\"\340\244\270\340\245\215\340\244\256\340\244\276\340\244\260\340\245\215\340\244\237 \340\244\271\340\244\276\340\244\234\340\244\274\340\244\277\340\244\260\340\245\200\\\",\\n  \\\"brandFull\\\": \\\"\340\244\270\340\245\215\340\244\256\340\244\276\340\244\260\340\245\215\340\244\237 \340\244\205\340\244\237\340\245\207\340\244\202\340\244\241\340\245\207\340\244\202\340\244\270 \340\244\270\340\244\277\340\244\270\340\245\215\340\244\237\340\244\256\\\",\\n  \\\"common\\\": {\\n    \\\"loading\\\": \\\"\340\244\262\340\245\213\340\244\241 \340\244\271\340\245\213 \340\244\260\340\244\271\340\244\276 \340\244\271\340\245\210...\\\",\\n    \\\"save\\\": \\\"\340\244\270\340\245\207\340\244\265 \340\244\225\340\244\260\340\245\207\340\244\202\\\",\\n    \\\"saving\\\": \\\"\340\244\270\340\245\207\340\244\265 \340\244\271\340\245\213 \340\244\260\340\244\271\340\244\276 \340\244\271\340\245\210...\\\",\\n    \\\"saved\\\": \\\"\340\244\270\340\244\253\340\244\262\340\244\244\340\244\276\340\244\252\340\245\202\340\244\260\340\245\215\340\244\265\340\244\225 \340\244\270\340\245\207\340\244\265 \340\244\271\340\245\213 \340\244\227\340\244\257\340\244\276\340\245\244\\\",\\n    \\\"deleted\\\": \\\"\340\244\270\340\244\253\340\244\262\340\244\244\340\244\276\340\244\252\340\245\202\340\244\260\340\245\215\340\244\265\340\244\225 \340\244\271\340\244\237\340\244\276\340\244\257\340\244\276 \340\244\227\340\244\257\340\244\276\340\245\244\\\",\\n    \\\"cancel\\\": \\\"\340\244\260\340\244\246\340\245\215\340\244\246 \340\244\225\340\244\260\340\245\207\340\244\202\\\",\\n    \\\"delete\\\": \\\"\340\244\271\340\244\237\340\244\276\340\244\217\340\244\201\\\",\\n    \\\"edit\\\": \\\"\340\244\254\340\244\246\340\244\262\340\245\207\340\244\202\\\",\\n    \\\"add\\\": \\\"\340\244\234\340\245\213\340\244\241\340\244\274\340\245\207\340\244\202\\\",\\n    \\\"close\\\": \\\"\340\244\254\340\244\202\340\24