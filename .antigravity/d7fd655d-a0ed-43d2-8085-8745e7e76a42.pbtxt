3\357clV\345\215\335\203HA\347\222m\025w`\247\350\330\300s(5H@=\276)j\240S\003}\315\372\206\226}\345]\260\037-\256\226\216&2#\204-\001t\371\332\033=\355\250\017e\354~w\021\317\032\271\231\210K\271\216JB\267y\351\201~BY\a\227q\264:U\3125\025\323(D\227\0016&\023\335\\{Pt\026\316\215\351@\305\264\vU\031\222\340D\352\304\021\330+#\212\337P\037\321\005\2526b\360B\204\324\037.\017\024\255\f}~\302\301l\207r{\211\316\246\225[\t\230\327\"\026bn\036\035i\270\361L\302\r\tv\211\225\005\357\266\250\245J8\223\302\020\247\023:4\366\225(U\n\300\310\v\273\320n\2132\343\206\b\030\271{\235Y}\337U\253?\253\210\246\0043M\211\270\024&\377$\261\373\302(\277\334\244\276\350\356\034\t\223\325\355\217\357d\350\273\236\263\'\217\245+\005\244Ew\234\371P\356W4\a\350\r\245OM3\311 \347\313fj\034?\274\340\351mx%\003\341\362\305\367\002=\3040\205\205NR5\353\177(\215\002g1p\371\204\263\273\371\301\376\234\\\377\377\300`,\211r~b\237=\232^\236\265q\301\340\231\352\261\223\322a:\254*\205n\207\3229B\315\336\353\231\006\362\255\231\372 \032\254\210Vn\221\275*\215\005\002\'j\031+\310I\033)u\373\225\\6yK\321\210\244I\371Bv\221\001\264\0272\210e\rQd\372\255\bw3\a`\362\330X\006\242\270 w\354i\226i\340N\253\317\212j\302 \355\227\211LkY\030\332\335hd\320\021\265Y\242\203\346d\307\340V\035u\b|=\247\223\326iC\034\326\316)\316A\340C5\243{\272\316(P \210\004\267\033F&N%\024\005c\225\276:\361C\222\316\214m\370\301\177E\335\273\344Z5\336\313\031\335a\220\271\314\245!\271h+9<\300\350k\310\0067CP\244\224\326\224\030\371\313\004\006\275\332\243\035\273\355^\302\201\034F3\247\032o\311\211\245\306\3018\244\321l\347E\366GE\377I|] \362\216\v\037\244\264_\256\372\000\036\331\004\331\afA\f\276\252\'\254~\312\314\241?V\037\275\365E\322\3263\333he\357c&\325\215\245 \366\264d7\360\343g\326\373\315\310\0166\256n\233\2741\371\207\252\316\276\233\033\214\313\021\235\316\032\235C\257\301\220\2413#d\367;\362\263\371=@\355\207\017\217\aK\374\215\333\fQ07]\336\257\v\230\260\366\262?\337\366[\376|\347\021\220\311_\332{\270GJ\003\357\313\"\366M\225v(\023h\343u\327\314S\270\n\031\0064S\222g\312\004\211:\302\023\357e\016SD\267P\215\277\360\277\207\020\253\267k\021\363c\vb\276\373(k\234\303\322\231\317hM\006\254\002\243)3\321\232\023\312n\177\216\322p\307\341[\232$\002\374\006\266\351\343r\3758\213W\243\231\231\217\352\357%\323\306d\005\244\351\0358Ec\273\241[\025d!h\024\3162\335]\317\n\252nQtJ\006D\343r\nd\225\303\367\257\366$E\346\212\367\372q2e\217\326\025\241E[U\272\322{\315i7\'/\"\344\230\337e\256\330\220a\225\274\205/+\2202\334\320\001G|IJx\320\256\372I+\f\273i\274\214C\241|\364\0220H\266\273\227\'\247\262[k\350\243\366*\375\234mV_\214\266L\210\351\020\350\205Fv!\333\306\340\016\372>\225\a]\256E\336\334\302\253\3744\366\v\202\363\203\244\313:\271\177\302\203\3666\371m\261\317\304\357\n\257\244\254\237\337\341I\361\270o\205\366P\0317\020B\351\253wF+UA\321\234\256%\303v\023\267\242\357\323\277P\371\033X\016\310\222\265\365\334\274\240.\301h2\277\373dL+\216\205\301\333\260>U\374\255\2627\003\321\017d\b}+\337\261\207\205=/\024\352/Aw\254\taY\213\300\0031y\003\241B\313\022\335\231\225\311h\263z/\305\227<w\247\025\206\310\026<\317\037\0357\265N\375z\037\313\342O\267\314\374l\026ST|t\351\024\356zg!b\272\304\017\272\036\304\243\266D\254\241\377\323\362\f\001\242j\a\002`\233\330\341K\326\241\306\245\274<\246\035\034_u\312W~\006\346\334\373;\362\340\366\a\304\331\224\004\034\303wnF\317Gh\236H\210N\b\\\252\220 W\005\334\001I6K\316\307+\245qC\360G\325\035\213\231\310\324\001\224?Q\265\265\031L]\021\341L4l\201\001\340\271\236~\024\037\221\200s\025\323\005\372\204e\266\243\f\254\361\213\247|\251\277\304-sf}\275)\210W\243\022\354\024I\353{\0245p\254\335/\306/\323\220T\231_\261\206i\037\321\000\207\355\222\v\211\354?\255\340\032\222\335h\tZ\337A\237\"\242\225O\200I\354\321;ac\375]K.\331\342\245\350$U\272\314\220\230?b\024>\373%\366G\243H+\362\034a\273-\023\3770\3368\361j]\352\256c\221\272\204h\022\257\327\027\257Tt\032S\324\226\274\021[\307\201\210l\023\273\253\325>\353\257\326\377#\261\027?@\030\347]4\324\275\241\aBF\210%\"\310h\022\020\0064I\326\254r\222s\177\237\346\031%X\2434\026\252\"\213m6\022\227\324\301clX\017\223\377\304\'S\322\214A\023b\377\372M~\356\361\260\255\340\310\260}I0fNG8\377\332}N\025a\342\213(:\3452~\325\243G\306\304#\243Xc\215\302\025_I1\005\021\264\251\261\210"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_5284555610896261428"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useCallback, useEffect, useMemo, useState } from \'react\';\\nimport { Link } from \'react-router-dom\';\\nimport {\\n  ResponsiveContainer,\\n  BarChart,\\n  Bar,\\n  XAxis,\\n  YAxis,\\n  Tooltip,\\n  CartesianGrid,\\n} from \'recharts\';\\nimport { Check, Copy, QrCode, ScanLine, X } from \'lucide-react\';\\nimport { useAuth } from \'../context/AuthContext\';\\nimport { useTranslation } from \'../hooks/useTranslation\';\\nimport { useToast } from \'../context/ToastContext\';\\nimport type { Announcement, AttendanceRecord, LeaveRequest, UserProfile } from \'../types\';\\nimport {\\n  approvePendingUser,\\n  fetchManagerMembers,\\n  rejectPendingUser,\\n} from \'../services/userService\';\\nimport { fetchAttendanceForManager } from \'../services/attendanceService\';\\nimport { fetchLeavesForUser } from \'../services/leaveService\';\\nimport { fetchAnnouncements } from \'../services/communicationService\';\\nimport { getOrgDateString, getPastDates, getFirebaseErrorKey } from \'../utils/helpers\';\\nimport { Layout } from \'../components/Layout\';\\nimport { QRCardModal } from \'../components/QRCardModal\';\\nimport { CardSkeleton, StatGridSkeleton } from \'../components/Skeletons\';\\n\\nexport const ManagerDashboard: React.FC = () => {\\n  const { profile, org, getRoleLabel } = useAuth();\\n  const { t, formatDate, formatNumber } = useTranslation();\\n  const { showToast } = useToast();\\n\\n  const [loading, setLoading] = useState(true);\\n  const [members, setMembers] = useState<UserProfile[]>([]);\\n  const [attendance, setAttendance] = useState<AttendanceRecord[]>([]);\\n  const [pendingLeaves, setPendingLeaves] = useState<LeaveRequest[]>([]);\\n  const [announcements, setAnnouncements] = useState<Announcement[]>([]);\\n  const [showQrModal, setShowQrModal] = useState(false);\\n  const [copied, setCopied] = useState(false);\\n\\n  const today = useMemo(() => getOrgDateString(org?.timezone || \'Asia/Kolkata\'), [org?.timezone]);\\n  const managerLabel = getRoleLabel(\'manager\');\\n  const memberLabel = getRoleLabel(\'member\');\\n  const threshold = org?.lowAttendanceThreshold ?? 75;\\n\\n  const loadData = useCallback(async () => {\\n    if (!org || !profile) return;\\n    setLoading(true);\\n    try {\\n      const fromDate = getPastDates(30, org.timezone)[0];\\n      const [myMembers, attRecs, leavesRes, notices] = await Promise.all([\\n        fetchManagerMembers(org.id, profile.uid),\\n        fetchAttendanceForManager(org.id, profile.uid, { fromDate, toDate: today }),\\n        fetchLeavesForUser(profile),\\n        fetchAnnouncements(profile),\\n      ]);\\n      setMembers(myMembers);\\n      setAttendance(attRecs);\\n      setPendingLeaves(leavesRes.teamLeaves.filter((l) => l.status === \'pending\'));\\n      setAnnouncements(notices.slice(0, 4));\\n    } catch (err) {\\n      showToast(t(getFirebaseErrorKey(err)), \'error\');\\n    } finally {\\n      setLoading(false);\\n    }\\n  }, [org, profile, today, showToast, t]);\\n\\n  useEffect(() => {\\n    loadData();\\n  }, [loadData]);\\n\\n  const activeMembers = useMemo(() => members.filter((m) => m.status === \'active\'), [members]);\\n  const pendingMembers = useMemo(() => members.filter((m) => m.status === \'pending\'), [members]);\\n\\n  const todayStats = useMemo(() => {\\n    let present = 0;\\n    let late = 0;\\n    let absent = 0;\\n    for (const r of attendance) {\\n      if (r.date !== today) continue;\\n      if (r.status === \'present\') present++;\\n      else if (r.status === \'late\') late++;\\n      else if (r.status === \'absent\') absent++;\\n    }\\n    return { present, late, absent };\\n  }, [attendance, today]);\\n\\n  const weeklyChart = useMemo(() => {\\n    const dates = getPastDates(7, org?.timezone || \'Asia/Kolkata\');\\n    const byDate = new Map<string, { present: number; late: number; absent: number }>();\\n    for (const d of dates) byDate.set(d, { present: 0, late: 0, absent: 0 });\\n    for (const r of attendance) {\\n      const b = byDate.get(r.date);\\n      if (!b) continue;\\n      if (r.status === \'present\') b.present++;\\n      else if (r.status === \'late\') b.late++;\\n      else if (r.status === \'absent\') b.absent++;\\n    }\\n    return dates.map((d) => ({\\n      date: formatDate(d, { weekday: \'short\', day: \'numeric\' }),\\n      ...byDate.get(d)!,\\n    }));\\n  }, [attendance, org?.timezone, formatDate]);\\n\\n  // Members below configurable threshold over past 30 days\\n  const lowAttendanceList = useMemo(() => {\\n    const statsByUid = new Map<string, { attended: number; total: number }>();\\n    for (const r of attendance) {\\n      const cur = statsByUid.get(r.personUid) || { attended: 0, total: 0 };\\n      cur.total++;\\n      if (r.status === \'present\' || r.status === \'late\') cur.attended++;\\n      statsByUid.set(r.personUid, cur);\\n    }\\n    return activeMembers\\n      .map((m) => {\\n        const s = statsByUid.get(m.uid);\\n        if (!s || s.total === 0) return null;\\n        const pct = Math.round((s.attended / s.total) * 100);\\n        return { member: m, pct, attended: s.attended, total: s.total };\\n      })\\n      .filter((x): x is NonNullable<typeof x> => x !== null && x.pct < threshold)\\n      .sort((a, b) => a.pct - b.pct);\\n  }, [activeMembers, attendance, threshold]);\\n\\n  const handleCopyCode = () => {\\n    if (!profile?.managerCode) return;\\n    navigator.clipboard.writeText(profile.managerCode);\\n    setCopied(true);\\n    setTimeout(() => setCopied(false), 1800);\\n  };\\n\\n  const handleApprove = async (m: UserProfile) => {\\n    if (!org) return;\\n    try {\\n      await approvePendingUser(org, m);\\n      showToast(t(\'people.approvedToast\'), \'success\');\\n      await loadData();\\n    } catch (err) {\\n      showToast(t(getFirebaseErrorKey(err)), \'error\');\\n    }\\n  };\\n\\n  const handleReject = async (m: UserProfile) => {\\n    if (!org) return;\\n    try {\\n      await rejectPendingUser(org.id, m);\\n      showToast(t(\'people.rejectedToast\'), \'info\');\\n      await loadData();\\n    } catch (err) {\\n      showToast(t(getFirebaseErrorKey(err)), \'error\');\\n    }\\n  };\\n\\n  return (\\n    <Layout title={t(\'nav.dashboard\')}>\\n      <div className=\\\"space-y-8\\\">\\n        <div className=\\\"flex flex-col sm:flex-row sm:items-end justify-between gap-4\\\">\\n          <div>\\n            <p className=\\\"text-sm text-stone-500 dark:text-stone-400\\\">\\n              {formatDate(today, { weekday: \'long\', day: \'numeric\', month: \'long\' })}\\n            </p>\\n            <h2 className=\\\"mt-1 text-2xl sm:text-3xl font-bold tracking-tight text-stone-900 dark:text-stone-50\\\">\\n              {t(\'dashboard.welcome\')}, {profile?.name}\\n            </h2>\\n          </div>\\n\\n          <div className=\\\"flex flex-wrap items-center gap-2.5\\\">\\n            {profile?.managerCode && (\\n              <div className=\\\"flex items-center gap-2 rounded-xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] px-3 py-2\\\">\\n                <span className=\\\"text-xs text-stone-500 dark:text-stone-400\\\">\\n                  {t(\'dashboard.yourManagerCode\')}\\n                </span>\\n                <span className=\\\"font-mono text-sm font-semibold text-stone-900 dark:text-stone-100\\\">\\n                  {profile.managerCode}\\n                </span>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={handleCopyCode}\\n                  aria-label={t(\'common.copy\')}\\n                  className=\\\"text-stone-400 hover:text-[#C25E00]\\\"\\n                >\\n                  {copied ? <Check className=\\\"w-4 h-4 text-emerald-600\\\" /> : <Copy className=\\\"w-4 h-4\\\" />}\\n                </button>\\n              </div>\\n            )}\\n\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => setShowQrModal(true)}\\n              className=\\\"inline-flex items-center gap-2 rounded-xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] hover:bg-stone-50 dark:hover:bg-stone-800 px-3.5 py-2.5 text-sm font-medium transition-colors\\\"\\n            >\\n              <QrCode className=\\\"w-4 h-4 text-[#C25E00]\\\" />\\n              <span>{t(\'dashboard.showQr\')}</span>\\n            </button>\\n\\n            <Link\\n              to=\\\"/attendance\\\"\\n              className=\\\"inline-flex items-center gap-2 rounded-xl bg-[#C25E00] hover:bg-[#A84F00] text-white px-4 py-2.5 text-sm font-medium transition-colors\\\"\\n            >\\n              <ScanLine className=\\\"w-4 h-4\\\" />\\n              <span>{t(\'dashboard.markNow\')}</span>\\n            </Link>\\n          </div>\\n        </div>\\n\\n        {/* Stats */}\\n        {loading ? (\\n          <StatGridSkeleton />\\n        ) : (\\n          <div className=\\\"grid grid-cols-2 lg:grid-cols-4 gap-4\\\">\\n            <div className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5\\\">\\n              <p className=\\\"text-xs font-medium text-stone-500 dark:text-stone-400\\\">\\n                {memberLabel}\\n              </p>\\n              <p className=\\\"mt-2 text-3xl font-bold tabular-nums text-stone-900 dark:text-stone-50\\\">\\n                {formatNumber(activeMembers.length)}\\n              </p>\\n            </div>\\n            <div className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5\\\">\\n              <p className=\\\"text-xs font-medium text-stone-500 dark:text-stone-400\\\">\\n                {t(\'dashboard.presentToday\')}\\n              </p>\\n              <p className=\\\"mt-2 text-3xl font-bold tabular-nums text-emerald-700 dark:text-emerald-400\\\">\\n                {formatNumber(todayStats.present)}\\n              </p>\\n            </div>\\n            <div className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5\\\">\\n              <p className=\\\"text-xs font-medium text-stone-500 dark:text-stone-400\\\">\\n                {t(\'dashboard.lateToday\')}\\n              </p>\\n              <p className=\\\"mt-2 text-3xl font-bold tabular-nums text-amber-700 dark:text-amber-400\\\">\\n                {formatNumber(todayStats.late)}\\n              </p>\\n            </div>\\n            <div className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5\\\">\\n              <p className=\\\"text-xs font-medium text-stone-500 dark:text-stone-400\\\">\\n                {t(\'dashboard.absentToday\')}\\n              </p>\\n              <p className=\\\"mt-2 text-3xl font-bold tabular-nums text-red-700 dark:text-red-400\\\">\\n                {formatNumber(todayStats.absent)}\\n              </p>\\n            </div>\\n          </div>\\n        )}\\n\\n        {/* Weekly Chart */}\\n        <section className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5 sm:p-6\\\">\\n          <h3 className=\\\"text-base font-semibold text-stone-900 dark:text-stone-100 mb-5\\\">\\n            {t(\'dashboard.attendanceTrend\')} \302\267 {t(\'dashboard.last7Days\')}\\n          </h3>\\n          <div className=\\\"h-60 w-full\\\">\\n            <ResponsiveContainer width=\\\"100%\\\" height=\\\"100%\\\">\\n              <BarChart data={weeklyChart} margin={{ top: 4, right: 8, left: -20, bottom: 0 }}>\\n                <CartesianGrid strokeDasharray=\\\"3 3\\\" stroke=\\\"#E7E5E4\\\" opacity={0.4} vertical={false} />\\n                <XAxis dataKey=\\\"date\\\" tick={{ fontSize: 11, fill: \'#78716C\' }} axisLine={false} tickLine={false} />\\n                <YAxis allowDecimals={false} tick={{ fontSize: 11, fill: \'#78716C\' }} axisLine={false} tickLine={false} />\\n                <Tooltip contentStyle={{ borderRadius: \'12px\', border: \'1px solid #E7E5E4\', fontSize: \'12px\' }} />\\n                <Bar dataKey=\\\"present\\\" name={t(\'common.present\')} stackId=\\\"a\\\" fill=\\\"#15803D\\\" />\\n                <Bar dataKey=\\\"late\\\" name={t(\'common.late\')} stackId=\\\"a\\\" fill=\\\"#D97706\\\" />\\n                <Bar dataKey=\\\"absent\\\" name={t(\'common.absent\')} stackId=\\\"a\\\" fill=\\\"#DC2626\\\" radius={[4, 4, 0, 0]} />\\n              </BarChart>\\n            </ResponsiveContainer>\\n          </div>\\n        </section>\\n\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6\\\">\\n          {/* Low Attendance List */}\\n          <section className=\\\"lg:col-span-6 rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5 sm:p-6\\\">\\n            <div className=\\\"flex items-center justify-between mb-4\\\">\\n              <h3 className=\\\"text-base font-semibold text-stone-900 dark:text-stone-100\\\">\\n                {t(\'dashboard.lowAttendance\')}\\n              </h3>\\n              <span className=\\\"text-xs text-stone-500 dark:text-stone-400 tabular-nums\\\">\\n                {t(\'dashboard.belowThreshold\')} {threshold}%\\n              </span>\\n            </div>\\n\\n            {loading ? (\\n              <CardSkeleton rows={3} />\\n            ) : lowAttendanceList.length === 0 ? (\\n              <p className=\\\"text-sm text-stone-500 dark:text-stone-400 py-4\\\">\\n                {t(\'dashboard.noLowAttendance\')}\\n              </p>\\n            ) : (\\n              <div className=\\\"divide-y divide-stone-100 dark:divide-stone-800\\\">\\n                {lowAttendanceList.map((item) => (\\n                  <div key={item.member.uid} className=\\\"py-3 flex items-center justify-between gap-3\\\">\\n                    <div className=\\\"min-w-0\\\">\\n                      <p className=\\\"text-sm font-medium text-stone-900 dark:text-stone-100 truncate\\\">\\n                        {item.member.name}\\n                      </p>\\n                      <p className=\\\"text-xs font-mono text-stone-500 dark:text-stone-400\\\">\\n                        {item.member.memberId} \302\267 {item.attended}/{item.total}\\n                      </p>\\n                    </div>\\n                    <span className=\\\"text-sm font-semibold tabular-nums text-red-700 dark:text-red-400\\\">\\n                      {item.pct}%\\n                    </span>\\n                  </div>\\n                ))}\\n              </div>\\n            )}\\n          </section>\\n\\n          {/* Pending Leaves + Pending Approvals + Notices */}\\n          <div className=\\\"lg:col-span-6 space-y-6\\\">\\n            {pendingMembers.length > 0 && (\\n              <section className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5 sm:p-6\\\">\\n                <h3 className=\\\"text-base font-semibold text-stone-900 dark:text-stone-100 mb-3\\\">\\n                  {t(\'dashboard.pendingApprovals\')} ({pendingMembers.length})\\n                </h3>\\n                <div className=\\\"divide-y divide-stone-100 dark:divide-stone-800\\\">\\n                  {pendingMembers.map((m) => (\\n                    <div key={m.uid} className=\\\"py-2.5 flex items-center justify-between gap-2\\\">\\n                      <div className=\\\"min-w-0\\\">\\n                        <p className=\\\"text-sm font-medium truncate\\\">{m.name}</p>\\n                        <p className=\\\"text-xs text-stone-500 truncate\\\">{m.email}</p>\\n                      </div>\\n                      <div className=\\\"flex items-center gap-1.5\\\">\\n                        <button\\n                          type=\\\"button\\\"\\n                          onClick={() => handleApprove(m)}\\n                          className=\\\"rounded-lg bg-emerald-600 text-white px-2.5 py-1 text-xs font-medium\\\"\\n                        >\\n                          {t(\'dashboard.approve\')}\\n                        </button>\\n                        <button\\n                          type=\\\"button\\\"\\n                          onClick={() => handleReject(m)}\\n                          className=\\\"rounded-lg border border-stone-200 dark:border-stone-700 p-1 text-stone-500 hover:text-red-600\\\"\\n                        >\\n                          <X className=\\\"w-3.5 h-3.5\\\" />\\n                        </button>\\n                      </div>\\n                    </div>\\n                  ))}\\n                </div>\\n              </section>\\n            )}\\n\\n            <section className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5 sm:p-6\\\">\\n              <div className=\\\"flex items-center justify-between mb-3\\\">\\n                <h3 className=\\\"text-base font-semibold text-stone-900 dark:text-stone-100\\\">\\n                  {t(\'dashboard.pendingLeaves\')}\\n                </h3>\\n                <Link to=\\\"/leaves\\\" className=\\\"text-xs font-medium text-[#C25E00] hover:underline\\\">\\n                  {t(\'dashboard.viewAll\')}\\n                </Link>\\n              </div>\\n              {pendingLeaves.length === 0 ? (\\n                <p className=\\\"text-sm text-stone-500 dark:text-stone-400\\\">\\n                  {t(\'dashboard.noPendingLeaves\')}\\n                </p>\\n              ) : (\\n                <div className=\\\"divide-y divide-stone-100 dark:divide-stone-800\\\">\\n                  {pendingLeaves.slice(0, 4).map((l) => (\\n                    <div key={l.id} className=\\\"py-2.5\\\">\\n                      <p className=\\\"text-sm font-medium text-stone-900 dark:text-stone-100\\\">\\n                        {l.personName}\\n                      </p>\\n                      <p className=\\\"text-xs text-stone-500 dark:text-stone-400 mt-0.5\\\">\\n                        {formatDate(l.fromDate)} \342\200\223 {formatDate(l.toDate)} \302\267 {l.reason}\\n                      </p>\\n                    </div>\\n                  ))}\\n                </div>\\n              )}\\n            </section>\\n\\n            <section className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5 sm:p-6\\\">\\n              <div className=\\\"flex items-center justify-between mb-3\\\">\\n                <h3 className=\\\"text-base font-semibold text-stone-900 dark:text-stone-100\\\">\\n                  {t(\'dashboard.recentAnnouncements\')}\\n                </h3>\\n                <Link to=\\\"/announcements\\\" className=\\\"text-xs font-medium text-[#C25E00] hover:underline\\\">\\n                  {t(\'dashboard.viewAll\')}\\n                </Link>\\n              </div>\\n              {announcements.length === 0 ? (\\n                <p className=\\\"text-sm text-stone-500 dark:text-stone-400\\\">\\n                  {t(\'dashboard.noAnnouncements\')}\\n                </p>\\n              ) : (\\n                <div className=\\\"space-y-3\\\">\\n                  {announcements.map((a) => (\\n                    <div\\n                      key={a.id}\\n                      className=\\\"pb-3 border-b last:border-b-0 border-stone-100 dark:border-stone-800\\\"\\n                    >\\n                      <p className=\\\"text-sm text-stone-800 dark:text-stone-200\\\">{a.text}</p>\\n                      <p className=\\\"mt-1 text-xs text-stone-400\\\">{a.fromName}</p>\\n                    </div>\\n                  ))}\\n                </div>\\n              )}\\n            </section>\\n          </div>\\n        </div>\\n      </div>\\n\\n      {showQrModal && profile && org && (\\n        <QRCardModal\\n          person={profile}\\n          org={org}\\n          roleLabel={managerLabel}\\n          onClose={() => setShowQrModal(false)}\\n        />\\n      )}\\n    </Layout>\\n  );\\n};\\n\", \"Description\":\"Create ManagerDashboard with member stats, weekly chart, low-attendance alerts, own QR modal, invite code, pending approvals and leaves\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/ManagerDashboard.tsx\", \"toolAction\":\"Creating ManagerDashboard page\", \"toolSummary\":\"Create ManagerDashboard.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_5284555610896261471"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useCallback, useEffect, useMemo, useState } from \'react\';\\nimport { QRCodeSVG } from \'qrcode.react\';\\nimport { ChevronLeft, ChevronRight, QrCode } from \'lucide-react\';\\nimport { useAuth } from \'../context/AuthContext\';\\nimport { useTranslation } from \'../hooks/useTranslation\';\\nimport { useToast } from \'../context/ToastContext\';\\nimport type { Announcement, AttendanceRecord } from \'../types\';\\nimport { fetchAttendanceForPerson } from \'../services/attendanceService\';\\nimport { fetchAnnouncements } from \'../services/communicationService\';\\nimport { getFirebaseErrorKey, getOrgDateString } from \'../utils/helpers\';\\nimport { Layout } from \'../components/Layout\';\\nimport { QRCardModal } from \'../components/QRCardModal\';\\nimport { CardSkeleton } from \'../components/Skeletons\';\\n\\nexport const MemberDashboard: React.FC = () => {\\n  const { profile, org, getRoleLabel } = useAuth();\\n  const { t, formatDate, formatNumber, language } = useTranslation();\\n  const { showToast } = useToast();\\n\\n  const [loading, setLoading] = useState(true);\\n  const [records, setRecords] = useState<AttendanceRecord[]>([]);\\n  const [announcements, setAnnouncements] = useState<Announcement[]>([]);\\n  const [showQrModal, setShowQrModal] = useState(false);\\n\\n  const today = useMemo(() => getOrgDateString(org?.timezone || \'Asia/Kolkata\'), [org?.timezone]);\\n  const [calYear, setCalYear] = useState(() => Number(today.slice(0, 4)));\\n  const [calMonth, setCalMonth] = useState(() => Number(today.slice(5, 7)) - 1); // 0-indexed\\n\\n  const memberLabel = getRoleLabel(\'member\');\\n\\n  const loadData = useCallback(async () => {\\n    if (!org || !profile) return;\\n    setLoading(true);\\n    try {\\n      const [recs, notices] = await Promise.all([\\n        fetchAttendanceForPerson(org.id, profile.uid),\\n        fetchAnnouncements(profile),\\n      ]);\\n      setRecords(recs);\\n      setAnnouncements(notices.slice(0, 4));\\n    } catch (err) {\\n      showToast(t(getFirebaseErrorKey(err)), \'error\');\\n    } finally {\\n      setLoading(false);\\n    }\\n  }, [org, profile, showToast, t]);\\n\\n  useEffect(() => {\\n    loadData();\\n  }, [loadData]);\\n\\n  const recordByDate = useMemo(() => {\\n    const map = new Map<string, AttendanceRecord>();\\n    for (const r of records) map.set(r.date, r);\\n    return map;\\n  }, [records]);\\n\\n  const todayRecord = recordByDate.get(today);\\n\\n  const monthPrefix = `${today.slice(0, 7)}`;\\n  const monthlyStats = useMemo(() => {\\n    const monthRecs = records.filter((r) => r.date.startsWith(monthPrefix));\\n    const attended = monthRecs.filter((r) => r.status === \'present\' || r.status === \'late\').length;\\n    const pct = monthRecs.length > 0 ? Math.round((attended / monthRecs.length) * 100) : 0;\\n    return { attended, total: monthRecs.length, pct };\\n  }, [records, monthPrefix]);\\n\\n  // Current consecutive streak of Present or Late\\n  const streak = useMemo(() => {\\n    const sorted = [...records].sort((a, b) => b.date.localeCompare(a.date));\\n    let count = 0;\\n    for (const r of sorted) {\\n      if (r.status === \'present\' || r.status === \'late\') {\\n        count++;\\n      } else if (r.status === \'absent\') {\\n        break;\\n      }\\n    }\\n    return count;\\n  }, [records]);\\n\\n  // Calendar Grid\\n  const calendarDays = useMemo(() => {\\n    const firstDay = new Date(calYear, calMonth, 1);\\n    const startWeekday = firstDay.getDay(); // 0=Sun\\n    const daysInMonth = new Date(calYear, calMonth + 1, 0).getDate();\\n    const cells: Array<{ day: number | null; dateStr?: string }> = [];\\n    for (let i = 0; i < startWeekday; i++) cells.push({ day: null });\\n    for (let d = 1; d <= daysInMonth; d++) {\\n      const m = String(calMonth + 1).padStart(2, \'0\');\\n      const dayStr = String(d).padStart(2, \'0\');\\n      cells.push({ day: d, dateStr: `${calYear}-${m}-${dayStr}` });\\n    }\\n    return cells;\\n  }, [calYear, calMonth]);\\n\\n  const monthHeading = new Intl.DateTimeFormat(language === \'hi\' ? \'hi-IN\' : \'en-IN\', {\\n    month: \'long\',\\n    year: \'numeric\',\\n  }).format(new Date(calYear, calMonth, 1));\\n\\n  const prevMonth = () => {\\n    if (calMonth === 0) {\\n      setCalMonth(11);\\n      setCalYear((y) => y - 1);\\n    } else {\\n      setCalMonth((m) => m - 1);\\n    }\\n  };\\n\\n  const nextMonth = () => {\\n    if (calMonth === 11) {\\n      setCalMonth(0);\\n      setCalYear((y) => y + 1);\\n    } else {\\n      setCalMonth((m) => m + 1);\\n    }\\n  };\\n\\n  const qrValue =\\n    org && profile\\n      ? JSON.stringify({ orgId: org.id, uid: profile.uid, memberId: profile.memberId })\\n      : \'\';\\n\\n  const cellColors = (status?: string) => {\\n    if (status === \'present\')\\n      return \'bg-emerald-100 dark:bg-emerald-950/60 text-emerald-900 dark:text-emerald-200 border-emerald-200 dark:border-emerald-800\';\\n    if (status === \'absent\')\\n      return \'bg-red-100 dark:bg-red-950/60 text-red-900 dark:text-red-200 border-red-200 dark:border-red-800\';\\n    if (status === \'late\' || status === \'leave\')\\n      return \'bg-amber-100 dark:bg-amber-950/60 text-amber-900 dark:text-amber-200 border-amber-200 dark:border-amber-800\';\\n    return \'bg-stone-50 dark:bg-stone-900/50 text-stone-600 dark:text-stone-400 border-stone-200/70 dark:border-stone-800\';\\n  };\\n\\n  const weekdayLabels =\\n    language === \'hi\'\\n      ? [\'\340\244\260\340\244\265\340\244\277\', \'\340\244\270\340\245\213\340\244\256\', \'\340\244\256\340\244\202\340\244\227\340\244\262\', \'\340\244\254\340\245\201\340\244\247\', \'\340\244\227\340\245\201\340\244\260\340\245\201\', \'\340\244\266\340\245\201\340\244\225\340\245\215\340\244\260\', \'\340\244\266\340\244\250\340\244\277\']\\n      : [\'Sun\', \'Mon\', \'Tue\', \'Wed\', \'Thu\', \'Fri\', \'Sat\'];\\n\\n  return (\\n    <Layout title={t(\'nav.myQr\')}>\\n      <div className=\\\"space-y-8\\\">\\n        {/* Top Row: QR Card + Key Metrics */}\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch\\\">\\n          <div className=\\\"lg:col-span-5 rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-6 flex flex-col items-center justify-between text-center\\\">\\n            <div>\\n              <p className=\\\"text-xs font-medium text-stone-500 dark:text-stone-400\\\">\\n                {org?.name}\\n              </p>\\n              <h2 className=\\\"mt-1 text-xl font-bold text-stone-900 dark:text-stone-100\\\">\\n                {profile?.name}\\n              </h2>\\n              <p className=\\\"mt-0.5 text-xs font-mono text-stone-500 dark:text-stone-400\\\">\\n                {profile?.memberId} \302\267 {memberLabel}\\n              </p>\\n            </div>\\n\\n            <div className=\\\"my-5 p-4 rounded-xl bg-white border border-stone-200\\\">\\n              {qrValue && <QRCodeSVG value={qrValue} size={172} level=\\\"M\\\" />}\\n            </div>\\n\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => setShowQrModal(true)}\\n              className=\\\"w-full inline-flex items-center justify-center gap-2 rounded-xl bg-[#C25E00] hover:bg-[#A84F00] text-white px-4 py-2.5 text-sm font-medium transition-colors\\\"\\n            >\\n              <QrCode className=\\\"w-4 h-4\\\" />\\n              <span>\\n                {t(\'qr.downloadQr\')} / {t(\'qr.printCard\')}\\n              </span>\\n            </button>\\n          </div>\\n\\n          <div className=\\\"lg:col-span-7 flex flex-col gap-4\\\">\\n            <div className=\\\"grid grid-cols-1 sm:grid-cols-3 gap-4\\\">\\n              <div className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5\\\">\\n                <p className=\\\"text-xs font-medium text-stone-500 dark:text-stone-400\\\">\\n                  {t(\'dashboard.todayStatus\')}\\n                </p>\\n                <p className=\\\"mt-2 text-2xl font-bold text-stone-900 dark:text-stone-100\\\">\\n                  {todayRecord ? t(`common.${todayRecord.status}`) : t(\'common.unmarked\')}\\n                </p>\\n              </div>\\n              <div className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5\\\">\\n                <p className=\\\"text-xs font-medium text-stone-500 dark:text-stone-400\\\">\\n                  {t(\'dashboard.myAttendanceRate\')}\\n                </p>\\n                <p className=\\\"mt-2 text-3xl font-bold tabular-nums text-stone-900 dark:text-stone-100\\\">\\n                  {formatNumber(monthlyStats.pct)}%\\n                </p>\\n                <p className=\\\"mt-1 text-xs text-stone-500 tabular-nums\\\">\\n                  {formatNumber(monthlyStats.attended)} / {formatNumber(monthlyStats.total)} {t(\'common.days\')}\\n                </p>\\n              </div>\\n              <div className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5\\\">\\n                <p className=\\\"text-xs font-medium text-stone-500 dark:text-stone-400\\\">\\n                  {t(\'dashboard.currentStreak\')}\\n                </p>\\n                <p className=\\\"mt-2 text-3xl font-bold tabular-nums text-[#C25E00]\\\">\\n                  {formatNumber(streak)}\\n                </p>\\n                <p className=\\\"mt-1 text-xs text-stone-500\\\">{t(\'common.days\')}</p>\\n              </div>\\n            </div>\\n\\n            {/* Monthly Calendar */}\\n            <section className=\\\"flex-1 rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5\\\">\\n              <div className=\\\"flex items-center justify-between mb-4\\\">\\n                <h3 className=\\\"text-base font-semibold text-stone-900 dark:text-stone-100\\\">\\n                  {monthHeading}\\n                </h3>\\n                <div className=\\\"flex items-center gap-1\\\">\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={prevMonth}\\n                    aria-label={t(\'common.previous\')}\\n                    className=\\\"p-1.5 rounded-lg border border-stone-200 dark:border-stone-800 hover:bg-stone-50 dark:hover:bg-stone-800\\\"\\n                  >\\n                    <ChevronLeft className=\\\"w-4 h-4\\\" />\\n                  </button>\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={nextMonth}\\n                    aria-label={t(\'common.next\')}\\n                    className=\\\"p-1.5 rounded-lg border border-stone-200 dark:border-stone-800 hover:bg-stone-50 dark:hover:bg-stone-800\\\"\\n                  >\\n                    <ChevronRight className=\\\"w-4 h-4\\\" />\\n                  </button>\\n                </div>\\n              </div>\\n\\n              <div className=\\\"grid grid-cols-7 gap-1.5 text-center text-[11px] font-medium text-stone-500 mb-2\\\">\\n                {weekdayLabels.map((w) => (\\n                  <div key={w}>{w}</div>\\n                ))}\\n              </div>\\n\\n              <div className=\\\"grid grid-cols-7 gap-1.5\\\">\\n                {calendarDays.map((cell, idx) => {\\n                  if (!cell.day || !cell.dateStr) return <div key={idx} />;\\n                  const rec = recordByDate.get(cell.dateStr);\\n                  return (\\n                    <div\\n                      key={cell.dateStr}\\n                      title={rec ? `${cell.dateStr}: ${t(`common.${rec.status}`)}` : cell.dateStr}\\n                      className={`h-10 rounded-lg border flex flex-col items-center justify-center text-xs font-medium tabular-nums ${cellColors(\\n                        rec?.status\\n                      )} ${cell.dateStr === today ? \'ring-2 ring-[#C25E00]\' : \'\'}`}\\n                    >\\n                      <span>{cell.day}</span>\\n                    </div>\\n                  );\\n                })}\\n              </div>\\n\\n              <div className=\\\"mt-4 flex flex-wrap items-center gap-4 text-xs text-stone-600 dark:text-stone-400\\\">\\n                <span className=\\\"inline-flex items-center gap-1.5\\\">\\n                  <span className=\\\"w-3 h-3 rounded bg-emerald-200 dark:bg-emerald-900 border border-emerald-400\\\" />\\n                  {t(\'common.present\')}\\n                </span>\\n                <span className=\\\"inline-flex items-center gap-1.5\\\">\\n                  <span className=\\\"w-3 h-3 rounded bg-red-200 dark:bg-red-900 border border-red-400\\\" />\\n                  {t(\'common.absent\')}\\n                </span>\\n                <span className=\\\"inline-flex items-center gap-1.5\\\">\\n                  <span className=\\\"w-3 h-3 rounded bg-amber-200 dark:bg-amber-900 border border-amber-400\\\" />\\n                  {t(\'common.late\')} / {t(\'common.leave\')}\\n                </span>\\n              </div>\\n            </section>\\n          </div>\\n        </div>\\n\\n        {/* History + Notices */}\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6\\\">\\n          <section className=\\\"lg:col-span-7 rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5 sm:p-6\\\">\\n            <h3 className=\\\"text-base font-semibold text-stone-900 dark:text-stone-100 mb-4\\\">\\n              {t(\'dashboard.recentHistory\')}\\n            </h3>\\n            {loading ? (\\n              <CardSkeleton rows={4} />\\n            ) : records.length === 0 ? (\\n              <p className=\\\"text-sm text-stone-500 py-4\\\">{t(\'common.noData\')}</p>\\n            ) : (\\n              <div className=\\\"divide-y divide-stone-100 dark:divide-stone-800\\\">\\n                {records.slice(0, 12).map((r) => (\\n                  <div key={r.id} className=\\\"py-3 flex items-center justify-between gap-3 text-sm\\\">\\n                    <div>\\n                      <p className=\\\"font-medium text-stone-900 dark:text-stone-100\\\">\\n                        {formatDate(r.date)}\\n                      </p>\\n                      <p className=\\\"text-xs text-stone-500\\\">\\n                        {t(`common.${r.method}`)}\\n                        {r.note ? ` \302\267 ${r.note}` : \'\'}\\n                      </p>\\n                    </div>\\n                    <span\\n                      className={`text-xs font-semibold ${\\n                        r.status === \'present\'\\n                          ? \'text-emerald-700 dark:text-emerald-400\'\\n                          : r.status === \'absent\'\\n                          ? \'text-red-700 dark:text-red-400\'\\n                          : \'text-amber-700 dark:text-amber-400\'\\n                      }`}\\n                    >\\n                      {t(`common.${r.status}`)}\\n                    </span>\\n                  </div>\\n                ))}\\n              </div>\\n            )}\\n          </section>\\n\\n          <section className=\\\"lg:col-span-5 rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5 sm:p-6\\\">\\n            <h3 className=\\\"text-base font-semibold text-stone-900 dark:text-stone-100 mb-4\\\">\\n              {t(\'dashboard.recentAnnouncements\')}\\n            </h3>\\n            {announcements.length === 0 ? (\\n              <p className=\\\"text-sm text-stone-500\\\">{t(\'dashboard.noAnnouncements\')}</p>\\n            ) : (\\n              <div className=\\\"space-y-3\\\">\\n                {announcements.map((a) => (\\n                  <div\\n                    key={a.id}\\n                    className=\\\"pb-3 border-b last:border-b-0 border-stone-100 dark:border-stone-800\\\"\\n                  >\\n                    <p className=\\\"text-sm text-stone-800 dark:text-stone-200\\\">{a.text}</p>\\n                    <p className=\\\"mt-1 text-xs text-stone-400\\\">{a.fromName}</p>\\n                  </div>\\n                ))}\\n              </div>\\n            )}\\n          </section>\\n        </div>\\n      </div>\\n\\n      {showQrModal && profile && org && (\\n        <QRCardModal\\n          person={profile}\\n          org={org}\\n          roleLabel={memberLabel}\\n          onClose={() => setShowQrModal(false)}\\n        />\\n      )}\\n    </Layout>\\n  );\\n};\\n\", \"Description\":\"Create MemberDashboard with QR code, download/print ID card, monthly %, streak, color-coded calendar, recent history, and notices\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/MemberDashboard.tsx\", \"toolAction\":\"Creating MemberDashboard page\", \"toolSummary\":\"Create MemberDashboard.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_5284555610896261514"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useCallback, useEffect, useMemo, useState } from \'react\';\\nimport Papa from \'papaparse\';\\nimport {\\n  Check,\\n  Copy,\\n  Edit2,\\n  Plus,\\n  QrCode,\\n  Search,\\n  Trash2,\\n  Upload,\\n  UserCheck,\\n  UserX,\\n  X,\\n} from \'lucide-react\';\\nimport { useAuth } from \'../context/AuthContext\';\\nimport { useTranslation } from \'../hooks/useTranslation\';\\nimport { useToast } from \'../context/ToastContext\';\\nimport type { UserProfile } from \'../types\';\\nimport {\\n  addPersonDirect,\\n  approvePendingUser,\\n  deleteUserProfile,\\n  fetchManagerMembers,\\n  fetchOrgUsers,\\n  rejectPendingUser,\\n  setUserStatus,\\n  updateUserDetails,\\n} from \'../services/userService\';\\nimport { getFirebaseErrorKey } from \'../utils/helpers\';\\nimport { Layout } from \'./Layout\';\\nimport { QRCardModal } from \'./QRCardModal\';\\nimport { CardSkeleton, EmptyState } from \'./Skeletons\';\\n\\ninterface PeopleManagerViewProps {\\n  targetRole: \'manager\' | \'member\';\\n  adminViewingAllMembers?: boolean;\\n}\\n\\ninterface CsvPreviewRow {\\n  rowNum: number;\\n  name: string;\\n  email: string;\\n  phone: string;\\n  rollNumber: string;\\n  error?: string;\\n}\\n\\nconst PAGE_SIZE = 10;\\n\\nexport const PeopleManagerView: React.FC<PeopleManagerViewProps> = ({\\n  targetRole,\\n  adminViewingAllMembers = false,\\n}) => {\\n  const { profile, org, getRoleLabel } = useAuth();\\n  const { t, formatNumber } = useTranslation();\\n  const { showToast } = useToast();\\n\\n  const roleLabel = getRoleLabel(targetRole);\\n  const managerLabel = getRoleLabel(\'manager\');\\n\\n  const [loading, setLoading] = useState(true);\\n  const [people, setPeople] = useState<UserProfile[]>([]);\\n  const [managers, setManagers] = useState<UserProfile[]>([]);\\n  const [search, setSearch] = useState(\'\');\\n  const [statusFilter, setStatusFilter] = useState<\'all\' | \'active\' | \'pending\' | \'inactive\'>(\'all\');\\n  const [sortBy, setSortBy] = useState<\'name\' | \'memberId\'>(\'name\');\\n  const [page, setPage] = useState(1);\\n\\n  const [showAddModal, setShowAddModal] = useState(false);\\n  const [showCsvModal, setShowCsvModal] = useState(false);\\n  const [editingPerson, setEditingPerson] = useState<UserProfile | null>(null);\\n  const [qrPerson, setQrPerson] = useState<UserProfile | null>(null);\\n  const [confirmDelete, setConfirmDelete] = useState<UserProfile | null>(null);\\n  const [copied, setCopied] = useState(false);\\n\\n  // Add / Edit form state\\n  const [formName, setFormName] = useState(\'\');\\n  const [formEmail, setFormEmail] = useState(\'\');\\n  const [formPhone, setFormPhone] = useState(\'\');\\n  const [formRoll, setFormRoll] = useState(\'\');\\n  const [formManagerId, setFormManagerId] = useState(\'\');\\n  const [saving, setSaving] = useState(false);\\n\\n  // CSV import state\\n  const [csvRows, setCsvRows] = useState<CsvPreviewRow[]>([]);\\n  const [csvImporting, setCsvImporting] = useState(false);\\n  const [csvProgress, setCsvProgress] = useState({ done: 0, total: 0, failed: 0 });\\n\\n  const loadPeople = useCallback(async () => {\\n    if (!org || !profile) return;\\n    setLoading(true);\\n    try {\\n      if (targetRole === \'manager\') {\\n        const list = await fetchOrgUsers(org.id, \'manager\');\\n        setPeople(list);\\n      } else if (adminViewingAllMembers) {\\n        const [mems, mgrs] = await Promise.all([\\n          fetchOrgUsers(org.id, \'member\'),\\n          fetchOrgUsers(org.id, \'manager\'),\\n        ]);\\n        setPeople(mems);\\n        setManagers(mgrs.filter((m) => m.status === \'active\'));\\n      } else {\\n        const list = await fetchManagerMembers(org.id, profile.uid);\\n        setPeople(list);\\n      }\\n    } catch (err) {\\n      showToast(t(getFirebaseErrorKey(err)), \'error\');\\n    } finally {\\n      setLoading(false);\\n    }\\n  }, [org, profile, targetRole, adminViewingAllMembers, showToast, t]);\\n\\n  useEffect(() => {\\n    loadPeople();\\n  }, [loadPeople]);\\n\\n  const managerNameMap = useMemo(() => {\\n    const map = new Map<string, string>();\\n    for (const m of managers) map.set(m.uid, m.name);\\n    return map;\\n  }, [managers]);\\n\\n  const filtered = useMemo(() => {\\n    const q = search.trim().toLowerCase();\\n    return people\\n      .filter((p) => {\\n        if (statusFilter !== \'all\' && p.status !== statusFilter) return false;\\n        if (!q) return true;\\n        return (\\n          p.name.toLowerCase().includes(q) ||\\n          p.email.toLowerCase().includes(q) ||\\n          (p.memberId || \'\').toLowerCase().includes(q) ||\\n          (p.rollNumber || \'\').toLowerCase().includes(q)\\n        );\\n      })\\n      .sort((a, b) =>\\n        sortBy === \'name\'\\n          ? a.name.localeCompare(b.name)\\n          : (a.memberId || \'\').localeCompare(b.memberId || \'\')\\n      );\\n  }, [people, search, statusFilter, sortBy]);\\n\\n  const totalPages = Math.max(1, Math.ceil(filtered.length / PAGE_SIZE));\\n  const paginated = filtered.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);\\n\\n  useEffect(() => {\\n    setPage(1);\\n  }, [search, statusFilter, sortBy]);\\n\\n  const inviteCode =\\n    targetRole === \'manager\'\\n      ? org?.orgCode\\n      : !adminViewingAllMembers\\n      ? profile?.managerCode\\n      : undefined;\\n\\n  const handleCopyInvite = () => {\\n    if (!inviteCode) return;\\n    navigator.clipboard.writeText(inviteCode);\\n    setCopied(true);\\n    setTimeout(() => setCopied(false), 1800);\\n  };\\n\\n  const openAddModal = () => {\\n    setFormName(\'\');\\n    setFormEmail(\'\');\\n    setFormPhone(\'\');\\n    setFormRoll(\'\');\\n    setFormManagerId(managers[0]?.uid || \'\');\\n    setShowAddModal(true);\\n  };\\n\\n  const openEditModal = (p: UserProfile) => {\\n    setEditingPerson(p);\\n    setFormName(p.name);\\n    setFormPhone(p.phone || \'\');\\n    setFormRoll(p.rollNumber || \'\');\\n  };\\n\\n  const handleAddSubmit = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    if (!org || !profile) return;\\n    if (!formName.trim() || !formEmail.trim()) {\\n      showToast(t(\'errors.requiredFields\'), \'error\');\\n      return;\\n    }\\n    setSaving(true);\\n    try {\\n      const assignedManagerId =\\n        targetRole === \'member\'\\n          ? adminViewingAllMembers\\n            ? formManagerId || null\\n            : profile.uid\\n          : null;\\n\\n      const { resetEmailSent } = await addPersonDirect({\\n        org,\\n        role: targetRole,\\n        managerId: assignedManagerId,\\n        name: formName,\\n        email: formEmail,\\n        phone: formPhone,\\n        rollNumber: formRoll,\\n      });\\n\\n      showToast(\\n        resetEmailSent ? t(\'people.personAdded\') : t(\'people.personAddedNoEmail\'),\\n        \'success\'\\n      );\\n      setShowAddModal(false);\\n      await loadPeople();\\n    } catch (err) {\\n      showToast(t(getFirebaseErrorKey(err)), \'error\');\\n    } finally {\\n      setSaving(false);\\n    }\\n  };\\n\\n  const handleEditSubmit = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    if (!editingPerson) return;\\n    setSaving(true);\\n    try {\\n      await updateUserDetails(editingPerson.uid, {\\n        name: formName.trim(),\\n        phone: formPhone.trim(),\\n        rollNumber: formRoll.trim(),\\n      });\\n      showToast(t(\'people.personUpdated\'), \'success\');\\n      setEditingPerson(null);\\n      await loadPeople();\\n    } catch (err) {\\n      showToast(t(getFirebaseErrorKey(err)), \'error\');\\n    } finally {\\n      setSaving(false);\\n    }\\n  };\\n\\n  const handleToggleStatus = async (p: UserProfile) => {\\n    const next = p.status === \'active\' ? \'inactive\' : \'active\';\\n    try {\\n      await setUserStatus(p.uid, next);\\n      showToast(t(\'people.personUpdated\'), \'success\');\\n      await loadPeople();\\n    } catch (err) {\\n      showToast(t(getFirebaseErrorKey(err)), \'error\');\\n    }\\n  };\\n\\n  const handleApprove = async (p: UserProfile) => {\\n    if (!org) return;\\n    try {\\n      await approvePendingUser(org, p);\\n      showToast(t(\'people.approvedToast\'), \'success\');\\n      await loadPeople();\\n    } catch (err) {\\n      showToast(t(getFirebaseErrorKey(err)), \'error\');\\n    }\\n  };\\n\\n  const handleReject = async (p: UserProfile) => {\\n    if (!org) return;\\n    try {\\n      await rejectPendingUser(org.id, p);\\n      showToast(t(\'people.rejectedToast\'), \'info\');\\n      await loadPeople();\\n    } catch (err) {\\n      showToast(t(getFirebaseErrorKey(err)), \'error\');\\n    }\\n  };\\n\\n  const handleConfirmDelete = async () => {\\n    if (!confirmDelete) return;\\n    try {\\n      await deleteUserProfile(confirmDelete);\\n      showToast(t(\'people.personRemoved\'), \'success\');\\n      setConfirmDelete(null);\\n      await loadPeople();\\n    } catch (err) {\\n      showToast(t(getFirebaseErrorKey(err)), \'error\');\\n    }\\n  };\\n\\n  // CSV Handling\\n  const handleCsvFile = (e: React.ChangeEvent<HTMLInputElement>) => {\\n    const file = e.target.files?.[0];\\n    if (!file) return;\\n    Papa.parse<Record<string, string>>(file, {\\n      header: true,\\n      skipEmptyLines: true,\\n      complete: (res) => {\\n        const seenEmails = new Set(people.map((p) => p.email.toLowerCase()));\\n        const parsed: CsvPreviewRow[] = res.data.map((row, idx) => {\\n          const name = (row.name || row.Name || \'\').trim();\\n          const email = (row.email || row.Email || \'\').trim().toLowerCase();\\n          const phone = (row.phone || row.Phone || \'\').trim();\\n          const rollNumber = (row.rollNumber || row.roll || row.employeeId || \'\').trim();\\n\\n          let error: string | undefined;\\n          if (!name) error = t(\'people.csvMissingName\');\\n          else if (!email || !/^[^\\\\s@]+@[^\\\\s@]+\\\\.[^\\\\s@]+$/.test(email)) {\\n            error = t(\'people.csvInvalidEmail\');\\n          } else if (seenEmails.has(email)) {\\n            error = t(\'errors.emailInUse\');\\n          } else {\\n            seenEmails.add(email);\\n          }\\n\\n          return { rowNum: idx + 1, name, email, phone, rollNumber, error };\\n        });\\n        setCsvRows(parsed);\\n      },\\n    });\\n  };\\n\\n  const handleDownloadSampleCsv = () => {\\n    const csv = \'name,email,phone,rollNumber\\\\nAarav Sharma,aarav@example.com,9810012345,101\\\\nDiya Patel,diya@example.com,9810012346,102\\\\n\';\\n    const blob = new Blob([csv], { type: \'text/csv;charset=utf-8;\' });\\n    const url = URL.createObjectURL(blob);\\n    const a = document.createElement(\'a\');\\n    a.href = url;\\n    a.download = `sample_${targetRole}s.csv`;\\n    a.click();\\n    URL.revokeObjectURL(url);\\n  };\\n\\n  const handleImportCsv = async () => {\\n    if (!org || !profile) return;\\n    const valid = csvRows.filter((r) => !r.error);\\n    if (valid.length === 0) return;\\n\\n    setCsvImporting(true);\\n    setCsvProgress({ done: 0, total: valid.length, failed: 0 });\\n    let failed = 0;\\n    const updatedRows = [...csvRows];\\n\\n    for (let i = 0; i < valid.length; i++) {\\n      const row = valid[i];\\n      try {\\n        const assignedManagerId =\\n          targetRole === \'member\'\\n            ? adminViewingAllMembers\\n              ? formManagerId || managers[0]?.uid || null\\n              : profile.uid\\n            : null;\\n        await addPersonDirect({\\n          org,\\n          role: targetRole,\\n          managerId: assignedManagerId,\\n          name: row.name,\\n          email: row.email,\\n          phone: row.phone,\\n          rollNumber: row.rollNumber,\\n        });\\n      } catch (err) {\\n        failed++;\\n        const idx = updatedRows.findIndex((r) => r.rowNum === row.rowNum);\\n        if (idx >= 0) updatedRows[idx] = { ...updatedRows[idx], error: t(getFirebaseErrorKey(err)) };\\n      }\\n      setCsvProgress({ done: i + 1, total: valid.length, failed });\\n    }\\n\\n    setCsvRows(updatedRows);\\n    setCsvImporting(false);\\n    showToast(t(\'people.csvDone\'), failed === 0 ? \'success\' : \'info\');\\n    await loadPeople();\\n    if (failed === 0) {\\n      setShowCsvModal(false);\\n      setCsvRows([]);\\n    }\\n  };\\n\\n  const validCsvCount = csvRows.filter((r) => !r.error).length;\\n  const invalidCsvCount = csvRows.length - validCsvCount;\\n\\n  return (\\n    <Layout title={roleLabel}>\\n      <div className=\\\"space-y-6\\\">\\n        {/* Top Action Bar */}\\n        <div className=\\\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\\\">\\n          <div>\\n            <h2 className=\\\"text-2xl font-bold tracking-tight text-stone-900 dark:text-stone-50\\\">\\n              {roleLabel}\\n            </h2>\\n            {inviteCode && (\\n              <div className=\\\"mt-1.5 flex items-center gap-2 text-xs text-stone-500 dark:text-stone-400\\\">\\n                <span>{t(\'people.inviteCode\')}:</span>\\n                <span className=\\\"font-mono font-semibold text-stone-900 dark:text-stone-100\\\">\\n                  {inviteCode}\\n                </span>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={handleCopyInvite}\\n                  className=\\\"inline-flex items-center gap-1 text-[#C25E00] hover:underline\\\"\\n                >\\n                  {copied ? <Check className=\\\"w-3.5 h-3.5\\\" /> : <Copy className=\\\"w-3.5 h-3.5\\\" />}\\n                  <span>{copied ? t(\'common.copied\') : t(\'common.copy\')}</span>\\n                </button>\\n              </div>\\n            )}\\n          </div>\\n\\n          <div className=\\\"flex flex-wrap items-center gap-2.5\\\">\\n            {(!adminViewingAllMembers || managers.length > 0) && (\\n              <>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => {\\n                    setCsvRows([]);\\n                    setFormManagerId(managers[0]?.uid || \'\');\\n                    setShowCsvModal(true);\\n                  }}\\n                  className=\\\"inline-flex items-center gap-2 rounded-xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] hover:bg-stone-50 dark:hover:bg-stone-800 px-3.5 py-2 text-sm font-medium transition-colors\\\"\\n                >\\n                  <Upload className=\\\"w-4 h-4\\\" />\\n                  <span>{t(\'people.bulkImport\')}</span>\\n                </button>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={openAddModal}\\n                  className=\\\"inline-flex items-center gap-2 rounded-xl bg-[#C25E00] hover:bg-[#A84F00] text-white px-4 py-2 text-sm font-medium transition-colors\\\"\\n                >\\n                  <Plus className=\\\"w-4 h-4\\\" />\\n                  <span>\\n                    {t(\'people.addPerson\')} {roleLabel}\\n                  </span>\\n                </button>\\n              </>\\n            )}\\n          </div>\\n        </div>\\n\\n        {/* Search & Filter Row */}\\n        <div className=\\\"flex flex-col sm:flex-row gap-3\\\">\\n          <div className=\\\"relative flex-1\\\">\\n            <Search className=\\\"w-4 h-4 text-stone-400 absolute left-3.5 top-1/2 -translate-y-1/2\\\" />\\n            <input\\n              type=\\\"text\\\"\\n              value={search}\\n              onChange={(e) => setSearch(e.target.value)}\\n              placeholder={t(\'common.search\')}\\n              className=\\\"w-full rounded-xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] pl-10 pr-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#C25E00]/30 focus:border-[#C25E00]\\\"\\n            />\\n          </div>\\n\\n          <div className=\\\"flex items-center gap-2\\\">\\n            <select\\n              value={statusFilter}\\n              onChange={(e) => setStatusFilter(e.target.value as typeof statusFilter)}\\n              className=\\\"rounded-xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] px-3 py-2.5 text-sm\\\"\\n            >\\n              <option value=\\\"all\\\">{t(\'people.statusAll\')}</option>\\n              <option value=\\\"active\\\">{t(\'common.active\')}</option>\\n              <option value=\\\"pending\\\">{t(\'common.pending\')}</option>\\n              <option value=\\\"inactive\\\">{t(\'common.inactive\')}</option>\\n            </select>\\n\\n            <select\\n              value={sortBy}\\n              onChange={(e) => setSortBy(e.target.value as \'name\' | \'memberId\')}\\n              className=\\\"rounded-xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] px-3 py-2.5 text-sm\\\"\\n            >\\n              <option value=\\\"name\\\">{t(\'common.name\')}</option>\\n              <option value=\\\"memberId\\\">{t(\'common.memberId\')}</option>\\n            </select>\\n          </div>\\n        </div>\\n\\n        {/* Table / List */}\\n        {loading ? (\\n          <CardSkeleton rows={5} />\\n        ) : filtered.length === 0 ? (\\n          <EmptyState\\n            title={t(\'people.emptyTitle\')}\\n            description={t(\'people.emptyDesc\')}\\n            actionLabel={\\n              !adminViewingAllMembers || managers.length > 0\\n                ? `${t(\'people.addPerson\')} ${roleLabel}`\\n                : undefined\\n            }\\n            onAction={openAddModal}\\n          />\\n        ) : (\\n          <div className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] overflow-hidden\\\">\\n            <div className=\\\"overflow-x-auto\\\">\\n              <table className=\\\"w-full text-left text-sm\\\">\\n                <thead className=\\\"border-b border-stone-200 dark:border-stone-800 bg-stone-50/70 dark:bg-stone-900/50 text-xs text-stone-500 dark:text-stone-400\\\">\\n                  <tr>\\n                    <th className=\\\"py-3 px-4 font-medium\\\">{t(\'common.name\')}</th>\\n                    <th className=\\\"py-3 px-4 font-medium\\\">{t(\'common.memberId\')}</th>\\n                    {adminViewingAllMembers && (\\n                      <th className=\\\"py-3 px-4 font-medium\\\">{managerLabel}</th>\\n                    )}\\n                    <th className=\\\"py-3 px-4 font-medium\\\">{t(\'common.phone\')}</th>\\n                    <th className=\\\"py-3 px-4 font-medium\\\">{t(\'common.status\')}</th>\\n                    <th className=\\\"py-3 px-4 font-medium text-right\\\">{t(\'common.actions\')}</th>\\n                  </tr>\\n                </thead>\\n                <tbody className=\\\"divide-y divide-stone-100 dark:divide-stone-800\\\">\\n                  {paginated.map((person) => (\\n                    <tr\\n                      key={person.uid}\\n                      className=\\\"hover:bg-stone-50/70 dark:hover:bg-stone-800/30 transition-colors\\\"\\n                    >\\n                      <td className=\\\"py-3 px-4\\\">\\n                        <p className=\\\"font-medium text-stone-900 dark:text-stone-100\\\">\\n                          {person.name}\\n                          {person.isDemo && (\\n                            <span className=\\\"ml-2 text-xs font-normal text-stone-400\\\">\\n                              \302\267 {t(\'common.demo\')}\\n                            </span>\\n                          )}\\n                        </p>\\n                        <p className=\\\"text-xs text-stone-500 dark:text-stone-400\\\">\\n                          {person.email}\\n                          {person.rollNumber ? ` \302\267 #${person.rollNumber}` : \'\'}\\n                        </p>\\n                      </td>\\n                      <td className=\\\"py-3 px-4 font-mono text-xs text-stone-700 dark:text-stone-300 whitespace-nowrap\\\">\\n                        {person.memberId || \'\342\200\224\'}\\n                        {person.managerCode && (\\n                          <div className=\\\"text-[11px] text-stone-400 mt-0.5\\\">\\n                            Code: {person.managerCode}\\n                          </div>\\n                        )}\\n                      </td>\\n                      {adminViewingAllMembers && (\\n                        <td className=\\\"py-3 px-4 text-xs text-stone-600 dark:text-stone-400\\\">\\n                          {(person.managerId && managerNameMap.get(person.managerId)) || \'\342\200\224\'}\\n                        </td>\\n                      )}\\n                      <td className=\\\"py-3 px-4 text-xs text-stone-600 dark:text-stone-400 tabular-nums whitespace-nowrap\\\">\\n                        {person.phone || \'\342\200\224\'}\\n                      </td>\\n                      <td className=\\\"py-3 px-4 text-xs font-medium whitespace-nowrap\\\">\\n                        <span\\n                          className={\\n                            person.status === \'active\'\\n                              ? \'text-emerald-700 dark:text-emerald-400\'\\n                              : person.status === \'pending\'\\n                              ? \'text-amber-700 dark:text-amber-400\'\\n                              : \'text-stone-400\'\\n                          }\\n                        >\\n                          {t(`common.${person.status}`)}\\n                        </span>\\n                      </td>\\n                      <td className=\\\"py-3 px-4 text-right whitespace-nowrap\\\">\\n                        <div className=\\\"inline-flex items-center gap-1\\\">\\n                          {person.status === \'pending\' ? (\\n                            <>\\n                              <button\\n                                type=\\\"button\\\"\\n                                onClick={() => handleApprove(person)}\\n                                className=\\\"rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white px-2.5 py-1 text-xs font-medium\\\"\\n                              >\\n                                {t(\'dashboard.approve\')}\\n                              </button>\\n                              <button\\n                                type=\\\"button\\\"\\n                                onClick={() => handleReject(person)}\\n                                className=\\\"rounded-lg border border-stone-200 dark:border-stone-700 px-2 py-1 text-xs text-stone-600 hover:text-red-600\\\"\\n                              >\\n                                {t(\'dashboard.reject\')}\\n                              </button>\\n                            </>\\n                          ) : (\\n                            <>\\n                              {person.status === \'active\' && (\\n                                <button\\n                                  type=\\\"button\\\"\\n                                  onClick={() => setQrPerson(person)}\\n                                  title={t(\'people.viewQr\')}\\n                                  aria-label={t(\'people.viewQr\')}\\n                                  className=\\\"p-2 rounded-lg text-stone-500 hover:text-[#C25E00] hover:bg-stone-100 dark:hover:bg-stone-800\\\"\\n                                >\\n                                  <QrCode className=\\\"w-4 h-4\\\" />\\n                                </button>\\n                              )}\\n                              <button\\n                                type=\\\"button\\\"\\n                                onClick={() => openEditModal(person)}\\n                                title={t(\'common.edit\')}\\n                                aria-label={t(\'common.edit\')}\\n                                className=\\\"p-2 rounded-lg text-stone-500 hover:text-stone-900 dark:hover:text-stone-100 hover:bg-stone-100 dark:hover:bg-stone-800\\\"\\n                              >\\n                                <Edit2 className=\\\"w-4 h-4\\\" />\\n                              </button>\\n                              <button\\n                                type=\\\"button\\\"\\n                                onClick={() => handleToggleStatus(person)}\\n                                title={\\n                                  person.status === \'active\'\\n                                    ? t(\'people.deactivate\')\\n                                    : t(\'people.activate\')\\n                                }\\n                                aria-label={\\n                                  person.status === \'active\'\\n                                    ? t(\'people.deactivate\')\\n                                    : t(\'people.activate\')\\n                                }\\n                                className=\\\"p-2 rounded-lg text-stone-500 hover:text-amber-700 hover:bg-stone-100 dark:hover:bg-stone-800\\\"\\n                              >\\n                                {person.status === \'active\' ? (\\n                                  <UserX className=\\\"w-4 h-4\\\" />\\n                                ) : (\\n                                  <UserCheck className=\\\"w-4 h-4\\\" />\\n                                )}\\n                              </button>\\n                              <button\\n                                type=\\\"button\\\"\\n                                onClick={() => setConfirmDelete(person)}\\n                                title={t(\'people.remove\')}\\n                                aria-label={t(\'people.remove\')}\\n                                className=\\\"p-2 rounded-lg text-stone-500 hover:text-red-600 hover:bg-stone-100 dark:hover:bg-stone-800\\\"\\n                              >\\n                                <Trash2 className=\\\"w-4 h-4\\\" />\\n                              </button>\\n                            </>\\n                          )}\\n                        </div>\\n                      </td>\\n                    </tr>\\n                  ))}\\n                </tbody>\\n              </table>\\n            </div>\\n\\n            {/* Pagination */}\\n            {totalPages > 1 && (\\n              <div className=\\\"px-4 py-3 border-t border-stone-200 dark:border-stone-800 flex items-center justify-between text-xs text-stone-500\\\">\\n                <span className=\\\"tabular-nums\\\">\\n                  {t(\'common.page\')} {formatNumber(page)} {t(\'common.of\')} {formatNumber(totalPages)}\\n                </span>\\n                <div className=\\\"flex items-center gap-2\\\">\\n                  <button\\n                    type=\\\"button\\\"\\n                    disabled={page <= 1}\\n                    onClick={() => setPage((p) => p - 1)}\\n                    className=\\\"rounded-lg border border-stone-200 dark:border-stone-700 px-3 py-1 disabled:opacity-40\\\"\\n                  >\\n                    {t(\'common.previous\')}\\n                  </button>\\n                  <button\\n                    type=\\\"button\\\"\\n                    disabled={page >= totalPages}\\n                    onClick={() => setPage((p) => p + 1)}\\n                    className=\\\"rounded-lg border border-stone-200 dark:border-stone-700 px-3 py-1 disabled:opacity-40\\\"\\n                  >\\n                    {t(\'common.next\')}\\n                  </button>\\n                </div>\\n              </div>\\n            )}\\n          </div>\\n        )}\\n      </div>\\n\\n      {/* Add Person Modal */}\\n      {showAddModal && (\\n        <div className=\\\"fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4\\\">\\n          <div className=\\\"w-full max-w-md rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-6 shadow-xl\\\">\\n            <div className=\\\"flex items-center justify-between mb-4\\\">\\n              <h3 className=\\\"text-base font-semibold\\\">\\n                {t(\'people.addPerson\')} {roleLabel}\\n              </h3>\\n              <button type=\\\"button\\\" onClick={() => setShowAddModal(false)}>\\n                <X className=\\\"w-5 h-5 text-stone-400\\\" />\\n              </button>\\n            </div>\\n\\n            <form onSubmit={handleAddSubmit} className=\\\"space-y-4\\\">\\n              <div>\\n                <label className=\\\"block text-sm font-medium mb-1\\\">{t(\'common.name\')}</label>\\n                <input\\n                  type=\\\"text\\\"\\n                  required\\n                  value={formName}\\n                  onChange={(e) => setFormName(e.target.value)}\\n                  className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-transparent px-3.5 py-2 text-sm\\\"\\n                />\\n              </div>\\n              <div>\\n                <label className=\\\"block text-sm font-medium mb-1\\\">{t(\'common.email\')}</label>\\n                <input\\n                  type=\\\"email\\\"\\n                  required\\n                  value={formEmail}\\n                  onChange={(e) => setFormEmail(e.target.value)}\\n                  className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-transparent px-3.5 py-2 text-sm\\\"\\n                />\\n              </div>\\n              <div className=\\\"grid grid-cols-2 gap-3\\\">\\n                <div>\\n                  <label className=\\\"block text-sm font-medium mb-1\\\">{t(\'common.phone\')}</label>\\n                  <input\\n                    type=\\\"tel\\\"\\n                    value={formPhone}\\n                    onChange={(e) => setFormPhone(e.target.value)}\\n                    className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-transparent px-3.5 py-2 text-sm\\\"\\n                  />\\n                </div>\\n                <div>\\n                  <label className=\\\"block text-sm font-medium mb-1\\\">{t(\'common.rollNumber\')}</label>\\n                  <input\\n                    type=\\\"text\\\"\\n                    value={formRoll}\\n                    onChange={(e) => setFormRoll(e.target.value)}\\n                    className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-transparent px-3.5 py-2 text-sm\\\"\\n                  />\\n                </div>\\n              </div>\\n\\n              {adminViewingAllMembers && managers.length > 0 && (\\n                <div>\\n                  <label className=\\\"block text-sm font-medium mb-1\\\">{managerLabel}</label>\\n                  <select\\n                    value={formManagerId}\\n                    onChange={(e) => setFormManagerId(e.target.value)}\\n                    className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-900 px-3.5 py-2 text-sm\\\"\\n                  >\\n                    {managers.map((m) => (\\n                      <option key={m.uid} value={m.uid}>\\n                        {m.name} ({m.memberId})\\n                      </option>\\n                    ))}\\n                  </select>\\n                </div>\\n              )}\\n\\n              <p className=\\\"text-xs text-stone-500 dark:text-stone-400\\\">\\n                {t(\'people.passwordResetNote\')}\\n              </p>\\n\\n              <div className=\\\"flex justify-end gap-2 pt-2\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setShowAddModal(false)}\\n                  className=\\\"rounded-xl border border-stone-200 dark:border-stone-700 px-4 py-2 text-sm font-medium\\\"\\n                >\\n                  {t(\'common.cancel\')}\\n                </button>\\n                <button\\n                  type=\\\"submit\\\"\\n                  disabled={saving}\\n                  className=\\\"rounded-xl bg-[#C25E00] hover:bg-[#A84F00] disabled:opacity-60 text-white px-4 py-2 text-sm font-medium\\\"\\n                >\\n                  {saving ? t(\'common.saving\') : t(\'common.save\')}\\n                </button>\\n              </div>\\n            </form>\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* Edit Person Modal */}\\n      {editingPerson && (\\n        <div className=\\\"fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4\\\">\\n          <div className=\\\"w-full max-w-md rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-6 shadow-xl\\\">\\n            <div className=\\\"flex items-center justify-between mb-4\\\">\\n              <h3 className=\\\"text-base font-semibold\\\">{t(\'people.editPerson\')}</h3>\\n              <button type=\\\"button\\\" onClick={() => setEditingPerson(null)}>\\n                <X className=\\\"w-5 h-5 text-stone-400\\\" />\\n              </button>\\n            </div>\\n            <form onSubmit={handleEditSubmit} className=\\\"space-y-4\\\">\\n              <div>\\n                <label className=\\\"block text-sm font-medium mb-1\\\">{t(\'common.name\')}</label>\\n                <input\\n                  type=\\\"text\\\"\\n                  required\\n                  value={formName}\\n                  onChange={(e) => setFormName(e.target.value)}\\n                  className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-transparent px-3.5 py-2 text-sm\\\"\\n                />\\n              </div>\\n              <div>\\n                <label className=\\\"block text-sm font-medium mb-1\\\">{t(\'common.phone\')}</label>\\n                <input\\n                  type=\\\"tel\\\"\\n                  value={formPhone}\\n                  onChange={(e) => setFormPhone(e.target.value)}\\n                  className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-transparent px-3.5 py-2 text-sm\\\"\\n                />\\n              </div>\\n              <div>\\n                <label className=\\\"block text-sm font-medium mb-1\\\">{t(\'common.rollNumber\')}</label>\\n                <input\\n                  type=\\\"text\\\"\\n                  value={formRoll}\\n                  onChange={(e) => setFormRoll(e.target.value)}\\n                  className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-transparent px-3.5 py-2 text-sm\\\"\\n                />\\n              </div>\\n              <div className=\\\"flex justify-end gap-2 pt-2\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setEditingPerson(null)}\\n                  className=\\\"rounded-xl border border-stone-200 dark:border-stone-700 px-4 py-2 text-sm font-medium\\\"\\n                >\\n                  {t(\'common.cancel\')}\\n                </button>\\n                <button\\n                  type=\\\"submit\\\"\\n                  disabled={saving}\\n                  className=\\\"rounded-xl bg-[#C25E00] text-white px-4 py-2 text-sm font-medium\\\"\\n                >\\n                  {saving ? t(\'common.saving\') : t(\'common.save\')}\\n                </button>\\n              </div>\\n            </form>\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* Bulk CSV Import Modal */}\\n      {showCsvModal && (\\n        <div className=\\\"fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4\\\">\\n          <div className=\\\"w-full max-w-2xl rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-6 shadow-xl max-h-[90vh] flex flex-col\\\">\\n            <div className=\\\"flex items-center justify-between mb-3\\\">\\n              <h3 className=\\\"text-base font-semibold\\\">{t(\'people.csvTitle\')}</h3>\\n              <button type=\\\"button\\\" onClick={() => setShowCsvModal(false)}>\\n                <X className=\\\"w-5 h-5 text-stone-400\\\" />\\n              </button>\\n            </div>\\n            <p className=\\\"text-sm text-stone-500 dark:text-stone-400\\\">{t(\'people.csvHint\')}</p>\\n\\n            {adminViewingAllMembers && managers.length > 0 && (\\n              <div className=\\\"mt-3\\\">\\n                <label className=\\\"block text-xs font-medium mb-1\\\">{managerLabel}</label>\\n                <select\\n                  value={formManagerId}\\n                  onChange={(e) => setFormManagerId(e.target.value)}\\n                  className=\\\"rounded-xl border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-900 px-3 py-1.5 text-sm\\\"\\n                >\\n                  {managers.map((m) => (\\n                    <option key={m.uid} value={m.uid}>\\n                      {m.name}\\n                    </option>\\n                  ))}\\n                </select>\\n              </div>\\n            )}\\n\\n            <div className=\\\"mt-4 flex flex-wrap items-center gap-3\\\">\\n              <label className=\\\"inline-flex items-center gap-2 rounded-xl bg-stone-900 dark:bg-stone-100 text-white dark:text-stone-900 px-4 py-2 text-sm font-medium cursor-pointer\\\">\\n                <Upload className=\\\"w-4 h-4\\\" />\\n                <span>{t(\'people.csvSelectFile\')}</span>\\n                <input type=\\\"file\\\" accept=\\\".csv,text/csv\\\" onChange={handleCsvFile} className=\\\"hidden\\\" />\\n              </label>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={handleDownloadSampleCsv}\\n                className=\\\"text-xs font-medium text-[#C25E00] hover:underline\\\"\\n              >\\n                {t(\'people.csvDownloadSample\')}\\n              </button>\\n            </div>\\n\\n            {csvRows.length > 0 && (\\n              <>\\n                <div className=\\\"mt-4 flex items-center gap-4 text-xs text-stone-600 dark:text-stone-400\\\">\\n                  <span>\\n                    {t(\'people.csvValid\')}: <strong className=\\\"text-emerald-700\\\">{validCsvCount}</strong>\\n                  </span>\\n                  <span>\302\267</span>\\n                  <span>\\n                    {t(\'people.csvInvalid\')}: <strong className=\\\"text-red-600\\\">{invalidCsvCount}</strong>\\n                  </span>\\n                </div>\\n\\n                <div className=\\\"mt-3 flex-1 overflow-auto rounded-xl border border-stone-200 dark:border-stone-800\\\">\\n                  <table className=\\\"w-full text-left text-xs\\\">\\n                    <thead className=\\\"bg-stone-50 dark:bg-stone-900 border-b border-stone-200 dark:border-stone-800\\\">\\n                      <tr>\\n                        <th className=\\\"py-2 px-3\\\">#</th>\\n                        <th className=\\\"py-2 px-3\\\">{t(\'common.name\')}</th>\\n                        <th className=\\\"py-2 px-3\\\">{t(\'common.email\')}</th>\\n                        <th className=\\\"py-2 px-3\\\">{t(\'common.phone\')}</th>\\n                        <th className=\\\"py-2 px-3\\\">{t(\'common.status\')}</th>\\n                      </tr>\\n                    </thead>\\n                    <tbody className=\\\"divide-y divide-stone-100 dark:divide-stone-800\\\">\\n                      {csvRows.map((row) => (\\n                        <tr key={row.rowNum}>\\n                          <td className=\\\"py-2 px-3 tabular-nums\\\">{row.rowNum}</td>\\n                          <td className=\\\"py-2 px-3\\\">{row.name || \'\342\200\224\'}</td>\\n                          <td className=\\\"py-2 px-3\\\">{row.email || \'\342\200\224\'}</td>\\n                          <td className=\\\"py-2 px-3\\\">{row.phone || \'\342\200\224\'}</td>\\n                          <td className=\\\"py-2 px-3\\\">\\n                            {row.error ? (\\n                              <span className=\\\"text-red-600 font-medium\\\">{row.error}</span>\\n                            ) : (\\n                              <span className=\\\"text-emerald-700 font-medium\\\">{t(\'people.csvValid\')}</span>\\n                            )}\\n                          </td>\\n                        </tr>\\n                      ))}\\n                    </tbody>\\n                  </table>\\n                </div>\\n\\n                <div className=\\\"mt-4 flex items-center justify-between gap-3\\\">\\n                  <span className=\\\"text-xs text-stone-500\\\">\\n                    {csvImporting\\n                      ? `${t(\'people.csvImporting\')} ${csvProgress.done}/${csvProgress.total}`\\n                      : t(\'people.passwordResetNote\')}\\n                  </span>\\n                  <button\\n                    type=\\\"button\\\"\\n                    disabled={csvImporting || validCsvCount === 0}\\n                    onClick={handleImportCsv}\\n                    className=\\\"rounded-xl bg-[#C25E00] hover:bg-[#A84F00] disabled:opacity-50 text-white px-4 py-2 text-sm font-medium whitespace-nowrap\\\"\\n                  >\\n                    {csvImporting\\n                      ? t(\'people.csvImporting\')\\n                      : `${t(\'people.csvImportBtn\')} (${validCsvCount})`}\\n                  </button>\\n                </div>\\n              </>\\n            )}\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* Delete Confirmation Modal */}\\n      {confirmDelete && (\\n        <div className=\\\"fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4\\\">\\n          <div className=\\\"w-full max-w-sm rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-6 shadow-xl\\\">\\n            <h3 className=\\\"text-base font-semibold text-stone-900 dark:text-stone-100\\\">\\n              {confirmDelete.name}\\n            </h3>\\n            <p className=\\\"mt-2 text-sm text-stone-600 dark:text-stone-400\\\">\\n              {t(\'people.confirmRemove\')}\\n            </p>\\n            <div className=\\\"mt-5 flex justify-end gap-2\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setConfirmDelete(null)}\\n                className=\\\"rounded-xl border border-stone-200 dark:border-stone-700 px-4 py-2 text-sm font-medium\\\"\\n              >\\n                {t(\'common.cancel\')}\\n              </button>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={handleConfirmDelete}\\n                className=\\\"rounded-xl bg-red-600 hover:bg-red-700 text-white px-4 py-2 text-sm font-medium\\\"\\n              >\\n                {t(\'common.delete\')}\\n              </button>\\n            </div>\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* QR Card Modal */}\\n      {qrPerson && org && (\\n        <QRCardModal\\n          person={qrPerson}\\n          org={org}\\n          roleLabel={roleLabel}\\n          onClose={() => setQrPerson(null)}\\n        />\\n      )}\\n    </Layout>\\n  );\\n};\\n\", \"Description\":\"Create reusable PeopleManagerView with add, edit, activate/deactivate, remove, pending approval, CSV bulk import with preview & error reporting, and QR card modal\", \"Overwrite\":true, \"TargetFile\":\"/src/components/PeopleManagerView.tsx\", \"toolAction\":\"Creating PeopleManagerView component\", \"toolSummary\":\"Create PeopleManagerView.tsx\"}"
      original_name: "write_to_file"
