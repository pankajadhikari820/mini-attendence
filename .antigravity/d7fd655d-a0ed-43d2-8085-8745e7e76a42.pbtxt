    tool_calls {
      id: "call_8998832684038257493"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { createUserWithEmailAndPassword } from \'firebase/auth\';\\nimport {\\n  collection,\\n  doc,\\n  getDoc,\\n  serverTimestamp,\\n  setDoc,\\n  updateDoc,\\n  writeBatch,\\n} from \'firebase/firestore\';\\nimport { auth, db } from \'../firebase\';\\nimport type {\\n  LanguageCode,\\n  ManagerCodeLookup,\\n  OrgCodeLookup,\\n  Organization,\\n  OrgType,\\n} from \'../types\';\\nimport { generateCode, getDefaultRoleLabels } from \'../utils/helpers\';\\nimport { allocateUniqueUserId } from \'./userService\';\\n\\nexport async function generateUniqueOrgCode(): Promise<string> {\\n  for (let attempt = 0; attempt < 10; attempt++) {\\n    const code = generateCode(6);\\n    const snap = await getDoc(doc(db, \'orgCodes\', code));\\n    if (!snap.exists()) {\\n      return code;\\n    }\\n  }\\n  return generateCode(8);\\n}\\n\\nexport async function createOrganizationAndAdmin(params: {\\n  orgName: string;\\n  orgType: OrgType;\\n  adminName: string;\\n  englishName?: string;\\n  email: string;\\n  password: string;\\n  phone: string;\\n  language: LanguageCode;\\n}): Promise<{ orgId: string; orgCode: string; uid: string; adminId: string }> {\\n  const email = params.email.trim().toLowerCase();\\n  const orgCode = await generateUniqueOrgCode();\\n\\n  const cred = await createUserWithEmailAndPassword(auth, email, params.password);\\n  const uid = cred.user.uid;\\n\\n  const orgRef = doc(collection(db, \'organizations\'));\\n  const orgId = orgRef.id;\\n  const roleLabels = getDefaultRoleLabels(params.orgType);\\n\\n  const adminId = await allocateUniqueUserId({\\n    nameForId: params.englishName?.trim() || params.adminName,\\n    uid,\\n    orgId,\\n    role: \'admin\',\\n  });\\n\\n  const batch = writeBatch(db);\\n\\n  batch.set(orgRef, {\\n    name: params.orgName.trim(),\\n    type: params.orgType,\\n    orgCode,\\n    adminUid: uid,\\n    roleLabels,\\n    lateAfter: \'09:30\',\\n    timezone: \'Asia/Kolkata\',\\n    defaultSessionDuration: 30,\\n    location: {\\n      lat: 0,\\n      lng: 0,\\n      radius: 50,\\n      enabled: true, // Location check default ON\\n    },\\n    lowAttendanceThreshold: 75,\\n    counters: {\\n      manager: 0,\\n      member: 0,\\n    },\\n    hasDemoData: false,\\n    createdAt: serverTimestamp(),\\n  });\\n\\n  batch.set(doc(db, \'orgCodes\', orgCode), {\\n    orgId,\\n    orgName: params.orgName.trim(),\\n    roleLabels,\\n  });\\n\\n  batch.set(doc(db, \'users\', uid), {\\n    uid,\\n    name: params.adminName.trim(),\\n    ...(params.englishName?.trim() ? { englishName: params.englishName.trim() } : {}),\\n    email,\\n    phone: params.phone.trim(),\\n    role: \'admin\',\\n    orgId,\\n    managerId: null,\\n    memberId: adminId,\\n    status: \'active\',\\n    language: params.language,\\n    createdAt: serverTimestamp(),\\n  });\\n\\n  await batch.commit();\\n\\n  return { orgId, orgCode, uid, adminId };\\n}\\n\\nexport async function lookupOrgCode(code: string): Promise<OrgCodeLookup | null> {\\n  const clean = code.trim().toUpperCase();\\n  if (!clean) return null;\\n  const snap = await getDoc(doc(db, \'orgCodes\', clean));\\n  if (!snap.exists()) return null;\\n  return snap.data() as OrgCodeLookup;\\n}\\n\\nexport async function lookupManagerCode(code: string): Promise<ManagerCodeLookup | null> {\\n  const clean = code.trim().toUpperCase();\\n  if (!clean) return null;\\n  const snap = await getDoc(doc(db, \'managerCodes\', clean));\\n  if (!snap.exists()) return null;\\n  return snap.data() as ManagerCodeLookup;\\n}\\n\\nexport async function updateOrganization(\\n  orgId: string,\\n  orgCode: string,\\n  updates: Partial<Omit<Organization, \'id\' | \'orgCode\' | \'adminUid\' | \'createdAt\'>>\\n): Promise<void> {\\n  await updateDoc(doc(db, \'organizations\', orgId), updates as Record<string, unknown>);\\n  if (updates.name || updates.roleLabels) {\\n    const codePatch: Record<string, unknown> = {};\\n    if (updates.name) codePatch.orgName = updates.name;\\n    if (updates.roleLabels) codePatch.roleLabels = updates.roleLabels;\\n    await setDoc(doc(db, \'orgCodes\', orgCode), codePatch, { merge: true });\\n  }\\n}\\n\", \"Description\":\"Update orgService to assign 6-char unique ID to Admin and set default location check ON, radius 50m, duration 30m\", \"Overwrite\":true, \"TargetFile\":\"/src/services/orgService.ts\", \"toolAction\":\"Updating orgService\", \"toolSummary\":\"Update src/services/orgService.ts\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_8998832684038256732"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import {\\n  collection,\\n  doc,\\n  getDocs,\\n  query,\\n  serverTimestamp,\\n  updateDoc,\\n  where,\\n  writeBatch,\\n} from \'firebase/firestore\';\\nimport { db } from \'../firebase\';\\nimport type { AttendanceMethod, AttendanceStatus, Organization, UserProfile } from \'../types\';\\nimport { getPastDates } from \'../utils/helpers\';\\nimport { buildAttendanceDocId } from \'./attendanceService\';\\nimport { allocateUniqueUserId } from \'./userService\';\\n\\nconst DEMO_MANAGERS = [\\n  { key: \'mgr1\', name: \'Kavita Nair\', email: \'kavita.demo@example.com\', phone: \'9810112201\' },\\n  { key: \'mgr2\', name: \'Rajesh Verma\', email: \'rajesh.demo@example.com\', phone: \'9810112202\' },\\n  { key: \'mgr3\', name: \'Meera Deshmukh\', email: \'meera.demo@example.com\', phone: \'9810112203\' },\\n];\\n\\nconst DEMO_MEMBERS = [\\n  { key: \'mem01\', mgrIdx: 0, name: \'Aarav Sharma\', roll: \'101\', rate: 0.94 },\\n  { key: \'mem02\', mgrIdx: 0, name: \'Diya Patel\', roll: \'102\', rate: 0.90 },\\n  { key: \'mem03\', mgrIdx: 0, name: \'Rohan Kulkarni\', roll: \'103\', rate: 0.62 },\\n  { key: \'mem04\', mgrIdx: 0, name: \'Ananya Iyer\', roll: \'104\', rate: 0.96 },\\n  { key: \'mem05\', mgrIdx: 0, name: \'Kabir Mehta\', roll: \'105\', rate: 0.85 },\\n  { key: \'mem06\', mgrIdx: 1, name: \'Priya Singh\', roll: \'201\', rate: 0.92 },\\n  { key: \'mem07\', mgrIdx: 1, name: \'Vihaan Joshi\', roll: \'202\', rate: 0.68 },\\n  { key: \'mem08\', mgrIdx: 1, name: \'Sneha Reddy\', roll: \'203\', rate: 0.88 },\\n  { key: \'mem09\', mgrIdx: 1, name: \'Arjun Malhotra\', roll: \'204\', rate: 0.82 },\\n  { key: \'mem10\', mgrIdx: 1, name: \'Neha Gupta\', roll: \'205\', rate: 0.95 },\\n  { key: \'mem11\', mgrIdx: 2, name: \'Siddharth Rao\', roll: \'301\', rate: 0.91 },\\n  { key: \'mem12\', mgrIdx: 2, name: \'Tanvi Kapoor\', roll: \'302\', rate: 0.86 },\\n  { key: \'mem13\', mgrIdx: 2, name: \'Ishaan Chatterjee\', roll: \'303\', rate: 0.58 },\\n  { key: \'mem14\', mgrIdx: 2, name: \'Pooja Yadav\', roll: \'304\', rate: 0.93 },\\n  { key: \'mem15\', mgrIdx: 2, name: \'Devansh Tiwari\', roll: \'305\', rate: 0.89 },\\n];\\n\\nasync function commitOpsInChunks(\\n  ops: Array<(batch: ReturnType<typeof writeBatch>) => void>\\n): Promise<void> {\\n  const CHUNK = 380;\\n  for (let i = 0; i < ops.length; i += CHUNK) {\\n    const batch = writeBatch(db);\\n    for (const op of ops.slice(i, i + CHUNK)) {\\n      op(batch);\\n    }\\n    await batch.commit();\\n  }\\n}\\n\\nexport async function loadDemoData(org: Organization, admin: UserProfile): Promise<void> {\\n  await deleteDemoData(org.id);\\n\\n  const ops: Array<(batch: ReturnType<typeof writeBatch>) => void> = [];\\n\\n  // Allocate globally unique 6-character IDs (e.g. KAV482) for every demo manager & member\\n  const mgrDocs = await Promise.all(\\n    DEMO_MANAGERS.map(async (m, idx) => {\\n      const uid = `demo_${org.id}_${m.key}`;\\n      const memberId = await allocateUniqueUserId({\\n        nameForId: m.name,\\n        uid,\\n        orgId: org.id,\\n        role: \'manager\',\\n        isDemo: true,\\n      });\\n      const managerCode = `DM${org.orgCode.slice(0, 3)}${idx + 1}`.toUpperCase();\\n      return { ...m, uid, memberId, managerCode };\\n    })\\n  );\\n\\n  for (const m of mgrDocs) {\\n    ops.push((batch) => {\\n      batch.set(doc(db, \'users\', m.uid), {\\n        uid: m.uid,\\n        name: m.name,\\n        email: m.email,\\n        phone: m.phone,\\n        role: \'manager\',\\n        orgId: org.id,\\n        managerId: null,\\n        memberId: m.memberId,\\n        managerCode: m.managerCode,\\n        status: \'active\',\\n        language: \'en\',\\n        isDemo: true,\\n        createdAt: serverTimestamp(),\\n      });\\n    });\\n  }\\n\\n  const memDocs = await Promise.all(\\n    DEMO_MEMBERS.map(async (m, idx) => {\\n      const uid = `demo_${org.id}_${m.key}`;\\n      const mgr = mgrDocs[m.mgrIdx];\\n      const memberId = await allocateUniqueUserId({\\n        nameForId: m.name,\\n        uid,\\n        orgId: org.id,\\n        role: \'member\',\\n        isDemo: true,\\n      });\\n      return {\\n        ...m,\\n        uid,\\n        managerId: mgr.uid,\\n        memberId,\\n        email: `${m.key}.demo@example.com`,\\n        phone: `982000${String(1000 + idx)}`,\\n      };\\n    })\\n  );\\n\\n  for (const mem of memDocs) {\\n    ops.push((batch) => {\\n      batch.set(doc(db, \'users\', mem.uid), {\\n        uid: mem.uid,\\n        name: mem.name,\\n        email: mem.email,\\n        phone: mem.phone,\\n        rollNumber: mem.roll,\\n        role: \'member\',\\n        orgId: org.id,\\n        managerId: mem.managerId,\\n        memberId: mem.memberId,\\n        status: \'active\',\\n        language: \'en\',\\n        isDemo: true,\\n        createdAt: serverTimestamp(),\\n      });\\n    });\\n  }\\n\\n  const dates = getPastDates(30, org.timezone || \'Asia/Kolkata\');\\n\\n  let seed = 42;\\n  const nextRand = () => {\\n    seed = (seed * 1664525 + 1013904223) % 4294967296;\\n    return seed / 4294967296;\\n  };\\n\\n  for (const date of dates) {\\n    const dayOfWeek = new Date(`${date}T00:00:00Z`).getUTCDay();\\n    if (dayOfWeek === 0 && date !== dates[dates.length - 1]) continue;\\n\\n    for (const m of mgrDocs) {\\n      const r = nextRand();\\n      const status: AttendanceStatus =\\n        r < 0.84 ? \'present\' : r < 0.92 ? \'late\' : r < 0.96 ? \'leave\' : \'absent\';\\n      const method: AttendanceMethod =\\n        status === \'present\' || status === \'late\'\\n          ? r < 0.72\\n            ? \'live_qr\'\\n            : r < 0.86\\n            ? \'live_code\'\\n            : \'manual\'\\n          : \'manual\';\\n      const docId = buildAttendanceDocId(org.id, date, m.uid);\\n      ops.push((batch) => {\\n        batch.set(doc(db, \'attendance\', docId), {\\n          orgId: org.id,\\n          personUid: m.uid,\\n          personName: m.name,\\n          personMemberId: m.memberId,\\n          role: \'manager\',\\n          managerId: null,\\n          date,\\n          timestamp: serverTimestamp(),\\n          status,\\n          method,\\n          distanceMeters: method === \'manual\' ? 0 : Math.floor(nextRand() * 28) + 4,\\n          markedBy: method === \'manual\' ? admin.uid : m.uid,\\n          note: \'\',\\n          isDemo: true,\\n        });\\n      });\\n    }\\n\\n    for (const mem of memDocs) {\\n      const r = nextRand();\\n      let status: AttendanceStatus;\\n      if (r < mem.rate * 0.88) status = \'present\';\\n      else if (r < mem.rate) status = \'late\';\\n      else if (r < mem.rate + 0.05) status = \'leave\';\\n      else status = \'absent\';\\n\\n      const method: AttendanceMethod =\\n        status === \'present\' || status === \'late\'\\n          ? nextRand() < 0.75\\n            ? \'live_qr\'\\n            : nextRand() < 0.7\\n            ? \'live_code\'\\n            : \'manual\'\\n          : \'manual\';\\n\\n      const docId = buildAttendanceDocId(org.id, date, mem.uid);\\n      ops.push((batch) => {\\n        batch.set(doc(db, \'attendance\', docId), {\\n          orgId: org.id,\\n          personUid: mem.uid,\\n          personName: mem.name,\\n          personMemberId: mem.memberId,\\n          role: \'member\',\\n          managerId: mem.managerId,\\n          date,\\n          timestamp: serverTimestamp(),\\n          status,\\n          method,\\n          distanceMeters: method === \'manual\' ? 0 : Math.floor(nextRand() * 32) + 3,\\n          markedBy: method === \'manual\' ? mem.managerId : mem.uid,\\n          note: \'\',\\n          isDemo: true,\\n        });\\n      });\\n    }\\n  }\\n\\n  const today = dates[dates.length - 1];\\n  ops.push((batch) => {\\n    batch.set(doc(collection(db, \'leaves\')), {\\n      orgId: org.id,\\n      personUid: mgrDocs[0].uid,\\n      personName: mgrDocs[0].name,\\n      personRole: \'manager\',\\n      personMemberId: mgrDocs[0].memberId,\\n      toUid: admin.uid,\\n      fromDate: today,\\n      toDate: today,\\n      reason: \'Attending university academic seminar (Demo)\',\\n      status: \'pending\',\\n      comment: \'\',\\n      isDemo: true,\\n      createdAt: serverTimestamp(),\\n    });\\n  });\\n\\n  ops.push((batch) => {\\n    batch.set(doc(collection(db, \'leaves\')), {\\n      orgId: org.id,\\n      personUid: memDocs[2].uid,\\n      personName: memDocs[2].name,\\n      personRole: \'member\',\\n      personMemberId: memDocs[2].memberId,\\n      toUid: mgrDocs[0].uid,\\n      fromDate: today,\\n      toDate: today,\\n      reason: \'Medical appointment (Demo)\',\\n      status: \'pending\',\\n      comment: \'\',\\n      isDemo: true,\\n      createdAt: serverTimestamp(),\\n    });\\n  });\\n\\n  ops.push((batch) => {\\n    batch.set(doc(collection(db, \'announcements\')), {\\n      orgId: org.id,\\n      fromUid: admin.uid,\\n      fromName: admin.name,\\n      fromRole: \'admin\',\\n      audience: \'all\',\\n      managerId: null,\\n      text: \'Morning attendance session opens at 09:00 AM. Please keep GPS enabled on your phone. (Demo notice)\',\\n      isDemo: true,\\n      createdAt: serverTimestamp(),\\n    });\\n  });\\n\\n  await commitOpsInChunks(ops);\\n  await updateDoc(doc(db, \'organizations\', org.id), { hasDemoData: true });\\n}\\n\\nexport async function deleteDemoData(orgId: string): Promise<void> {\\n  const collectionsToClean = [\\n    \'users\',\\n    \'userIds\',\\n    \'attendance\',\\n    \'leaves\',\\n    \'announcements\',\\n    \'notifications\',\\n  ];\\n  const ops: Array<(batch: ReturnType<typeof writeBatch>) => void> = [];\\n\\n  for (const col of collectionsToClean) {\\n    try {\\n      const snap = await getDocs(\\n        query(collection(db, col), where(\'orgId\', \'==\', orgId), where(\'isDemo\', \'==\', true))\\n      );\\n      for (const d of snap.docs) {\\n        ops.push((batch) => batch.delete(d.ref));\\n      }\\n    } catch {\\n      // Continue if empty or collection not yet initialized\\n    }\\n  }\\n\\n  if (ops.length > 0) {\\n    await commitOpsInChunks(ops);\\n  }\\n  await updateDoc(doc(db, \'organizations\', orgId), { hasDemoData: false });\\n}\\n\", \"Description\":\"Update demoService to assign globally unique 6-character IDs via userIds and include realistic live_qr, live_code, and manual records\", \"Overwrite\":true, \"TargetFile\":\"/src/services/demoService.ts\", \"toolAction\":\"Updating demoService with 6-char IDs\", \"toolSummary\":\"Update src/services/demoService.ts\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_8998832684038255971"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import {\\n  addDoc,\\n  collection,\\n  doc,\\n  getDoc,\\n  getDocs,\\n  onSnapshot,\\n  query,\\n  serverTimestamp,\\n  setDoc,\\n  Timestamp,\\n  updateDoc,\\n  where,\\n  writeBatch,\\n} from \'firebase/firestore\';\\nimport { db } from \'../firebase\';\\nimport type {\\n  AttendanceAttempt,\\n  AttendanceRecord,\\n  AttendanceSession,\\n  AttendanceStatus,\\n  Organization,\\n  UserProfile,\\n} from \'../types\';\\nimport {\\n  generateSessionToken,\\n  generateSixDigitCode,\\n  getFlatEarthDistanceMeters,\\n  getOrgDateString,\\n  getOrgTimeHHMM,\\n  getOrCreateDeviceId,\\n  isAfterLateTime,\\n} from \'../utils/helpers\';\\nimport { buildAttendanceDocId } from \'./attendanceService\';\\n\\nexport async function startAttendanceSession(params: {\\n  org: Organization;\\n  owner: UserProfile;\\n  title: string;\\n  durationMinutes: number;\\n  lat: number;\\n  lng: number;\\n  radius: number;\\n}): Promise<{ session: AttendanceSession; token: string; code: string }> {\\n  const sessionRef = doc(collection(db, \'sessions\'));\\n  const sessionId = sessionRef.id;\\n\\n  const token = generateSessionToken();\\n  const code = generateSixDigitCode();\\n  const cosLat = Math.cos((params.lat * Math.PI) / 180);\\n  const endsAtDate = new Date(Date.now() + params.durationMinutes * 60 * 1000);\\n  const endsAt = Timestamp.fromDate(endsAtDate);\\n  const locationCheckEnabled = params.org.location?.enabled ?? true;\\n\\n  const sessionPayload = {\\n    orgId: params.org.id,\\n    ownerUid: params.owner.uid,\\n    ownerName: params.owner.name,\\n    ownerRole: params.owner.role === \'admin\' ? (\'admin\' as const) : (\'manager\' as const),\\n    title: params.title.trim(),\\n    status: \'open\' as const,\\n    durationMinutes: params.durationMinutes,\\n    locationCheckEnabled,\\n    location: {\\n      lat: params.lat,\\n      lng: params.lng,\\n      cosLat,\\n      radius: Math.max(20, Math.min(500, Math.round(params.radius))),\\n    },\\n    markedCount: 0,\\n    startedAt: serverTimestamp(),\\n    endsAt,\\n  };\\n\\n  await setDoc(sessionRef, sessionPayload);\\n\\n  await setDoc(doc(db, \'sessionSecrets\', sessionId), {\\n    ownerUid: params.owner.uid,\\n    orgId: params.org.id,\\n    token,\\n    prevToken: \'\',\\n    code,\\n    prevCode: \'\',\\n    tokenUpdatedAt: serverTimestamp(),\\n  });\\n\\n  return {\\n    session: {\\n      ...sessionPayload,\\n      id: sessionId,\\n      startedAt: Timestamp.now(),\\n    },\\n    token,\\n    code,\\n  };\\n}\\n\\nexport async function rotateSessionSecret(params: {\\n  sessionId: string;\\n  prevToken: string;\\n  prevCode: string;\\n}): Promise<{ token: string; code: string }> {\\n  const token = generateSessionToken();\\n  const code = generateSixDigitCode();\\n\\n  await updateDoc(doc(db, \'sessionSecrets\', params.sessionId), {\\n    token,\\n    prevToken: params.prevToken,\\n    code,\\n    prevCode: params.prevCode,\\n    tokenUpdatedAt: serverTimestamp(),\\n  });\\n\\n  return { token, code };\\n}\\n\\nexport async function extendAttendanceSession(\\n  sessionId: string,\\n  currentEndsAt: Timestamp | null | undefined,\\n  extraMinutes = 10\\n): Promise<Timestamp> {\\n  const baseMs = Math.max(Date.now(), currentEndsAt?.toMillis?.() ?? Date.now());\\n  const nextEndsAt = Timestamp.fromDate(new Date(baseMs + extraMinutes * 60 * 1000));\\n  await updateDoc(doc(db, \'sessions\', sessionId), {\\n    endsAt: nextEndsAt,\\n    status: \'open\',\\n  });\\n  return nextEndsAt;\\n}\\n\\nexport async function closeAttendanceSession(sessionId: string): Promise<void> {\\n  await updateDoc(doc(db, \'sessions\', sessionId), {\\n    status: \'closed\',\\n  });\\n}\\n\\nexport async function fetchOpenSessionByOwner(\\n  orgId: string,\\n  ownerUid: string\\n): Promise<AttendanceSession | null> {\\n  const snap = await getDocs(\\n    query(\\n      collection(db, \'sessions\'),\\n      where(\'orgId\', \'==\', orgId),\\n      where(\'ownerUid\', \'==\', ownerUid),\\n      where(\'status\', \'==\', \'open\')\\n    )\\n  );\\n  const nowMs = Date.now();\\n  const active = snap.docs\\n    .map((d) => ({ ...(d.data() as Omit<AttendanceSession, \'id\'>), id: d.id }))\\n    .filter((s) => (s.endsAt?.toMillis?.() ?? 0) > nowMs)\\n    .sort((a, b) => (b.startedAt?.toMillis?.() ?? 0) - (a.startedAt?.toMillis?.() ?? 0));\\n\\n  return active[0] || null;\\n}\\n\\n/**\\n * Finds the active open session of the logged-in user\'s direct parent\\n * (Member -> their Manager, Manager -> Org Admin).\\n */\\nexport async function findActiveParentSession(\\n  profile: UserProfile,\\n  org: Organization\\n): Promise<AttendanceSession | null> {\\n  const parentUid =\\n    profile.role === \'member\'\\n      ? profile.managerId\\n      : profile.role === \'manager\'\\n      ? org.adminUid\\n      : null;\\n\\n  if (!parentUid) return null;\\n  return fetchOpenSessionByOwner(org.id, parentUid);\\n}\\n\\nexport function subscribeSession(\\n  sessionId: string,\\n  callback: (session: AttendanceSession | null) => void\\n): () => void {\\n  return onSnapshot(doc(db, \'sessions\', sessionId), (snap) => {\\n    if (!snap.exists()) {\\n      callback(null);\\n    } else {\\n      callback({ ...(snap.data() as Omit<AttendanceSession, \'id\'>), id: snap.id });\\n    }\\n  });\\n}\\n\\nexport function subscribeSessionAttendance(\\n  orgId: string,\\n  sessionId: string,\\n  callback: (records: AttendanceRecord[]) => void\\n): () => void {\\n  const q = query(\\n    collection(db, \'attendance\'),\\n    where(\'orgId\', \'==\', orgId),\\n    where(\'sessionId\', \'==\', sessionId)\\n  );\\n  return onSnapshot(\\n    q,\\n    (snap) => {\\n      const list = snap.docs\\n        .map((d) => ({ ...(d.data() as AttendanceRecord), id: d.id }))\\n        .sort((a, b) => (b.timestamp?.toMillis?.() ?? 0) - (a.timestamp?.toMillis?.() ?? 0));\\n      callback(list);\\n    },\\n    () => callback([])\\n  );\\n}\\n\\nexport function subscribeSessionAttempts(\\n  orgId: string,\\n  sessionId: string,\\n  callback: (attempts: AttendanceAttempt[]) => void\\n): () => void {\\n  const q = query(\\n    collection(db, \'attempts\'),\\n    where(\'orgId\', \'==\', orgId),\\n    where(\'sessionId\', \'==\', sessionId)\\n  );\\n  return onSnapshot(\\n    q,\\n    (snap) => {\\n      const list = snap.docs\\n        .map((d) => ({ ...(d.data() as AttendanceAttempt), id: d.id }))\\n        .sort((a, b) => (b.time?.toMillis?.() ?? 0) - (a.time?.toMillis?.() ?? 0));\\n      callback(list);\\n    },\\n    () => callback([])\\n  );\\n}\\n\\nexport async function logFailedAttempt(params: {\\n  orgId: string;\\n  sessionId: string;\\n  ownerUid: string;\\n  person: UserProfile;\\n  reason: string;\\n  distance: number | null;\\n}): Promise<void> {\\n  try {\\n    await addDoc(collection(db, \'attempts\'), {\\n      orgId: params.orgId,\\n      sessionId: params.sessionId,\\n      ownerUid: params.ownerUid,\\n      personUid: params.person.uid,\\n      personName: params.person.name,\\n      personId: params.person.memberId || \'\',\\n      reason: params.reason,\\n      distance: params.distance,\\n      time: serverTimestamp(),\\n    });\\n  } catch {\\n    // Logging failure should never block user feedback\\n  }\\n}\\n\\nexport type SelfMarkErrorCode =\\n  | \'errExpired\'\\n  | \'errInvalidCode\'\\n  | \'errOutsideArea\'\\n  | \'errSessionClosed\'\\n  | \'errAlreadyMarked\'\\n  | \'errDeviceUsed\'\\n  | \'errWrongSession\'\\n  | \'generic\';\\n\\nexport interface SelfMarkResult {\\n  ok: boolean;\\n  errorCode?: SelfMarkErrorCode;\\n  status?: AttendanceStatus;\\n  timeStr?: string;\\n  distanceMeters?: number;\\n}\\n\\n/**\\n * Self-marking flow enforced by Firestore Security Rules (zero Cloud Functions):\\n * - Writes `attendance/{orgId}_{date}_{personUid}` and `sessionDevices/{sessionId}_{deviceId}`\\n *   atomically in a single writeBatch.\\n * - Firestore rules verify session open/endsAt, token/code against `sessionSecrets`\\n *   (15s current / 5s previous), flat-earth radius using `cosLat`, and one-device lock.\\n */\\nexport async function submitSelfAttendance(params: {\\n  org: Organization;\\n  profile: UserProfile;\\n  session: AttendanceSession;\\n  method: \'live_qr\' | \'live_code\';\\n  token?: string;\\n  code?: string;\\n  lat: number;\\n  lng: number;\\n  accuracy: number;\\n}): Promise<SelfMarkResult> {\\n  const { org, profile, session, method, lat, lng, accuracy } = params;\\n\\n  const distanceMeters = getFlatEarthDistanceMeters(\\n    lat,\\n    lng,\\n    session.location.lat,\\n    session.location.lng,\\n    session.location.cosLat\\n  );\\n\\n  // Client pre-checks for immediate feedback + attempt logging\\n  if (session.status !== \'open\' || (session.endsAt?.toMillis?.() ?? 0) < Date.now()) {\\n    return { ok: false, errorCode: \'errSessionClosed\' };\\n  }\\n\\n  if (session.locationCheckEnabled && distanceMeters > session.location.radius) {\\n    await logFailedAttempt({\\n      orgId: org.id,\\n      sessionId: session.id,\\n      ownerUid: session.ownerUid,\\n      person: profile,\\n      reason: \'outside_radius\',\\n      distance: distanceMeters,\\n    });\\n    return { ok: false, errorCode: \'errOutsideArea\', distanceMeters };\\n  }\\n\\n  const date = getOrgDateString(org.timezone || \'Asia/Kolkata\');\\n  const currentHHMM = getOrgTimeHHMM(org.timezone || \'Asia/Kolkata\');\\n  const attendanceDocId = buildAttendanceDocId(org.id, date, profile.uid);\\n\\n  // Check if already marked today\\n  const existingAtt = await getDoc(doc(db, \'attendance\', attendanceDocId));\\n  if (existingAtt.exists()) {\\n    return { ok: false, errorCode: \'errAlreadyMarked\' };\\n  }\\n\\n  // Check if this device was already used in this session\\n  const deviceId = getOrCreateDeviceId();\\n  const deviceDocId = `${session.id}_${deviceId}`;\\n  try {\\n    const existingDevice = await getDoc(doc(db, \'sessionDevices\', deviceDocId));\\n    if (existingDevice.exists()) {\\n      await logFailedAttempt({\\n        orgId: org.id,\\n        sessionId: session.id,\\n        ownerUid: session.ownerUid,\\n        person: profile,\\n        reason: \'device_already_used\',\\n        distance: distanceMeters,\\n      });\\n      return { ok: false, errorCode: \'errDeviceUsed\' };\\n    }\\n  } catch {\\n    // Proceed to atomic batch which is authoritative\\n  }\\n\\n  const status: AttendanceStatus = isAfterLateTime(currentHHMM, org.lateAfter)\\n    ? \'late\'\\n    : \'present\';\\n\\n  const batch = writeBatch(db);\\n\\n  batch.set(doc(db, \'sessionDevices\', deviceDocId), {\\n    sessionId: session.id,\\n    deviceId,\\n    personUid: profile.uid,\\n    orgId: org.id,\\n    createdAt: serverTimestamp(),\\n  });\\n\\n  batch.set(doc(db, \'attendance\', attendanceDocId), {\\n    orgId: org.id,\\n    personUid: profile.uid,\\n    personName: profile.name,\\n    personMemberId: profile.memberId,\\n    role: profile.role === \'admin\' ? \'manager\' : profile.role,\\n    managerId: profile.managerId || null,\\n    date,\\n    timestamp: serverTimestamp(),\\n    status,\\n    method,\\n    markedBy: profile.uid,\\n    note: \'\',\\n    sessionId: session.id,\\n    lat,\\n    lng,\\n    accuracy,\\n    distanceMeters,\\n    deviceId,\\n    ...(method === \'live_qr\' ? { submittedToken: params.token || \'\' } : {}),\\n    ...(method === \'live_code\' ? { submittedCode: params.code || \'\' } : {}),\\n  });\\n\\n  try {\\n    await batch.commit();\\n    return {\\n      ok: true,\\n      status,\\n      timeStr: currentHHMM,\\n      distanceMeters,\\n    };\\n  } catch (err) {\\n    // Diagnose rejection reason accurately\\n    try {\\n      const [attSnap, devSnap, sessSnap] = await Promise.all([\\n        getDoc(doc(db, \'attendance\', attendanceDocId)),\\n        getDoc(doc(db, \'sessionDevices\', deviceDocId)),\\n        getDoc(doc(db, \'sessions\', session.id)),\\n      ]);\\n\\n      if (attSnap.exists()) {\\n        return { ok: false, errorCode: \'errAlreadyMarked\' };\\n      }\\n      if (devSnap.exists()) {\\n        await logFailedAttempt({\\n          orgId: org.id,\\n          sessionId: session.id,\\n          ownerUid: session.ownerUid,\\n          person: profile,\\n          reason: \'device_already_used\',\\n          distance: distanceMeters,\\n        });\\n        return { ok: false, errorCode: \'errDeviceUsed\' };\\n      }\\n      if (sessSnap.exists()) {\\n        const s = sessSnap.data() as AttendanceSession;\\n        if (s.status !== \'open\' || (s.endsAt?.toMillis?.() ?? 0) < Date.now()) {\\n          return { ok: false, errorCode: \'errSessionClosed\' };\\n        }\\n      }\\n    } catch {\\n      // Fall through to token/code error\\n    }\\n\\n    const codeErr = (err as { code?: string })?.code;\\n    if (codeErr === \'permission-denied\') {\\n      await logFailedAttempt({\\n        orgId: org.id,\\n        sessionId: session.id,\\n        ownerUid: session.ownerUid,\\n        person: profile,\\n        reason: \'expired_or_invalid_secret\',\\n        distance: distanceMeters,\\n      });\\n      return {\\n        ok: false,\\n        errorCode: method === \'live_qr\' ? \'errExpired\' : \'errInvalidCode\',\\n      };\\n    }\\n\\n    return { ok: false, errorCode: \'generic\' };\\n  }\\n}\\n\", \"Description\":\"Create sessionService handling live rotating QR/code sessions, 10s secret rotation, realtime attendance/attempts subscriptions, and atomic self-marking with one-device lock\", \"Overwrite\":true, \"TargetFile\":\"/src/services/sessionService.ts\", \"toolAction\":\"Creating live session service\", \"toolSummary\":\"Create src/services/sessionService.ts\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_8998832684038255210"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import {\\n  collection,\\n  doc,\\n  getDoc,\\n  getDocs,\\n  query,\\n  serverTimestamp,\\n  setDoc,\\n  where,\\n  writeBatch,\\n} from \'firebase/firestore\';\\nimport { db } from \'../firebase\';\\nimport type {\\n  AttendanceMethod,\\n  AttendanceRecord,\\n  AttendanceStatus,\\n  Organization,\\n  QRPayload,\\n  UserProfile,\\n} from \'../types\';\\nimport {\\n  getCurrentPosition,\\n  getDistanceMeters,\\n  getOrgDateString,\\n  getOrgTimeHHMM,\\n  isAfterLateTime,\\n} from \'../utils/helpers\';\\n\\nexport function buildAttendanceDocId(orgId: string, date: string, personUid: string): string {\\n  return `${orgId}_${date}_${personUid}`;\\n}\\n\\nexport async function verifyLocationCheck(\\n  org: Organization\\n): Promise<{ ok: true } | { ok: false; reason: \'locationDenied\' | \'locationTooFar\'; distance?: number }> {\\n  if (!org.location?.enabled) return { ok: true };\\n  if (!org.location.lat && !org.location.lng) return { ok: true };\\n\\n  try {\\n    const pos = await getCurrentPosition();\\n    const distance = getDistanceMeters(pos.lat, pos.lng, org.location.lat, org.location.lng);\\n    if (distance > (org.location.radius || 50)) {\\n      return { ok: false, reason: \'locationTooFar\', distance };\\n    }\\n    return { ok: true };\\n  } catch {\\n    return { ok: false, reason: \'locationDenied\' };\\n  }\\n}\\n\\nexport interface QRScanResult {\\n  ok: boolean;\\n  code:\\n    | \'markedPresent\'\\n    | \'markedLate\'\\n    | \'alreadyMarked\'\\n    | \'invalidQr\'\\n    | \'wrongOrg\'\\n    | \'notYourPerson\'\\n    | \'userInactive\'\\n    | \'userNotFound\'\\n    | \'locationDenied\'\\n    | \'locationTooFar\';\\n  personName?: string;\\n  memberId?: string;\\n  status?: AttendanceStatus;\\n  timeStr?: string;\\n  distance?: number;\\n}\\n\\n/**\\n * Backup ID-Card QR scanner used by Admin/Manager (e.g. when a member has a dead phone or no GPS).\\n * Tagged as method: \\\"manual\\\" so reports highlight backup entries cleanly in yellow.\\n */\\nexport async function markAttendanceViaQR(params: {\\n  rawText: string;\\n  org: Organization;\\n  marker: UserProfile;\\n  skipLocationCheck?: boolean;\\n}): Promise<QRScanResult> {\\n  let payload: QRPayload;\\n  try {\\n    const parsed = JSON.parse(params.rawText);\\n    if (!parsed || typeof parsed.orgId !== \'string\' || typeof parsed.uid !== \'string\') {\\n      return { ok: false, code: \'invalidQr\' };\\n    }\\n    payload = parsed as QRPayload;\\n  } catch {\\n    return { ok: false, code: \'invalidQr\' };\\n  }\\n\\n  if (payload.orgId !== params.org.id) {\\n    return { ok: false, code: \'wrongOrg\' };\\n  }\\n\\n  const personSnap = await getDoc(doc(db, \'users\', payload.uid));\\n  if (!personSnap.exists()) {\\n    return { ok: false, code: \'userNotFound\' };\\n  }\\n  const person = { ...(personSnap.data() as UserProfile), uid: personSnap.id };\\n\\n  if (person.orgId !== params.org.id) {\\n    return { ok: false, code: \'wrongOrg\' };\\n  }\\n\\n  if (person.status !== \'active\') {\\n    return { ok: false, code: \'userInactive\', personName: person.name, memberId: person.memberId };\\n  }\\n\\n  const isDirectParent =\\n    (params.marker.role === \'admin\' && person.role === \'manager\') ||\\n    (params.marker.role === \'manager\' &&\\n      person.role === \'member\' &&\\n      person.managerId === params.marker.uid);\\n\\n  if (!isDirectParent) {\\n    return { ok: false, code: \'notYourPerson\', personName: person.name, memberId: person.memberId };\\n  }\\n\\n  const date = getOrgDateString(params.org.timezone || \'Asia/Kolkata\');\\n  const currentHHMM = getOrgTimeHHMM(params.org.timezone || \'Asia/Kolkata\');\\n  const docId = buildAttendanceDocId(params.org.id, date, person.uid);\\n  const existing = await getDoc(doc(db, \'attendance\', docId));\\n\\n  if (existing.exists()) {\\n    const existingData = existing.data() as AttendanceRecord;\\n    return {\\n      ok: false,\\n      code: \'alreadyMarked\',\\n      personName: person.name,\\n      memberId: person.memberId,\\n      status: existingData.status,\\n      timeStr: currentHHMM,\\n    };\\n  }\\n\\n  const status: AttendanceStatus = isAfterLateTime(currentHHMM, params.org.lateAfter)\\n    ? \'late\'\\n    : \'present\';\\n\\n  await setDoc(doc(db, \'attendance\', docId), {\\n    orgId: params.org.id,\\n    personUid: person.uid,\\n    personName: person.name,\\n    personMemberId: person.memberId,\\n    role: person.role,\\n    managerId: person.managerId || null,\\n    date,\\n    timestamp: serverTimestamp(),\\n    status,\\n    method: \'manual\' as AttendanceMethod,\\n    markedBy: params.marker.uid,\\n    note: \'ID Card QR backup\',\\n  });\\n\\n  return {\\n    ok: true,\\n    code: status === \'late\' ? \'markedLate\' : \'markedPresent\',\\n    personName: person.name,\\n    memberId: person.memberId,\\n    status,\\n    timeStr: currentHHMM,\\n  };\\n}\\n\\nexport async function markAttendanceManual(params: {\\n  org: Organization;\\n  marker: UserProfile;\\n  person: UserProfile;\\n  date: string;\\n  status: AttendanceStatus;\\n  note?: string;\\n}): Promise<void> {\\n  if (params.person.status !== \'active\') {\\n    throw new Error(\'Cannot mark inactive or pending user\');\\n  }\\n  const today = getOrgDateString(params.org.timezone || \'Asia/Kolkata\');\\n  if (params.marker.role !== \'admin\' && params.date !== today) {\\n    throw new Error(\'Only admins can edit past dates\');\\n  }\\n\\n  const docId = buildAttendanceDocId(params.org.id, params.date, params.person.uid);\\n  await setDoc(doc(db, \'attendance\', docId), {\\n    orgId: params.org.id,\\n    personUid: params.person.uid,\\n    personName: params.person.name,\\n    personMemberId: params.person.memberId,\\n    role: params.person.role === \'admin\' ? \'manager\' : params.person.role,\\n    managerId: params.person.managerId || null,\\n    date: params.date,\\n    timestamp: serverTimestamp(),\\n    status: params.status,\\n    method: \'manual\' as AttendanceMethod,\\n    markedBy: params.marker.uid,\\n    note: params.note?.trim() || \'\',\\n  });\\n}\\n\\nexport async function bulkMarkAttendance(params: {\\n  org: Organization;\\n  marker: UserProfile;\\n  entries: Array<{ person: UserProfile; status: AttendanceStatus; note?: string }>;\\n  date: string;\\n}): Promise<void> {\\n  const today = getOrgDateString(params.org.timezone || \'Asia/Kolkata\');\\n  if (params.marker.role !== \'admin\' && params.date !== today) {\\n    throw new Error(\'Only admins can edit past dates\');\\n  }\\n\\n  const CHUNK = 400;\\n  for (let i = 0; i < params.entries.length; i += CHUNK) {\\n    const slice = params.entries.slice(i, i + CHUNK);\\n    const batch = writeBatch(db);\\n    for (const entry of slice) {\\n      if (entry.person.status !== \'active\') continue;\\n      const docId = buildAttendanceDocId(params.org.id, params.date, entry.person.uid);\\n      batch.set(doc(db, \'attendance\', docId), {\\n        orgId: params.org.id,\\n        personUid: entry.person.uid,\\n        personName: entry.person.name,\\n        personMemberId: entry.person.memberId,\\n        role: entry.person.role === \'admin\' ? \'manager\' : entry.person.role,\\n        managerId: entry.person.managerId || null,\\n        date: params.date,\\n        timestamp: serverTimestamp(),\\n        status: entry.status,\\n        method: \'manual\' as AttendanceMethod,\\n        markedBy: params.marker.uid,\\n        note: entry.note?.trim() || \'\',\\n      });\\n    }\\n    await batch.commit();\\n  }\\n}\\n\\nexport async function fetchAttendanceForOrg(\\n  orgId: string,\\n  options?: { fromDate?: string; toDate?: string; date?: string }\\n): Promise<AttendanceRecord[]> {\\n  const constraints = [where(\'orgId\', \'==\', orgId)];\\n  if (options?.date) {\\n    constraints.push(where(\'date\', \'==\', options.date));\\n  }\\n  const snap = await getDocs(query(collection(db, \'attendance\'), ...constraints));\\n  let records = snap.docs.map((d) => ({ ...(d.data() as AttendanceRecord), id: d.id }));\\n  if (options?.fromDate) records = records.filter((r) => r.date >= options.fromDate!);\\n  if (options?.toDate) records = records.filter((r) => r.date <= options.toDate!);\\n  return records.sort((a, b) => b.date.localeCompare(a.date));\\n}\\n\\nexport async function fetchAttendanceForManager(\\n  orgId: string,\\n  managerUid: string,\\n  options?: { fromDate?: string; toDate?: string; date?: string; includeOwn?: boolean }\\n): Promise<AttendanceRecord[]> {\\n  const teamConstraints = [\\n    where(\'orgId\', \'==\', orgId),\\n    where(\'managerId\', \'==\', managerUid),\\n  ];\\n  if (options?.date) teamConstraints.push(where(\'date\', \'==\', options.date));\\n  const teamSnap = await getDocs(query(collection(db, \'attendance\'), ...teamConstraints));\\n  let records = teamSnap.docs.map((d) => ({ ...(d.data() as AttendanceRecord), id: d.id }));\\n\\n  if (options?.includeOwn) {\\n    const ownConstraints = [\\n      where(\'orgId\', \'==\', orgId),\\n      where(\'personUid\', \'==\', managerUid),\\n    ];\\n    if (options?.date) ownConstraints.push(where(\'date\', \'==\', options.date));\\n    const ownSnap = await getDocs(query(collection(db, \'attendance\'), ...ownConstraints));\\n    const ownRecs = ownSnap.docs.map((d) => ({ ...(d.data() as AttendanceRecord), id: d.id }));\\n    const seen = new Set(records.map((r) => r.id));\\n    for (const r of ownRecs) {\\n      if (!seen.has(r.id)) records.push(r);\\n    }\\n  }\\n\\n  if (options?.fromDate) records = records.filter((r) => r.date >= options.fromDate!);\\n  if (options?.toDate) records = records.filter((r) => r.date <= options.toDate!);\\n  return records.sort((a, b) => b.date.localeCompare(a.date));\\n}\\n\\nexport async function fetchAttendanceForPerson(\\n  orgId: string,\\n  personUid: string,\\n  options?: { fromDate?: string; toDate?: string }\\n): Promise<AttendanceRecord[]> {\\n  const snap = await getDocs(\\n    query(\\n      collection(db, \'attendance\'),\\n      where(\'orgId\', \'==\', orgId),\\n      where(\'personUid\', \'==\', personUid)\\n    )\\n  );\\n  let records = snap.docs.map((d) => ({ ...(d.data() as AttendanceRecord), id: d.id }));\\n  if (options?.fromDate) records = records.filter((r) => r.date >= options.fromDate!);\\n  if (options?.toDate) records = records.filter((r) => r.date <= options.toDate!);\\n  return records.sort((a, b) => b.date.localeCompare(a.date));\\n}\\n\", \"Description\":\"Update attendanceService so backup ID-card QR scans accept { orgId, uid, id } and tag backup entries as manual\", \"Overwrite\":true, \"TargetFile\":\"/src/services/attendanceService.ts\", \"toolAction\":\"Updating attendanceService backup logic\", \"toolSummary\":\"Update src/services/attendanceService.ts\"}"
      original_name: "write_to_file"
    }
