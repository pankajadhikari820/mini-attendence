            }
            lines {
              text: "    \"faq1Q\": \"Is it free?\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    \"faq1A\": \"Yes. You can create your organization, add your team, and mark attendance right away at no cost.\","
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    \"faq1A\": \"Yes. You can create your organization, add your team, and run live attendance sessions at no cost.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"faq2Q\": \"Do members need to install an app?\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    \"faq2A\": \"No. They can open it in any browser, save their QR image, or print an ID card. They can also install it to their home screen if they like.\","
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    \"faq3Q\": \"How is the QR code made?\","
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    \"faq3A\": \"As soon as someone is added or approved, a unique ID and QR code are generated automatically for them.\","
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    \"faq4Q\": \"Can one person see another person\'s data?\","
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    \"faq4A\": \"No. Members only see their own records. Managers only see their own assigned members. Organizations are completely isolated from each other.\","
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    \"faq2A\": \"No. They can open it in any browser, scan the live QR or enter their ID, and install to their home screen if they like.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"faq3Q\": \"How is the unique ID made?\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"faq3A\": \"Every person receives a globally unique 6-character ID made from 3 letters of their name and 3 random digits (like PAN482).\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"faq4Q\": \"Can someone share a screenshot of the QR?\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"faq4A\": \"No. The live QR and 6-digit code rotate every 10 seconds, expire within 15 seconds, check GPS distance, and allow only one person per device.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
