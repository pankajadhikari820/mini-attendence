      arguments_json: "{\"CodeContent\":\"{\\n  \\\"indexes\\\": [\\n    {\\n      \\\"collectionGroup\\\": \\\"users\\\",\\n      \\\"queryScope\\\": \\\"COLLECTION\\\",\\n      \\\"fields\\\": [\\n        { \\\"fieldPath\\\": \\\"orgId\\\", \\\"order\\\": \\\"ASCENDING\\\" },\\n        { \\\"fieldPath\\\": \\\"role\\\", \\\"order\\\": \\\"ASCENDING\\\" }\\n      ]\\n    },\\n    {\\n      \\\"collectionGroup\\\": \\\"users\\\",\\n      \\\"queryScope\\\": \\\"COLLECTION\\\",\\n      \\\"fields\\\": [\\n        { \\\"fieldPath\\\": \\\"orgId\\\", \\\"order\\\": \\\"ASCENDING\\\" },\\n        { \\\"fieldPath\\\": \\\"managerId\\\", \\\"order\\\": \\\"ASCENDING\\\" }\\n      ]\\n    },\\n    {\\n      \\\"collectionGroup\\\": \\\"users\\\",\\n      \\\"queryScope\\\": \\\"COLLECTION\\\",\\n      \\\"fields\\\": [\\n        { \\\"fieldPath\\\": \\\"orgId\\\", \\\"order\\\": \\\"ASCENDING\\\" },\\n        { \\\"fieldPath\\\": \\\"isDemo\\\", \\\"order\\\": \\\"ASCENDING\\\" }\\n      ]\\n    },\\n    {\\n      \\\"collectionGroup\\\": \\\"attendance\\\",\\n      \\\"queryScope\\\": \\\"COLLECTION\\\",\\n      \\\"fields\\\": [\\n        { \\\"fieldPath\\\": \\\"orgId\\\", \\\"order\\\": \\\"ASCENDING\\\" },\\n        { \\\"fieldPath\\\": \\\"date\\\", \\\"order\\\": \\\"ASCENDING\\\" }\\n      ]\\n    },\\n    {\\n      \\\"collectionGroup\\\": \\\"attendance\\\",\\n      \\\"queryScope\\\": \\\"COLLECTION\\\",\\n      \\\"fields\\\": [\\n        { \\\"fieldPath\\\": \\\"orgId\\\", \\\"order\\\": \\\"ASCENDING\\\" },\\n        { \\\"fieldPath\\\": \\\"managerId\\\", \\\"order\\\": \\\"ASCENDING\\\" },\\n        { \\\"fieldPath\\\": \\\"date\\\", \\\"order\\\": \\\"ASCENDING\\\" }\\n      ]\\n    },\\n    {\\n      \\\"collectionGroup\\\": \\\"attendance\\\",\\n      \\\"queryScope\\\": \\\"COLLECTION\\\",\\n      \\\"fields\\\": [\\n        { \\\"fieldPath\\\": \\\"orgId\\\", \\\"order\\\": \\\"ASCENDING\\\" },\\n        { \\\"fieldPath\\\": \\\"personUid\\\", \\\"order\\\": \\\"ASCENDING\\\" },\\n        { \\\"fieldPath\\\": \\\"date\\\", \\\"order\\\": \\\"DESCENDING\\\" }\\n      ]\\n    },\\n    {\\n      \\\"collectionGroup\\\": \\\"attendance\\\",\\n      \\\"queryScope\\\": \\\"COLLECTION\\\",\\n      \\\"fields\\\": [\\n        { \\\"fieldPath\\\": \\\"orgId\\\", \\\"order\\\": \\\"ASCENDING\\\" },\\n        { \\\"fieldPath\\\": \\\"isDemo\\\", \\\"order\\\": \\\"ASCENDING\\\" }\\n      ]\\n    },\\n    {\\n      \\\"collectionGroup\\\": \\\"leaves\\\",\\n      \\\"queryScope\\\": \\\"COLLECTION\\\",\\n      \\\"fields\\\": [\\n        { \\\"fieldPath\\\": \\\"orgId\\\", \\\"order\\\": \\\"ASCENDING\\\" },\\n        { \\\"fieldPath\\\": \\\"toUid\\\", \\\"order\\\": \\\"ASCENDING\\\" },\\n        { \\\"fieldPath\\\": \\\"createdAt\\\", \\\"order\\\": \\\"DESCENDING\\\" }\\n      ]\\n    },\\n    {\\n      \\\"collectionGroup\\\": \\\"leaves\\\",\\n      \\\"queryScope\\\": \\\"COLLECTION\\\",\\n      \\\"fields\\\": [\\n        { \\\"fieldPath\\\": \\\"orgId\\\", \\\"order\\\": \\\"ASCENDING\\\" },\\n        { \\\"fieldPath\\\": \\\"personUid\\\", \\\"order\\\": \\\"ASCENDING\\\" },\\n        { \\\"fieldPath\\\": \\\"createdAt\\\", \\\"order\\\": \\\"DESCENDING\\\" }\\n      ]\\n    },\\n    {\\n      \\\"collectionGroup\\\": \\\"announcements\\\",\\n      \\\"queryScope\\\": \\\"COLLECTION\\\",\\n      \\\"fields\\\": [\\n        { \\\"fieldPath\\\": \\\"orgId\\\", \\\"order\\\": \\\"ASCENDING\\\" },\\n        { \\\"fieldPath\\\": \\\"createdAt\\\", \\\"order\\\": \\\"DESCENDING\\\" }\\n      ]\\n    },\\n    {\\n      \\\"collectionGroup\\\": \\\"notifications\\\",\\n      \\\"queryScope\\\": \\\"COLLECTION\\\",\\n      \\\"fields\\\": [\\n        { \\\"fieldPath\\\": \\\"toUid\\\", \\\"order\\\": \\\"ASCENDING\\\" },\\n        { \\\"fieldPath\\\": \\\"createdAt\\\", \\\"order\\\": \\\"DESCENDING\\\" }\\n      ]\\n    }\\n  ],\\n  \\\"fieldOverrides\\\": []\\n}\\n\", \"Description\":\"Define all composite Firestore indexes required for org-scoped queries\", \"Overwrite\":true, \"TargetFile\":\"/firestore.indexes.json\", \"toolAction\":\"Creating Firestore indexes config\", \"toolSummary\":\"Create firestore.indexes.json\"}"
