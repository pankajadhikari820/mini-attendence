    tool_calls {
      id: "call_14380352042139270757"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Preserve intended destination path and query when redirecting unauthenticated users to login\", \"EndLine\":40, \"Instruction\":\"Import useLocation and pass state={{ from: location.pathname + location.search }} when redirecting to /login.\", \"ReplacementContent\":\"import React from \'react\';\\nimport { Navigate, useLocation } from \'react-router-dom\';\\nimport { useAuth } from \'../context/AuthContext\';\\nimport type { UserRole } from \'../types\';\\n\\ninterface ProtectedRouteProps {\\n  allowedRoles?: UserRole[];\\n  allowPending?: boolean;\\n  children: React.ReactNode;\\n}\\n\\nexport function getHomePathForRole(role?: UserRole): string {\\n  if (role === \'admin\') return \'/admin\';\\n  if (role === \'manager\') return \'/manager\';\\n  if (role === \'member\') return \'/member\';\\n  return \'/login\';\\n}\\n\\nexport const ProtectedRoute: React.FC<ProtectedRouteProps> = ({\\n  allowedRoles,\\n  allowPending = false,\\n  children,\\n}) => {\\n  const { user, profile, loading } = useAuth();\\n  const location = useLocation();\\n\\n  if (loading) {\\n    return (\\n      <div className=\\\"min-h-screen flex items-center justify-center bg-[#FAF9F6] dark:bg-[#0F0F11]\\\">\\n        <div className=\\\"w-7 h-7 rounded-full border-2 border-stone-300 dark:border-stone-700 border-t-[#C25E00] animate-spin\\\" />\\n      </div>\\n    );\\n  }\\n\\n  if (!user || !profile) {\\n    return (\\n      <Navigate\\n        to=\\\"/login\\\"\\n        replace\\n        state={{ from: `${location.pathname}${location.search}` }}\\n      />\\n    );\\n  }\", \"StartLine\":1, \"TargetContent\":\"import React from \'react\';\\nimport { Navigate } from \'react-router-dom\';\\nimport { useAuth } from \'../context/AuthContext\';\\nimport type { UserRole } from \'../types\';\\n\\ninterface ProtectedRouteProps {\\n  allowedRoles?: UserRole[];\\n  allowPending?: boolean;\\n  children: React.ReactNode;\\n}\\n\\nexport function getHomePathForRole(role?: UserRole): string {\\n  if (role === \'admin\') return \'/admin\';\\n  if (role === \'manager\') return \'/manager\';\\n  if (role === \'member\') return \'/member\';\\n  return \'/login\';\\n}\\n\\nexport const ProtectedRoute: React.FC<ProtectedRouteProps> = ({\\n  allowedRoles,\\n  allowPending = false,\\n  children,\\n}) => {\\n  const { user, profile, loading } = useAuth();\\n\\n  if (loading) {\\n    return (\\n      <div className=\\\"min-h-screen flex items-center justify-center bg-[#FAF9F6] dark:bg-[#0F0F11]\\\">\\n        <div className=\\\"w-7 h-7 rounded-full border-2 border-stone-300 dark:border-stone-700 border-t-[#C25E00] animate-spin\\\" />\\n      </div>\\n    );\\n  }\\n\\n  if (!user || !profile) {\\n    return <Navigate to=\\\"/login\\\" replace />;\\n  }\", \"TargetFile\":\"/src/components/ProtectedRoute.tsx\", \"toolAction\":\"Updating ProtectedRoute redirect state\", \"toolSummary\":\"Update ProtectedRoute.tsx\"}"
      original_name: "replace_file_content"
    }
    tool_calls {
      id: "call_14380352042139267168"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Return user to requested route (e.g. /mark) after login\", \"EndLine\":33, \"Instruction\":\"Read redirect destination from location.state?.from and navigate there after active login.\", \"ReplacementContent\":\"import React, { useEffect, useState } from \'react\';\\nimport { Link, useLocation, useNavigate } from \'react-router-dom\';\\nimport { signInWithEmailAndPassword } from \'firebase/auth\';\\nimport { auth } from \'../firebase\';\\nimport { useAuth } from \'../context/AuthContext\';\\nimport { useTranslation } from \'../hooks/useTranslation\';\\nimport { getFirebaseErrorKey } from \'../utils/helpers\';\\nimport { Logo } from \'../components/Logo\';\\nimport { LanguageToggle } from \'../components/LanguageToggle\';\\nimport { ThemeToggle } from \'../components/ThemeToggle\';\\nimport { getHomePathForRole } from \'../components/ProtectedRoute\';\\n\\nexport const LoginPage: React.FC = () => {\\n  const { user, profile } = useAuth();\\n  const { t } = useTranslation();\\n  const navigate = useNavigate();\\n  const location = useLocation();\\n  const redirectFrom = (location.state as { from?: string } | null)?.from;\\n\\n  const [email, setEmail] = useState(\'\');\\n  const [password, setPassword] = useState(\'\');\\n  const [error, setError] = useState(\'\');\\n  const [submitting, setSubmitting] = useState(false);\\n\\n  useEffect(() => {\\n    if (user && profile) {\\n      if (profile.status === \'pending\' || profile.status === \'inactive\') {\\n        navigate(\'/pending\', { replace: true });\\n      } else if (\\n        redirectFrom &&\\n        redirectFrom.startsWith(\'/\') &&\\n        !redirectFrom.startsWith(\'/login\') &&\\n        !redirectFrom.startsWith(\'/register\') &&\\n        !redirectFrom.startsWith(\'/pending\')\\n      ) {\\n        if (redirectFrom.startsWith(\'/mark\') && profile.role === \'admin\') {\\n          navigate(\'/attendance\', { replace: true });\\n        } else {\\n          navigate(redirectFrom, { replace: true });\\n        }\\n      } else {\\n        navigate(getHomePathForRole(profile.role), { replace: true });\\n      }\\n    }\\n  }, [user, profile, navigate, redirectFrom]);\", \"StartLine\":1, \"TargetContent\":\"import React, { useEffect, useState } from \'react\';\\nimport { Link, useNavigate } from \'react-router-dom\';\\nimport { signInWithEmailAndPassword } from \'firebase/auth\';\\nimport { auth } from \'../firebase\';\\nimport { useAuth } from \'../context/AuthContext\';\\nimport { useTranslation } from \'../hooks/useTranslation\';\\nimport { getFirebaseErrorKey } from \'../utils/helpers\';\\nimport { Logo } from \'../components/Logo\';\\nimport { LanguageToggle } from \'../components/LanguageToggle\';\\nimport { ThemeToggle } from \'../components/ThemeToggle\';\\nimport { getHomePathForRole } from \'../components/ProtectedRoute\';\\n\\nexport const LoginPage: React.FC = () => {\\n  const { user, profile } = useAuth();\\n  const { t } = useTranslation();\\n  const navigate = useNavigate();\\n\\n  const [email, setEmail] = useState(\'\');\\n  const [password, setPassword] = useState(\'\');\\n  const [error, setError] = useState(\'\');\\n  const [submitting, setSubmitting] = useState(false);\\n\\n  useEffect(() => {\\n    if (user && profile) {\\n      if (profile.status === \'pending\' || profile.status === \'inactive\') {\\n        navigate(\'/pending\', { replace: true });\\n      } else {\\n        navigate(getHomePathForRole(profile.role), { replace: true });\\n      }\\n    }\\n  }, [user, profile, navigate]);\", \"TargetFile\":\"/src/pages/LoginPage.tsx\", \"toolAction\":\"Updating LoginPage post-login redirect\", \"toolSummary\":\"Update LoginPage.tsx\"}"
