71\340\245\210\340\245\244\",\n    \"tabScanQr\": \"QR \340\244\270\340\245\215\340\244\225\340\245\210\340\244\250 \340\244\225\340\244\260\340\245\207\340\244\202\",\n    \"tabEnterId\": \"\340\244\206\340\244\210\340\244\241\340\245\200 \340\244\241\340\244\276\340\244\262\340\245\207\340\244\202\",\n    \"yourIdLabel\": \"\340\244\206\340\244\252\340\244\225\340\245\200 \340\244\206\340\244\210\340\244\241\340\245\200 (6 \340\244\205\340\244\225\340\245\215\340\244\267\340\244\260)\",\n    \"yourIdPlaceholder\": \"\340\244\234\340\245\210\340\244\270\340\245\207: PAN482\",\n    \"idMismatch\": \"\340\244\205\340\244\252\340\244\250\340\245\200 \340\244\271\340\245\200 6 \340\244\205\340\244\225\340\245\215\340\244\267\340\244\260\340\245\213\340\244\202 \340\244\225\340\245\200 \340\244\206\340\244\210\340\244\241\340\245\200 \340\244\246\340\244\260\340\245\215\340\244\234 \340\244\225\340\244\260\340\245\207\340\244\202\",\n    \"liveCodeLabel\": \"\340\244\262\340\244\276\340\244\207\340\244\265 \340\244\225\340\245\213\340\244\241 (6 \340\244\205\340\244\202\340\244\225)\",\n    \"liveCodePlaceholder\": \"000000\",\n    \"submitBtn\": \"\340\244\271\340\244\276\340\244\234\340\244\274\340\244\277\340\244\260\340\245\200 \340\244\262\340\244\227\340\244\276\340\244\217\340\244\201\",\n    \"submitting\": \"\340\244\270\340\244\244\340\245\215\340\244\257\340\244\276\340\244\252\340\244\250 \340\244\271\340\245\213 \340\244\260\340\244\271\340\244\276 \340\244\271\340\245\210...\",\n    \"successTitle\": \"\340\244\271\340\244\276\340\244\234\340\244\274\340\244\277\340\244\260\340\245\200 \340\244\262\340\244\227 \340\244\227\340\244\210\",\n    \"distanceLabel\": \"\340\244\246\340\245\202\340\244\260\340\245\200\",\n    \"errExpired\": \"QR \340\244\225\340\245\200 10 \340\244\270\340\245\207\340\244\225\340\244\202\340\244\241 \340\244\225\340\245\200 \340\244\270\340\244\256\340\244\257-\340\244\270\340\245\200\340\244\256\340\244\276 \340\244\270\340\244