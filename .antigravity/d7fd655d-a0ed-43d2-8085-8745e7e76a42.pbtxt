              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  if (profile.status !== \'active\') return <Navigate to=\"/pending\" replace />;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  return <Navigate to={getHomePathForRole(profile.role)} replace />;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "};"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
