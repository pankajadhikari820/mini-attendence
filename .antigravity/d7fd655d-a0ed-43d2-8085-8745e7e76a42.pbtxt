\305\352A\327\330]\240\252\267t\325\226\v\322\016,\360\335I&7\274=j\\\223\323\377e\306v\3403\213[\277\337\006,)}nFL\255q\372\232\242\214\305|\027\252{\316\343n\357\024\245\030\237;\270\346\371\327\254\021A\263k\333\177\257\224-\300\252\026\261\347\342\340\204\apF&p\262\033\034\265&@\245B\021\304\000\341]\313\377\334#\000\335\005%;]\376\270!\033\337\027\211\256\302\01615+\273\264\221\3048\2703L]F\356\337\263HK`\204\212\254\026^\302\360\220\031ua\256*\253\221\325\334,\216Y\341q\034\327dy\b\264.\234\245\023\235\321\370\324vI\207\334\001\2717\t\t*\232\213T\227\2255c\273\230\240\303MeX\205\0169\236\200\276wb\342\261\230\253\377x\272eA\251\343\023GB)\333K\201r:\222\005\244\242\310%DE`\255\361\377a9\220\3237\276p\217\"\273\027\0255\344\347U\274\373\366\314\274\342\370\314\'\3067\23436\v\276\020\022\345\334\332\024\212L\372:z\233\230K\271 \275\227g\217\356\022Z*\vID%\350\263\240\v\324v\251\243\'\213S:\320`\'m2{\235g;\302\237\267\253\224\360\3341\351\275c*pV\312\020K\n\262\255U\275\200YD\247\\\"\331x\026 ~d\201\222\245@\254\260X\2209^\307\271\245\263\0325.g\265\214\243\244\253\243\274\264/EUF9\357I\277\260\334=\212\370Q\035pj-\305\340\222\202\r\324NG\273\220\031\345.\027\345\036\221\\\344\245\260\300\t9y\005V\v\211\177:\270X\025\034\257h\fU\b:z\221\3168\246-\006\330\246\330\235\217;\020v\276\205t8i\211:{I^{,\030`9\305>\204_y\360\r\263%[b\274Pe\257\025\254k\343\025OK\317\271%\222\220\006b\016v\334\207K\035n\265|\255.TG\037\016r\375\r\377\306\266\312\315%\365\357\363\253\236\200\335\335\343r\020\236\210\276\252\242\207\253\216\002\366\353\v\234\302v\201\376\2078\327<\350\354\0244\241\243\260-\363 \222\3639\006?M!\245b\214E=i$\254\215y"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_4466862426846864857"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import {\\n  addDoc,\\n  arrayUnion,\\n  collection,\\n  deleteDoc,\\n  doc,\\n  getDoc,\\n  getDocs,\\n  onSnapshot,\\n  query,\\n  serverTimestamp,\\n  updateDoc,\\n  where,\\n  writeBatch,\\n} from \'firebase/firestore\';\\nimport { db } from \'../firebase\';\\nimport type {\\n  AcademicClass,\\n  Department,\\n  FacultyAssignment,\\n  Organization,\\n  ParentLink,\\n  Subject,\\n  TimetableSlot,\\n  UserProfile,\\n} from \'../types\';\\nimport { timesOverlap } from \'../utils/helpers\';\\nimport { recordAuditLog } from \'./auditService\';\\nimport { createNotification } from \'./communicationService\';\\n\\n// ===================== DEPARTMENTS =====================\\n\\nexport async function fetchDepartments(orgId: string): Promise<Department[]> {\\n  const snap = await getDocs(\\n    query(collection(db, \'departments\'), where(\'orgId\', \'==\', orgId))\\n  );\\n  return snap.docs\\n    .map((d) => ({ ...(d.data() as Omit<Department, \'id\'>), id: d.id }))\\n    .sort((a, b) => a.name.localeCompare(b.name));\\n}\\n\\nexport async function createDepartment(params: {\\n  orgId: string;\\n  name: string;\\n  code: string;\\n  actor: UserProfile;\\n}): Promise<Department> {\\n  const payload = {\\n    orgId: params.orgId,\\n    name: params.name.trim(),\\n    code: params.code.trim().toUpperCase(),\\n    createdAt: serverTimestamp(),\\n  };\\n  const ref = await addDoc(collection(db, \'departments\'), payload);\\n  await recordAuditLog({\\n    actor: params.actor,\\n    action: \'academic.updated\',\\n    targetCollection: \'departments\',\\n    targetId: ref.id,\\n    summary: `Created department ${payload.name} (${payload.code})`,\\n  });\\n  return { ...payload, id: ref.id, createdAt: null };\\n}\\n\\nexport async function deleteDepartment(dept: Department, actor: UserProfile): Promise<void> {\\n  await deleteDoc(doc(db, \'departments\', dept.id));\\n  await recordAuditLog({\\n    actor,\\n    action: \'academic.updated\',\\n    targetCollection: \'departments\',\\n    targetId: dept.id,\\n    summary: `Deleted department ${dept.name}`,\\n  });\\n}\\n\\n// ===================== CLASSES / SECTIONS =====================\\n\\nexport async function fetchClasses(orgId: string): Promise<AcademicClass[]> {\\n  const snap = await getDocs(query(collection(db, \'classes\'), where(\'orgId\', \'==\', orgId)));\\n  return snap.docs\\n    .map((d) => ({ ...(d.data() as Omit<AcademicClass, \'id\'>), id: d.id }))\\n    .sort((a, b) => a.name.localeCompare(b.name));\\n}\\n\\nexport async function createAcademicClass(params: {\\n  orgId: string;\\n  department: Department;\\n  courseName: string;\\n  semester: string;\\n  section: string;\\n  roomNumber?: string;\\n  actor: UserProfile;\\n}): Promise<AcademicClass> {\\n  const course = params.courseName.trim();\\n  const sem = params.semester.trim();\\n  const sec = params.section.trim().toUpperCase();\\n  const formattedName = `${course} \302\267 Sem ${sem} \302\267 Sec ${sec}`;\\n  const payload = {\\n    orgId: params.orgId,\\n    departmentId: params.department.id,\\n    departmentName: params.department.name,\\n    courseName: course,\\n    semester: sem,\\n    section: sec,\\n    roomNumber: params.roomNumber?.trim() || \'\',\\n    name: formattedName,\\n    createdAt: serverTimestamp(),\\n  };\\n  const ref = await addDoc(collection(db, \'classes\'), payload);\\n  await recordAuditLog({\\n    actor: params.actor,\\n    action: \'academic.updated\',\\n    targetCollection: \'classes\',\\n    targetId: ref.id,\\n    summary: `Created class ${formattedName}`,\\n  });\\n  return { ...payload, id: ref.id, createdAt: null };\\n}\\n\\nexport async function deleteAcademicClass(cls: AcademicClass, actor: UserProfile): Promise<void> {\\n  await deleteDoc(doc(db, \'classes\', cls.id));\\n  await recordAuditLog({\\n    actor,\\n    action: \'academic.updated\',\\n    targetCollection: \'classes\',\\n    targetId: cls.id,\\n    summary: `Deleted class ${cls.name}`,\\n  });\\n}\\n\\n// ===================== SUBJECTS =====================\\n\\nexport async function fetchSubjects(orgId: string, classId?: string): Promise<Subject[]> {\\n  const constraints = [where(\'orgId\', \'==\', orgId)];\\n  if (classId) constraints.push(where(\'classId\', \'==\', classId));\\n  const snap = await getDocs(query(collection(db, \'subjects\'), ...constraints));\\n  return snap.docs\\n    .map((d) => ({ ...(d.data() as Omit<Subject, \'id\'>), id: d.id }))\\n    .sort((a, b) => a.name.localeCompare(b.name));\\n}\\n\\nexport async function createSubject(params: {\\n  orgId: string;\\n  academicClass: AcademicClass;\\n  name: string;\\n  code: string;\\n  credits?: number;\\n  actor: UserProfile;\\n}): Promise<Subject> {\\n  const payload = {\\n    orgId: params.orgId,\\n    departmentId: params.academicClass.departmentId,\\n    classId: params.academicClass.id,\\n    className: params.academicClass.name,\\n    name: params.name.trim(),\\n    code: params.code.trim().toUpperCase(),\\n    credits: params.credits || 4,\\n    createdAt: serverTimestamp(),\\n  };\\n  const ref = await addDoc(collection(db, \'subjects\'), payload);\\n  await recordAuditLog({\\n    actor: params.actor,\\n    action: \'academic.updated\',\\n    targetCollection: \'subjects\',\\n    targetId: ref.id,\\n    summary: `Created subject ${payload.name} (${payload.code}) for ${payload.className}`,\\n  });\\n  return { ...payload, id: ref.id, createdAt: null };\\n}\\n\\nexport async function deleteSubject(subj: Subject, actor: UserProfile): Promise<void> {\\n  await deleteDoc(doc(db, \'subjects\', subj.id));\\n  await recordAuditLog({\\n    actor,\\n    action: \'academic.updated\',\\n    targetCollection: \'subjects\',\\n    targetId: subj.id,\\n    summary: `Deleted subject ${subj.name} (${subj.code})`,\\n  });\\n}\\n\\n// ===================== FACULTY ASSIGNMENTS =====================\\n\\nexport async function fetchFacultyAssignments(\\n  orgId: string,\\n  teacherUid?: string\\n): Promise<FacultyAssignment[]> {\\n  const constraints = [where(\'orgId\', \'==\', orgId)];\\n  if (teacherUid) constraints.push(where(\'teacherUid\', \'==\', teacherUid));\\n  const snap = await getDocs(query(collection(db, \'facultyAssignments\'), ...constraints));\\n  return snap.docs\\n    .map((d) => ({ ...(d.data() as Omit<FacultyAssignment, \'id\'>), id: d.id }))\\n    .sort((a, b) => a.className.localeCompare(b.className) || a.subjectName.localeCompare(b.subjectName));\\n}\\n\\nexport function subscribeFacultyAssignments(\\n  orgId: string,\\n  teacherUid: string,\\n  callback: (items: FacultyAssignment[]) => void\\n): () => void {\\n  const q = query(\\n    collection(db, \'facultyAssignments\'),\\n    where(\'orgId\', \'==\', orgId),\\n    where(\'teacherUid\', \'==\', teacherUid)\\n  );\\n  return onSnapshot(\\n    q,\\n    (snap) => {\\n      const list = snap.docs\\n        .map((d) => ({ ...(d.data() as Omit<FacultyAssignment, \'id\'>), id: d.id }))\\n        .sort((a, b) => a.className.localeCompare(b.className) || a.subjectName.localeCompare(b.subjectName));\\n      callback(list);\\n    },\\n    () => callback([])\\n  );\\n}\\n\\nexport async function createFacultyAssignment(params: {\\n  orgId: string;\\n  teacher: UserProfile;\\n  academicClass: AcademicClass;\\n  subject: Subject;\\n  actor: UserProfile;\\n}): Promise<FacultyAssignment> {\\n  // Prevent duplicate teacher-class-subject assignment\\n  const existing = await fetchFacultyAssignments(params.orgId, params.teacher.uid);\\n  const dup = existing.find(\\n    (a) => a.classId === params.academicClass.id && a.subjectId === params.subject.id\\n  );\\n  if (dup) {\\n    throw new Error(\'DUPLICATE_ASSIGNMENT\');\\n  }\\n\\n  const payload = {\\n    orgId: params.orgId,\\n    teacherUid: params.teacher.uid,\\n    teacherName: params.teacher.name,\\n    teacherMemberId: params.teacher.memberId || \'\',\\n    departmentId: params.academicClass.departmentId,\\n    classId: params.academicClass.id,\\n    className: params.academicClass.name,\\n    courseName: params.academicClass.courseName,\\n    semester: params.academicClass.semester,\\n    section: params.academicClass.section,\\n    subjectId: params.subject.id,\\n    subjectName: params.subject.name,\\n    subjectCode: params.subject.code,\\n    createdAt: serverTimestamp(),\\n  };\\n\\n  const ref = await addDoc(collection(db, \'facultyAssignments\'), payload);\\n  await recordAuditLog({\\n    actor: params.actor,\\n    action: \'academic.updated\',\\n    targetCollection: \'facultyAssignments\',\\n    targetId: ref.id,\\n    summary: `Assigned ${params.teacher.name} to ${params.subject.name} (${params.academicClass.name})`,\\n  });\\n  return { ...payload, id: ref.id, createdAt: null };\\n}\\n\\nexport async function deleteFacultyAssignment(\\n  assignment: FacultyAssignment,\\n  actor: UserProfile\\n): Promise<void> {\\n  await deleteDoc(doc(db, \'facultyAssignments\', assignment.id));\\n  await recordAuditLog({\\n    actor,\\n    action: \'academic.updated\',\\n    targetCollection: \'facultyAssignments\',\\n    targetId: assignment.id,\\n    summary: `Removed assignment of ${assignment.teacherName} from ${assignment.subjectName} (${assignment.className})`,\\n  });\\n}\\n\\n// ===================== TIMETABLES =====================\\n\\nexport async function fetchTimetableSlots(\\n  orgId: string,\\n  filters?: { classId?: string; teacherUid?: string }\\n): Promise<TimetableSlot[]> {\\n  const constraints = [where(\'orgId\', \'==\', orgId)];\\n  if (filters?.classId) constraints.push(where(\'classId\', \'==\', filters.classId));\\n  if (filters?.teacherUid) constraints.push(where(\'teacherUid\', \'==\', filters.teacherUid));\\n  const snap = await getDocs(query(collection(db, \'timetables\'), ...constraints));\\n  return snap.docs\\n    .map((d) => ({ ...(d.data() as Omit<TimetableSlot, \'id\'>), id: d.id }))\\n    .sort((a, b) => a.dayOfWeek - b.dayOfWeek || a.startTime.localeCompare(b.startTime));\\n}\\n\\nexport function subscribeTimetableForClass(\\n  orgId: string,\\n  classId: string,\\n  callback: (slots: TimetableSlot[]) => void\\n): () => void {\\n  const q = query(\\n    collection(db, \'timetables\'),\\n    where(\'orgId\', \'==\', orgId),\\n    where(\'classId\', \'==\', classId)\\n  );\\n  return onSnapshot(\\n    q,\\n    (snap) => {\\n      const list = snap.docs\\n        .map((d) => ({ ...(d.data() as Omit<TimetableSlot, \'id\'>), id: d.id }))\\n        .sort((a, b) => a.dayOfWeek - b.dayOfWeek || a.startTime.localeCompare(b.startTime));\\n      callback(list);\\n    },\\n    () => callback([])\\n  );\\n}\\n\\nexport interface TimetableConflict {\\n  type: \'teacher\' | \'class\' | \'room\';\\n  slot: TimetableSlot;\\n}\\n\\nexport function detectTimetableConflicts(\\n  existingSlots: TimetableSlot[],\\n  candidate: {\\n    dayOfWeek: number;\\n    startTime: string;\\n    endTime: string;\\n    classId: string;\\n    teacherUid: string;\\n    roomNumber: string;\\n    ignoreSlotId?: string;\\n  }\\n): TimetableConflict[] {\\n  const conflicts: TimetableConflict[] = [];\\n  const normRoom = candidate.roomNumber.trim().toLowerCase();\\n\\n  for (const s of existingSlots) {\\n    if (candidate.ignoreSlotId && s.id === candidate.ignoreSlotId) continue;\\n    if (s.dayOfWeek !== candidate.dayOfWeek) continue;\\n    if (!timesOverlap(s.startTime, s.endTime, candidate.startTime, candidate.endTime)) continue;\\n\\n    if (s.teacherUid === candidate.teacherUid) {\\n      conflicts.push({ type: \'teacher\', slot: s });\\n    }\\n    if (s.classId === candidate.classId) {\\n      conflicts.push({ type: \'class\', slot: s });\\n    }\\n    if (normRoom && s.roomNumber.trim().toLowerCase() === normRoom) {\\n      conflicts.push({ type: \'room\', slot: s });\\n    }\\n  }\\n  return conflicts;\\n}\\n\\nexport async function createTimetableSlot(params: {\\n  orgId: string;\\n  assignment: FacultyAssignment;\\n  dayOfWeek: number;\\n  startTime: string;\\n  endTime: string;\\n  roomNumber: string;\\n  actor: UserProfile;\\n}): Promise<TimetableSlot> {\\n  const payload = {\\n    orgId: params.orgId,\\n    dayOfWeek: params.dayOfWeek,\\n    startTime: params.startTime,\\n    endTime: params.endTime,\\n    classId: params.assignment.classId,\\n    className: params.assignment.className,\\n    courseName: params.assignment.courseName,\\n    semester: params.assignment.semester,\\n    section: params.assignment.section,\\n    subjectId: params.assignment.subjectId,\\n    subjectName: params.assignment.subjectName,\\n    subjectCode: params.assignment.subjectCode,\\n    teacherUid: params.assignment.teacherUid,\\n    teacherName: params.assignment.teacherName,\\n    roomNumber: params.roomNumber.trim() || \'Main Room\',\\n    createdAt: serverTimestamp(),\\n  };\\n\\n  const ref = await addDoc(collection(db, \'timetables\'), payload);\\n  await recordAuditLog({\\n    actor: params.actor,\\n    action: \'timetable.updated\',\\n    targetCollection: \'timetables\',\\n    targetId: ref.id,\\n    summary: `Scheduled ${payload.subjectName} (${payload.className}) \302\267 ${payload.startTime}-${payload.endTime}`,\\n  });\\n  return { ...payload, id: ref.id, createdAt: null };\\n}\\n\\nexport async function deleteTimetableSlot(slot: TimetableSlot, actor: UserProfile): Promise<void> {\\n  await deleteDoc(doc(db, \'timetables\', slot.id));\\n  await recordAuditLog({\\n    actor,\\n    action: \'timetable.updated\',\\n    targetCollection: \'timetables\',\\n    targetId: slot.id,\\n    summary: `Removed timetable slot ${slot.subjectName} (${slot.className})`,\\n  });\\n}\\n\\n// ===================== PARENT LINKS =====================\\n\\nexport async function fetchParentLinks(orgId: string): Promise<ParentLink[]> {\\n  const snap = await getDocs(\\n    query(collection(db, \'parentLinks\'), where(\'orgId\', \'==\', orgId))\\n  );\\n  return snap.docs\\n    .map((d) => ({ ...(d.data() as Omit<ParentLink, \'id\'>), id: d.id }))\\n    .sort((a, b) => (b.createdAt?.toMillis?.() ?? 0) - (a.createdAt?.toMillis?.() ?? 0));\\n}\\n\\nexport async function verifyParentLink(params: {\\n  link: ParentLink;\\n  actor: UserProfile;\\n}): Promise<void> {\\n  const batch = writeBatch(db);\\n  batch.update(doc(db, \'parentLinks\', params.link.id), {\\n    status: \'verified\',\\n    verifiedAt: serverTimestamp(),\\n  });\\n  batch.update(doc(db, \'users\', params.link.parentUid), {\\n    status: \'active\',\\n    linkedStudentUids: arrayUnion(params.link.studentUid),\\n  });\\n  batch.update(doc(db, \'users\', params.link.studentUid), {\\n    parentUids: arrayUnion(params.link.parentUid),\\n  });\\n  await batch.commit();\\n\\n  await createNotification({\\n    orgId: params.link.orgId,\\n    toUid: params.link.parentUid,\\n    type: \'approval\',\\n    text: `Your parent account has been linked and verified for student ${params.link.studentName} (${params.link.studentMemberId}).`,\\n  });\\n\\n  await recordAuditLog({\\n    actor: params.actor,\\n    action: \'parent.linked\',\\n    targetCollection: \'parentLinks\',\\n    targetId: params.link.id,\\n    summary: `Verified parent ${params.link.parentName} link to student ${params.link.studentName} (${params.link.studentMemberId})`,\\n  });\\n}\\n\\nexport async function rejectParentLink(params: {\\n  link: ParentLink;\\n  actor: UserProfile;\\n}): Promise<void> {\\n  await updateDoc(doc(db, \'parentLinks\', params.link.id), { status: \'rejected\' });\\n  await recordAuditLog({\\n    actor: params.actor,\\n    action: \'parent.linked\',\\n    targetCollection: \'parentLinks\',\\n    targetId: params.link.id,\\n    summary: `Rejected parent link request from ${params.link.parentName} for ${params.link.studentMemberId}`,\\n  });\\n}\\n\\nexport async function linkParentDirectly(params: {\\n  orgId: string;\\n  parent: UserProfile;\\n  student: UserProfile;\\n  actor: UserProfile;\\n}): Promise<void> {\\n  const linkRef = doc(collection(db, \'parentLinks\'));\\n  const batch = writeBatch(db);\\n  batch.set(linkRef, {\\n    orgId: params.orgId,\\n    parentUid: params.parent.uid,\\n    parentName: params.parent.name,\\n    parentEmail: params.parent.email,\\n    studentUid: params.student.uid,\\n    studentName: params.student.name,\\n    studentMemberId: params.student.memberId || \'\',\\n    status: \'verified\',\\n    createdAt: serverTimestamp(),\\n    verifiedAt: serverTimestamp(),\\n  });\\n  batch.update(doc(db, \'users\', params.parent.uid), {\\n    status: \'active\',\\n    linkedStudentUids: arrayUnion(params.student.uid),\\n  });\\n  batch.update(doc(db, \'users\', params.student.uid), {\\n    parentUids: arrayUnion(params.parent.uid),\\n  });\\n  await batch.commit();\\n\\n  await recordAuditLog({\\n    actor: params.actor,\\n    action: \'parent.linked\',\\n    targetCollection: \'parentLinks\',\\n    targetId: linkRef.id,\\n    summary: `Linked parent ${params.parent.name} directly to student ${params.student.name} (${params.student.memberId})`,\\n  });\\n}\\n\\nexport async function fetchLinkedStudentsForParent(\\n  parentProfile: UserProfile\\n): Promise<UserProfile[]> {\\n  const uids = parentProfile.linkedStudentUids || [];\\n  if (uids.length === 0) return [];\\n  const snaps = await Promise.all(uids.map((uid) => getDoc(doc(db, \'users\', uid))));\\n  return snaps\\n    .filter((s) => s.exists())\\n    .map((s) => ({ ...(s.data() as UserProfile), uid: s.id }));\\n}\\n\\n// ===================== SUPER ADMIN ORG MANAGEMENT =====================\\n\\nexport async function fetchAllOrganizations(): Promise<Organization[]> {\\n  const snap = await getDocs(collection(db, \'organizations\'));\\n  return snap.docs\\n    .map((d) => ({ ...(d.data() as Omit<Organization, \'id\'>), id: d.id }))\\n    .sort((a, b) => a.name.localeCompare(b.name));\\n}\\n\", \"Description\":\"Create academicService.ts for Departments, Classes/Sections, Subjects, Faculty Assignments, Timetables with conflict detection, Parent Links, and Super Admin org management\", \"Overwrite\":true, \"TargetFile\":\"/src/services/academicService.ts\", \"toolAction\":\"Creating academicService.ts\", \"toolSummary\":\"Create academicService.ts\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_4466862426846864870"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { doc, getDoc, serverTimestamp, setDoc } from \'firebase/firestore\';\\nimport { db } from \'../firebase\';\\nimport type { AttendanceRecord, Organization, UserProfile } from \'../types\';\\nimport { getOrgDateString, normalizeAttendanceStatus } from \'../utils/helpers\';\\nimport { recordAuditLog } from \'./auditService\';\\n\\nexport interface SubjectAttendanceSummary {\\n  subjectKey: string;\\n  subjectId?: string;\\n  subjectName: string;\\n  subjectCode?: string;\\n  present: number;\\n  absent: number;\\n  leave: number;\\n  total: number;\\n  percentage: number;\\n  isShortage: boolean;\\n}\\n\\nexport interface StudentAttendanceAnalysis {\\n  student: UserProfile;\\n  present: number;\\n  absent: number;\\n  leave: number;\\n  total: number;\\n  overallPct: number;\\n  isLowOverall: boolean;\\n  subjects: SubjectAttendanceSummary[];\\n  shortageSubjects: SubjectAttendanceSummary[];\\n}\\n\\n/**\\n * Computes accurate overall and subject-wise attendance statistics using ONLY\\n * PRESENT, ABSENT, and LEAVE statuses. Every lecture session is counted individually\\n * so multiple lectures on the same day never collapse into a single record.\\n */\\nexport function computeStudentAttendanceAnalysis(\\n  student: UserProfile,\\n  records: AttendanceRecord[],\\n  threshold = 75\\n): StudentAttendanceAnalysis {\\n  let present = 0;\\n  let absent = 0;\\n  let leave = 0;\\n\\n  const bySubject = new Map<\\n    string,\\n    {\\n      subjectId?: string;\\n      subjectName: string;\\n      subjectCode?: string;\\n      present: number;\\n      absent: number;\\n      leave: number;\\n    }\\n  >();\\n\\n  for (const r of records) {\\n    const st = normalizeAttendanceStatus(r.status);\\n    if (st === \'present\') present++;\\n    else if (st === \'absent\') absent++;\\n    else leave++;\\n\\n    const key = r.subjectId || r.subjectName || \'general\';\\n    const cur = bySubject.get(key) || {\\n      subjectId: r.subjectId,\\n      subjectName: r.subjectName || \'General Attendance\',\\n      subjectCode: r.subjectCode,\\n      present: 0,\\n      absent: 0,\\n      leave: 0,\\n    };\\n    if (st === \'present\') cur.present++;\\n    else if (st === \'absent\') cur.absent++;\\n    else cur.leave++;\\n    bySubject.set(key, cur);\\n  }\\n\\n  const total = present + absent + leave;\\n  const overallPct = total > 0 ? Math.round((present / total) * 100) : 0;\\n\\n  const subjects: SubjectAttendanceSummary[] = Array.from(bySubject.entries())\\n    .map(([subjectKey, s]) => {\\n      const subTotal = s.present + s.absent + s.leave;\\n      const pct = subTotal > 0 ? Math.round((s.present / subTotal) * 100) : 0;\\n      return {\\n        subjectKey,\\n        subjectId: s.subjectId,\\n        subjectName: s.subjectName,\\n        subjectCode: s.subjectCode,\\n        present: s.present,\\n        absent: s.absent,\\n        leave: s.leave,\\n        total: subTotal,\\n        percentage: pct,\\n        isShortage: subTotal > 0 && pct < threshold,\\n      };\\n    })\\n    .sort((a, b) => a.percentage - b.percentage);\\n\\n  return {\\n    student,\\n    present,\\n    absent,\\n    leave,\\n    total,\\n    overallPct,\\n    isLowOverall: total > 0 && overallPct < threshold,\\n    subjects,\\n    shortageSubjects: subjects.filter((s) => s.isShortage),\\n  };\\n}\\n\\n/**\\n * Dispatches deduplicated low-attendance alerts to Students, their Faculty/Manager,\\n * and Verified Parents using deterministic notification doc IDs scoped by YYYY-MM\\n * so duplicate notifications are never sent in the same month.\\n */\\nexport async function dispatchLowAttendanceAlerts(params: {\\n  org: Organization;\\n  actor: UserProfile;\\n  analyses: StudentAttendanceAnalysis[];\\n}): Promise<{ sentCount: number; skippedDuplicates: number }> {\\n  const threshold = params.org.lowAttendanceThreshold ?? 75;\\n  const monthKey = getOrgDateString(params.org.timezone || \'Asia/Kolkata\').slice(0, 7);\\n  let sentCount = 0;\\n  let skippedDuplicates = 0;\\n\\n  const belowList = params.analyses.filter(\\n    (a) => a.total > 0 && (a.isLowOverall || a.shortageSubjects.length > 0)\\n  );\\n\\n  for (const item of belowList) {\\n    const shortageSummary =\\n      item.shortageSubjects.length > 0\\n        ? item.shortageSubjects\\n            .slice(0, 3)\\n            .map((s) => `${s.subjectName} (${s.percentage}%)`)\\n            .join(\', \')\\n        : `Overall (${item.overallPct}%)`;\\n\\n    const targets: Array<{ uid: string; label: string; text: string }> = [\\n      {\\n        uid: item.student.uid,\\n        label: \'student\',\\n        text: `Low attendance alert (${item.overallPct}% \342\200\224 minimum required ${threshold}%). Shortage in: ${shortageSummary}.`,\\n      },\\n    ];\\n\\n    if (item.student.managerId) {\\n      targets.push({\\n        uid: item.student.managerId,\\n        label: \'faculty\',\\n        text: `Student ${item.student.name} (${item.student.memberId}) is below ${threshold}% attendance (${item.overallPct}%). Shortage: ${shortageSummary}.`,\\n      });\\n    }\\n\\n    for (const parentUid of item.student.parentUids || []) {\\n      targets.push({\\n        uid: parentUid,\\n        label: \'parent\',\\n        text: `Attendance alert for ${item.student.name} (${item.student.memberId}): currently ${item.overallPct}% (minimum ${threshold}%). Shortage: ${shortageSummary}.`,\\n      });\\n    }\\n\\n    for (const target of targets) {\\n      const dedupeDocId = `lowatt_${params.org.id}_${monthKey}_${item.student.uid}_${target.uid}`;\\n      const notifRef = doc(db, \'notifications\', dedupeDocId);\\n      try {\\n        const existing = await getDoc(notifRef);\\n        if (existing.exists()) {\\n          skippedDuplicates++;\\n          continue;\\n        }\\n        await setDoc(notifRef, {\\n          orgId: params.org.id,\\n          toUid: target.uid,\\n          type: \'low_attendance\',\\n          text: target.text,\\n          dedupeKey: dedupeDocId,\\n          read: false,\\n          createdAt: serverTimestamp(),\\n        });\\n        sentCount++;\\n      } catch {\\n        // Ignore individual permission failures\\n      }\\n    }\\n  }\\n\\n  if (sentCount > 0) {\\n    await recordAuditLog({\\n      actor: params.actor,\\n      action: \'alert.low_attendance_sent\',\\n      targetCollection: \'notifications\',\\n      targetId: `${params.org.id}_${monthKey}`,\\n      summary: `Sent ${sentCount} deduplicated low-attendance alerts (threshold ${threshold}%)`,\\n      metadata: { sentCount, skippedDuplicates, threshold },\\n    });\\n  }\\n\\n  return { sentCount, skippedDuplicates };\\n}\\n\", \"Description\":\"Create lowAttendanceService.ts with accurate lecture-level analytics and deduplicated multi-recipient low-attendance alert dispatch\", \"Overwrite\":true, \"TargetFile\":\"/src/services/lowAttendanceService.ts\", \"toolAction\":\"Creating lowAttendanceService.ts\", \"toolSummary\":\"Create lowAttendanceService.ts\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_4466862426846864883"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import {\\n  addDoc,\\n  collection,\\n  doc,\\n  getDoc,\\n  getDocs,\\n  increment,\\n  onSnapshot,\\n  query,\\n  runTransaction,\\n  serverTimestamp,\\n  Timestamp,\\n  updateDoc,\\n  where,\\n  writeBatch,\\n} from \'firebase/firestore\';\\nimport { db } from \'../firebase\';\\nimport type {\\n  AttendanceAttempt,\\n  AttendanceRecord,\\n  AttendanceSession,\\n  AttendanceStatus,\\n  FacultyAssignment,\\n  Organization,\\n  TimetableSlot,\\n  UserProfile,\\n} from \'../types\';\\nimport {\\n  generateSessionToken,\\n  generateSixDigitCode,\\n  getFlatEarthDistanceMeters,\\n  getOrgDateString,\\n  getOrgTimeHHMM,\\n  getOrCreateDeviceId,\\n  normalizeAttendanceStatus,\\n} from \'../utils/helpers\';\\nimport { buildSessionAttendanceDocId } from \'./attendanceService\';\\nimport { recordAuditLog } from \'./auditService\';\\n\\n/**\\n * Starts a new Live Attendance Session scoped to a specific subject, class, semester,\\n * section, and teacher (or Org-level Admin -> Manager session).\\n * Atomically initializes its owner-only `sessionSecrets/{sessionId}` document with a\\n * 128-bit crypto token and 6-digit live code valid for strictly 10 seconds on `request.time`.\\n * Prevents duplicate open sessions for the same teacher + class + subject or timetable slot.\\n */\\nexport async function startAttendanceSession(params: {\\n  org: Organization;\\n  owner: UserProfile;\\n  title: string;\\n  durationMinutes: number;\\n  lat: number;\\n  lng: number;\\n  radius: number;\\n  assignment?: FacultyAssignment | null;\\n  timetableSlot?: TimetableSlot | null;\\n}): Promise<{ session: AttendanceSession; token: string; code: string }> {\\n  // Check for duplicate active session by this owner for the exact same subject/slot\\n  const openMine = await fetchOpenSessionsByOwner(params.org.id, params.owner.uid);\\n  const targetSubjectId = params.timetableSlot?.subjectId || params.assignment?.subjectId || \'\';\\n  const targetClassId = params.timetableSlot?.classId || params.assignment?.classId || \'\';\\n  const duplicate = openMine.find((s) => {\\n    if (params.timetableSlot && s.timetableSlotId === params.timetableSlot.id) return true;\\n    if (targetSubjectId && targetClassId) {\\n      return s.subjectId === targetSubjectId && s.classId === targetClassId;\\n    }\\n    return !targetSubjectId && !s.subjectId;\\n  });\\n\\n  if (duplicate) {\\n    // Re-attach cleanly instead of creating duplicate conflicting sessions\\n    const fresh = await rotateSessionSecret({ sessionId: duplicate.id });\\n    return { session: duplicate, token: fresh.token, code: fresh.code };\\n  }\\n\\n  const sessionRef = doc(collection(db, \'sessions\'));\\n  const sessionId = sessionRef.id;\\n\\n  const token = generateSessionToken();\\n  const code = generateSixDigitCode();\\n  const cosLat = Math.cos((params.lat * Math.PI) / 180);\\n  const endsAtDate = new Date(Date.now() + params.durationMinutes * 60 * 1000);\\n  const endsAt = Timestamp.fromDate(endsAtDate);\\n  const locationCheckEnabled = params.org.location?.enabled ?? true;\\n  const dateStr = getOrgDateString(params.org.timezone || \'Asia/Kolkata\');\\n\\n  const classId = params.timetableSlot?.classId || params.assignment?.classId || \'\';\\n  const className = params.timetableSlot?.className || params.assignment?.className || \'\';\\n  const courseName = params.timetableSlot?.courseName || params.assignment?.courseName || \'\';\\n  const semester = params.timetableSlot?.semester || params.assignment?.semester || \'\';\\n  const section = params.timetableSlot?.section || params.assignment?.section || \'\';\\n  const subjectId = params.timetableSlot?.subjectId || params.assignment?.subjectId || \'\';\\n  const subjectName = params.timetableSlot?.subjectName || params.assignment?.subjectName || \'\';\\n  const subjectCode = params.timetableSlot?.subjectCode || params.assignment?.subjectCode || \'\';\\n  const departmentId = params.assignment?.departmentId || \'\';\\n  const roomNumber = params.timetableSlot?.roomNumber || \'\';\\n\\n  const autoTitle =\\n    params.title.trim() ||\\n    (subjectName && className ? `${subjectName} \302\267 ${className}` : subjectName || \'Live Attendance\');\\n\\n  const sessionPayload = {\\n    orgId: params.org.id,\\n    ownerUid: params.owner.uid,\\n    ownerName: params.owner.name,\\n    ownerRole: params.owner.role === \'admin\' || params.owner.role === \'super_admin\'\\n      ? (\'admin\' as const)\\n      : (\'manager\' as const),\\n    title: autoTitle,\\n    date: dateStr,\\n    status: \'open\' as const,\\n    durationMinutes: params.durationMinutes,\\n    locationCheckEnabled,\\n    location: {\\n      lat: params.lat,\\n      lng: params.lng,\\n      cosLat,\\n      radius: Math.max(20, Math.min(500, Math.round(params.radius))),\\n    },\\n    markedCount: 0,\\n    ...(departmentId ? { departmentId } : {}),\\n    ...(classId ? { classId, className, courseName, semester, section } : {}),\\n    ...(subjectId ? { subjectId, subjectName, subjectCode } : {}),\\n    ...(roomNumber ? { roomNumber } : {}),\\n    ...(params.timetableSlot\\n      ? {\\n          timetableSlotId: params.timetableSlot.id,\\n          startTimeLabel: params.timetableSlot.startTime,\\n          endTimeLabel: params.timetableSlot.endTime,\\n        }\\n      : {}),\\n    startedAt: serverTimestamp(),\\n    endsAt,\\n  };\\n\\n  const batch = writeBatch(db);\\n  batch.set(sessionRef, sessionPayload);\\n  batch.set(doc(db, \'sessionSecrets\', sessionId), {\\n    ownerUid: params.owner.uid,\\n    orgId: params.org.id,\\n    active: true,\\n    token,\\n    code,\\n    rotationSeq: 1,\\n    tokenUpdatedAt: serverTimestamp(),\\n  });\\n  await batch.commit();\\n\\n  await recordAuditLog({\\n    actor: params.owner,\\n    action: \'session.started\',\\n    targetCollection: \'sessions\',\\n    targetId: sessionId,\\n    summary: `Started live session \\\"${autoTitle}\\\" (${params.durationMinutes} min)`,\\n    metadata: {\\n      classId: classId || null,\\n      subjectId: subjectId || null,\\n      durationMinutes: params.durationMinutes,\\n    },\\n  });\\n\\n  return {\\n    session: {\\n      ...sessionPayload,\\n      id: sessionId,\\n      startedAt: Timestamp.now(),\\n    },\\n    token,\\n    code,\\n  };\\n}\\n\\n/**\\n * Rotates the live session\'s QR token & 6-digit code every 10 seconds.\\n * Immediately overwrites and invalidates the previous token on the server.\\n */\\nexport async function rotateSessionSecret(params: {\\n  sessionId: string;\\n}): Promise<{ token: string; code: string }> {\\n  const token = generateSessionToken();\\n  const code = generateSixDigitCode();\\n\\n  await updateDoc(doc(db, \'sessionSecrets\', params.sessionId), {\\n    active: true,\\n    token,\\n    code,\\n    rotationSeq: increment(1),\\n    tokenUpdatedAt: serverTimestamp(),\\n  });\\n\\n  return { token, code };\\n}\\n\\nexport async function extendAttendanceSession(\\n  sessionId: string,\\n  currentEndsAt: Timestamp | null | undefined,\\n  extraMinutes = 10\\n): Promise<Timestamp> {\\n  const baseMs = Math.max(Date.now(), currentEndsAt?.toMillis?.() ?? Date.now());\\n  const nextEndsAt = Timestamp.fromDate(new Date(baseMs + extraMinutes * 60 * 1000));\\n  await updateDoc(doc(db, \'sessions\', sessionId), {\\n    endsAt: nextEndsAt,\\n    status: \'open\',\\n  });\\n  return nextEndsAt;\\n}\\n\\n/**\\n * Stops a live attendance session and immediately invalidates its active secret\\n * atomically so no further QR scans can succeed.\\n */\\nexport async function closeAttendanceSession(\\n  sessionId: string,\\n  actor?: UserProfile\\n): Promise<void> {\\n  const batch = writeBatch(db);\\n  batch.update(doc(db, \'sessions\', sessionId), {\\n    status: \'closed\',\\n    closedAt: serverTimestamp(),\\n  });\\n  batch.update(doc(db, \'sessionSecrets\', sessionId), {\\n    active: false,\\n    token: \'\',\\n    code: \'\',\\n    tokenUpdatedAt: serverTimestamp(),\\n  });\\n  await batch.commit();\\n\\n  if (actor) {\\n    await recordAuditLog({\\n      actor,\\n      action: \'session.closed\',\\n      targetCollection: \'sessions\',\\n      targetId: sessionId,\\n      summary: `Closed live attendance session ${sessionId.slice(0, 8)}`,\\n    });\\n  }\\n}\\n\\nexport async function fetchOpenSessionsByOwner(\\n  orgId: string,\\n  ownerUid: string\\n): Promise<AttendanceSession[]> {\\n  const snap = await getDocs(\\n    query(\\n      collection(db, \'sessions\'),\\n      where(\'orgId\', \'==\', orgId),\\n      where(\'ownerUid\', \'==\', ownerUid),\\n      where(\'status\', \'==\', \'open\')\\n    )\\n  );\\n  const nowMs = Date.now();\\n  return snap.docs\\n    .map((d) => ({ ...(d.data() as Omit<AttendanceSession, \'id\'>), id: d.id }))\\n    .filter((s) => (s.endsAt?.toMillis?.() ?? 0) > nowMs)\\n    .sort((a, b) => (b.startedAt?.toMillis?.() ?? 0) - (a.startedAt?.toMillis?.() ?? 0));\\n}\\n\\nexport async function fetchOpenSessionByOwner(\\n  orgId: string,\\n  ownerUid: string\\n): Promise<AttendanceSession | null> {\\n  const list = await fetchOpenSessionsByOwner(orgId, ownerUid);\\n  return list[0] || null;\\n}\\n\\nexport async function fetchRecentSessionsByOwner(\\n  orgId: string,\\n  ownerUid: string,\\n  maxCount = 20\\n): Promise<AttendanceSession[]> {\\n  const snap = await getDocs(\\n    query(\\n      collection(db, \'sessions\'),\\n      where(\'orgId\', \'==\', orgId),\\n      where(\'ownerUid\', \'==\', ownerUid)\\n    )\\n  );\\n  return snap.docs\\n    .map((d) => ({ ...(d.data() as Omit<AttendanceSession, \'id\'>), id: d.id }))\\n    .sort((a, b) => (b.startedAt?.toMillis?.() ?? 0) - (a.startedAt?.toMillis?.() ?? 0))\\n    .slice(0, maxCount);\\n}\\n\\nexport function subscribeOwnerOpenSessions(\\n  orgId: string,\\n  ownerUid: string,\\n  callback: (sessions: AttendanceSession[]) => void\\n): () => void {\\n  const q = query(\\n    collection(db, \'sessions\'),\\n    where(\'orgId\', \'==\', orgId),\\n    where(\'ownerUid\', \'==\', ownerUid),\\n    where(\'status\', \'==\', \'open\')\\n  );\\n  return onSnapshot(\\n    q,\\n    (snap) => {\\n      const nowMs = Date.now();\\n      const list = snap.docs\\n        .map((d) => ({ ...(d.data() as Omit<AttendanceSession, \'id\'>), id: d.id }))\\n        .filter((s) => (s.endsAt?.toMillis?.() ?? 0) > nowMs)\\n        .sort((a, b) => (b.startedAt?.toMillis?.() ?? 0) - (a.startedAt?.toMillis?.() ?? 0));\\n      callback(list);\\n    },\\n    () => callback([])\\n  );\\n}\\n\\nexport function isAuthorizedForSession(\\n  profile: UserProfile,\\n  org: Organization,\\n  session: AttendanceSession\\n): boolean {\\n  if (profile.status !== \'active\') return false;\\n  if (session.orgId !== org.id || profile.orgId !== org.id) return false;\\n\\n  // Admin -> Manager session\\n  if (session.ownerRole === \'admin\' && profile.role === \'manager\') return true;\\n\\n  // Multi-teacher class/section session -> Student assigned to that class\\n  if (\\n    session.ownerRole === \'manager\' &&\\n    profile.role === \'member\' &&\\n    session.classId &&\\n    profile.classId &&\\n    session.classId === profile.classId\\n  ) {\\n    return true;\\n  }\\n\\n  // Legacy direct Manager -> Member session\\n  if (\\n    session.ownerRole === \'manager\' &&\\n    profile.role === \'member\' &&\\n    profile.managerId &&\\n    profile.managerId === session.ownerUid\\n  ) {\\n    return true;\\n  }\\n\\n  return false;\\n}\\n\\nexport type SessionStreamError = \'permission-denied\' | \'network\' | \'index-required\' | \'unknown\';\\n\\nfunction classifyFirestoreError(err: unknown): SessionStreamError {\\n  const code = (err as { code?: string })?.code || \'\';\\n  if (!navigator.onLine || code === \'unavailable\' || code === \'deadline-exceeded\') {\\n    return \'network\';\\n  }\\n  if (code === \'permission-denied\') return \'permission-denied\';\\n  if (code === \'failed-precondition\') return \'index-required\';\\n  return \'unknown\';\\n}\\n\\n/**\\n * Queries all currently active (OPEN & unexpired) sessions eligible for the logged-in user.\\n * - For Students: merges active sessions matching `classId` (multi-teacher!) AND legacy `managerId`.\\n * - For Teachers/Managers: queries open sessions started by Org Admin (`ownerRole == \'admin\'`).\\n * Every query matches the exact static predicates in `firestore.rules` so Firestore never\\n * rejects the query with a false permission-denied error.\\n */\\nexport async function findEligibleLiveSessions(\\n  profile: UserProfile,\\n  org: Organization\\n): Promise<{ sessions: AttendanceSession[]; error?: SessionStreamError }> {\\n  if (!navigator.onLine) {\\n    return { sessions: [], error: \'network\' };\\n  }\\n\\n  const queries = buildEligibleSessionQueries(profile, org);\\n  if (queries.length === 0) {\\n    return { sessions: [] };\\n  }\\n\\n  const nowMs = Date.now();\\n  const map = new Map<string, AttendanceSession>();\\n  let lastErr: SessionStreamError | undefined;\\n  let anySuccess = false;\\n\\n  await Promise.all(\\n    queries.map(async (q) => {\\n      try {\\n        const snap = await getDocs(q);\\n        anySuccess = true;\\n        for (const d of snap.docs) {\\n          const s = { ...(d.data() as Omit<AttendanceSession, \'id\'>), id: d.id };\\n          if (\\n            s.status === \'open\' &&\\n            (s.endsAt?.toMillis?.() ?? 0) > nowMs &&\\n            isAuthorizedForSession(profile, org, s)\\n          ) {\\n            map.set(s.id, s);\\n          }\\n        }\\n      } catch (err) {\\n        lastErr = classifyFirestoreError(err);\\n      }\\n    })\\n  );\\n\\n  const sorted = Array.from(map.values()).sort(\\n    (a, b) => (b.startedAt?.toMillis?.() ?? 0) - (a.startedAt?.toMillis?.() ?? 0)\\n  );\\n  return { sessions: sorted, error: anySuccess ? undefined : lastErr };\\n}\\n\\nfunction buildEligibleSessionQueries(profile: UserProfile, org: Organization) {\\n  const list = [];\\n  if (profile.role === \'manager\') {\\n    list.push(\\n      query(\\n        collection(db, \'sessions\'),\\n        where(\'orgId\', \'==\', org.id),\\n        where(\'ownerRole\', \'==\', \'admin\'),\\n        where(\'status\', \'==\', \'open\')\\n      )\\n    );\\n  } else if (profile.role === \'member\') {\\n    if (profile.classId) {\\n      list.push(\\n        query(\\n          collection(db, \'sessions\'),\\n          where(\'orgId\', \'==\', org.id),\\n          where(\'classId\', \'==\', profile.classId),\\n          where(\'status\', \'==\', \'open\')\\n        )\\n      );\\n    }\\n    if (profile.managerId) {\\n      list.push(\\n        query(\\n          collection(db, \'sessions\'),\\n          where(\'orgId\', \'==\', org.id),\\n          where(\'ownerUid\', \'==\', profile.managerId),\\n          where(\'status\', \'==\', \'open\')\\n        )\\n      );\\n    }\\n  }\\n  return list;\\n}\\n\\n/**\\n * Real-time `onSnapshot()` subscription to ALL active sessions eligible for this Student or Manager.\\n * Supports multiple teachers running independent subject-wise sessions simultaneously or back-to-back.\\n * Properly surfaces permission-denied, network, and index errors instead of masking them as empty.\\n * Unsubscribes cleanly on unmount.\\n */\\nexport function subscribeEligibleLiveSessions(\\n  profile: UserProfile,\\n  org: Organization,\\n  onUpdate: (sessions: AttendanceSession[]) => void,\\n  onError?: (err: SessionStreamError) => void\\n): () => void {\\n  const queries = buildEligibleSessionQueries(profile, org);\\n  if (queries.length === 0) {\\n    onUpdate([]);\\n    return () => {};\\n  }\\n\\n  const buckets: Array<Map<string, AttendanceSession>> = queries.map(() => new Map());\\n  const ready = queries.map(() => false);\\n  let active = true;\\n\\n  const emitMerged = () => {\\n    if (!active) return;\\n    const nowMs = Date.now();\\n    const merged = new Map<string, AttendanceSession>();\\n    for (const bucket of buckets) {\\n      for (const [id, sess] of bucket.entries()) {\\n        if (\\n          sess.status === \'open\' &&\\n          (sess.endsAt?.toMillis?.() ?? 0) > nowMs &&\\n          isAuthorizedForSession(profile, org, sess)\\n        ) {\\n          merged.set(id, sess);\\n        }\\n      }\\n    }\\n    const sorted = Array.from(merged.values()).sort(\\n      (a, b) => (b.startedAt?.toMillis?.() ?? 0) - (a.startedAt?.toMillis?.() ?? 0)\\n    );\\n    onUpdate(sorted);\\n  };\\n\\n  const unsubs = queries.map((q, idx) =>\\n    onSnapshot(\\n      q,\\n      (snap) => {\\n        const nextMap = new Map<string, AttendanceSession>();\\n        for (const d of snap.docs) {\\n          nextMap.set(d.id, { ...(d.data() as Omit<AttendanceSession, \'id\'>), id: d.id });\\n        }\\n        buckets[idx] = nextMap;\\n        ready[idx] = true;\\n        emitMerged();\\n      },\\n      (err) => {\\n        if (!active) return;\\n        const kind = classifyFirestoreError(err);\\n        buckets[idx] = new Map();\\n        ready[idx] = true;\\n        // Only surface error if NO sibling query succeeded with data\\n        const anyHasData = buckets.some((b) => b.size > 0);\\n        if (!anyHasData) {\\n          onError?.(kind);\\n        }\\n      }\\n    )\\n  );\\n\\n  return () => {\\n    active = false;\\n    for (const unsub of unsubs) {\\n      try {\\n        unsub();\\n      } catch {\\n        // Ignore cleanup error\\n      }\\n    }\\n  };\\n}\\n\\nexport type ResolvedSessionResult =\\n  | { status: \'ok\'; session: AttendanceSession }\\n  | { status: \'closed\' | \'unauthorized\' | \'not_found\' | \'network\' };\\n\\n/**\\n * Resolves a scanned sessionId directly from Firestore so that scanning an ended,\\n * unauthorized, or non-existent session QR returns an accurate, clear error.\\n */\\nexport async function resolveScannedSession(\\n  scannedSessionId: string,\\n  profile: UserProfile,\\n  org: Organization\\n): Promise<ResolvedSessionResult> {\\n  if (!navigator.onLine) return { status: \'network\' };\\n  try {\\n    const snap = await getDoc(doc(db, \'sessions\', scannedSessionId));\\n    if (!snap.exists()) {\\n      return { status: \'not_found\' };\\n    }\\n    const sess = { ...(snap.data() as Omit<AttendanceSession, \'id\'>), id: snap.id };\\n    if (!isAuthorizedForSession(profile, org, sess)) {\\n      return { status: \'unauthorized\' };\\n    }\\n    if (sess.status !== \'open\' || (sess.endsAt?.toMillis?.() ?? 0) <= Date.now()) {\\n      return { status: \'closed\' };\\n    }\\n    return { status: \'ok\', session: sess };\\n  } catch (err) {\\n    const code = (err as { code?: string })?.code;\\n    if (code === \'permission-denied\') {\\n      return { status: \'unauthorized\' };\\n    }\\n    if (code === \'unavailable\' || !navigator.onLine) {\\n      return { status: \'network\' };\\n    }\\n    return { status: \'not_found\' };\\n  }\\n}\\n\\nexport function subscribeSession(\\n  sessionId: string,\\n  callback: (session: AttendanceSession | null) => void\\n): () => void {\\n  return onSnapshot(doc(db, \'sessions\', sessionId), (snap) => {\\n    if (!snap.exists()) {\\n      callback(null);\\n    } else {\\n      callback({ ...(snap.data() as Omit<AttendanceSession, \'id\'>), id: snap.id });\\n    }\\n  });\\n}\\n\\nexport function subscribeSessionAttendance(\\n  orgId: string,\\n  sessionId: string,\\n  callback: (records: AttendanceRecord[]) => void\\n): () => void {\\n  const q = query(\\n    collection(db, \'attendance\'),\\n    where(\'orgId\', \'==\', orgId),\\n    where(\'sessionId\', \'==\', sessionId)\\n  );\\n  return onSnapshot(\\n    q,\\n    (snap) => {\\n      const list = snap.docs\\n        .map((d) => {\\n          const data = d.data() as AttendanceRecord;\\n          return { ...data, id: d.id, status: normalizeAttendanceStatus(data.status) };\\n        })\\n        .sort((a, b) => (b.timestamp?.toMillis?.() ?? 0) - (a.timestamp?.toMillis?.() ?? 0));\\n      callback(list);\\n    },\\n    () => callback([])\\n  );\\n}\\n\\nexport function subscribeSessionAttempts(\\n  orgId: string,\\n  sessionId: string,\\n  callback: (attempts: AttendanceAttempt[]) => void\\n): () => void {\\n  const q = query(\\n    collection(db, \'attempts\'),\\n    where(\'orgId\', \'==\', orgId),\\n    where(\'sessionId\', \'==\', sessionId)\\n  );\\n  return onSnapshot(\\n    q,\\n    (snap) => {\\n      const list = snap.docs\\n        .map((d) => ({ ...(d.data() as AttendanceAttempt), id: d.id }))\\n        .sort((a, b) => (b.time?.toMillis?.() ?? 0) - (a.time?.toMillis?.() ?? 0));\\n      callback(list);\\n    },\\n    () => callback([])\\n  );\\n}\\n\\nexport async function logFailedAttempt(params: {\\n  orgId: string;\\n  sessionId: string;\\n  ownerUid: string;\\n  person: UserProfile;\\n  reason: string;\\n  distance: number | null;\\n}): Promise<void> {\\n  try {\\n    await addDoc(collection(db, \'attempts\'), {\\n      orgId: params.orgId,\\n      sessionId: params.sessionId,\\n      ownerUid: params.ownerUid,\\n      personUid: params.person.uid,\\n      personName: params.person.name,\\n      personId: params.person.memberId || \'\',\\n      reason: params.reason,\\n      distance: params.distance,\\n      time: serverTimestamp(),\\n    });\\n  } catch {\\n    // Logging failure should never block user feedback\\n  }\\n}\\n\\nexport type SelfMarkErrorCode =\\n  | \'errExpired\'\\n  | \'errInvalidCode\'\\n  | \'errOutsideArea\'\\n  | \'errSessionClosed\'\\n  | \'errAlreadyMarked\'\\n  | \'errDeviceUsed\'\\n  | \'errWrongSession\'\\n  | \'errUnauthorized\'\\n  | \'errNetwork\'\\n  | \'generic\';\\n\\nexport interface SelfMarkResult {\\n  ok: boolean;\\n  errorCode?: SelfMarkErrorCode;\\n  status?: AttendanceStatus;\\n  timeStr?: string;\\n  distanceMeters?: number;\\n  subjectName?: string;\\n}\\n\\n/**\\n * Atomic self-marking flow using a Firestore Transaction + strict backend Security Rules:\\n * - Always records status: \'present\' (LATE status completely removed).\\n * - Uses session-scoped deterministic doc ID `${orgId}_${sessionId}_${personUid}` so\\n *   multiple subjects/teachers on the same day NEVER overwrite each other while strictly\\n *   preventing duplicate attendance within the same session.\\n * - Atomically writes `sessionDevices/{sessionId}_{deviceId}` and `attendance/{recordId}`.\\n * - Backend `firestore.rules` authoritatively validates role/class eligibility, open session,\\n *   exact current token/code within strictly 10 seconds on `request.time`, GPS radius, and device lock.\\n */\\nexport async function submitSelfAttendance(params: {\\n  org: Organization;\\n  profile: UserProfile;\\n  session: AttendanceSession;\\n  method: \'live_qr\' | \'live_code\';\\n  token?: string;\\n  code?: string;\\n  lat: number;\\n  lng: number;\\n  accuracy: number;\\n}): Promise<SelfMarkResult> {\\n  const { org, profile, session, method, lat, lng, accuracy } = params;\\n\\n  if (!navigator.onLine) {\\n    return { ok: false, errorCode: \'errNetwork\' };\\n  }\\n\\n  if (!isAuthorizedForSession(profile, org, session)) {\\n    return { ok: false, errorCode: \'errUnauthorized\' };\\n  }\\n\\n  const distanceMeters = getFlatEarthDistanceMeters(\\n    lat,\\n    lng,\\n    session.location.lat,\\n    session.location.lng,\\n    session.location.cosLat\\n  );\\n\\n  // Fast client pre-check for immediate feedback + attempt logging (enforced again on server)\\n  if (session.status !== \'open\' || (session.endsAt?.toMillis?.() ?? 0) <= Date.now()) {\\n    return { ok: false, errorCode: \'errSessionClosed\' };\\n  }\\n\\n  if (session.locationCheckEnabled && distanceMeters > session.location.radius) {\\n    await logFailedAttempt({\\n      orgId: org.id,\\n      sessionId: session.id,\\n      ownerUid: session.ownerUid,\\n      person: profile,\\n      reason: \'outside_radius\',\\n      distance: distanceMeters,\\n    });\\n    return { ok: false, errorCode: \'errOutsideArea\', distanceMeters };\\n  }\\n\\n  const date = session.date || getOrgDateString(org.timezone || \'Asia/Kolkata\');\\n  const currentHHMM = getOrgTimeHHMM(org.timezone || \'Asia/Kolkata\');\\n  const attendanceDocId = buildSessionAttendanceDocId(org.id, session.id, profile.uid);\\n  const deviceId = getOrCreateDeviceId();\\n  const deviceDocId = `${session.id}_${deviceId}`;\\n\\n  // Strictly PRESENT (no LATE status anywhere)\\n  const status: AttendanceStatus = \'present\';\\n\\n  const sessionRef = doc(db, \'sessions\', session.id);\\n  const attendanceRef = doc(db, \'attendance\', attendanceDocId);\\n  const deviceRef = doc(db, \'sessionDevices\', deviceDocId);\\n\\n  try {\\n    await runTransaction(db, async (tx) => {\\n      const [sessSnap, attSnap, devSnap] = await Promise.all([\\n        tx.get(sessionRef),\\n        tx.get(attendanceRef),\\n        tx.get(deviceRef),\\n      ]);\\n\\n      if (!sessSnap.exists()) {\\n        throw new Error(\'TX_SESSION_CLOSED\');\\n      }\\n      const liveSess = sessSnap.data() as AttendanceSession;\\n      if (liveSess.status !== \'open\' || (liveSess.endsAt?.toMillis?.() ?? 0) <= Date.now()) {\\n        throw new Error(\'TX_SESSION_CLOSED\');\\n      }\\n\\n      if (attSnap.exists()) {\\n        throw new Error(\'TX_ALREADY_MARKED\');\\n      }\\n\\n      if (devSnap.exists()) {\\n        throw new Error(\'TX_DEVICE_USED\');\\n      }\\n\\n      tx.set(deviceRef, {\\n        sessionId: session.id,\\n        deviceId,\\n        personUid: profile.uid,\\n        orgId: org.id,\\n        createdAt: serverTimestamp(),\\n      });\\n\\n      tx.set(attendanceRef, {\\n        orgId: org.id,\\n        personUid: profile.uid,\\n        personName: profile.name,\\n        personMemberId: profile.memberId,\\n        role: profile.role === \'manager\' ? \'manager\' : \'member\',\\n        managerId: profile.managerId || null,\\n        teacherUid: session.ownerUid,\\n        teacherName: session.ownerName,\\n        ...(session.departmentId ? { departmentId: session.departmentId } : {}),\\n        ...(session.classId\\n          ? {\\n              classId: session.classId,\\n              className: session.className || \'\',\\n              semester: session.semester || \'\',\\n              section: session.section || \'\',\\n            }\\n          : {}),\\n        ...(session.subjectId\\n          ? {\\n              subjectId: session.subjectId,\\n              subjectName: session.subjectName || \'\',\\n              subjectCode: session.subjectCode || \'\',\\n            }\\n          : {}),\\n        date,\\n        timestamp: serverTimestamp(),\\n        status,\\n        method,\\n        markedBy: profile.uid,\\n        note: \'\',\\n        sessionId: session.id,\\n        lat,\\n        lng,\\n        accuracy,\\n        distanceMeters,\\n        deviceId,\\n        ...(method === \'live_qr\' ? { submittedToken: params.token || \'\' } : {}),\\n        ...(method === \'live_code\' ? { submittedCode: params.code || \'\' } : {}),\\n      });\\n    });\\n\\n    await recordAuditLog({\\n      actor: profile,\\n      action: \'attendance.created\',\\n      targetCollection: \'attendance\',\\n      targetId: attendanceDocId,\\n      summary: `Marked PRESENT via ${method} for ${session.subjectName || session.title}`,\\n      metadata: {\\n        sessionId: session.id,\\n        subjectId: session.subjectId || null,\\n        classId: session.classId || null,\\n        distanceMeters,\\n      },\\n    });\\n\\n    return {\\n      ok: true,\\n      status,\\n      timeStr: currentHHMM,\\n      distanceMeters,\\n      subjectName: session.subjectName || session.title,\\n    };\\n  } catch (err) {\\n    const message = (err as Error)?.message || \'\';\\n    const codeErr = (err as { code?: string })?.code || \'\';\\n\\n    if (message === \'TX_SESSION_CLOSED\') {\\n      return { ok: false, errorCode: \'errSessionClosed\' };\\n    }\\n    if (message === \'TX_ALREADY_MARKED\') {\\n      return { ok: false, errorCode: \'errAlreadyMarked\' };\\n    }\\n    if (message === \'TX_DEVICE_USED\') {\\n      await logFailedAttempt({\\n        orgId: org.id,\\n        sessionId: session.id,\\n        ownerUid: session.ownerUid,\\n        person: profile,\\n        reason: \'device_already_used\',\\n        distance: distanceMeters,\\n      });\\n      return { ok: false, errorCode: \'errDeviceUsed\' };\\n    }\\n\\n    if (!navigator.onLine || codeErr === \'unavailable\' || codeErr === \'deadline-exceeded\') {\\n      return { ok: false, errorCode: \'errNetwork\' };\\n    }\\n\\n    if (codeErr === \'permission-denied\') {\\n      try {\\n        const [attSnap, devSnap, sessSnap] = await Promise.all([\\n          getDoc(attendanceRef),\\n          getDoc(deviceRef),\\n          getDoc(sessionRef),\\n        ]);\\n        if (attSnap.exists()) {\\n          return { ok: false, errorCode: \'errAlreadyMarked\' };\\n        }\\n        if (devSnap.exists()) {\\n          await logFailedAttempt({\\n            orgId: org.id,\\n            sessionId: session.id,\\n            ownerUid: session.ownerUid,\\n            person: profile,\\n            reason: \'device_already_used\',\\n            distance: distanceMeters,\\n          });\\n          return { ok: false, errorCode: \'errDeviceUsed\' };\\n        }\\n        if (sessSnap.exists()) {\\n          const s = sessSnap.data() as AttendanceSession;\\n          if (s.status !== \'open\' || (s.endsAt?.toMillis?.() ?? 0) <= Date.now()) {\\n            return { ok: false, errorCode: \'errSessionClosed\' };\\n          }\\n        }\\n      } catch {\\n        // Proceed to expired/invalid secret classification\\n      }\\n\\n      await logFailedAttempt({\\n        orgId: org.id,\\n        sessionId: session.id,\\n        ownerUid: session.ownerUid,\\n        person: profile,\\n        reason: \'expired_or_invalid_secret\',\\n        distance: distanceMeters,\\n      });\\n      return {\\n        ok: false,\\n        errorCode: method === \'live_qr\' ? \'errExpired\' : \'errInvalidCode\',\\n      };\\n    }\\n\\n    return { ok: false, errorCode: \'generic\' };\\n  }\\n}\\n\", \"Description\":\"Fix Live Attendance Session queries, support multiple independent teachers & subject-wise sessions, remove LATE status, and write immutable audit logs\", \"Overwrite\":true, \"TargetFile\":\"/src/services/sessionService.ts\", \"toolAction\":\"Updating sessionService.ts\", \"toolSummary\":\"Update sessionService.ts\"}"
      original_name: "write_to_file"
    }
