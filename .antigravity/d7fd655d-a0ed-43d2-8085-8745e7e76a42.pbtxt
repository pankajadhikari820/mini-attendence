    tool_calls {
      id: "call_13750254771015051507"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useEffect, useRef, useState } from \'react\';\\nimport { Link, NavLink, useLocation, useNavigate } from \'react-router-dom\';\\nimport {\\n  BarChart3,\\n  Bell,\\n  BookOpen,\\n  Building2,\\n  CalendarClock,\\n  CalendarDays,\\n  CheckCircle2,\\n  ClipboardList,\\n  GraduationCap,\\n  LayoutDashboard,\\n  LogOut,\\n  Megaphone,\\n  ScanLine,\\n  Settings,\\n  ShieldCheck,\\n  Users,\\n  UserCog,\\n} from \'lucide-react\';\\nimport { useAuth } from \'../context/AuthContext\';\\nimport { useTranslation } from \'../hooks/useTranslation\';\\nimport type { AppNotification } from \'../types\';\\nimport {\\n  markAllNotificationsRead,\\n  markNotificationRead,\\n  subscribeNotifications,\\n} from \'../services/communicationService\';\\nimport { getInitials } from \'../utils/helpers\';\\nimport { Logo } from \'./Logo\';\\nimport { LanguageToggle } from \'./LanguageToggle\';\\nimport { ThemeToggle } from \'./ThemeToggle\';\\nimport { PWAInstallButton } from \'./PWAInstallButton\';\\nimport { getHomePathForRole } from \'./ProtectedRoute\';\\n\\ninterface LayoutProps {\\n  title?: string;\\n  children: React.ReactNode;\\n}\\n\\ninterface NavItem {\\n  to: string;\\n  label: string;\\n  icon: React.FC<{ className?: string }>;\\n  mobile?: boolean;\\n}\\n\\nexport const Layout: React.FC<LayoutProps> = ({ title, children }) => {\\n  const { profile, org, logout, getRoleLabel } = useAuth();\\n  const { t, formatTime } = useTranslation();\\n  const navigate = useNavigate();\\n  const location = useLocation();\\n  const [notifications, setNotifications] = useState<AppNotification[]>([]);\\n  const [notifOpen, setNotifOpen] = useState(false);\\n  const notifRef = useRef<HTMLDivElement>(null);\\n\\n  useEffect(() => {\\n    if (!profile?.uid) return;\\n    return subscribeNotifications(profile.uid, setNotifications);\\n  }, [profile?.uid]);\\n\\n  useEffect(() => {\\n    const onClickOutside = (e: MouseEvent) => {\\n      if (notifRef.current && !notifRef.current.contains(e.target as Node)) {\\n        setNotifOpen(false);\\n      }\\n    };\\n    document.addEventListener(\'mousedown\', onClickOutside);\\n    return () => document.removeEventListener(\'mousedown\', onClickOutside);\\n  }, []);\\n\\n  const unreadCount = notifications.filter((n) => !n.read).length;\\n\\n  const managerLabel = getRoleLabel(\'manager\');\\n  const memberLabel = getRoleLabel(\'member\');\\n  const homePath = getHomePathForRole(profile?.role);\\n\\n  const navItems: NavItem[] = (() => {\\n    if (profile?.role === \'super_admin\') {\\n      return [\\n        { to: \'/super-admin\', label: t(\'nav.organizations\'), icon: Building2, mobile: true },\\n        { to: \'/admin\', label: t(\'nav.dashboard\'), icon: LayoutDashboard, mobile: true },\\n        { to: \'/academics\', label: t(\'nav.academics\'), icon: BookOpen },\\n        { to: \'/timetable\', label: t(\'nav.timetable\'), icon: CalendarDays },\\n        { to: \'/admin/managers\', label: managerLabel, icon: UserCog },\\n        { to: \'/admin/members\', label: memberLabel, icon: Users },\\n        { to: \'/reports\', label: t(\'nav.reports\'), icon: BarChart3, mobile: true },\\n        { to: \'/audit-logs\', label: t(\'nav.auditLogs\'), icon: ShieldCheck, mobile: true },\\n        { to: \'/settings\', label: t(\'nav.settings\'), icon: Settings, mobile: true },\\n      ];\\n    }\\n    if (profile?.role === \'admin\') {\\n      return [\\n        { to: \'/admin\', label: t(\'nav.dashboard\'), icon: LayoutDashboard, mobile: true },\\n        { to: \'/attendance\', label: t(\'nav.startAttendance\'), icon: ScanLine, mobile: true },\\n        { to: \'/academics\', label: t(\'nav.academics\'), icon: BookOpen },\\n        { to: \'/timetable\', label: t(\'nav.timetable\'), icon: CalendarDays },\\n        { to: \'/admin/managers\', label: managerLabel, icon: UserCog, mobile: true },\\n        { to: \'/admin/members\', label: memberLabel, icon: Users },\\n        { to: \'/attendance/manual\', label: t(\'nav.manualBackup\'), icon: ClipboardList },\\n        { to: \'/reports\', label: t(\'nav.reports\'), icon: BarChart3, mobile: true },\\n        { to: \'/leaves\', label: t(\'nav.leaves\'), icon: CalendarClock },\\n        { to: \'/announcements\', label: t(\'nav.announcements\'), icon: Megaphone },\\n        { to: \'/audit-logs\', label: t(\'nav.auditLogs\'), icon: ShieldCheck },\\n        { to: \'/settings\', label: t(\'nav.settings\'), icon: Settings, mobile: true },\\n      ];\\n    }\\n    if (profile?.role === \'manager\') {\\n      return [\\n        { to: \'/manager\', label: t(\'nav.dashboard\'), icon: LayoutDashboard, mobile: true },\\n        { to: \'/attendance\', label: t(\'nav.startAttendance\'), icon: ScanLine, mobile: true },\\n        { to: \'/timetable\', label: t(\'nav.timetable\'), icon: CalendarDays, mobile: true },\\n        { to: \'/mark\', label: t(\'nav.markYourAttendance\'), icon: CheckCircle2 },\\n        { to: \'/attendance/manual\', label: t(\'nav.manualBackup\'), icon: ClipboardList },\\n        { to: \'/manager/members\', label: memberLabel, icon: Users },\\n        { to: \'/reports\', label: t(\'nav.reports\'), icon: BarChart3, mobile: true },\\n        { to: \'/leaves\', label: t(\'nav.leaves\'), icon: CalendarClock },\\n        { to: \'/announcements\', label: t(\'nav.announcements\'), icon: Megaphone },\\n        { to: \'/settings\', label: t(\'nav.settings\'), icon: Settings, mobile: true },\\n      ];\\n    }\\n    if (profile?.role === \'parent\') {\\n      return [\\n        { to: \'/parent\', label: t(\'nav.parentPortal\'), icon: GraduationCap, mobile: true },\\n        { to: \'/timetable\', label: t(\'nav.timetable\'), icon: CalendarDays, mobile: true },\\n        { to: \'/announcements\', label: t(\'nav.announcements\'), icon: Megaphone, mobile: true },\\n        { to: \'/settings\', label: t(\'nav.settings\'), icon: Settings, mobile: true },\\n      ];\\n    }\\n    return [\\n      { to: \'/member\', label: t(\'nav.dashboard\'), icon: LayoutDashboard, mobile: true },\\n      { to: \'/mark\', label: t(\'nav.markYourAttendance\'), icon: ScanLine, mobile: true },\\n      { to: \'/timetable\', label: t(\'nav.timetable\'), icon: CalendarDays, mobile: true },\\n      { to: \'/leaves\', label: t(\'nav.leaves\'), icon: CalendarClock, mobile: true },\\n      { to: \'/announcements\', label: t(\'nav.announcements\'), icon: Megaphone },\\n      { to: \'/settings\', label: t(\'nav.settings\'), icon: Settings, mobile: true },\\n    ];\\n  })();\\n\\n  const mobileItems = navItems.filter((item) => item.mobile);\\n\\n  const handleLogout = async () => {\\n    await logout();\\n    navigate(\'/login\');\\n  };\\n\\n  const roleBadgeText =\\n    profile?.role === \'super_admin\'\\n      ? t(\'common.superAdmin\')\\n      : profile?.role === \'admin\'\\n      ? t(\'common.admin\')\\n      : profile?.role === \'manager\'\\n      ? managerLabel\\n      : profile?.role === \'parent\'\\n      ? t(\'common.parent\')\\n      : memberLabel;\\n\\n  const pageHeading =\\n    title || navItems.find((item) => item.to === location.pathname)?.label || t(\'nav.dashboard\');\\n\\n  return (\\n    <div className=\\\"min-h-screen bg-[#FAF9F6] dark:bg-[#0F0F11] text-stone-900 dark:text-stone-100 flex\\\">\\n      {/* Desktop Sidebar */}\\n      <aside className=\\\"hidden md:flex md:flex-col md:w-60 lg:w-64 border-r border-stone-200 dark:border-stone-800 bg-white dark:bg-[#141416] fixed inset-y-0 left-0 z-30 no-print\\\">\\n        <div className=\\\"h-16 px-5 flex items-center border-b border-stone-200 dark:border-stone-800\\\">\\n          <Link to={homePath}>\\n            <Logo />\\n          </Link>\\n        </div>\\n\\n        {org && (\\n          <div className=\\\"px-5 py-3.5 border-b border-stone-100 dark:border-stone-800/80 flex items-center gap-2.5\\\">\\n            {org.logoUrl && (\\n              <img\\n                src={org.logoUrl}\\n                alt={org.name}\\n                className=\\\"w-8 h-8 rounded-lg object-cover border border-stone-200 dark:border-stone-700 shrink-0\\\"\\n              />\\n            )}\\n            <div className=\\\"min-w-0 flex-1\\\">\\n              <p className=\\\"text-sm font-semibold text-stone-900 dark:text-stone-100 truncate\\\">\\n                {org.name}\\n              </p>\\n              <p className=\\\"text-xs text-stone-500 dark:text-stone-400 truncate mt-0.5 font-mono\\\">\\n                {roleBadgeText}\\n                {profile?.memberId ? ` \302\267 ${profile.memberId}` : \'\'}\\n              </p>\\n            </div>\\n          </div>\\n        )}\\n\\n        <nav className=\\\"flex-1 overflow-y-auto px-3 py-4 space-y-0.5\\\">\\n          {profile?.role === \'admin\' || profile?.role === \'manager\' || profile?.role === \'super_admin\' ? (\\n            <Link\\n              to=\\\"/attendance\\\"\\n              className=\\\"mb-3 flex items-center justify-center gap-2 rounded-xl bg-[#C25E00] hover:bg-[#A84F00] text-white px-4 py-2.5 text-sm font-medium transition-colors\\\"\\n            >\\n              <ScanLine className=\\\"w-4 h-4\\\" />\\n              <span className=\\\"whitespace-nowrap\\\">{t(\'nav.startAttendance\')}</span>\\n            </Link>\\n          ) : profile?.role === \'member\' ? (\\n            <Link\\n              to=\\\"/mark\\\"\\n              className=\\\"mb-3 flex items-center justify-center gap-2 rounded-xl bg-[#C25E00] hover:bg-[#A84F00] text-white px-4 py-2.5 text-sm font-medium transition-colors\\\"\\n            >\\n              <ScanLine className=\\\"w-4 h-4\\\" />\\n              <span className=\\\"whitespace-nowrap\\\">{t(\'nav.markYourAttendance\')}</span>\\n            </Link>\\n          ) : null}\\n\\n          {navItems.map((item) => {\\n            const Icon = item.icon;\\n            return (\\n              <NavLink\\n                key={item.to}\\n                to={item.to}\\n                end={\\n                  item.to === \'/admin\' ||\\n                  item.to === \'/manager\' ||\\n                  item.to === \'/member\' ||\\n                  item.to === \'/parent\' ||\\n                  item.to === \'/super-admin\' ||\\n                  item.to === \'/attendance\'\\n                }\\n                className={({ isActive }) =>\\n                  `flex items-center gap-3 rounded-xl px-3 py-2 text-sm font-medium transition-colors ${\\n                    isActive\\n                      ? \'bg-stone-100 dark:bg-stone-800/90 text-stone-900 dark:text-stone-100\'\\n                      : \'text-stone-600 dark:text-stone-400 hover:bg-stone-50 dark:hover:bg-stone-800/50 hover:text-stone-900 dark:hover:text-stone-100\'\\n                  }`\\n                }\\n              >\\n                <Icon className=\\\"w-4 h-4 shrink-0\\\" />\\n                <span className=\\\"truncate\\\">{item.label}</span>\\n              </NavLink>\\n            );\\n          })}\\n        </nav>\\n\\n        <div className=\\\"p-3 border-t border-stone-200 dark:border-stone-800 space-y-2\\\">\\n          <div className=\\\"flex items-center gap-2.5 px-2 py-1.5\\\">\\n            {profile?.photoUrl ? (\\n              <img\\n                src={profile.photoUrl}\\n                alt={profile.name}\\n                className=\\\"w-8 h-8 rounded-full object-cover border border-stone-200 dark:border-stone-700 shrink-0\\\"\\n              />\\n            ) : (\\n              <div className=\\\"w-8 h-8 rounded-full bg-stone-200 dark:bg-stone-800 text-stone-700 dark:text-stone-200 flex items-center justify-center text-xs font-semibold shrink-0\\\">\\n                {getInitials(profile?.name || \'\')}\\n              </div>\\n            )}\\n            <div className=\\\"min-w-0 flex-1\\\">\\n              <p className=\\\"text-sm font-medium text-stone-900 dark:text-stone-100 truncate\\\">\\n                {profile?.name}\\n              </p>\\n              <p className=\\\"text-xs text-stone-500 dark:text-stone-400 truncate\\\">\\n                {profile?.email}\\n              </p>\\n            </div>\\n          </div>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={handleLogout}\\n            className=\\\"w-full flex items-center gap-2.5 rounded-lg px-3 py-2 text-sm text-stone-600 dark:text-stone-400 hover:bg-stone-100 dark:hover:bg-stone-800 hover:text-stone-900 dark:hover:text-stone-100 transition-colors\\\"\\n          >\\n            <LogOut className=\\\"w-4 h-4\\\" />\\n            <span>{t(\'common.logout\')}</span>\\n          </button>\\n        </div>\\n      </aside>\\n\\n      {/* Main Content Area */}\\n      <div className=\\\"flex-1 flex flex-col md:pl-60 lg:pl-64 min-w-0\\\">\\n        <header className=\\\"sticky top-0 z-20 h-14 md:h-16 border-b border-stone-200 dark:border-stone-800 bg-[#FAF9F6]/90 dark:bg-[#0F0F11]/90 backdrop-blur-md px-4 md:px-8 flex items-center justify-between gap-4 no-print\\\">\\n          <div className=\\\"flex items-center gap-3 min-w-0\\\">\\n            <div className=\\\"md:hidden\\\">\\n              <Logo compact />\\n            </div>\\n            <h1 className=\\\"text-base md:text-lg font-semibold tracking-tight text-stone-900 dark:text-stone-100 truncate\\\">\\n              {pageHeading}\\n            </h1>\\n          </div>\\n\\n          <div className=\\\"flex items-center gap-2 shrink-0\\\">\\n            <div className=\\\"hidden sm:block\\\">\\n              <PWAInstallButton compact />\\n            </div>\\n            <LanguageToggle />\\n            <ThemeToggle />\\n\\n            {/* Notification Bell */}\\n            <div ref={notifRef} className=\\\"relative\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setNotifOpen((o) => !o)}\\n                aria-label={t(\'notifications.title\')}\\n                className=\\\"relative inline-flex items-center justify-center w-9 h-9 rounded-lg border border-stone-200 dark:border-stone-800 text-stone-600 dark:text-stone-300 hover:bg-stone-100 dark:hover:bg-stone-800 transition-colors\\\"\\n              >\\n                <Bell className=\\\"w-4 h-4\\\" />\\n                {unreadCount > 0 && (\\n                  <span className=\\\"absolute -top-1 -right-1 min-w-[18px] h-[18px] px-1 rounded-full bg-[#C25E00] text-white text-[10px] font-semibold flex items-center justify-center tabular-nums\\\">\\n                    {unreadCount > 9 ? \'9+\' : unreadCount}\\n                  </span>\\n                )}\\n              </button>\\n\\n              {notifOpen && (\\n                <div className=\\\"absolute right-0 mt-2 w-80 max-w-[calc(100vw-2rem)] rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 shadow-xl overflow-hidden z-40\\\">\\n                  <div className=\\\"flex items-center justify-between px-4 py-3 border-b border-stone-100 dark:border-stone-800\\\">\\n                    <span className=\\\"text-sm font-semibold text-stone-900 dark:text-stone-100\\\">\\n                      {t(\'notifications.title\')}\\n                    </span>\\n                    {unreadCount > 0 && (\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() => markAllNotificationsRead(notifications)}\\n                        className=\\\"text-xs font-medium text-[#C25E00] hover:underline\\\"\\n                      >\\n                        {t(\'notifications.markAllRead\')}\\n                      </button>\\n                    )}\\n                  </div>\\n                  <div className=\\\"max-h-80 overflow-y-auto divide-y divide-stone-100 dark:divide-stone-800\\\">\\n                    {notifications.length === 0 ? (\\n                      <p className=\\\"px-4 py-8 text-center text-xs text-stone-500 dark:text-stone-400\\\">\\n                        {t(\'notifications.empty\')}\\n                      </p>\\n                    ) : (\\n                      notifications.map((item) => (\\n                        <button\\n                          key={item.id}\\n                          type=\\\"button\\\"\\n                          onClick={() => {\\n                            if (!item.read) markNotificationRead(item.id);\\n                          }}\\n                          className={`w-full text-left px-4 py-3 text-xs transition-colors hover:bg-stone-50 dark:hover:bg-stone-800/60 ${\\n                            !item.read ? \'bg-amber-50/50 dark:bg-amber-950/20\' : \'\'\\n                          }`}\\n                        >\\n                          <p\\n                            className={`leading-relaxed ${\\n                              !item.read\\n                                ? \'font-medium text-stone-900 dark:text-stone-100\'\\n                                : \'text-stone-600 dark:text-stone-400\'\\n                            }`}\\n                          >\\n                            {item.text}\\n                          </p>\\n                          <p className=\\\"mt-1 text-[11px] text-stone-400\\\">\\n                            {formatTime(item.createdAt?.toDate?.())}\\n                          </p>\\n                        </button>\\n                      ))\\n                    )}\\n                  </div>\\n                </div>\\n              )}\\n            </div>\\n          </div>\\n        </header>\\n\\n        <main className=\\\"flex-1 w-full max-w-6xl mx-auto px-4 md:px-8 py-6 pb-24 md:py-8 md:pb-10\\\">\\n          {children}\\n        </main>\\n      </div>\\n\\n      {/* Mobile Bottom Navigation */}\\n      <nav\\n        aria-label=\\\"Primary\\\"\\n        className=\\\"md:hidden fixed bottom-0 inset-x-0 z-30 h-16 border-t border-stone-200 dark:border-stone-800 bg-white/95 dark:bg-[#141416]/95 backdrop-blur-md flex items-center justify-around px-1 no-print\\\"\\n      >\\n        {mobileItems.map((item) => {\\n          const Icon = item.icon;\\n          return (\\n            <NavLink\\n              key={item.to}\\n              to={item.to}\\n              end={\\n                item.to === \'/admin\' ||\\n                item.to === \'/manager\' ||\\n                item.to === \'/member\' ||\\n                item.to === \'/parent\' ||\\n                item.to === \'/super-admin\' ||\\n                item.to === \'/attendance\'\\n              }\\n              className={({ isActive }) =>\\n                `flex flex-col items-center justify-center gap-0.5 min-w-[56px] py-1.5 rounded-lg text-[11px] font-medium transition-colors ${\\n                  isActive ? \'text-[#C25E00]\' : \'text-stone-500 dark:text-stone-400\'\\n                }`\\n              }\\n            >\\n              <Icon className=\\\"w-5 h-5\\\" />\\n              <span className=\\\"truncate max-w-[68px]\\\">{item.label}</span>\\n            </NavLink>\\n          );\\n        })}\\n      </nav>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Upgrade Layout navigation for all 5 roles including Academics, Timetable, Audit Logs, Parent Portal, and Super Admin\", \"Overwrite\":true, \"TargetFile\":\"/src/components/Layout.tsx\", \"toolAction\":\"Updating Layout.tsx\", \"toolSummary\":\"Update Layout.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_13750254771015052252"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useRef } from \'react\';\\nimport { QRCodeCanvas } from \'qrcode.react\';\\nimport jsPDF from \'jspdf\';\\nimport { Download, FileText, Printer, ShieldAlert, X } from \'lucide-react\';\\nimport type { Organization, UserProfile } from \'../types\';\\nimport { useTranslation } from \'../hooks/useTranslation\';\\nimport { getInitials } from \'../utils/helpers\';\\n\\ninterface QRCardModalProps {\\n  person: UserProfile;\\n  org: Organization;\\n  roleLabel: string;\\n  onClose: () => void;\\n}\\n\\nexport const QRCardModal: React.FC<QRCardModalProps> = ({\\n  person,\\n  org,\\n  roleLabel,\\n  onClose,\\n}) => {\\n  const { t } = useTranslation();\\n  const canvasWrapRef = useRef<HTMLDivElement>(null);\\n\\n  const qrValue = JSON.stringify({\\n    type: \'student_id\',\\n    orgId: org.id,\\n    uid: person.uid,\\n    id: person.memberId,\\n  });\\n\\n  const enrollmentDisplay = person.enrollmentNumber || person.rollNumber || \'\342\200\224\';\\n  const academicLine = [\\n    person.courseName,\\n    person.semester,\\n    person.section,\\n  ]\\n    .filter(Boolean)\\n    .join(\' \302\267 \') || person.className || \'\';\\n\\n  const handleDownloadPDF = () => {\\n    const sourceCanvas = canvasWrapRef.current?.querySelector(\'canvas\');\\n    const qrDataUrl = sourceCanvas ? sourceCanvas.toDataURL(\'image/png\') : \'\';\\n\\n    // Standard portrait ID card PDF (86mm x 130mm)\\n    const pdf = new jsPDF({\\n      orientation: \'portrait\',\\n      unit: \'mm\',\\n      format: [86, 132],\\n    });\\n\\n    // Background & card frame\\n    pdf.setFillColor(250, 249, 246);\\n    pdf.rect(0, 0, 86, 132, \'F\');\\n    pdf.setDrawColor(214, 211, 209);\\n    pdf.setLineWidth(0.5);\\n    pdf.roundedRect(3, 3, 80, 126, 3, 3, \'S\');\\n\\n    // Top accent bar\\n    pdf.setFillColor(194, 94, 0);\\n    pdf.rect(3, 3, 80, 14, \'F\');\\n\\n    // College Logo (if configured) + Name\\n    if (org.logoUrl && org.logoUrl.startsWith(\'data:image/\')) {\\n      try {\\n        pdf.addImage(org.logoUrl, \'JPEG\', 6, 5, 10, 10);\\n      } catch {\\n        // Ignore invalid image format\\n      }\\n    }\\n    pdf.setTextColor(255, 255, 255);\\n    pdf.setFont(\'helvetica\', \'bold\');\\n    pdf.setFontSize(9);\\n    pdf.text(org.name.slice(0, 32), 43, 10, { align: \'center\' });\\n    pdf.setFont(\'helvetica\', \'normal\');\\n    pdf.setFontSize(6.5);\\n    pdf.text(\'OFFICIAL DIGITAL IDENTITY CARD\', 43, 14.2, { align: \'center\' });\\n\\n    // Student Photo or Initials Box\\n    if (person.photoUrl && person.photoUrl.startsWith(\'data:image/\')) {\\n      try {\\n        pdf.addImage(person.photoUrl, \'JPEG\', 31, 21, 24, 24);\\n      } catch {\\n        pdf.setFillColor(231, 229, 228);\\n        pdf.roundedRect(31, 21, 24, 24, 3, 3, \'F\');\\n      }\\n    } else {\\n      pdf.setFillColor(231, 229, 228);\\n      pdf.roundedRect(31, 21, 24, 24, 3, 3, \'F\');\\n      pdf.setTextColor(68, 64, 60);\\n      pdf.setFont(\'helvetica\', \'bold\');\\n      pdf.setFontSize(12);\\n      pdf.text(getInitials(person.name), 43, 35, { align: \'center\' });\\n    }\\n\\n    // Student Name & Role\\n    pdf.setTextColor(28, 25, 23);\\n    pdf.setFont(\'helvetica\', \'bold\');\\n    pdf.setFontSize(11);\\n    pdf.text(person.name.slice(0, 28), 43, 52, { align: \'center\' });\\n\\n    pdf.setTextColor(120, 113, 108);\\n    pdf.setFont(\'helvetica\', \'normal\');\\n    pdf.setFontSize(7.5);\\n    pdf.text(`${roleLabel} \302\267 ID: ${person.memberId || \'\342\200\224\'}`, 43, 56.5, { align: \'center\' });\\n\\n    // Academic Metadata Grid\\n    let y = 62;\\n    pdf.setDrawColor(231, 229, 228);\\n    pdf.line(8, y - 2, 78, y - 2);\\n\\n    const rows: Array<[string, string]> = [\\n      [\'Enrollment / Roll\', enrollmentDisplay],\\n      ...(person.departmentName ? [[\'Department\', person.departmentName] as [string, string]] : []),\\n      ...(academicLine ? [[\'Class / Sem / Sec\', academicLine] as [string, string]] : []),\\n      ...(person.phone ? [[\'Phone\', person.phone] as [string, string]] : []),\\n    ];\\n\\n    pdf.setFontSize(7);\\n    for (const [label, value] of rows) {\\n      pdf.setTextColor(120, 113, 108);\\n      pdf.setFont(\'helvetica\', \'normal\');\\n      pdf.text(label, 8, y + 2);\\n      pdf.setTextColor(28, 25, 23);\\n      pdf.setFont(\'helvetica\', \'bold\');\\n      pdf.text(value.slice(0, 28), 78, y + 2, { align: \'right\' });\\n      y += 5;\\n    }\\n\\n    // QR Code\\n    const qrY = Math.max(y + 2, 84);\\n    if (qrDataUrl) {\\n      pdf.setFillColor(255, 255, 255);\\n      pdf.roundedRect(25, qrY, 36, 36, 2, 2, \'F\');\\n      pdf.addImage(qrDataUrl, \'PNG\', 27, qrY + 2, 32, 32);\\n    }\\n\\n    pdf.setTextColor(120, 113, 108);\\n    pdf.setFont(\'helvetica\', \'normal\');\\n    pdf.setFontSize(5.5);\\n    pdf.text(\'For campus verification & faculty backup scan only.\', 43, 125.5, { align: \'center\' });\\n\\n    pdf.save(`${person.memberId || person.name.replace(/\\\\s+/g, \'_\')}-ID-Card.pdf`);\\n  };\\n\\n  const handleDownloadPNG = () => {\\n    const sourceCanvas = canvasWrapRef.current?.querySelector(\'canvas\');\\n    if (!sourceCanvas) return;\\n\\n    const outCanvas = document.createElement(\'canvas\');\\n    const W = 560;\\n    const H = 760;\\n    outCanvas.width = W;\\n    outCanvas.height = H;\\n    const ctx = outCanvas.getContext(\'2d\');\\n    if (!ctx) return;\\n\\n    ctx.fillStyle = \'#FAF9F6\';\\n    ctx.fillRect(0, 0, W, H);\\n\\n    ctx.strokeStyle = \'#E7E5E4\';\\n    ctx.lineWidth = 4;\\n    ctx.strokeRect(16, 16, W - 32, H - 32);\\n\\n    ctx.fillStyle = \'#C25E00\';\\n    ctx.fillRect(16, 16, W - 32, 82);\\n\\n    ctx.fillStyle = \'#FFFFFF\';\\n    ctx.font = \'700 22px \\\"Plus Jakarta Sans\\\", sans-serif\';\\n    ctx.textAlign = \'center\';\\n    ctx.fillText(org.name, W / 2, 56);\\n    ctx.font = \'500 13px \\\"DM Sans\\\", sans-serif\';\\n    ctx.fillText(\'DIGITAL IDENTITY CARD\', W / 2, 80);\\n\\n    ctx.fillStyle = \'#1C1917\';\\n    ctx.font = \'700 28px \\\"Plus Jakarta Sans\\\", sans-serif\';\\n    ctx.fillText(person.name, W / 2, 146);\\n\\n    ctx.fillStyle = \'#57534E\';\\n    ctx.font = \'600 18px \\\"JetBrains Mono\\\", monospace\';\\n    ctx.fillText(`${person.memberId || \'\342\200\224\'}  \302\267  ${roleLabel}`, W / 2, 180);\\n\\n    if (academicLine) {\\n      ctx.fillStyle = \'#78716C\';\\n      ctx.font = \'500 16px \\\"DM Sans\\\", sans-serif\';\\n      ctx.fillText(academicLine, W / 2, 212);\\n    }\\n\\n    if (person.enrollmentNumber || person.rollNumber) {\\n      ctx.fillStyle = \'#78716C\';\\n      ctx.font = \'500 15px \\\"JetBrains Mono\\\", monospace\';\\n      ctx.fillText(`Enrollment: ${enrollmentDisplay}`, W / 2, 240);\\n    }\\n\\n    const qrSize = 320;\\n    const qrX = (W - qrSize) / 2;\\n    const qrY = 276;\\n    ctx.fillStyle = \'#FFFFFF\';\\n    ctx.fillRect(qrX - 18, qrY - 18, qrSize + 36, qrSize + 36);\\n    ctx.drawImage(sourceCanvas, qrX, qrY, qrSize, qrSize);\\n\\n    ctx.fillStyle = \'#78716C\';\\n    ctx.font = \'400 14px \\\"DM Sans\\\", sans-serif\';\\n    ctx.fillText(\'For campus identity & faculty backup scan only\', W / 2, H - 46);\\n\\n    const link = document.createElement(\'a\');\\n    link.download = `${person.memberId || person.name.replace(/\\\\s+/g, \'_\')}-ID.png`;\\n    link.href = outCanvas.toDataURL(\'image/png\');\\n    link.click();\\n  };\\n\\n  const handlePrintCard = () => {\\n    const sourceCanvas = canvasWrapRef.current?.querySelector(\'canvas\');\\n    const qrDataUrl = sourceCanvas ? sourceCanvas.toDataURL(\'image/png\') : \'\';\\n    const printArea = document.createElement(\'div\');\\n    printArea.className = \'print-only fixed inset-0 bg-white flex items-center justify-center p-8 z-[999]\';\\n    printArea.innerHTML = `\\n      <div style=\\\"width:330px;border:1px solid #d6d3d1;border-radius:16px;overflow:hidden;font-family:\'DM Sans\',sans-serif;background:#fff;color:#1c1917;\\\">\\n        <div style=\\\"background:#C25E00;color:#fff;padding:16px;text-align:center;\\\">\\n          <div style=\\\"font-size:14px;font-weight:700;\\\">${org.name}</div>\\n          <div style=\\\"font-size:10px;opacity:0.9;margin-top:2px;letter-spacing:0.08em;\\\">DIGITAL IDENTITY CARD</div>\\n        </div>\\n        <div style=\\\"padding:20px;text-align:center;\\\">\\n          ${\\n            person.photoUrl\\n              ? `<img src=\\\"${person.photoUrl}\\\" style=\\\"width:76px;height:76px;border-radius:14px;object-fit:cover;margin:0 auto 12px;border:2px solid #e7e5e4;\\\" />`\\n              : \'\'\\n          }\\n          <div style=\\\"font-size:20px;font-weight:700;margin-bottom:4px;\\\">${person.name}</div>\\n          <div style=\\\"font-size:13px;color:#57534e;font-family:monospace;margin-bottom:8px;\\\">${person.memberId || \'\342\200\224\'} \302\267 ${roleLabel}</div>\\n          ${academicLine ? `<div style=\\\"font-size:12px;color:#57534e;margin-bottom:4px;\\\">${academicLine}</div>` : \'\'}\\n          ${person.departmentName ? `<div style=\\\"font-size:11px;color:#78716c;margin-bottom:10px;\\\">${person.departmentName}</div>` : \'\'}\\n          <img src=\\\"${qrDataUrl}\\\" style=\\\"width:190px;height:190px;margin:12px auto;display:block;\\\" alt=\\\"QR Code\\\" />\\n          <div style=\\\"font-size:11px;color:#78716c;margin-top:8px;\\\">Enrollment / Roll: ${enrollmentDisplay}</div>\\n          <div style=\\\"font-size:10px;color:#a8a29e;margin-top:10px;\\\">Campus identity card \302\267 Not valid for self-attendance</div>\\n        </div>\\n      </div>\\n    `;\\n    document.body.appendChild(printArea);\\n    window.print();\\n    document.body.removeChild(printArea);\\n  };\\n\\n  return (\\n    <div className=\\\"fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4 no-print\\\">\\n      <div className=\\\"w-full max-w-md rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 p-6 shadow-xl max-h-[92vh] overflow-y-auto\\\">\\n        <div className=\\\"flex items-center justify-between mb-4\\\">\\n          <h3 className=\\\"text-base font-semibold text-stone-900 dark:text-stone-100\\\">\\n            {t(\'qr.digitalIdTitle\')}\\n          </h3>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={onClose}\\n            aria-label={t(\'common.close\')}\\n            className=\\\"text-stone-400 hover:text-stone-700 dark:hover:text-stone-200 p-1\\\"\\n          >\\n            <X className=\\\"w-5 h-5\\\" />\\n          </button>\\n        </div>\\n\\n        {/* Official Digital Student ID Card Preview */}\\n        <div className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-[#FAF9F6] dark:bg-stone-950 overflow-hidden\\\">\\n          <div className=\\\"bg-[#C25E00] px-5 py-4 text-white flex items-center gap-3\\\">\\n            {org.logoUrl && (\\n              <img\\n                src={org.logoUrl}\\n                alt={org.name}\\n                className=\\\"w-10 h-10 rounded-xl object-cover bg-white/15 p-0.5 shrink-0\\\"\\n              />\\n            )}\\n            <div className=\\\"min-w-0 flex-1\\\">\\n              <p className=\\\"text-sm font-bold truncate\\\">{org.name}</p>\\n              <p className=\\\"text-[11px] uppercase tracking-wider text-white/85\\\">\\n                {t(\'qr.officialCardLabel\')}\\n              </p>\\n            </div>\\n          </div>\\n\\n          <div className=\\\"p-5\\\">\\n            <div className=\\\"flex items-center gap-4\\\">\\n              {person.photoUrl ? (\\n                <img\\n                  src={person.photoUrl}\\n                  alt={person.name}\\n                  className=\\\"w-16 h-16 rounded-xl object-cover border border-stone-200 dark:border-stone-700 shrink-0\\\"\\n                />\\n              ) : (\\n                <div className=\\\"w-16 h-16 rounded-xl bg-stone-200 dark:bg-stone-800 text-stone-700 dark:text-stone-200 flex items-center justify-center text-lg font-bold shrink-0\\\">\\n                  {getInitials(person.name)}\\n                </div>\\n              )}\\n              <div className=\\\"min-w-0 flex-1\\\">\\n                <h4 className=\\\"text-lg font-bold text-stone-900 dark:text-stone-100 truncate\\\">\\n                  {person.name}\\n                </h4>\\n                <p className=\\\"text-xs font-mono text-[#C25E00] font-semibold mt-0.5\\\">\\n                  {person.memberId || \'\342\200\224\'} \302\267 {roleLabel}\\n                </p>\\n                {academicLine && (\\n                  <p className=\\\"text-xs text-stone-600 dark:text-stone-400 mt-0.5 truncate\\\">\\n                    {academicLine}\\n                  </p>\\n                )}\\n              </div>\\n            </div>\\n\\n            <div className=\\\"mt-4 pt-3.5 border-t border-stone-200 dark:border-stone-800 grid grid-cols-2 gap-2.5 text-xs\\\">\\n              <div>\\n                <span className=\\\"text-stone-400 block\\\">{t(\'qr.enrollmentNo\')}</span>\\n                <span className=\\\"font-mono font-medium text-stone-800 dark:text-stone-200\\\">\\n                  {enrollmentDisplay}\\n                </span>\\n              </div>\\n              <div>\\n                <span className=\\\"text-stone-400 block\\\">{t(\'academics.department\')}</span>\\n                <span className=\\\"font-medium text-stone-800 dark:text-stone-200 truncate block\\\">\\n                  {person.departmentName || \'\342\200\224\'}\\n                </span>\\n              </div>\\n              {person.phone && (\\n                <div>\\n                  <span className=\\\"text-stone-400 block\\\">{t(\'common.phone\')}</span>\\n                  <span className=\\\"font-mono text-stone-700 dark:text-stone-300\\\">\\n                    {person.phone}\\n                  </span>\\n                </div>\\n              )}\\n              <div>\\n                <span className=\\\"text-stone-400 block\\\">{t(\'common.status\')}</span>\\n                <span className=\\\"font-medium text-emerald-700 dark:text-emerald-400 capitalize\\\">\\n                  {person.status}\\n                </span>\\n              </div>\\n            </div>\\n\\n            <div className=\\\"mt-4 flex flex-col items-center\\\">\\n              <div\\n                ref={canvasWrapRef}\\n                className=\\\"inline-flex items-center justify-center rounded-xl bg-white p-3.5 border border-stone-200\\\"\\n              >\\n                <QRCodeCanvas value={qrValue} size={172} level=\\\"M\\\" includeMargin={false} />\\n              </div>\\n              <p className=\\\"mt-2.5 text-[11px] text-stone-500 dark:text-stone-400 text-center flex items-center gap-1.5\\\">\\n                <ShieldAlert className=\\\"w-3.5 h-3.5 text-amber-600 shrink-0\\\" />\\n                <span>{t(\'qr.idCardSecurityNote\')}</span>\\n              </p>\\n            </div>\\n          </div>\\n        </div>\\n\\n        <div className=\\\"mt-5 grid grid-cols-3 gap-2\\\">\\n          <button\\n            type=\\\"button\\\"\\n            onClick={handleDownloadPDF}\\n            className=\\\"inline-flex items-center justify-center gap-1.5 rounded-xl bg-[#C25E00] hover:bg-[#A84F00] text-white px-3 py-2.5 text-xs font-medium transition-colors\\\"\\n          >\\n            <FileText className=\\\"w-4 h-4 shrink-0\\\" />\\n            <span>{t(\'qr.downloadPdf\')}</span>\\n          </button>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={handleDownloadPNG}\\n            className=\\\"inline-flex items-center justify-center gap-1.5 rounded-xl border border-stone-200 dark:border-stone-700 bg-white dark:bg-stone-800 text-stone-800 dark:text-stone-100 hover:bg-stone-50 dark:hover:bg-stone-700 px-3 py-2.5 text-xs font-medium transition-colors\\\"\\n          >\\n            <Download className=\\\"w-4 h-4 shrink-0\\\" />\\n            <span>PNG</span>\\n          </button>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={handlePrintCard}\\n            className=\\\"inline-flex items-center justify-center gap-1.5 rounded-xl border border-stone-200 dark:border-stone-700 bg-white dark:bg-stone-800 text-stone-800 dark:text-stone-100 hover:bg-stone-50 dark:hover:bg-stone-700 px-3 py-2.5 text-xs font-medium transition-colors\\\"\\n          >\\n            <Printer className=\\\"w-4 h-4 shrink-0\\\" />\\n            <span>{t(\'qr.printCard\')}</span>\\n          </button>\\n        </div>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Upgrade QRCardModal into a full Digital Student ID Card with PDF download, photo, academic metadata, and security notice\", \"Overwrite\":true, \"TargetFile\":\"/src/components/QRCardModal.tsx\", \"toolAction\":\"Updating QRCardModal.tsx\", \"toolSummary\":\"Update QRCardModal.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_13750254771015052997"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport { Link, useNavigate } from \'react-router-dom\';\\nimport { CheckCircle2 } from \'lucide-react\';\\nimport { useTranslation } from \'../hooks/useTranslation\';\\nimport { useToast } from \'../context/ToastContext\';\\nimport type { ManagerCodeLookup, OrgCodeLookup, OrgType } from \'../types\';\\nimport {\\n  createOrganizationAndAdmin,\\n  lookupManagerCode,\\n  lookupOrgCode,\\n} from \'../services/orgService\';\\nimport { registerParentAccount, selfRegisterUser } from \'../services/userService\';\\nimport { getFirebaseErrorKey, needsEnglishNameForId } from \'../utils/helpers\';\\nimport { Logo } from \'../components/Logo\';\\nimport { LanguageToggle } from \'../components/LanguageToggle\';\\nimport { ThemeToggle } from \'../components/ThemeToggle\';\\n\\nconst ORG_TYPES: OrgType[] = [\'College\', \'School\', \'Coaching\', \'Company\', \'Other\'];\\n\\nexport const RegisterPage: React.FC = () => {\\n  const { t, language } = useTranslation();\\n  const { showToast } = useToast();\\n  const navigate = useNavigate();\\n\\n  const [mode, setMode] = useState<\'create\' | \'join\'>(\'create\');\\n  const [error, setError] = useState(\'\');\\n  const [submitting, setSubmitting] = useState(false);\\n\\n  // Create Org fields\\n  const [orgName, setOrgName] = useState(\'\');\\n  const [orgType, setOrgType] = useState<OrgType>(\'College\');\\n  const [adminName, setAdminName] = useState(\'\');\\n  const [englishName, setEnglishName] = useState(\'\');\\n  const [phone, setPhone] = useState(\'\');\\n  const [email, setEmail] = useState(\'\');\\n  const [password, setPassword] = useState(\'\');\\n  const [confirmPassword, setConfirmPassword] = useState(\'\');\\n\\n  const showEnglishNameField = needsEnglishNameForId(adminName);\\n\\n  // Join Org fields\\n  const [joinRole, setJoinRole] = useState<\'manager\' | \'member\' | \'parent\'>(\'member\');\\n  const [joinCode, setJoinCode] = useState(\'\');\\n  const [verifyingCode, setVerifyingCode] = useState(false);\\n  const [verifiedOrg, setVerifiedOrg] = useState<OrgCodeLookup | null>(null);\\n  const [verifiedManager, setVerifiedManager] = useState<ManagerCodeLookup | null>(null);\\n  const [rollNumber, setRollNumber] = useState(\'\');\\n  const [studentMemberId, setStudentMemberId] = useState(\'\');\\n  const [relationship, setRelationship] = useState(\'Parent\');\\n\\n  const handleVerifyCode = async () => {\\n    setError(\'\');\\n    setVerifiedOrg(null);\\n    setVerifiedManager(null);\\n    if (!joinCode.trim()) {\\n      setError(t(\'errors.invalidCode\'));\\n      return;\\n    }\\n    setVerifyingCode(true);\\n    try {\\n      if (joinRole === \'manager\' || joinRole === \'parent\') {\\n        const res = await lookupOrgCode(joinCode);\\n        if (!res) {\\n          setError(t(\'errors.invalidCode\'));\\n        } else {\\n          setVerifiedOrg(res);\\n        }\\n      } else {\\n        const res = await lookupManagerCode(joinCode);\\n        if (!res) {\\n          setError(t(\'errors.invalidCode\'));\\n        } else {\\n          setVerifiedManager(res);\\n        }\\n      }\\n    } catch (err) {\\n      setError(t(getFirebaseErrorKey(err)));\\n    } finally {\\n      setVerifyingCode(false);\\n    }\\n  };\\n\\n  const handleCreateOrg = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    setError(\'\');\\n    if (password !== confirmPassword) {\\n      setError(t(\'errors.passwordMismatch\'));\\n      return;\\n    }\\n    if (password.length < 6) {\\n      setError(t(\'errors.weakPassword\'));\\n      return;\\n    }\\n    if (showEnglishNameField && needsEnglishNameForId(englishName)) {\\n      setError(t(\'errors.englishNameRequired\'));\\n      return;\\n    }\\n    setSubmitting(true);\\n    try {\\n      await createOrganizationAndAdmin({\\n        orgName,\\n        orgType,\\n        adminName,\\n        englishName: showEnglishNameField ? englishName.trim() : undefined,\\n        email,\\n        password,\\n        phone,\\n        language,\\n      });\\n      showToast(t(\'landing.step1Title\'), \'success\');\\n      navigate(\'/admin\', { replace: true });\\n    } catch (err) {\\n      setError(t(getFirebaseErrorKey(err)));\\n    } finally {\\n      setSubmitting(false);\\n    }\\n  };\\n\\n  const handleJoinOrg = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    setError(\'\');\\n\\n    if (password !== confirmPassword) {\\n      setError(t(\'errors.passwordMismatch\'));\\n      return;\\n    }\\n    if (password.length < 6) {\\n      setError(t(\'errors.weakPassword\'));\\n      return;\\n    }\\n    if (showEnglishNameField && needsEnglishNameForId(englishName)) {\\n      setError(t(\'errors.englishNameRequired\'));\\n      return;\\n    }\\n\\n    let orgLookup = verifiedOrg;\\n    let mgrLookup = verifiedManager;\\n\\n    setSubmitting(true);\\n    try {\\n      if ((joinRole === \'manager\' || joinRole === \'parent\') && !orgLookup) {\\n        orgLookup = await lookupOrgCode(joinCode);\\n        if (!orgLookup) {\\n          setError(t(\'errors.invalidCode\'));\\n          setSubmitting(false);\\n          return;\\n        }\\n      }\\n      if (joinRole === \'member\' && !mgrLookup) {\\n        mgrLookup = await lookupManagerCode(joinCode);\\n        if (!mgrLookup) {\\n          setError(t(\'errors.invalidCode\'));\\n          setSubmitting(false);\\n          return;\\n        }\\n      }\\n\\n      if (joinRole === \'parent\') {\\n        if (!studentMemberId.trim()) {\\n          setError(t(\'auth.studentIdRequired\'));\\n          setSubmitting(false);\\n          return;\\n        }\\n        await registerParentAccount({\\n          orgId: orgLookup!.orgId,\\n          name: adminName,\\n          englishName: showEnglishNameField ? englishName.trim() : undefined,\\n          email,\\n          password,\\n          phone,\\n          studentMemberId,\\n          relationship,\\n          language,\\n        });\\n        navigate(\'/pending\', { replace: true });\\n        return;\\n      }\\n\\n      await selfRegisterUser({\\n        role: joinRole,\\n        orgId: joinRole === \'manager\' ? orgLookup!.orgId : mgrLookup!.orgId,\\n        managerId: joinRole === \'member\' ? mgrLookup!.managerUid : null,\\n        parentNotifyUid: joinRole === \'member\' ? mgrLookup!.managerUid : null,\\n        name: adminName,\\n        englishName: showEnglishNameField ? englishName.trim() : undefined,\\n        email,\\n        password,\\n        phone,\\n        rollNumber,\\n        language,\\n      });\\n      navigate(\'/pending\', { replace: true });\\n    } catch (err) {\\n      if (err instanceof Error && err.message === \'STUDENT_NOT_FOUND\') {\\n        setError(t(\'auth.studentIdNotFound\'));\\n      } else {\\n        setError(t(getFirebaseErrorKey(err)));\\n      }\\n    } finally {\\n      setSubmitting(false);\\n    }\\n  };\\n\\n  return (\\n    <div className=\\\"min-h-screen bg-[#FAF9F6] dark:bg-[#0F0F11] flex flex-col\\\">\\n      <header className=\\\"max-w-6xl w-full mx-auto px-4 sm:px-6 h-16 flex items-center justify-between\\\">\\n        <Link to=\\\"/\\\">\\n          <Logo />\\n        </Link>\\n        <div className=\\\"flex items-center gap-2\\\">\\n          <LanguageToggle />\\n          <ThemeToggle />\\n        </div>\\n      </header>\\n\\n      <main className=\\\"flex-1 flex items-center justify-center px-4 py-10\\\">\\n        <div className=\\\"w-full max-w-lg rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-6 sm:p-8 shadow-xs\\\">\\n          <h1 className=\\\"text-2xl font-bold tracking-tight text-stone-900 dark:text-stone-100\\\">\\n            {t(\'auth.registerTitle\')}\\n          </h1>\\n          <p className=\\\"mt-1.5 text-sm text-stone-500 dark:text-stone-400\\\">\\n            {t(\'auth.registerSubtitle\')}\\n          </p>\\n\\n          {/* Segmented Mode Switch */}\\n          <div className=\\\"mt-6 grid grid-cols-2 gap-1 p-1 rounded-xl bg-stone-100 dark:bg-stone-900 border border-stone-200 dark:border-stone-800\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => {\\n                setMode(\'create\');\\n                setError(\'\');\\n              }}\\n              className={`py-2 text-sm font-medium rounded-lg transition-colors ${\\n                mode === \'create\'\\n                  ? \'bg-white dark:bg-stone-800 text-stone-900 dark:text-stone-100 shadow-xs\'\\n                  : \'text-stone-600 dark:text-stone-400\'\\n              }`}\\n            >\\n              {t(\'auth.tabCreateOrg\')}\\n            </button>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => {\\n                setMode(\'join\');\\n                setError(\'\');\\n              }}\\n              className={`py-2 text-sm font-medium rounded-lg transition-colors ${\\n                mode === \'join\'\\n                  ? \'bg-white dark:bg-stone-800 text-stone-900 dark:text-stone-100 shadow-xs\'\\n                  : \'text-stone-600 dark:text-stone-400\'\\n              }`}\\n            >\\n              {t(\'auth.tabJoinOrg\')}\\n            </button>\\n          </div>\\n\\n          {error && (\\n            <div\\n              role=\\\"alert\\\"\\n              className=\\\"mt-5 rounded-xl border border-red-200 dark:border-red-900 bg-red-50 dark:bg-red-950/40 px-4 py-3 text-sm text-red-700 dark:text-red-300\\\"\\n            >\\n              {error}\\n            </div>\\n          )}\\n\\n          {mode === \'create\' ? (\\n            <form onSubmit={handleCreateOrg} className=\\\"mt-6 space-y-4\\\">\\n              <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-4\\\">\\n                <div>\\n                  <label className=\\\"block text-sm font-medium text-stone-700 dark:text-stone-300 mb-1.5\\\">\\n                    {t(\'auth.orgNameLabel\')}\\n                  </label>\\n                  <input\\n                    type=\\\"text\\\"\\n                    required\\n                    placeholder={t(\'auth.orgNamePlaceholder\')}\\n                    value={orgName}\\n                    onChange={(e) => setOrgName(e.target.value)}\\n                    className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-transparent px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#C25E00]/30 focus:border-[#C25E00]\\\"\\n                  />\\n                </div>\\n                <div>\\n                  <label className=\\\"block text-sm font-medium text-stone-700 dark:text-stone-300 mb-1.5\\\">\\n                    {t(\'auth.orgTypeLabel\')}\\n                  </label>\\n                  <select\\n                    value={orgType}\\n                    onChange={(e) => setOrgType(e.target.value as OrgType)}\\n                    className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-900 px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#C25E00]/30 focus:border-[#C25E00]\\\"\\n                  >\\n                    {ORG_TYPES.map((type) => (\\n                      <option key={type} value={type}>\\n                        {t(`auth.orgTypes.${type}`)}\\n                      </option>\\n                    ))}\\n                  </select>\\n                </div>\\n              </div>\\n\\n              <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-4\\\">\\n                <div>\\n                  <label className=\\\"block text-sm font-medium text-stone-700 dark:text-stone-300 mb-1.5\\\">\\n                    {t(\'auth.yourNameLabel\')}\\n                  </label>\\n                  <input\\n                    type=\\\"text\\\"\\n                    required\\n                    value={adminName}\\n                    onChange={(e) => setAdminName(e.target.value)}\\n                    className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-transparent px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#C25E00]/30 focus:border-[#C25E00]\\\"\\n                  />\\n                </div>\\n                <div>\\n                  <label className=\\\"block text-sm font-medium text-stone-700 dark:text-stone-300 mb-1.5\\\">\\n                    {t(\'auth.phoneLabel\')}\\n                  </label>\\n                  <input\\n                    type=\\\"tel\\\"\\n                    value={phone}\\n                    onChange={(e) => setPhone(e.target.value)}\\n                    className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-transparent px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#C25E00]/30 focus:border-[#C25E00]\\\"\\n                  />\\n                </div>\\n              </div>\\n\\n              {showEnglishNameField && (\\n                <div>\\n                  <label className=\\\"block text-sm font-medium text-stone-700 dark:text-stone-300 mb-1.5\\\">\\n                    {t(\'common.englishNameLabel\')}\\n                  </label>\\n                  <input\\n                    type=\\\"text\\\"\\n                    required\\n                    value={englishName}\\n                    onChange={(e) => setEnglishName(e.target.value)}\\n                    placeholder=\\\"e.g. Pankaj Sharma\\\"\\n                    className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-transparent px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#C25E00]/30 focus:border-[#C25E00]\\\"\\n                  />\\n                  <p className=\\\"mt-1 text-xs text-stone-500 dark:text-stone-400\\\">\\n                    {t(\'common.englishNameHint\')}\\n                  </p>\\n                </div>\\n              )}\\n\\n              <div>\\n                <label className=\\\"block text-sm font-medium text-stone-700 dark:text-stone-300 mb-1.5\\\">\\n                  {t(\'auth.emailLabel\')}\\n                </label>\\n                <input\\n                  type=\\\"email\\\"\\n                  required\\n                  value={email}\\n                  onChange={(e) => setEmail(e.target.value)}\\n                  className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-transparent px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#C25E00]/30 focus:border-[#C25E00]\\\"\\n                />\\n              </div>\\n\\n              <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-4\\\">\\n                <div>\\n                  <label className=\\\"block text-sm font-medium text-stone-700 dark:text-stone-300 mb-1.5\\\">\\n                    {t(\'auth.passwordLabel\')}\\n                  </label>\\n                  <input\\n                    type=\\\"password\\\"\\n                    required\\n                    minLength={6}\\n                    value={password}\\n                    onChange={(e) => setPassword(e.target.value)}\\n                    className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-transparent px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#C25E00]/30 focus:border-[#C25E00]\\\"\\n                  />\\n                </div>\\n                <div>\\n                  <label className=\\\"block text-sm font-medium text-stone-700 dark:text-stone-300 mb-1.5\\\">\\n                    {t(\'auth.confirmPasswordLabel\')}\\n                  </label>\\n                  <input\\n                    type=\\\"password\\\"\\n                    required\\n                    minLength={6}\\n                    value={confirmPassword}\\n                    onChange={(e) => setConfirmPassword(e.target.value)}\\n                    className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-transparent px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#C25E00]/30 focus:border-[#C25E00]\\\"\\n                  />\\n                </div>\\n              </div>\\n\\n              <button\\n                type=\\\"submit\\\"\\n                disabled={submitting}\\n                className=\\\"w-full rounded-xl bg-[#C25E00] hover:bg-[#A84F00] disabled:opacity-60 text-white py-2.5 text-sm font-medium transition-colors\\\"\\n              >\\n                {submitting ? t(\'common.saving\') : t(\'auth.createOrgBtn\')}\\n              </button>\\n            </form>\\n          ) : (\\n            <form onSubmit={handleJoinOrg} className=\\\"mt-6 space-y-4\\\">\\n              <div>\\n                <label className=\\\"block text-sm font-medium text-stone-700 dark:text-stone-300 mb-1.5\\\">\\n                  {t(\'auth.joinAsLabel\')}\\n                </label>\\n                <div className=\\\"grid grid-cols-1 sm:grid-cols-3 gap-2\\\">\\n                  {(\\n                    [\\n                      { id: \'member\', label: t(\'auth.joinRoleMember\') },\\n                      { id: \'manager\', label: t(\'auth.joinRoleManager\') },\\n                      { id: \'parent\', label: t(\'auth.joinRoleParent\') },\\n                    ] as const\\n                  ).map((opt) => (\\n                    <button\\n                      key={opt.id}\\n                      type=\\\"button\\\"\\n                      onClick={() => {\\n                        setJoinRole(opt.id);\\n                        setVerifiedOrg(null);\\n                        setVerifiedManager(null);\\n                        setError(\'\');\\n                      }}\\n                      className={`rounded-xl border px-3 py-2.5 text-left text-xs font-medium transition-colors ${\\n                        joinRole === opt.id\\n                          ? \'border-[#C25E00] bg-amber-50/50 dark:bg-amber-950/20 text-stone-900 dark:text-stone-100\'\\n                          : \'border-stone-200 dark:border-stone-800 text-stone-600 dark:text-stone-400\'\\n                      }`}\\n                    >\\n                      {opt.label}\\n                    </button>\\n                  ))}\\n                </div>\\n              </div>\\n\\n              <div>\\n                <label className=\\\"block text-sm font-medium text-stone-700 dark:text-stone-300 mb-1.5\\\">\\n                  {joinRole === \'member\' ? t(\'auth.managerCodeLabel\') : t(\'auth.orgCodeLabel\')}\\n                </label>\\n                <div className=\\\"flex gap-2\\\">\\n                  <input\\n                    type=\\\"text\\\"\\n                    required\\n                    value={joinCode}\\n                    onChange={(e) => {\\n                      setJoinCode(e.target.value.toUpperCase());\\n                      setVerifiedOrg(null);\\n                      setVerifiedManager(null);\\n                    }}\\n                    placeholder=\\\"ABC123\\\"\\n                    className=\\\"flex-1 rounded-xl border border-stone-300 dark:border-stone-700 bg-transparent px-3.5 py-2.5 text-sm font-mono uppercase tracking-wider focus:outline-none focus:ring-2 focus:ring-[#C25E00]/30 focus:border-[#C25E00]\\\"\\n                  />\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={handleVerifyCode}\\n                    disabled={verifyingCode}\\n                    className=\\\"rounded-xl border border-stone-300 dark:border-stone-700 px-4 py-2.5 text-sm font-medium hover:bg-stone-50 dark:hover:bg-stone-800 whitespace-nowrap\\\"\\n                  >\\n                    {verifyingCode ? \'...\' : t(\'auth.verifyCodeBtn\')}\\n                  </button>\\n                </div>\\n\\n                {(verifiedOrg || verifiedManager) && (\\n                  <div className=\\\"mt-2.5 flex items-center gap-2 text-xs text-emerald-700 dark:text-emerald-400\\\">\\n                    <CheckCircle2 className=\\\"w-4 h-4 shrink-0\\\" />\\n                    <span>\\n                      {t(\'auth.joiningOrg\')}:{\' \'}\\n                      <strong>{verifiedOrg?.orgName || verifiedManager?.orgName}</strong>\\n                      {verifiedManager ? ` \302\267 ${t(\'auth.underManager\')}: ${verifiedManager.managerName}` : \'\'}\\n                    </span>\\n                  </div>\\n                )}\\n              </div>\\n\\n              {joinRole === \'parent\' && (\\n                <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-4\\\">\\n                  <div>\\n                    <label className=\\\"block text-sm font-medium text-stone-700 dark:text-stone-300 mb-1.5\\\">\\n                      {t(\'auth.childStudentIdLabel\')}\\n                    </label>\\n                    <input\\n                      type=\\\"text\\\"\\n                      required\\n                      maxLength={8}\\n                      value={studentMemberId}\\n                      onChange={(e) => setStudentMemberId(e.target.value.toUpperCase())}\\n                      placeholder=\\\"e.g. AAR482\\\"\\n                      className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-transparent px-3.5 py-2.5 text-sm font-mono uppercase tracking-wider focus:outline-none focus:ring-2 focus:ring-[#C25E00]/30 focus:border-[#C25E00]\\\"\\n                    />\\n                  </div>\\n                  <div>\\n                    <label className=\\\"block text-sm font-medium text-stone-700 dark:text-stone-300 mb-1.5\\\">\\n                      {t(\'auth.relationshipLabel\')}\\n                    </label>\\n                    <select\\n                      value={relationship}\\n                      onChange={(e) => setRelationship(e.target.value)}\\n                      className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-900 px-3.5 py-2.5 text-sm\\\"\\n                    >\\n                      <option value=\\\"Father\\\">Father</option>\\n                      <option value=\\\"Mother\\\">Mother</option>\\n                      <option value=\\\"Guardian\\\">Guardian</option>\\n                      <option value=\\\"Parent\\\">Parent</option>\\n                    </select>\\n                  </div>\\n                </div>\\n              )}\\n\\n              <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-4\\\">\\n                <div>\\n                  <label className=\\\"block text-sm font-medium text-stone-700 dark:text-stone-300 mb-1.5\\\">\\n                    {t(\'auth.yourNameLabel\')}\\n                  </label>\\n                  <input\\n                    type=\\\"text\\\"\\n                    required\\n                    value={adminName}\\n                    onChange={(e) => setAdminName(e.target.value)}\\n                    className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-transparent px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#C25E00]/30 focus:border-[#C25E00]\\\"\\n                  />\\n                </div>\\n                <div>\\n                  <label className=\\\"block text-sm font-medium text-stone-700 dark:text-stone-300 mb-1.5\\\">\\n                    {t(\'auth.phoneLabel\')}\\n                  </label>\\n                  <input\\n                    type=\\\"tel\\\"\\n                    value={phone}\\n                    onChange={(e) => setPhone(e.target.value)}\\n                    className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-transparent px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#C25E00]/30 focus:border-[#C25E00]\\\"\\n                  />\\n                </div>\\n              </div>\\n\\n              {showEnglishNameField && (\\n                <div>\\n                  <label className=\\\"block text-sm font-medium text-stone-700 dark:text-stone-300 mb-1.5\\\">\\n                    {t(\'common.englishNameLabel\')}\\n                  </label>\\n                  <input\\n                    type=\\\"text\\\"\\n                    required\\n                    value={englishName}\\n                    onChange={(e) => setEnglishName(e.target.value)}\\n                    placeholder=\\\"e.g. Rahul Verma\\\"\\n                    className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-transparent px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#C25E00]/30 focus:border-[#C25E00]\\\"\\n                  />\\n                  <p className=\\\"mt-1 text-xs text-stone-500 dark:text-stone-400\\\">\\n                    {t(\'common.englishNameHint\')}\\n                  </p>\\n                </div>\\n              )}\\n\\n              <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-4\\\">\\n                <div>\\n                  <label className=\\\"block text-sm font-medium text-stone-700 dark:text-stone-300 mb-1.5\\\">\\n                    {t(\'auth.emailLabel\')}\\n                  </label>\\n                  <input\\n                    type=\\\"email\\\"\\n                    required\\n                    value={email}\\n                    onChange={(e) => setEmail(e.target.value)}\\n                    className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-transparent px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#C25E00]/30 focus:border-[#C25E00]\\\"\\n                  />\\n                </div>\\n                {joinRole !== \'parent\' && (\\n                  <div>\\n                    <label className=\\\"block text-sm font-medium text-stone-700 dark:text-stone-300 mb-1.5\\\">\\n                      {t(\'common.rollNumber\')} ({t(\'common.optional\')})\\n                    </label>\\n                    <input\\n                      type=\\\"text\\\"\\n                      value={rollNumber}\\n                      onChange={(e) => setRollNumber(e.target.value)}\\n                      className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-transparent px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#C25E00]/30 focus:border-[#C25E00]\\\"\\n                    />\\n                  </div>\\n                )}\\n              </div>\\n\\n              <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-4\\\">\\n                <div>\\n                  <label className=\\\"block text-sm font-medium text-stone-700 dark:text-stone-300 mb-1.5\\\">\\n                    {t(\'auth.passwordLabel\')}\\n                  </label>\\n                  <input\\n                    type=\\\"password\\\"\\n                    required\\n                    minLength={6}\\n                    value={password}\\n                    onChange={(e) => setPassword(e.target.value)}\\n                    className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-transparent px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#C25E00]/30 focus:border-[#C25E00]\\\"\\n                  />\\n                </div>\\n                <div>\\n                  <label className=\\\"block text-sm font-medium text-stone-700 dark:text-stone-300 mb-1.5\\\">\\n                    {t(\'auth.confirmPasswordLabel\')}\\n                  </label>\\n                  <input\\n                    type=\\\"password\\\"\\n                    required\\n                    minLength={6}\\n                    value={confirmPassword}\\n                    onChange={(e) => setConfirmPassword(e.target.value)}\\n                    className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-transparent px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#C25E00]/30 focus:border-[#C25E00]\\\"\\n                  />\\n                </div>\\n              </div>\\n\\n              <button\\n                type=\\\"submit\\\"\\n                disabled={submitting}\\n                className=\\\"w-full rounded-xl bg-[#C25E00] hover:bg-[#A84F00] disabled:opacity-60 text-white py-2.5 text-sm font-medium transition-colors\\\"\\n              >\\n                {submitting ? t(\'common.saving\') : t(\'auth.joinBtn\')}\\n              </button>\\n            </form>\\n          )}\\n\\n          <p className=\\\"mt-6 text-center text-sm text-stone-500 dark:text-stone-400\\\">\\n            {t(\'auth.haveAccount\')}{\' \'}\\n            <Link to=\\\"/login\\\" className=\\\"font-medium text-[#C25E00] hover:underline\\\">\\n              {t(\'auth.signInLink\')}\\n            </Link>\\n          </p>\\n        </div>\\n      </main>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Add Parent registration option with Organization Code and Child Student ID to RegisterPage\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/RegisterPage.tsx\", \"toolAction\":\"Updating RegisterPage.tsx\", \"toolSummary\":\"Update RegisterPage.tsx\"}"
