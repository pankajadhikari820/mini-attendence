      thinking_signature: "\022\321\003\n\316\003\001i\024}\023\2530\375\217\002\343]\377\020\206h\036\316\204\310\334\0241\374\3452p\026\362\333\261\275\352o\231cM`\034\356\nf \275\333\206cIp\251\313a2\330h\233\r\247A?\247\033\263\f\216\231\215\a+T\214h\b(\0033\001\326-S\340q\315\232?\263P\215M\225\220g\273\250^\332\246_M\364O\213Y\"EL\000\233\233\037\326{v8\340\251G\326\t\315\250(\026Z\264\221e\233)Zu%\035.e\026\364{\212o\373\330\277\330\256S\375\032\022:\241\033\214\3614V\312G\344\203m\244\026\v-\333\205\216L\260P\267\377\324\342P\034\ndGK\016*\200\361r0\271\256,\255\260*\001]\226\353o\037{.93\255`\310N\314\rf\217\216m\322\257\371\354\367:\340\356\t\f\353\352N\257\242:\345\006 )\226\215b|e\f\333=\310\200@\212\324\226\2670\261\363\210\031\244kC\224:\037\336)\023\257ev{\030\314\274\212\003\232\022\vU\n\253\036i\024\253\305\206\303\360\240\257j6\317\376\276Q\350\363\361\347|u\307\212\244\022\266R%6\374\004j\256\025Us\306\344e\314\277\346\\<7Q\321\356dK\361\201y.s\230\027h\204z.\303x8\222\350-\317\223u/4L3\244\301\256pt\034\326U\241l\020\366\260P\274?<\257x\021 \323g\325\263^\275\tMow*\216\262\a\325Pq\035\374T\213`\251\205\346\210\311eI\006i\220G>IN(\200\216\262\231?W\177\036g\262\245\266N\210\n3T\357\232i?\226\023\374\201B\276W\352u\340\203?\320i\255c\361\v\213\215)|l\310\306\255I\230\335\350R"
