    end_line: 393
    content: "rules_version = \'2\';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    function isSignedIn() {\n      return request.auth != null;\n    }\n\n    function myUser() {\n      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;\n    }\n\n    function hasProfile() {\n      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));\n    }\n\n    function isActive() {\n      return hasProfile() && myUser().status == \'active\';\n    }\n\n    function isOrgAdmin(orgId) {\n      return isActive() && myUser().orgId == orgId && myUser().role == \'admin\';\n    }\n\n    function isOrgManager(orgId) {\n      return isActive() && myUser().orgId == orgId && myUser().role == \'manager\';\n    }\n\n    function inSameOrg(orgId) {\n      return hasProfile() && myUser().orgId == orgId;\n    }\n\n    function userImmutableFieldsUnchanged() {\n      return request.resource.data.role == resource.data.role\n        && request.resource.data.orgId == resource.data.orgId\n        && request.resource.data.status == resource.data.status\n        && request.resource.data.managerId == resource.data.managerId\n        && request.resource.data.memberId == resource.data.memberId\n        && request.resource.data.uid == resource.data.uid;\n    }\n\n    function isDirectChildOfSession(sess) {\n      return myUser().orgId == sess.orgId && (\n        (sess.ownerRole == \'admin\' && myUser().role == \'manager\') ||\n        (sess.ownerRole == \'manager\' && myUser().role == \'member\' && myUser().managerId == sess.ownerUid)\n      );\n    }\n\n    function flatEarthDistanceOk(sess, lat, lng) {\n      let dLat = (lat - sess.location.lat) * 111320.0;\n      let dLng = (lng - sess.location.lng) * 111320.0 * sess.location.cosLat;\n      let dist = math.sqrt(math.pow(dLat, 2) + math.pow(dLng, 2));\n      return dist <= sess.location.radius;\n    }\n\n    function liveSecretValid(secret, data) {\n      let within10s = secret.active == true\n        && secret.tokenUpdatedAt is timestamp\n        && request.time >= secret.tokenUpdatedAt\n        && request.time <= secret.tokenUpdatedAt + duration.value(10, \'s\');\n      return within10s && (\n        (data.method == \'live_qr\'\n          && \'submittedToken\' in data\n          && secret.token is string\n          && secret.token.size() >= 32\n          && data.submittedToken == secret.token)\n        ||\n        (data.method == \'live_code\'\n          && \'submittedCode\' in data\n          && secret.code is string\n          && secret.code.size() == 6\n          && data.submittedCode == secret.code)\n      );\n    }\n\n    // Globally unique 6-character user ID lookup (e.g. PAN482)\n    match /userIds/{userId} {\n      allow get: if isSignedIn();\n      allow list: if isSignedIn() && hasProfile() && myUser().role == \'admin\';\n      allow create: if isSignedIn()\n        && userId.matches(\'^[A-Z]{3}[0-9]{3}$\')\n        && !exists(/databases/$(database)/documents/userIds/$(userId));\n      allow update: if false;\n      allow delete: if isSignedIn() && (\n        isOrgAdmin(resource.data.orgId) ||\n        (isOrgManager(resource.data.orgId) && resource.data.role == \'member\')\n      );\n    }\n\n    // Public lookup tables for self-registration (get by exact code only, NO list)\n    match /orgCodes/{code} {\n      allow get: if true;\n      allow list: if false;\n      allow create: if isSignedIn();\n      allow update, delete: if isSignedIn() && isOrgAdmin(resource.data.orgId);\n    }\n\n    match /managerCodes/{code} {\n      allow get: if true;\n      allow list: if false;\n      allow create: if isSignedIn() && (\n        isOrgAdmin(request.resource.data.orgId) ||\n        (isOrgManager(request.resource.data.orgId) && request.resource.data.managerUid == request.auth.uid)\n      );\n      allow update, delete: if isSignedIn() && (\n        isOrgAdmin(resource.data.orgId) ||\n        resource.data.managerUid == request.auth.uid\n      );\n    }\n\n    // Public contact form messages (create-only for public)\n    match /messages/{msgId} {\n      allow create: if request.resource.data.keys().hasAll([\'name\', \'email\', \'message\'])\n        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120\n        && request.resource.data.email is string && request.resource.data.email.size() > 3 && request.resource.data.email.size() <= 180\n        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 2000;\n      allow read, update, delete: if false;\n    }\n\n    // Organizations\n    match /organizations/{orgId} {\n      allow read: if inSameOrg(orgId);\n      allow create: if isSignedIn() && request.resource.data.adminUid == request.auth.uid;\n      allow update: if isOrgAdmin(orgId)\n        || (isOrgManager(orgId)\n            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\'counters\']));\n      allow delete: if isOrgAdmin(orgId);\n    }\n\n    // Users\n    match /users/{uid} {\n      allow read: if isSignedIn() && (\n        request.auth.uid == uid\n        || (hasProfile() && myUser().role == \'admin\' && myUser().orgId == resource.data.orgId)\n        || (hasProfile() && myUser().role == \'manager\' && myUser().orgId == resource.data.orgId && (\n              resource.data.managerId == request.auth.uid || resource.data.role == \'admin\'\n           ))\n      );\n\n      allow create: if isSignedIn() && (\n        (request.auth.uid == uid && request.resource.data.uid == uid && request.resource.data.role == \'admin\' && request.resource.data.status == \'active\')\n        || (request.auth.uid == uid && request.resource.data.uid == uid && request.resource.data.status == \'pending\' && request.resource.data.role in [\'manager\', \'member\'])\n        || isOrgAdmin(request.resource.data.orgId)\n        || (isOrgManager(request.resource.data.orgId) && request.resource.data.role == \'member\' && request.resource.data.managerId == request.auth.uid)\n      );\n\n      allow update: if isSignedIn() && (\n        (request.auth.uid == uid && userImmutableFieldsUnchanged())\n        || isOrgAdmin(resource.data.orgId)\n        || (isOrgManager(resource.data.orgId)\n            && resource.data.role == \'member\'\n            && resource.data.managerId == request.auth.uid\n            && request.resource.data.role == \'member\'\n            && request.resource.data.orgId == resource.data.orgId\n            && request.resource.data.managerId == request.auth.uid)\n      );\n\n      allow delete: if isSignedIn() && (\n        isOrgAdmin(resource.data.orgId)\n        || (isOrgManager(resource.data.orgId) && resource.data.role == \'member\' && resource.data.managerId == request.auth.uid)\n      );\n    }\n\n    // Live Attendance Sessions (public metadata for owner & direct children only)\n    match /sessions/{sessionId} {\n      allow read: if isActive() && myUser().orgId == resource.data.orgId && (\n        myUser().role == \'admin\'\n        || resource.data.ownerUid == request.auth.uid\n        || isDirectChildOfSession(resource.data)\n      );\n\n      allow create: if isActive()\n        && request.resource.data.orgId == myUser().orgId\n        && request.resource.data.ownerUid == request.auth.uid\n        && request.resource.data.ownerRole == myUser().role\n        && myUser().role in [\'admin\', \'manager\']\n        && request.resource.data.status == \'open\';\n\n      allow update: if isActive() && resource.data.orgId == myUser().orgId && (\n        resource.data.ownerUid == request.auth.uid\n        || isOrgAdmin(resource.data.orgId)\n      );\n\n      allow delete: if isActive() && resource.data.orgId == myUser().orgId && (\n        resource.data.ownerUid == request.auth.uid\n        || isOrgAdmin(resource.data.orgId)\n      );\n    }\n\n    // Session Secrets: STRICTLY owner-only. Members/scanners can NEVER read or write.\n    match /sessionSecrets/{sessionId} {\n      allow read: if isActive() && resource.data.ownerUid == request.auth.uid;\n      allow create: if isActive()\n        && request.resource.data.ownerUid == request.auth.uid\n        && request.resource.data.orgId == myUser().orgId\n        && myUser().role in [\'admin\', \'manager\']\n        && request.resource.data.tokenUpdatedAt == request.time;\n      allow update: if isActive()\n        && resource.data.ownerUid == request.auth.uid\n        && request.resource.data.ownerUid == resource.data.ownerUid\n        && request.resource.data.orgId == resource.data.orgId\n        && request.resource.data.tokenUpdatedAt == request.time;\n      allow delete: if isActive() && resource.data.ownerUid == request.auth.uid;\n    }\n\n    // One device = one person per session (write-once per sessionId_deviceId)\n    match /sessionDevices/{deviceDocId} {\n      allow get: if isActive() && (resource == null || resource.data.orgId == myUser().orgId);\n      allow list: if isActive() && (myUser().role == \'admin\' || myUser().role == \'manager\');\n      allow create: if isActive()\n        && request.resource.data.orgId == myUser().orgId\n        && request.resource.data.personUid == request.auth.uid\n        && deviceDocId == request.resource.data.sessionId + \'_\' + request.resource.data.deviceId\n        && !exists(/databases/$(database)/documents/sessionDevices/$(deviceDocId));\n      allow update: if false;\n      allow delete: if isOrgAdmin(resource.data.orgId);\n    }\n\n    // Failed attendance attempts log (owner sees rejected attempts on session screen)\n    match /attempts/{attemptId} {\n      allow read: if isActive() && resource.data.orgId == myUser().orgId && (\n        myUser().role == \'admin\'\n        || resource.data.ownerUid == request.auth.uid\n      );\n      allow create: if isActive()\n        && request.resource.data.orgId == myUser().orgId\n        && request.resource.data.personUid == request.auth.uid;\n      allow update: if false;\n      allow delete: if isOrgAdmin(resource.data.orgId);\n    }\n\n    function canSelfMarkAttendance(recordId) {\n      let sid = request.resource.data.sessionId;\n      let sess = get(/databases/$(database)/documents/sessions/$(sid)).data;\n      let secret = get(/databases/$(database)/documents/sessionSecrets/$(sid)).data;\n      let devDocId = sid + \'_\' + request.resource.data.deviceId;\n      return request.resource.data.method in [\'live_qr\', \'live_code\']\n        && request.resource.data.personUid == request.auth.uid\n        && recordId == request.resource.data.orgId + \'_\' + request.resource.data.date + \'_\' + request.auth.uid\n        && !exists(/databases/$(database)/documents/attendance/$(recordId))\n        && request.resource.data.timestamp == request.time\n        && sid is string\n        && request.resource.data.deviceId is string\n        && exists(/databases/$(database)/documents/sessions/$(sid))\n        && exists(/databases/$(database)/documents/sessionSecrets/$(sid))\n        && sess.orgId == request.resource.data.orgId\n        && secret.orgId == sess.orgId\n        && secret.ownerUid == sess.ownerUid\n        && sess.status == \'open\'\n        && request.time <= sess.endsAt\n        && isDirectChildOfSession(sess)\n        && liveSecretValid(secret, request.resource.data)\n        && (\n          !sess.locationCheckEnabled\n          || (\n            request.resource.data.lat is number\n            && request.resource.data.lng is number\n            && flatEarthDistanceOk(sess, request.resource.data.lat, request.resource.data.lng)\n          )\n        )\n        && existsAfter(/databases/$(database)/documents/sessionDevices/$(devDocId))\n        && getAfter(/databases/$(database)/documents/sessionDevices/$(devDocId)).data.personUid == request.auth.uid;\n    }\n\n    // Attendance: deterministic ID {orgId}_{date}_{personUid}\n    match /attendance/{recordId} {\n      allow get: if isSignedIn() && hasProfile() && (\n        resource == null\n        || (myUser().role == \'admin\' && myUser().orgId == resource.data.orgId)\n        || (myUser().role == \'manager\' && myUser().orgId == resource.data.orgId && (\n              resource.data.managerId == request.auth.uid || resource.data.personUid == request.auth.uid\n           ))\n        || (myUser().role == \'member\' && resource.data.personUid == request.auth.uid)\n      );\n\n      allow list: if isSignedIn() && hasProfile() && (\n        (myUser().role == \'admin\' && myUser().orgId == resource.data.orgId)\n        || (myUser().role == \'manager\' && myUser().orgId == resource.data.orgId && (\n              resource.data.managerId == request.auth.uid || resource.data.personUid == request.auth.uid\n           ))\n        || (myUser().role == \'member\' && resource.data.personUid == request.auth.uid)\n      );\n\n      // Two valid create paths:\n      // 1) Self-marking via live rotating QR (\"live_qr\") or live 6-digit code (\"live_code\")\n      // 2) Backup manual / ID-card marking by direct parent (Admin -> Manager, Manager -> own Member)\n      allow create: if isActive()\n        && request.resource.data.orgId == myUser().orgId\n        && request.resource.data.status in [\'present\', \'absent\', \'late\', \'leave\']\n        && (\n          (\n            request.resource.data.method in [\'live_qr\', \'live_code\']\n            && \'sessionId\' in request.resource.data\n            && \'deviceId\' in request.resource.data\n            && canSelfMarkAttendance(recordId)\n          )\n          ||\n          (\n            request.resource.data.method in [\'qr\', \'manual\']\n            && exists(/databases/$(database)/documents/users/$(request.resource.data.personUid))\n            && get(/databases/$(database)/documents/users/$(request.resource.data.personUid)).data.orgId == myUser().orgId\n            && get(/databases/$(database)/documents/users/$(request.resource.data.personUid)).data.status == \'active\'\n            && (\n              (myUser().role == \'admin\' && (\n                get(/databases/$(database)/documents/users/$(request.resource.data.personUid)).data.role == \'manager\'\n                || request.resource.data.isDemo == true\n              ))\n              || (myUser().role == \'manager\'\n                  && get(/databases/$(database)/documents/users/$(request.resource.data.personUid)).data.role == \'member\'\n                  && get(/databases/$(database)/documents/users/$(request.resource.data.personUid)).data.managerId == request.auth.uid)\n            )\n          )\n        );\n\n      allow update: if isActive()\n        && resource.data.orgId == myUser().orgId\n        && request.resource.data.orgId == resource.data.orgId\n        && request.resource.data.personUid == resource.data.personUid\n        && request.resource.data.status in [\'present\', \'absent\', \'late\', \'leave\']\n        && (\n          myUser().role == \'admin\'\n          || (myUser().role == \'manager\' && resource.data.managerId == request.auth.uid)\n        );\n\n      allow delete: if isOrgAdmin(resource.data.orgId);\n    }\n\n    // Leave Requests\n    match /leaves/{leaveId} {\n      allow read: if isSignedIn() && hasProfile() && (\n        (myUser().role == \'admin\' && myUser().orgId == resource.data.orgId)\n        || resource.data.personUid == request.auth.uid\n        || resource.data.toUid == request.auth.uid\n      );\n\n      allow create: if isActive()\n        && request.resource.data.orgId == myUser().orgId\n        && (\n          (request.resource.data.personUid == request.auth.uid && request.resource.data.status == \'pending\')\n          || (myUser().role == \'admin\' && request.resource.data.isDemo == true)\n        );\n\n      allow update: if isActive()\n        && resource.data.orgId == myUser().orgId\n        && (\n          myUser().role == \'admin\'\n          || resource.data.toUid == request.auth.uid\n        );\n\n      allow delete: if isOrgAdmin(resource.data.orgId) || resource.data.personUid == request.auth.uid;\n    }\n\n    // Announcements\n    match /announcements/{annId} {\n      allow read: if isActive() && myUser().orgId == resource.data.orgId && (\n        myUser().role == \'admin\'\n        || resource.data.audience == \'all\'\n        || (myUser().role == \'manager\' && (resource.data.audience == \'managers\' || resource.data.fromUid == request.auth.uid))\n        || (myUser().role == \'member\' && resource.data.audience == \'members\' && (resource.data.managerId == null || resource.data.managerId == myUser().managerId))\n      );\n\n      allow create: if isActive()\n        && request.resource.data.orgId == myUser().orgId\n        && (myUser().role == \'admin\' || myUser().role == \'manager\');\n\n      allow update, delete: if isActive()\n        && resource.data.orgId == myUser().orgId\n        && (myUser().role == \'admin\' || resource.data.fromUid == request.auth.uid);\n    }\n\n    // Notifications\n    match /notifications/{notifId} {\n      allow read: if isSignedIn() && (\n        resource.data.toUid == request.auth.uid\n        || isOrgAdmin(resource.data.orgId)\n      );\n\n      allow create: if isSignedIn() && (\n        hasProfile() && myUser().orgId == request.resource.data.orgId\n      );\n\n      allow update: if isSignedIn() && (\n        (resource.data.toUid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\'read\']))\n        || isOrgAdmin(resource.data.orgId)\n      );\n\n      allow delete: if isSignedIn() && (\n        resource.data.toUid == request.auth.uid\n        || isOrgAdmin(resource.data.orgId)\n      );\n    }\n  }\n}\n"
