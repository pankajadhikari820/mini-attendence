            lines {
              text: "    \"heroTitle\": \"Attendance in one scan.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    \"heroSubtitle\": \"A calm, reliable QR attendance system for colleges, schools, coaching institutes, and teams. Works right in the browser.\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    \"ctaStart\": \"Sign up\","
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
