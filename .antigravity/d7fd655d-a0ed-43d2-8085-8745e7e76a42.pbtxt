      thinking_signature: "\022\377\004\n\374\004\001i\024}\023\'Xj\341x\3367\363\225z7\270Ht)\337\b\241\206\303\r\315z\034z*\255|k5\274e\230\275\034\346\226eq\326H\273O}XXl\031\346Z}\214\371\2137a`\302\002\243\271pIg\231\200C\355\225\362\257\347\226)99+\270\257~\3113\\\330\353W\216\254;\016\n\343\222P\204i\221\232\003Y\370\240\206\374\306\321\370\rx\021P\205\227\212\2438L\305\206\257I\374(f\321\332\034\017\315\312\237J\254BiCN\az\003\021\302g\300\273\346\273s\210\255\364\375\224\001\004\242\023\016(\351\v<\031m?\371\374X\200H\372\236C\230\023\360\214?4\3709\226Z)/\233\270O}\272\320\2436+\316k\252\242x\261@\365\336\305\351y\006_\021\263\374\361\214y]\361\211\367Es\310s\000_\003hV\f\177\222\362\n\271J#_\353\03517$\306W\300\241\342Q\260\377pS\t\235\273\227T\330_\233o\301\255\262\253\374\206v;?!n\021\344#\027\334\274\263\ba\271\341\3033\324D\341P\004\251S{\207+\317{\313Q\361[\326\316!pl\375<\201\222\2052\235K\307\342i\320\317\240\177\232\246\027\336\223\222\315.l\342\225\t\234\243W\246K\270\022\031\317\022\353\337v\\\241\f\020\247\032)\255t \341m\305\200\b\254\004\355\206\356\201i\n\021^\035\004V\315\242\272.\v\234\242\a\346Zr\252=o*\306\304\216\\\001\314z\362\'\241\022\216\307\352Gv\004\275\312|\352\333\260\274\201\277\311\355\2142\200%\306\245\213\253T\3028\006eQ\310\276\331\033\365?B\254\320\rJ\315\030h\226\312\002\230\331|\301-\233E6\210\317\300J\n\237\323R\322Y\b\022\320\n\000\275_\205\305 3/\231\337!\206\271\337\263\376\r\314\253\261\331|M\n!\307:\324|\335\210@\243*sE\247\341\030?\352l\0164\2463\177\341\310\"\221\bmc\345\317(CZ\000\342\310\310\227\337\364W\331\360\307\256<\275\373\303\211\313\303\032\016\300\310R\006\252\330_\364;\035\032J\272Z\234JHw\360\323i>\216M\367\256/]~]i\251\236\272\035H\374\025\304\315*\021)d\302\366\250\260\205h\233+sA\357\241\341\217\312\3745\245\"\271j\020\335k\262j\322\2756\031W\252(\347\\\340}_"
