            lines {
              text: "  - Rotating secrets stored in `sessionSecrets/{sessionId}` (strictly readable/writable only by the session starter, verified server-side by Firestore Security Rules)."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
