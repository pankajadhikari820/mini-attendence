      name: "multi_replace_file_content"
      arguments_json: "{\"Description\":\"Enforce strict 10-second server-side QR token expiration and active secret checks in firestore.rules\", \"Instruction\":\"Update liveSecretValid, sessionSecrets rules, and canSelfMarkAttendance in firestore.rules so only the currently active token is valid for strictly 10 seconds on the Firestore server clock and previous/stopped tokens are immediately rejected.\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":70, \"ReplacementContent\":\"    function liveSecretValid(secret, data) {\\n      let within10s = secret.active == true\\n        && secret.tokenUpdatedAt is timestamp\\n        && request.time >= secret.tokenUpdatedAt\\n        && request.time <= secret.tokenUpdatedAt + duration.value(10, \'s\');\\n      return within10s && (\\n        (data.method == \'live_qr\'\\n          && \'submittedToken\' in data\\n          && secret.token is string\\n          && secret.token.size() >= 32\\n          && data.submittedToken == secret.token)\\n        ||\\n        (data.method == \'live_code\'\\n          && \'submittedCode\' in data\\n          && secret.code is string\\n          && secret.code.size() == 6\\n          && data.submittedCode == secret.code)\\n      );\\n    }\", \"StartLine\":56, \"TargetContent\":\"    function liveSecretValid(secret, data) {\\n      let withinCurrent = request.time <= secret.tokenUpdatedAt + duration.value(15, \'s\');\\n      let withinPrev = request.time <= secret.tokenUpdatedAt + duration.value(5, \'s\');\\n      return (\\n        (data.method == \'live_qr\' && \'submittedToken\' in data && (\\n          (data.submittedToken == secret.token && withinCurrent) ||\\n          (secret.prevToken != \'\' && data.submittedToken == secret.prevToken && withinPrev)\\n        )) ||\\n        (data.method == \'live_code\' && \'submittedCode\' in data && (\\n          (data.submittedCode == secret.code && withinCurrent) ||\\n          (secret.prevCode != \'\' && data.submittedCode == secret.prevCode && withinPrev)\\n        ))\\n      );\\n    }\"}, {\"AllowMultiple\":false, \"EndLine\":194, \"ReplacementContent\":\"    // Session Secrets: STRICTLY owner-only. Members/scanners can NEVER read or write.\\n    match /sessionSecrets/{sessionId} {\\n      allow read: if isActive() && resource.data.ownerUid == request.auth.uid;\\n      allow create: if isActive()\\n        && request.resource.data.ownerUid == request.auth.uid\\n        && request.resource.data.orgId == myUser().orgId\\n        && myUser().role in [\'admin\', \'manager\']\\n        && request.resource.data.tokenUpdatedAt == request.time;\\n      allow update: if isActive()\\n        && resource.data.ownerUid == request.auth.uid\\n        && request.resource.data.ownerUid == resource.data.ownerUid\\n        && request.resource.data.orgId == resource.data.orgId\\n        && request.resource.data.tokenUpdatedAt == request.time;\\n      allow delete: if isActive() && resource.data.ownerUid == request.auth.uid;\\n    }\", \"StartLine\":185, \"TargetContent\":\"    // Session Secrets: STRICTLY owner-only. Members/children can NEVER read or write.\\n    match /sessionSecrets/{sessionId} {\\n      allow read: if isActive() && resource.data.ownerUid == request.auth.uid;\\n      allow create: if isActive()\\n        && request.resource.data.ownerUid == request.auth.uid\\n        && request.resource.data.orgId == myUser().orgId\\n        && myUser().role in [\'admin\', \'manager\'];\\n      allow update, delete: if isActive() && resource.data.ownerUid == request.auth.uid;\\n    }\"}, {\"AllowMultiple\":false, \"EndLine\":250, \"ReplacementContent\":\"    function canSelfMarkAttendance(recordId) {\\n      let sid = request.resource.data.sessionId;\\n      let sess = get(/databases/$(database)/documents/sessions/$(sid)).data;\\n      let secret = get(/databases/$(database)/documents/sessionSecrets/$(sid)).data;\\n      let devDocId = sid + \'_\' + request.resource.data.deviceId;\\n      return request.resource.data.method in [\'live_qr\', \'live_code\']\\n        && request.resource.data.personUid == request.auth.uid\\n        && recordId == request.resource.data.orgId + \'_\' + request.resource.data.date + \'_\' + request.auth.uid\\n        && !exists(/databases/$(database)/documents/attendance/$(recordId))\\n        && request.resource.data.timestamp == request.time\\n        && sid is string\\n        && request.resource.data.deviceId is string\\n        && exists(/databases/$(database)/documents/sessions/$(sid))\\n        && exists(/databases/$(database)/documents/sessionSecrets/$(sid))\\n        && sess.orgId == request.resource.data.orgId\\n        && secret.orgId == sess.orgId\\n        && secret.ownerUid == sess.ownerUid\\n        && sess.status == \'open\'\\n        && request.time <= sess.endsAt\\n        && isDirectChildOfSession(sess)\\n        && liveSecretValid(secret, request.resource.data)\\n        && (\\n          !sess.locationCheckEnabled\\n          || (\\n            request.resource.data.lat is number\\n            && request.resource.data.lng is number\\n            && flatEarthDistanceOk(sess, request.resource.data.lat, request.resource.data.lng)\\n          )\\n        )\\n        && existsAfter(/databases/$(database)/documents/sessionDevices/$(devDocId))\\n        && getAfter(/databases/$(database)/documents/sessionDevices/$(devDocId)).data.personUid == request.auth.uid;\\n    }\", \"StartLine\":221, \"TargetContent\":\"    function canSelfMarkAttendance(recordId) {\\n      let sid = request.resource.data.sessionId;\\n      let sess = get(/databases/$(database)/documents/sessions/$(sid)).data;\\n      let secret = get(/databases/$(database)/documents/sessionSecrets/$(sid)).data;\\n      let devDocId = sid + \'_\' + request.resource.data.deviceId;\\n      return request.resource.data.method in [\'live_qr\', \'live_code\']\\n        && request.resource.data.personUid == request.auth.uid\\n        && recordId == request.resource.data.orgId + \'_\' + request.resource.data.date + \'_\' + request.auth.uid\\n        && request.resource.data.timestamp == request.time\\n        && sid is string\\n        && request.resource.data.deviceId is string\\n        && exists(/databases/$(database)/documents/sessions/$(sid))\\n        && exists(/databases/$(database)/documents/sessionSecrets/$(sid))\\n        && sess.status == \'open\'\\n        && request.time <= sess.endsAt\\n        && isDirectChildOfSession(sess)\\n        && liveSecretValid(secret, request.resource.data)\\n        && (\\n          !sess.locationCheckEnabled\\n          || (\\n            request.resource.data.lat is number\\n            && request.resource.data.lng is number\\n            && flatEarthDistanceOk(sess, request.resource.data.lat, request.resource.data.lng)\\n          )\\n        )\\n        && existsAfter(/databases/$(database)/documents/sessionDevices/$(devDocId))\\n        && getAfter(/databases/$(database)/documents/sessionDevices/$(devDocId)).data.personUid == request.auth.uid;\\n    }\"}], \"TargetFile\":\"/firestore.rules\", \"toolAction\":\"Tightening Firestore rules to strict 10s QR expiry\", \"toolSummary\":\"Update firestore.rules\"}"
      thinking_signature: "\022\314]\n\311]\001i\024}\023C\316\256o,\267\037\275%\002\212k\234\215LR\177W\n\357\"\261\265\035\v:\241\305\t\211O9\\\023#\255/k\345\251P!=\020t\263\266\177\036\035\"k\000\203{\205\347\303\r\"\320\346`\035\001\2008\353\363\201\215i\t\001\264w\273\333w\345]\347\360G[y\274\331#\344\300TN\334\3144\203\374dk\333\207\177\221\031m\217\003\255\204\n\023\3273\224\357\355C\301\005\342/K\303\270\252m\002f}\316=\r\035\217$+$\276z\005C\364:\3677\027\027h\256\210\207E\243R\t:\272\336\222\325\346\217\251\206\347~=\255=p\a\364\253\325\201_ZJ\1771+\372YS\033}\364.\333\326\312\f\031\332(\367\254\266J\346\022\216\367\225\343r<Q\227\224;\213\327/o~\361\244B\",0\310\t~\343TD\004\202?\361F\212\277\325\342B\325\016\023R1\251*\311\330\242\260\313 e\205 \213[\327\344l\205\340\243\267\326\032=\323Y\236\235\265D\v\221 -\202\305\"\201b\232*\340\356\341\026\341\241\004[\250d\214{\315HJ\250\303\307\002\235\305\371\276&=\271J\217d\'q&\342\264\302\0361\350\031\032?\023\0041\362NW\237\232\332q\022\212\255\272\344\367\3169\207\323\2544\306\315@X\227\031\321U\243\356\341\254\213\305\337Y\341\211\361\360\233G|(\366\325\300\206\315V\232%\212\031\312\'\364/\n-\214\30674\372\227T\000xR\362~d9G\t\2751\356\235#PF\3509[\361\0046\201O\"\211\260\000v\370\232\\\\D\304\351\336f\224\274;c\311\355\362x\241?\031~\231Z\335,\b\247\022\354\r\217\320\027\335\335\271\024\226=j\210\371\314\367\000\235\322X\202\361\371\241]\265\2653\220\017M\366\252\300\376,:T\277Q\312\024\332\311\367$}n\200\255\360\371Zt\031p\226]\344\250B\352\210^<\324\361\342\234!sv;[\222\307\f3\330\0315q\247\263d\374\236\340YQ\006o\362\246pv~\257\3010}\320D_L\253-\271\251\211\005HR\303\360\367b&E;\254\241\227\027\"%,x\247\033\r\031\335M\036\031\254F8\027\255\261\017\314X\214L\256dXe\214D\310G(\361\t\031H\264\366\210%\331\'\025Z\217e\215eA5\253\001*Q\0167n\253\335\335\264\363\216\333\al\317H\200\202#Z\177z\342\364\264\374\'*!\374G\236\321(\301\203N\300\316\224\a\322V}\237\032&\361\2504\375\231\255\300\230\211l\\\377\223\2