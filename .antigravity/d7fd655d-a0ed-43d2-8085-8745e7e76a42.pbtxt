    tool_calls {
      id: "call_5304874119093863969"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { createUserWithEmailAndPassword } from \'firebase/auth\';\\nimport {\\n  addDoc,\\n  collection,\\n  deleteDoc,\\n  doc,\\n  getDoc,\\n  getDocs,\\n  query,\\n  runTransaction,\\n  serverTimestamp,\\n  setDoc,\\n  updateDoc,\\n  where,\\n} from \'firebase/firestore\';\\nimport { auth, createSecondaryAccount, db } from \'../firebase\';\\nimport type { LanguageCode, Organization, UserProfile, UserRole, UserStatus } from \'../types\';\\nimport {\\n  extractIdPrefixFromName,\\n  generateCandidateUserId,\\n  generateCode,\\n} from \'../utils/helpers\';\\nimport { recordAuditLog } from \'./auditService\';\\nimport { createNotification } from \'./communicationService\';\\n\\nexport async function generateUniqueManagerCode(): Promise<string> {\\n  for (let attempt = 0; attempt < 10; attempt++) {\\n    const code = generateCode(6);\\n    const snap = await getDoc(doc(db, \'managerCodes\', code));\\n    if (!snap.exists()) return code;\\n  }\\n  return generateCode(8);\\n}\\n\\nconst ALPHABET = \'ABCDEFGHIJKLMNOPQRSTUVWXYZ\';\\n\\nexport async function lookupUserId(code: string): Promise<{\\n  uid: string;\\n  orgId: string;\\n  role: UserRole;\\n} | null> {\\n  const clean = code.trim().toUpperCase();\\n  if (!clean) return null;\\n  const snap = await getDoc(doc(db, \'userIds\', clean));\\n  if (!snap.exists()) return null;\\n  const data = snap.data() as { uid: string; orgId: string; role: UserRole };\\n  return data;\\n}\\n\\n/**\\n * Atomically reserves a globally unique 6-character ID (e.g. PAN482)\\n * using a Firestore transaction on the `userIds/{ID}` lookup collection.\\n */\\nexport async function allocateUniqueUserId(params: {\\n  nameForId: string;\\n  uid: string;\\n  orgId: string;\\n  role: UserRole;\\n  isDemo?: boolean;\\n}): Promise<string> {\\n  const basePrefix = extractIdPrefixFromName(params.nameForId);\\n  const firstTwo = basePrefix.slice(0, 2);\\n  const startThirdIdx = Math.max(0, ALPHABET.indexOf(basePrefix[2] || \'X\'));\\n\\n  for (let letterStep = 0; letterStep < 26; letterStep++) {\\n    const thirdChar = ALPHABET[(startThirdIdx + letterStep) % 26];\\n    const prefix = `${firstTwo}${thirdChar}`;\\n\\n    for (let attempt = 0; attempt < 30; attempt++) {\\n      const candidate = generateCandidateUserId(prefix);\\n      const idRef = doc(db, \'userIds\', candidate);\\n      try {\\n        const reserved = await runTransaction(db, async (tx) => {\\n          const snap = await tx.get(idRef);\\n          if (snap.exists()) return false;\\n          tx.set(idRef, {\\n            uid: params.uid,\\n            orgId: params.orgId,\\n            role: params.role,\\n            ...(params.isDemo ? { isDemo: true } : {}),\\n            createdAt: serverTimestamp(),\\n          });\\n          return true;\\n        });\\n        if (reserved) return candidate;\\n      } catch {\\n        // Collision or transaction retry contention \342\200\224 try next candidate\\n      }\\n    }\\n  }\\n\\n  throw new Error(\'Could not allocate unique 6-character ID\');\\n}\\n\\n/**\\n * Directly adds a Manager/Teacher, Student/Member, or Parent.\\n * Uses the secondary Firebase Auth instance so the current user stays signed in.\\n */\\nexport async function addPersonDirect(params: {\\n  org: Organization;\\n  role: \'manager\' | \'member\' | \'parent\';\\n  managerId: string | null;\\n  name: string;\\n  englishName?: string;\\n  email: string;\\n  phone: string;\\n  rollNumber?: string;\\n  enrollmentNumber?: string;\\n  classId?: string | null;\\n  className?: string;\\n  departmentId?: string | null;\\n  departmentName?: string;\\n  courseName?: string;\\n  semester?: string;\\n  section?: string;\\n  photoUrl?: string;\\n  language?: LanguageCode;\\n  actor?: UserProfile | null;\\n}): Promise<{ profile: UserProfile; resetEmailSent: boolean }> {\\n  const cleanEmail = params.email.trim().toLowerCase();\\n  const { uid, resetEmailSent } = await createSecondaryAccount(cleanEmail);\\n\\n  const memberId = await allocateUniqueUserId({\\n    nameForId: params.englishName?.trim() || params.name,\\n    uid,\\n    orgId: params.org.id,\\n    role: params.role,\\n  });\\n\\n  let managerCode: string | undefined;\\n  if (params.role === \'manager\') {\\n    managerCode = await generateUniqueManagerCode();\\n    await setDoc(doc(db, \'managerCodes\', managerCode), {\\n      orgId: params.org.id,\\n      managerUid: uid,\\n      managerName: params.name.trim(),\\n      orgName: params.org.name,\\n      roleLabels: params.org.roleLabels,\\n    });\\n  }\\n\\n  const userDoc: Record<string, unknown> = {\\n    uid,\\n    name: params.name.trim(),\\n    ...(params.englishName?.trim() ? { englishName: params.englishName.trim() } : {}),\\n    email: cleanEmail,\\n    phone: params.phone.trim(),\\n    rollNumber: params.rollNumber?.trim() || \'\',\\n    enrollmentNumber: params.enrollmentNumber?.trim() || params.rollNumber?.trim() || \'\',\\n    role: params.role,\\n    orgId: params.org.id,\\n    managerId: params.role === \'member\' ? params.managerId : null,\\n    memberId,\\n    status: \'active\',\\n    ...(managerCode ? { managerCode } : {}),\\n    ...(params.classId ? { classId: params.classId } : {}),\\n    ...(params.className ? { className: params.className } : {}),\\n    ...(params.departmentId ? { departmentId: params.departmentId } : {}),\\n    ...(params.departmentName ? { departmentName: params.departmentName } : {}),\\n    ...(params.courseName ? { courseName: params.courseName } : {}),\\n    ...(params.semester ? { semester: params.semester } : {}),\\n    ...(params.section ? { section: params.section } : {}),\\n    ...(params.photoUrl ? { photoUrl: params.photoUrl } : {}),\\n    ...(params.role === \'parent\' ? { linkedStudentUids: [] } : {}),\\n    language: params.language || \'en\',\\n    createdAt: serverTimestamp(),\\n  };\\n\\n  await setDoc(doc(db, \'users\', uid), userDoc);\\n\\n  if (params.actor) {\\n    await recordAuditLog({\\n      orgId: params.org.id,\\n      actorUid: params.actor.uid,\\n      actorName: params.actor.name,\\n      actorRole: params.actor.role,\\n      action: \'user.created\',\\n      targetType: \'user\',\\n      targetId: uid,\\n      summary: `Added ${params.role} ${params.name.trim()} (${memberId})`,\\n    });\\n  }\\n\\n  return {\\n    profile: { ...userDoc, createdAt: null } as unknown as UserProfile,\\n    resetEmailSent,\\n  };\\n}\\n\\n/**\\n * Self-registration for a Manager (using Organization Code) or Member (using Manager Code).\\n */\\nexport async function selfRegisterUser(params: {\\n  role: \'manager\' | \'member\';\\n  orgId: string;\\n  managerId: string | null;\\n  parentNotifyUid: string | null;\\n  name: string;\\n  englishName?: string;\\n  email: string;\\n  password: string;\\n  phone: string;\\n  rollNumber?: string;\\n  language: LanguageCode;\\n}): Promise<string> {\\n  const cleanEmail = params.email.trim().toLowerCase();\\n  const cred = await createUserWithEmailAndPassword(auth, cleanEmail, params.password);\\n  const uid = cred.user.uid;\\n\\n  await setDoc(doc(db, \'users\', uid), {\\n    uid,\\n    name: params.name.trim(),\\n    ...(params.englishName?.trim() ? { englishName: params.englishName.trim() } : {}),\\n    email: cleanEmail,\\n    phone: params.phone.trim(),\\n    rollNumber: params.rollNumber?.trim() || \'\',\\n    enrollmentNumber: params.rollNumber?.trim() || \'\',\\n    role: params.role,\\n    orgId: params.orgId,\\n    managerId: params.role === \'member\' ? params.managerId : null,\\n    memberId: \'\',\\n    status: \'pending\',\\n    language: params.language,\\n    createdAt: serverTimestamp(),\\n  });\\n\\n  if (params.parentNotifyUid) {\\n    try {\\n      await createNotification({\\n        orgId: params.orgId,\\n        toUid: params.parentNotifyUid,\\n        type: \'approval\',\\n        text: `${params.name.trim()} requested to join as ${params.role}.`,\\n      });\\n    } catch {\\n      // Non-fatal\\n    }\\n  }\\n\\n  return uid;\\n}\\n\\n/**\\n * Parent self-registration using Organization Code + Child\'s 6-character Student ID.\\n * Creates a pending parent account and a pending parentLink request for Admin verification.\\n */\\nexport async function registerParentAccount(params: {\\n  orgId: string;\\n  adminNotifyUid?: string | null;\\n  name: string;\\n  englishName?: string;\\n  email: string;\\n  password: string;\\n  phone: string;\\n  studentMemberId: string;\\n  relationship: string;\\n  language: LanguageCode;\\n}): Promise<{ uid: string; studentFound: boolean }> {\\n  const cleanStudentCode = params.studentMemberId.trim().toUpperCase();\\n  const studentLookup = await lookupUserId(cleanStudentCode);\\n  if (!studentLookup || studentLookup.orgId !== params.orgId || studentLookup.role !== \'member\') {\\n    throw new Error(\'STUDENT_NOT_FOUND\');\\n  }\\n\\n  const cleanEmail = params.email.trim().toLowerCase();\\n  const cred = await createUserWithEmailAndPassword(auth, cleanEmail, params.password);\\n  const uid = cred.user.uid;\\n\\n  await setDoc(doc(db, \'users\', uid), {\\n    uid,\\n    name: params.name.trim(),\\n    ...(params.englishName?.trim() ? { englishName: params.englishName.trim() } : {}),\\n    email: cleanEmail,\\n    phone: params.phone.trim(),\\n    role: \'parent\',\\n    orgId: params.orgId,\\n    managerId: null,\\n    memberId: \'\',\\n    linkedStudentUids: [],\\n    status: \'pending\',\\n    language: params.language,\\n    createdAt: serverTimestamp(),\\n  });\\n\\n  await addDoc(collection(db, \'parentLinks\'), {\\n    orgId: params.orgId,\\n    parentUid: uid,\\n    parentName: params.name.trim(),\\n    parentEmail: cleanEmail,\\n    studentUid: studentLookup.uid,\\n    studentName: \'\',\\n    studentMemberId: cleanStudentCode,\\n    relationship: params.relationship.trim() || \'Parent\',\\n    status: \'pending\',\\n    createdAt: serverTimestamp(),\\n  });\\n\\n  if (params.adminNotifyUid) {\\n    try {\\n      await createNotification({\\n        orgId: params.orgId,\\n        toUid: params.adminNotifyUid,\\n        type: \'approval\',\\n        text: `${params.name.trim()} requested Parent access linked to student ID ${cleanStudentCode}.`,\\n      });\\n    } catch {\\n      // Non-fatal\\n    }\\n  }\\n\\n  return { uid, studentFound: true };\\n}\\n\\nexport async function approvePendingUser(\\n  org: Organization,\\n  person: UserProfile,\\n  actor?: UserProfile | null\\n): Promise<void> {\\n  if (person.role === \'admin\' || person.role === \'super_admin\') return;\\n  const memberId =\\n    person.memberId ||\\n    (await allocateUniqueUserId({\\n      nameForId: person.englishName || person.name,\\n      uid: person.uid,\\n      orgId: org.id,\\n      role: person.role,\\n    }));\\n\\n  const patch: Record<string, unknown> = {\\n    status: \'active\',\\n    memberId,\\n  };\\n\\n  if (person.role === \'manager\' && !person.managerCode) {\\n    const code = await generateUniqueManagerCode();\\n    patch.managerCode = code;\\n    await setDoc(doc(db, \'managerCodes\', code), {\\n      orgId: org.id,\\n      managerUid: person.uid,\\n      managerName: person.name,\\n      orgName: org.name,\\n      roleLabels: org.roleLabels,\\n    });\\n  }\\n\\n  await updateDoc(doc(db, \'users\', person.uid), patch);\\n\\n  await createNotification({\\n    orgId: org.id,\\n    toUid: person.uid,\\n    type: \'approval\',\\n    text: `Your account has been approved. Your unique ID is ${memberId}.`,\\n  });\\n\\n  if (actor) {\\n    await recordAuditLog({\\n      orgId: org.id,\\n      actorUid: actor.uid,\\n      actorName: actor.name,\\n      actorRole: actor.role,\\n      action: \'user.approved\',\\n      targetType: \'user\',\\n      targetId: person.uid,\\n      summary: `Approved ${person.role} ${person.name} (${memberId})`,\\n    });\\n  }\\n}\\n\\nexport async function rejectPendingUser(\\n  orgId: string,\\n  person: UserProfile,\\n  actor?: UserProfile | null\\n): Promise<void> {\\n  await updateDoc(doc(db, \'users\', person.uid), { status: \'inactive\' });\\n  await createNotification({\\n    orgId,\\n    toUid: person.uid,\\n    type: \'approval\',\\n    text: \'Your registration request was not approved.\',\\n  });\\n  if (actor) {\\n    await recordAuditLog({\\n      orgId,\\n      actorUid: actor.uid,\\n      actorName: actor.name,\\n      actorRole: actor.role,\\n      action: \'user.rejected\',\\n      targetType: \'user\',\\n      targetId: person.uid,\\n      summary: `Rejected registration for ${person.name}`,\\n    });\\n  }\\n}\\n\\nexport async function updateUserDetails(\\n  uid: string,\\n  updates: Partial<\\n    Pick<\\n      UserProfile,\\n      | \'name\'\\n      | \'phone\'\\n      | \'rollNumber\'\\n      | \'enrollmentNumber\'\\n      | \'language\'\\n      | \'photoUrl\'\\n      | \'classId\'\\n      | \'className\'\\n      | \'departmentId\'\\n      | \'departmentName\'\\n      | \'courseName\'\\n      | \'semester\'\\n      | \'section\'\\n      | \'managerId\'\\n    >\\n  >\\n): Promise<void> {\\n  await updateDoc(doc(db, \'users\', uid), updates as Record<string, unknown>);\\n}\\n\\nexport async function updateUserRole(\\n  person: UserProfile,\\n  newRole: UserRole,\\n  actor: UserProfile\\n): Promise<void> {\\n  await updateDoc(doc(db, \'users\', person.uid), { role: newRole });\\n  await recordAuditLog({\\n    orgId: person.orgId,\\n    actorUid: actor.uid,\\n    actorName: actor.name,\\n    actorRole: actor.role,\\n    action: \'user.role_changed\',\\n    targetType: \'user\',\\n    targetId: person.uid,\\n    summary: `Changed role for ${person.name} from ${person.role} to ${newRole}`,\\n  });\\n}\\n\\nexport async function setUserStatus(\\n  uid: string,\\n  status: UserStatus,\\n  actor?: UserProfile | null,\\n  orgId?: string\\n): Promise<void> {\\n  await updateDoc(doc(db, \'users\', uid), { status });\\n  if (actor && orgId) {\\n    await recordAuditLog({\\n      orgId,\\n      actorUid: actor.uid,\\n      actorName: actor.name,\\n      actorRole: actor.role,\\n      action: \'user.status_changed\',\\n      targetType: \'user\',\\n      targetId: uid,\\n      summary: `Set user status to ${status}`,\\n    });\\n  }\\n}\\n\\nexport async function deleteUserProfile(\\n  person: UserProfile,\\n  actor?: UserProfile | null\\n): Promise<void> {\\n  if (person.managerCode) {\\n    try {\\n      await deleteDoc(doc(db, \'managerCodes\', person.managerCode));\\n    } catch {\\n      // Ignore if already removed\\n    }\\n  }\\n  if (person.memberId && /^[A-Z]{3}\\\\d{3}$/.test(person.memberId)) {\\n    try {\\n      await deleteDoc(doc(db, \'userIds\', person.memberId));\\n    } catch {\\n      // Ignore if already removed\\n    }\\n  }\\n  await deleteDoc(doc(db, \'users\', person.uid));\\n\\n  if (actor) {\\n    await recordAuditLog({\\n      orgId: person.orgId,\\n      actorUid: actor.uid,\\n      actorName: actor.name,\\n      actorRole: actor.role,\\n      action: \'user.deleted\',\\n      targetType: \'user\',\\n      targetId: person.uid,\\n      summary: `Deleted ${person.role} ${person.name} (${person.memberId})`,\\n    });\\n  }\\n}\\n\\nexport async function fetchOrgUsers(\\n  orgId: string,\\n  role?: \'manager\' | \'member\' | \'parent\'\\n): Promise<UserProfile[]> {\\n  const constraints = [where(\'orgId\', \'==\', orgId)];\\n  if (role) constraints.push(where(\'role\', \'==\', role));\\n  const q = query(collection(db, \'users\'), ...constraints);\\n  const snap = await getDocs(q);\\n  return snap.docs\\n    .map((d) => ({ ...(d.data() as UserProfile), uid: d.id }))\\n    .sort((a, b) => a.name.localeCompare(b.name));\\n}\\n\\nexport async function fetchManagerMembers(\\n  orgId: string,\\n  managerUid: string\\n): Promise<UserProfile[]> {\\n  const q = query(\\n    collection(db, \'users\'),\\n    where(\'orgId\', \'==\', orgId),\\n    where(\'managerId\', \'==\', managerUid)\\n  );\\n  const snap = await getDocs(q);\\n  return snap.docs\\n    .map((d) => ({ ...(d.data() as UserProfile), uid: d.id }))\\n    .filter((u) => u.role === \'member\')\\n    .sort((a, b) => a.name.localeCompare(b.name));\\n}\\n\\nexport async function fetchUsersByClass(\\n  orgId: string,\\n  classId: string\\n): Promise<UserProfile[]> {\\n  if (!classId) return [];\\n  const q = query(\\n    collection(db, \'users\'),\\n    where(\'orgId\', \'==\', orgId),\\n    where(\'classId\', \'==\', classId)\\n  );\\n  const snap = await getDocs(q);\\n  return snap.docs\\n    .map((d) => ({ ...(d.data() as UserProfile), uid: d.id }))\\n    .filter((u) => u.role === \'member\')\\n    .sort((a, b) => a.name.localeCompare(b.name));\\n}\\n\", \"Description\":\"Upgrade userService with class enrollment, parent registration, role updates, and audit logs\", \"Overwrite\":true, \"TargetFile\":\"/src/services/userService.ts\", \"toolAction\":\"Updating userService.ts\", \"toolSummary\":\"Update userService.ts\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_5304874119093864206"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import {\\n  addDoc,\\n  collection,\\n  doc,\\n  getDocs,\\n  query,\\n  serverTimestamp,\\n  updateDoc,\\n  where,\\n  writeBatch,\\n} from \'firebase/firestore\';\\nimport { db } from \'../firebase\';\\nimport type { LeaveRequest, Organization, UserProfile } from \'../types\';\\nimport { eachDateBetween } from \'../utils/helpers\';\\nimport { buildAttendanceDocId } from \'./attendanceService\';\\nimport { recordAuditLog } from \'./auditService\';\\nimport { createNotification } from \'./communicationService\';\\n\\nexport async function createLeaveRequest(params: {\\n  org: Organization;\\n  requester: UserProfile;\\n  fromDate: string;\\n  toDate: string;\\n  reason: string;\\n}): Promise<string> {\\n  const toUid =\\n    params.requester.role === \'member\' && params.requester.managerId\\n      ? params.requester.managerId\\n      : params.org.adminUid;\\n\\n  const ref = await addDoc(collection(db, \'leaves\'), {\\n    orgId: params.org.id,\\n    personUid: params.requester.uid,\\n    personName: params.requester.name,\\n    personRole: params.requester.role === \'member\' ? \'member\' : \'manager\',\\n    personMemberId: params.requester.memberId,\\n    toUid,\\n    fromDate: params.fromDate,\\n    toDate: params.toDate,\\n    reason: params.reason.trim(),\\n    status: \'pending\',\\n    comment: \'\',\\n    createdAt: serverTimestamp(),\\n  });\\n\\n  await createNotification({\\n    orgId: params.org.id,\\n    toUid,\\n    type: \'leave\',\\n    text: `${params.requester.name} requested leave (${params.fromDate} to ${params.toDate}).`,\\n  });\\n\\n  await recordAuditLog({\\n    orgId: params.org.id,\\n    actorUid: params.requester.uid,\\n    actorName: params.requester.name,\\n    actorRole: params.requester.role,\\n    action: \'leave.requested\',\\n    targetType: \'leave\',\\n    targetId: ref.id,\\n    summary: `Requested leave from ${params.fromDate} to ${params.toDate}`,\\n  });\\n\\n  return ref.id;\\n}\\n\\nexport async function decideLeaveRequest(params: {\\n  leave: LeaveRequest;\\n  decision: \'approved\' | \'rejected\';\\n  comment: string;\\n  decidedBy: UserProfile;\\n}): Promise<void> {\\n  await updateDoc(doc(db, \'leaves\', params.leave.id), {\\n    status: params.decision,\\n    comment: params.comment.trim(),\\n  });\\n\\n  // When approved, automatically mark each date as \\\"leave\\\" in attendance collection\\n  if (params.decision === \'approved\') {\\n    const dates = eachDateBetween(params.leave.fromDate, params.leave.toDate);\\n    if (dates.length > 0) {\\n      const batch = writeBatch(db);\\n      for (const date of dates) {\\n        const docId = buildAttendanceDocId(params.leave.orgId, date, params.leave.personUid);\\n        batch.set(doc(db, \'attendance\', docId), {\\n          orgId: params.leave.orgId,\\n          personUid: params.leave.personUid,\\n          personName: params.leave.personName,\\n          personMemberId: params.leave.personMemberId || \'\',\\n          role: params.leave.personRole,\\n          managerId: params.leave.personRole === \'member\' ? params.leave.toUid : null,\\n          teacherUid: params.decidedBy.uid,\\n          teacherName: params.decidedBy.name,\\n          date,\\n          timestamp: serverTimestamp(),\\n          status: \'leave\',\\n          method: \'manual\',\\n          markedBy: params.decidedBy.uid,\\n          note: params.leave.reason,\\n        });\\n      }\\n      await batch.commit();\\n    }\\n  }\\n\\n  await createNotification({\\n    orgId: params.leave.orgId,\\n    toUid: params.leave.personUid,\\n    type: \'leave\',\\n    text:\\n      params.decision === \'approved\'\\n        ? `Your leave (${params.leave.fromDate} to ${params.leave.toDate}) was approved.`\\n        : `Your leave (${params.leave.fromDate} to ${params.leave.toDate}) was rejected.`,\\n  });\\n\\n  await recordAuditLog({\\n    orgId: params.leave.orgId,\\n    actorUid: params.decidedBy.uid,\\n    actorName: params.decidedBy.name,\\n    actorRole: params.decidedBy.role,\\n    action: params.decision === \'approved\' ? \'leave.approved\' : \'leave.rejected\',\\n    targetType: \'leave\',\\n    targetId: params.leave.id,\\n    summary: `${params.decision === \'approved\' ? \'Approved\' : \'Rejected\'} leave for ${params.leave.personName} (${params.leave.fromDate} to ${params.leave.toDate})`,\\n  });\\n}\\n\\nexport async function fetchLeavesForStudent(\\n  orgId: string,\\n  studentUid: string\\n): Promise<LeaveRequest[]> {\\n  const snap = await getDocs(\\n    query(\\n      collection(db, \'leaves\'),\\n      where(\'orgId\', \'==\', orgId),\\n      where(\'personUid\', \'==\', studentUid)\\n    )\\n  );\\n  return snap.docs\\n    .map((d) => ({ ...(d.data() as LeaveRequest), id: d.id }))\\n    .sort((a, b) => (b.createdAt?.toMillis?.() ?? 0) - (a.createdAt?.toMillis?.() ?? 0));\\n}\\n\\nexport async function fetchLeavesForUser(profile: UserProfile): Promise<{\\n  myLeaves: LeaveRequest[];\\n  teamLeaves: LeaveRequest[];\\n}> {\\n  const sortByCreated = (list: LeaveRequest[]) =>\\n    list.sort((a, b) => {\\n      const ta = a.createdAt?.toMillis?.() ?? 0;\\n      const tb = b.createdAt?.toMillis?.() ?? 0;\\n      return tb - ta;\\n    });\\n\\n  if (profile.role === \'admin\' || profile.role === \'super_admin\') {\\n    const snap = await getDocs(\\n      query(collection(db, \'leaves\'), where(\'orgId\', \'==\', profile.orgId))\\n    );\\n    const all = snap.docs.map((d) => ({ ...(d.data() as LeaveRequest), id: d.id }));\\n    return {\\n      myLeaves: [],\\n      teamLeaves: sortByCreated(all),\\n    };\\n  }\\n\\n  if (profile.role === \'manager\') {\\n    const [ownSnap, teamSnap] = await Promise.all([\\n      getDocs(\\n        query(\\n          collection(db, \'leaves\'),\\n          where(\'orgId\', \'==\', profile.orgId),\\n          where(\'personUid\', \'==\', profile.uid)\\n        )\\n      ),\\n      getDocs(\\n        query(\\n          collection(db, \'leaves\'),\\n          where(\'orgId\', \'==\', profile.orgId),\\n          where(\'toUid\', \'==\', profile.uid)\\n        )\\n      ),\\n    ]);\\n    return {\\n      myLeaves: sortByCreated(\\n        ownSnap.docs.map((d) => ({ ...(d.data() as LeaveRequest), id: d.id }))\\n      ),\\n      teamLeaves: sortByCreated(\\n        teamSnap.docs.map((d) => ({ ...(d.data() as LeaveRequest), id: d.id }))\\n      ),\\n    };\\n  }\\n\\n  const myLeaves = await fetchLeavesForStudent(profile.orgId, profile.uid);\\n  return {\\n    myLeaves,\\n    teamLeaves: [],\\n  };\\n}\\n\", \"Description\":\"Add audit logs and parent/student fetch helper to leaveService\", \"Overwrite\":true, \"TargetFile\":\"/src/services/leaveService.ts\", \"toolAction\":\"Updating leaveService.ts\", \"toolSummary\":\"Update leaveService.ts\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_5304874119093864443"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import {\\n  collection,\\n  doc,\\n  getDocs,\\n  query,\\n  serverTimestamp,\\n  updateDoc,\\n  where,\\n  writeBatch,\\n} from \'firebase/firestore\';\\nimport { db } from \'../firebase\';\\nimport type { AttendanceMethod, AttendanceStatus, Organization, UserProfile } from \'../types\';\\nimport { getPastDates } from \'../utils/helpers\';\\nimport { buildAttendanceDocId } from \'./attendanceService\';\\nimport { allocateUniqueUserId } from \'./userService\';\\n\\nconst DEMO_MANAGERS = [\\n  { key: \'mgr1\', name: \'Dr. Kavita Nair\', email: \'kavita.demo@example.com\', phone: \'9810112201\' },\\n  { key: \'mgr2\', name: \'Prof. Rajesh Verma\', email: \'rajesh.demo@example.com\', phone: \'9810112202\' },\\n  { key: \'mgr3\', name: \'Prof. Meera Deshmukh\', email: \'meera.demo@example.com\', phone: \'9810112203\' },\\n];\\n\\nconst DEMO_MEMBERS = [\\n  { key: \'mem01\', mgrIdx: 0, classIdx: 0, name: \'Aarav Sharma\', roll: \'BCA-201\', rate: 0.94 },\\n  { key: \'mem02\', mgrIdx: 0, classIdx: 0, name: \'Diya Patel\', roll: \'BCA-202\', rate: 0.90 },\\n  { key: \'mem03\', mgrIdx: 0, classIdx: 0, name: \'Rohan Kulkarni\', roll: \'BCA-203\', rate: 0.62 },\\n  { key: \'mem04\', mgrIdx: 0, classIdx: 0, name: \'Ananya Iyer\', roll: \'BCA-204\', rate: 0.96 },\\n  { key: \'mem05\', mgrIdx: 0, classIdx: 0, name: \'Kabir Mehta\', roll: \'BCA-205\', rate: 0.85 },\\n  { key: \'mem06\', mgrIdx: 1, classIdx: 0, name: \'Priya Singh\', roll: \'BCA-206\', rate: 0.92 },\\n  { key: \'mem07\', mgrIdx: 1, classIdx: 0, name: \'Vihaan Joshi\', roll: \'BCA-207\', rate: 0.68 },\\n  { key: \'mem08\', mgrIdx: 1, classIdx: 0, name: \'Sneha Reddy\', roll: \'BCA-208\', rate: 0.88 },\\n  { key: \'mem09\', mgrIdx: 2, classIdx: 1, name: \'Arjun Malhotra\', roll: \'BSC-101\', rate: 0.82 },\\n  { key: \'mem10\', mgrIdx: 2, classIdx: 1, name: \'Neha Gupta\', roll: \'BSC-102\', rate: 0.95 },\\n  { key: \'mem11\', mgrIdx: 2, classIdx: 1, name: \'Siddharth Rao\', roll: \'BSC-103\', rate: 0.91 },\\n  { key: \'mem12\', mgrIdx: 2, classIdx: 1, name: \'Ishaan Chatterjee\', roll: \'BSC-104\', rate: 0.58 },\\n];\\n\\nasync function commitOpsInChunks(\\n  ops: Array<(batch: ReturnType<typeof writeBatch>) => void>\\n): Promise<void> {\\n  const CHUNK = 350;\\n  for (let i = 0; i < ops.length; i += CHUNK) {\\n    const batch = writeBatch(db);\\n    for (const op of ops.slice(i, i + CHUNK)) {\\n      op(batch);\\n    }\\n    await batch.commit();\\n  }\\n}\\n\\nexport async function loadDemoData(org: Organization, admin: UserProfile): Promise<void> {\\n  await deleteDemoData(org.id);\\n\\n  const ops: Array<(batch: ReturnType<typeof writeBatch>) => void> = [];\\n\\n  // 1. Seed Demo Department\\n  const deptId = `demo_${org.id}_dept_cs`;\\n  const deptName = \'Computer Science & AI\';\\n  ops.push((batch) => {\\n    batch.set(doc(db, \'departments\', deptId), {\\n      orgId: org.id,\\n      name: deptName,\\n      code: \'CSAI\',\\n      isDemo: true,\\n      createdAt: serverTimestamp(),\\n    });\\n  });\\n\\n  // 2. Seed Demo Classes\\n  const demoClasses = [\\n    {\\n      id: `demo_${org.id}_cls_bca`,\\n      name: \'BCA AI & DS \302\267 Sem 2 \302\267 Sec C\',\\n      courseName: \'BCA AI & DS\',\\n      semester: \'Sem 2\',\\n      section: \'Sec C\',\\n      classroom: \'Lab 204\',\\n    },\\n    {\\n      id: `demo_${org.id}_cls_bsc`,\\n      name: \'BSc Data Science \302\267 Sem 1 \302\267 Sec A\',\\n      courseName: \'BSc Data Science\',\\n      semester: \'Sem 1\',\\n      section: \'Sec A\',\\n      classroom: \'Room 108\',\\n    },\\n  ];\\n\\n  for (const cls of demoClasses) {\\n    ops.push((batch) => {\\n      batch.set(doc(db, \'classes\', cls.id), {\\n        orgId: org.id,\\n        departmentId: deptId,\\n        departmentName: deptName,\\n        name: cls.name,\\n        courseName: cls.courseName,\\n        semester: cls.semester,\\n        section: cls.section,\\n        classroom: cls.classroom,\\n        isDemo: true,\\n        createdAt: serverTimestamp(),\\n      });\\n    });\\n  }\\n\\n  // 3. Seed Demo Subjects\\n  const demoSubjects = [\\n    { id: `demo_${org.id}_sub_math`, name: \'Mathematics\', code: \'MTH201\' },\\n    { id: `demo_${org.id}_sub_prog`, name: \'Programming in Python\', code: \'CS202\' },\\n    { id: `demo_${org.id}_sub_dbms`, name: \'Database Systems\', code: \'CS105\' },\\n  ];\\n\\n  for (const sub of demoSubjects) {\\n    ops.push((batch) => {\\n      batch.set(doc(db, \'subjects\', sub.id), {\\n        orgId: org.id,\\n        departmentId: deptId,\\n        departmentName: deptName,\\n        name: sub.name,\\n        code: sub.code,\\n        isDemo: true,\\n        createdAt: serverTimestamp(),\\n      });\\n    });\\n  }\\n\\n  // 4. Allocate demo teachers\\n  const mgrDocs = await Promise.all(\\n    DEMO_MANAGERS.map(async (m, idx) => {\\n      const uid = `demo_${org.id}_${m.key}`;\\n      const memberId = await allocateUniqueUserId({\\n        nameForId: m.name,\\n        uid,\\n        orgId: org.id,\\n        role: \'manager\',\\n        isDemo: true,\\n      });\\n      const managerCode = `DM${org.orgCode.slice(0, 3)}${idx + 1}`.toUpperCase();\\n      return { ...m, uid, memberId, managerCode };\\n    })\\n  );\\n\\n  for (const m of mgrDocs) {\\n    ops.push((batch) => {\\n      batch.set(doc(db, \'users\', m.uid), {\\n        uid: m.uid,\\n        name: m.name,\\n        email: m.email,\\n        phone: m.phone,\\n        role: \'manager\',\\n        orgId: org.id,\\n        managerId: null,\\n        departmentId: deptId,\\n        departmentName: deptName,\\n        memberId: m.memberId,\\n        managerCode: m.managerCode,\\n        status: \'active\',\\n        language: \'en\',\\n        isDemo: true,\\n        createdAt: serverTimestamp(),\\n      });\\n    });\\n  }\\n\\n  // 5. Faculty Assignments (Multiple teachers independently assigned to the same class for different subjects)\\n  const assignments = [\\n    {\\n      id: `demo_${org.id}_fa_1`,\\n      teacher: mgrDocs[0],\\n      cls: demoClasses[0],\\n      sub: demoSubjects[0], // Mathematics\\n    },\\n    {\\n      id: `demo_${org.id}_fa_2`,\\n      teacher: mgrDocs[1],\\n      cls: demoClasses[0],\\n      sub: demoSubjects[1], // Programming\\n    },\\n    {\\n      id: `demo_${org.id}_fa_3`,\\n      teacher: mgrDocs[2],\\n      cls: demoClasses[1],\\n      sub: demoSubjects[2], // Database Systems\\n    },\\n  ];\\n\\n  for (const fa of assignments) {\\n    ops.push((batch) => {\\n      batch.set(doc(db, \'facultyAssignments\', fa.id), {\\n        orgId: org.id,\\n        teacherUid: fa.teacher.uid,\\n        teacherName: fa.teacher.name,\\n        departmentId: deptId,\\n        departmentName: deptName,\\n        classId: fa.cls.id,\\n        className: fa.cls.name,\\n        subjectId: fa.sub.id,\\n        subjectName: fa.sub.name,\\n        subjectCode: fa.sub.code,\\n        semester: fa.cls.semester,\\n        section: fa.cls.section,\\n        isDemo: true,\\n        createdAt: serverTimestamp(),\\n      });\\n    });\\n  }\\n\\n  // 6. Weekly Timetable slots (Mon-Sat)\\n  for (let day = 1; day <= 6; day++) {\\n    ops.push((batch) => {\\n      batch.set(doc(db, \'timetables\', `demo_${org.id}_tt_${day}_1`), {\\n        orgId: org.id,\\n        dayOfWeek: day,\\n        startTime: \'09:00\',\\n        endTime: \'10:00\',\\n        departmentId: deptId,\\n        departmentName: deptName,\\n        classId: demoClasses[0].id,\\n        className: demoClasses[0].name,\\n        subjectId: demoSubjects[0].id,\\n        subjectName: demoSubjects[0].name,\\n        subjectCode: demoSubjects[0].code,\\n        teacherUid: mgrDocs[0].uid,\\n        teacherName: mgrDocs[0].name,\\n        classroom: demoClasses[0].classroom,\\n        semester: demoClasses[0].semester,\\n        section: demoClasses[0].section,\\n        isDemo: true,\\n        createdAt: serverTimestamp(),\\n      });\\n    });\\n    ops.push((batch) => {\\n      batch.set(doc(db, \'timetables\', `demo_${org.id}_tt_${day}_2`), {\\n        orgId: org.id,\\n        dayOfWeek: day,\\n        startTime: \'10:00\',\\n        endTime: \'11:00\',\\n        departmentId: deptId,\\n        departmentName: deptName,\\n        classId: demoClasses[0].id,\\n        className: demoClasses[0].name,\\n        subjectId: demoSubjects[1].id,\\n        subjectName: demoSubjects[1].name,\\n        subjectCode: demoSubjects[1].code,\\n        teacherUid: mgrDocs[1].uid,\\n        teacherName: mgrDocs[1].name,\\n        classroom: demoClasses[0].classroom,\\n        semester: demoClasses[0].semester,\\n        section: demoClasses[0].section,\\n        isDemo: true,\\n        createdAt: serverTimestamp(),\\n      });\\n    });\\n    ops.push((batch) => {\\n      batch.set(doc(db, \'timetables\', `demo_${org.id}_tt_${day}_3`), {\\n        orgId: org.id,\\n        dayOfWeek: day,\\n        startTime: \'11:15\',\\n        endTime: \'12:15\',\\n        departmentId: deptId,\\n        departmentName: deptName,\\n        classId: demoClasses[1].id,\\n        className: demoClasses[1].name,\\n        subjectId: demoSubjects[2].id,\\n        subjectName: demoSubjects[2].name,\\n        subjectCode: demoSubjects[2].code,\\n        teacherUid: mgrDocs[2].uid,\\n        teacherName: mgrDocs[2].name,\\n        classroom: demoClasses[1].classroom,\\n        semester: demoClasses[1].semester,\\n        section: demoClasses[1].section,\\n        isDemo: true,\\n        createdAt: serverTimestamp(),\\n      });\\n    });\\n  }\\n\\n  // 7. Demo Students\\n  const memDocs = await Promise.all(\\n    DEMO_MEMBERS.map(async (m, idx) => {\\n      const uid = `demo_${org.id}_${m.key}`;\\n      const mgr = mgrDocs[m.mgrIdx];\\n      const cls = demoClasses[m.classIdx];\\n      const memberId = await allocateUniqueUserId({\\n        nameForId: m.name,\\n        uid,\\n        orgId: org.id,\\n        role: \'member\',\\n        isDemo: true,\\n      });\\n      return {\\n        ...m,\\n        uid,\\n        managerId: mgr.uid,\\n        cls,\\n        memberId,\\n        email: `${m.key}.demo@example.com`,\\n        phone: `982000${String(1000 + idx)}`,\\n      };\\n    })\\n  );\\n\\n  for (const mem of memDocs) {\\n    ops.push((batch) => {\\n      batch.set(doc(db, \'users\', mem.uid), {\\n        uid: mem.uid,\\n        name: mem.name,\\n        email: mem.email,\\n        phone: mem.phone,\\n        rollNumber: mem.roll,\\n        enrollmentNumber: `ENR-2025-${mem.roll}`,\\n        role: \'member\',\\n        orgId: org.id,\\n        managerId: mem.managerId,\\n        departmentId: deptId,\\n        departmentName: deptName,\\n        classId: mem.cls.id,\\n        className: mem.cls.name,\\n        courseName: mem.cls.courseName,\\n        semester: mem.cls.semester,\\n        section: mem.cls.section,\\n        memberId: mem.memberId,\\n        status: \'active\',\\n        language: \'en\',\\n        isDemo: true,\\n        createdAt: serverTimestamp(),\\n      });\\n    });\\n  }\\n\\n  // 8. Subject-wise Attendance Records (STRICTLY PRESENT, ABSENT, LEAVE ONLY \342\200\224 ZERO LATE)\\n  const dates = getPastDates(18, org.timezone || \'Asia/Kolkata\');\\n  let seed = 42;\\n  const nextRand = () => {\\n    seed = (seed * 1664525 + 1013904223) % 4294967296;\\n    return seed / 4294967296;\\n  };\\n\\n  for (const date of dates) {\\n    const dayOfWeek = new Date(`${date}T00:00:00Z`).getUTCDay();\\n    if (dayOfWeek === 0 && date !== dates[dates.length - 1]) continue;\\n\\n    // Teacher attendance\\n    for (const m of mgrDocs) {\\n      const r = nextRand();\\n      const status: AttendanceStatus = r < 0.9 ? \'present\' : r < 0.96 ? \'leave\' : \'absent\';\\n      const method: AttendanceMethod =\\n        status === \'present\' ? (r < 0.7 ? \'live_qr\' : \'live_code\') : \'manual\';\\n      const docId = buildAttendanceDocId(org.id, date, m.uid);\\n      ops.push((batch) => {\\n        batch.set(doc(db, \'attendance\', docId), {\\n          orgId: org.id,\\n          personUid: m.uid,\\n          personName: m.name,\\n          personMemberId: m.memberId,\\n          role: \'manager\',\\n          managerId: null,\\n          departmentId: deptId,\\n          departmentName: deptName,\\n          date,\\n          timestamp: serverTimestamp(),\\n          status,\\n          method,\\n          distanceMeters: method === \'manual\' ? 0 : Math.floor(nextRand() * 25) + 4,\\n          markedBy: method === \'manual\' ? admin.uid : m.uid,\\n          note: \'\',\\n          isDemo: true,\\n        });\\n      });\\n    }\\n\\n    // Subject-wise Student attendance (independent records per subject per day)\\n    for (const fa of assignments) {\\n      const classStudents = memDocs.filter((mem) => mem.cls.id === fa.cls.id);\\n      for (const mem of classStudents) {\\n        const r = nextRand();\\n        let status: AttendanceStatus;\\n        if (r < mem.rate) status = \'present\';\\n        else if (r < mem.rate + 0.06) status = \'leave\';\\n        else status = \'absent\';\\n\\n        const method: AttendanceMethod =\\n          status === \'present\'\\n            ? nextRand() < 0.78\\n              ? \'live_qr\'\\n              : \'live_code\'\\n            : \'manual\';\\n\\n        const docId = buildAttendanceDocId(org.id, date, mem.uid, fa.sub.id);\\n        ops.push((batch) => {\\n          batch.set(doc(db, \'attendance\', docId), {\\n            orgId: org.id,\\n            personUid: mem.uid,\\n            personName: mem.name,\\n            personMemberId: mem.memberId,\\n            role: \'member\',\\n            managerId: mem.managerId,\\n            teacherUid: fa.teacher.uid,\\n            teacherName: fa.teacher.name,\\n            departmentId: deptId,\\n            departmentName: deptName,\\n            classId: fa.cls.id,\\n            className: fa.cls.name,\\n            subjectId: fa.sub.id,\\n            subjectName: fa.sub.name,\\n            subjectCode: fa.sub.code,\\n            date,\\n            timestamp: serverTimestamp(),\\n            status,\\n            method,\\n            distanceMeters: method === \'manual\' ? 0 : Math.floor(nextRand() * 30) + 3,\\n            markedBy: method === \'manual\' ? fa.teacher.uid : mem.uid,\\n            note: \'\',\\n            isDemo: true,\\n          });\\n        });\\n      }\\n    }\\n  }\\n\\n  const today = dates[dates.length - 1];\\n  ops.push((batch) => {\\n    batch.set(doc(collection(db, \'leaves\')), {\\n      orgId: org.id,\\n      personUid: mgrDocs[0].uid,\\n      personName: mgrDocs[0].name,\\n      personRole: \'manager\',\\n      personMemberId: mgrDocs[0].memberId,\\n      toUid: admin.uid,\\n      fromDate: today,\\n      toDate: today,\\n      reason: \'Attending university academic seminar (Demo)\',\\n      status: \'pending\',\\n      comment: \'\',\\n      isDemo: true,\\n      createdAt: serverTimestamp(),\\n    });\\n  });\\n\\n  ops.push((batch) => {\\n    batch.set(doc(collection(db, \'leaves\')), {\\n      orgId: org.id,\\n      personUid: memDocs[2].uid,\\n      personName: memDocs[2].name,\\n      personRole: \'member\',\\n      personMemberId: memDocs[2].memberId,\\n      toUid: mgrDocs[0].uid,\\n      fromDate: today,\\n      toDate: today,\\n      reason: \'Medical appointment (Demo)\',\\n      status: \'pending\',\\n      comment: \'\',\\n      isDemo: true,\\n      createdAt: serverTimestamp(),\\n    });\\n  });\\n\\n  ops.push((batch) => {\\n    batch.set(doc(collection(db, \'announcements\')), {\\n      orgId: org.id,\\n      fromUid: admin.uid,\\n      fromName: admin.name,\\n      fromRole: \'admin\',\\n      audience: \'all\',\\n      managerId: null,\\n      text: \'Subject-wise live attendance sessions open at lecture start. Please keep GPS enabled on your phone. (Demo notice)\',\\n      isDemo: true,\\n      createdAt: serverTimestamp(),\\n    });\\n  });\\n\\n  await commitOpsInChunks(ops);\\n  await updateDoc(doc(db, \'organizations\', org.id), { hasDemoData: true });\\n}\\n\\nexport async function deleteDemoData(orgId: string): Promise<void> {\\n  const collectionsToClean = [\\n    \'users\',\\n    \'userIds\',\\n    \'attendance\',\\n    \'leaves\',\\n    \'announcements\',\\n    \'notifications\',\\n    \'departments\',\\n    \'classes\',\\n    \'subjects\',\\n    \'facultyAssignments\',\\n    \'timetables\',\\n  ];\\n  const ops: Array<(batch: ReturnType<typeof writeBatch>) => void> = [];\\n\\n  for (const col of collectionsToClean) {\\n    try {\\n      const snap = await getDocs(\\n        query(collection(db, col), where(\'orgId\', \'==\', orgId), where(\'isDemo\', \'==\', true))\\n      );\\n      for (const d of snap.docs) {\\n        ops.push((batch) => batch.delete(d.ref));\\n      }\\n    } catch {\\n      // Continue if empty or collection not yet initialized\\n    }\\n  }\\n\\n  if (ops.length > 0) {\\n    await commitOpsInChunks(ops);\\n  }\\n  await updateDoc(doc(db, \'organizations\', orgId), { hasDemoData: false });\\n}\\n\", \"Description\":\"Remove LATE status from demoService and seed realistic multi-teacher subject-wise demo data\", \"Overwrite\":true, \"TargetFile\":\"/src/services/demoService.ts\", \"toolAction\":\"Updating demoService.ts\", \"toolSummary\":\"Update demoService.ts\"}"
      original_name: "write_to_file"
