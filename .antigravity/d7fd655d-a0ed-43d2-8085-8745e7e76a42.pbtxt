            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "- **Multi-Organization Hierarchy**: Strict data isolation across organizations. Customize role names per organization (e.g. *Teacher / Student*, *Faculty / Student*, *Team Lead / Employee*)."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "- **Globally Unique 6-Character ID**: Every Admin, Manager, and Member receives a unique 6-character ID (`3 uppercase English letters + 3 digits`, e.g. `PAN482`, `RAH071`) reserved atomically via a Firestore transaction in `userIds/{ID}`. If a name is typed in Hindi, the form asks for the English spelling used for the ID."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "- **Live Rotating QR Sessions (Primary Attendance Mode)**:"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  - Admins start sessions for Managers; Managers start sessions for their own Members."
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
