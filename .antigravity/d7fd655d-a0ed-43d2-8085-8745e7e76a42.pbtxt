            }
            lines {
              text: "    \"whyHeading\": \"Simple. Fast. Safe.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"whySub\": \"Built for everyday reliability.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"why1Title\": \"Simple\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"why1Desc\": \"No training manual required. Clear labels, calm screens, and direct actions.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"why2Title\": \"Fast\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"why2Desc\": \"Mark an entire class or team in under a minute with continuous QR scanning.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"why3Title\": \"Safe\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"why3Desc\": \"Strict organization isolation. People only see the records they are permitted to see.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"faqHeading\": \"Common questions\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"faqSub\": \"Straight answers before you begin.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"faq1Q\": \"Is it free?\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"faq1A\": \"Yes. You can create your organization, add your team, and mark attendance right away at no cost.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"faq2Q\": \"Do members need to install an app?\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"faq2A\": \"No. They can open it in any browser, save their QR image, or print an ID card. They can also install it to their home screen if they like.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"faq3Q\": \"How is the QR code made?\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"faq3A\": \"As soon as someone is added or approved, a unique ID and QR code are generated automatically for them.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"faq4Q\": \"Can one person see another person\'s data?\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"faq4A\": \"No. Members only see their own records. Managers only see their own assigned members. Organizations are completely isolated from each other.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"faq5Q\": \"Does it work on mobile?\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    \"faq5A\": \"Yes. It is designed mobile-first so you can scan QR codes directly using your phone\'s back or front camera.\","
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
