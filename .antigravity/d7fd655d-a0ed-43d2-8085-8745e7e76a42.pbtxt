    tool_calls {
      id: "call_16405764573190887076"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useCallback, useEffect, useMemo, useState } from \'react\';\\nimport { Check, X } from \'lucide-react\';\\nimport { useAuth } from \'../context/AuthContext\';\\nimport { useTranslation } from \'../hooks/useTranslation\';\\nimport { useToast } from \'../context/ToastContext\';\\nimport type { LeaveRequest } from \'../types\';\\nimport {\\n  createLeaveRequest,\\n  decideLeaveRequest,\\n  fetchLeavesForUser,\\n} from \'../services/leaveService\';\\nimport { getFirebaseErrorKey, getOrgDateString } from \'../utils/helpers\';\\nimport { Layout } from \'../components/Layout\';\\nimport { CardSkeleton, EmptyState } from \'../components/Skeletons\';\\n\\nexport const LeavesPage: React.FC = () => {\\n  const { profile, org } = useAuth();\\n  const { t, formatDate } = useTranslation();\\n  const { showToast } = useToast();\\n\\n  const today = useMemo(() => getOrgDateString(org?.timezone || \'Asia/Kolkata\'), [org?.timezone]);\\n\\n  const [loading, setLoading] = useState(true);\\n  const [myLeaves, setMyLeaves] = useState<LeaveRequest[]>([]);\\n  const [teamLeaves, setTeamLeaves] = useState<LeaveRequest[]>([]);\\n\\n  // Request form\\n  const [fromDate, setFromDate] = useState(today);\\n  const [toDate, setToDate] = useState(today);\\n  const [reason, setReason] = useState(\'\');\\n  const [submitting, setSubmitting] = useState(false);\\n\\n  // Review comments by leave ID\\n  const [comments, setComments] = useState<Record<string, string>>({});\\n  const [decidingId, setDecidingId] = useState<string | null>(null);\\n\\n  const loadLeaves = useCallback(async () => {\\n    if (!profile) return;\\n    setLoading(true);\\n    try {\\n      const res = await fetchLeavesForUser(profile);\\n      setMyLeaves(res.myLeaves);\\n      setTeamLeaves(res.teamLeaves);\\n    } catch (err) {\\n      showToast(t(getFirebaseErrorKey(err)), \'error\');\\n    } finally {\\n      setLoading(false);\\n    }\\n  }, [profile, showToast, t]);\\n\\n  useEffect(() => {\\n    loadLeaves();\\n  }, [loadLeaves]);\\n\\n  const handleRequestSubmit = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    if (!org || !profile) return;\\n    if (toDate < fromDate) {\\n      showToast(t(\'leaves.invalidRange\'), \'error\');\\n      return;\\n    }\\n    if (!reason.trim()) {\\n      showToast(t(\'errors.requiredFields\'), \'error\');\\n      return;\\n    }\\n    setSubmitting(true);\\n    try {\\n      await createLeaveRequest({\\n        org,\\n        requester: profile,\\n        fromDate,\\n        toDate,\\n        reason,\\n      });\\n      setReason(\'\');\\n      showToast(t(\'leaves.submittedToast\'), \'success\');\\n      await loadLeaves();\\n    } catch (err) {\\n      showToast(t(getFirebaseErrorKey(err)), \'error\');\\n    } finally {\\n      setSubmitting(false);\\n    }\\n  };\\n\\n  const handleDecision = async (leave: LeaveRequest, decision: \'approved\' | \'rejected\') => {\\n    if (!profile) return;\\n    setDecidingId(leave.id);\\n    try {\\n      await decideLeaveRequest({\\n        leave,\\n        decision,\\n        comment: comments[leave.id] || \'\',\\n        decidedBy: profile,\\n      });\\n      showToast(\\n        decision === \'approved\' ? t(\'leaves.approvedToast\') : t(\'leaves.rejectedToast\'),\\n        decision === \'approved\' ? \'success\' : \'info\'\\n      );\\n      await loadLeaves();\\n    } catch (err) {\\n      showToast(t(getFirebaseErrorKey(err)), \'error\');\\n    } finally {\\n      setDecidingId(null);\\n    }\\n  };\\n\\n  const statusColor = (s: LeaveRequest[\'status\']) => {\\n    if (s === \'approved\') return \'text-emerald-700 dark:text-emerald-400\';\\n    if (s === \'rejected\') return \'text-red-700 dark:text-red-400\';\\n    return \'text-amber-700 dark:text-amber-400\';\\n  };\\n\\n  return (\\n    <Layout title={t(\'leaves.title\')}>\\n      <div className=\\\"space-y-8\\\">\\n        {/* Request Leave Form (Member & Manager) */}\\n        {profile?.role !== \'admin\' && (\\n          <section className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5 sm:p-6\\\">\\n            <h2 className=\\\"text-base font-semibold text-stone-900 dark:text-stone-100 mb-4\\\">\\n              {t(\'leaves.requestLeave\')}\\n            </h2>\\n            <form onSubmit={handleRequestSubmit} className=\\\"space-y-4\\\">\\n              <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-4\\\">\\n                <div>\\n                  <label className=\\\"block text-sm font-medium text-stone-700 dark:text-stone-300 mb-1\\\">\\n                    {t(\'leaves.fromDate\')}\\n                  </label>\\n                  <input\\n                    type=\\\"date\\\"\\n                    required\\n                    value={fromDate}\\n                    onChange={(e) => {\\n                      setFromDate(e.target.value);\\n                      if (toDate < e.target.value) setToDate(e.target.value);\\n                    }}\\n                    className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-900 px-3.5 py-2 text-sm\\\"\\n                  />\\n                </div>\\n                <div>\\n                  <label className=\\\"block text-sm font-medium text-stone-700 dark:text-stone-300 mb-1\\\">\\n                    {t(\'leaves.toDate\')}\\n                  </label>\\n                  <input\\n                    type=\\\"date\\\"\\n                    required\\n                    min={fromDate}\\n                    value={toDate}\\n                    onChange={(e) => setToDate(e.target.value)}\\n                    className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-900 px-3.5 py-2 text-sm\\\"\\n                  />\\n                </div>\\n              </div>\\n              <div>\\n                <label className=\\\"block text-sm font-medium text-stone-700 dark:text-stone-300 mb-1\\\">\\n                  {t(\'leaves.reason\')}\\n                </label>\\n                <textarea\\n                  rows={2}\\n                  required\\n                  value={reason}\\n                  onChange={(e) => setReason(e.target.value)}\\n                  placeholder={t(\'leaves.reasonPlaceholder\')}\\n                  className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-transparent px-3.5 py-2 text-sm resize-none\\\"\\n                />\\n              </div>\\n              <button\\n                type=\\\"submit\\\"\\n                disabled={submitting}\\n                className=\\\"rounded-xl bg-[#C25E00] hover:bg-[#A84F00] disabled:opacity-60 text-white px-5 py-2.5 text-sm font-medium\\\"\\n              >\\n                {submitting ? t(\'common.saving\') : t(\'leaves.submitRequest\')}\\n              </button>\\n            </form>\\n          </section>\\n        )}\\n\\n        {/* Team Requests to Review (Admin & Manager) */}\\n        {(profile?.role === \'admin\' || profile?.role === \'manager\') && (\\n          <section className=\\\"space-y-3\\\">\\n            <h2 className=\\\"text-lg font-semibold text-stone-900 dark:text-stone-100\\\">\\n              {t(\'leaves.teamRequests\')}\\n            </h2>\\n\\n            {loading ? (\\n              <CardSkeleton rows={3} />\\n            ) : teamLeaves.length === 0 ? (\\n              <EmptyState title={t(\'leaves.emptyTitle\')} description={t(\'leaves.emptyDesc\')} />\\n            ) : (\\n              <div className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] divide-y divide-stone-100 dark:divide-stone-800\\\">\\n                {teamLeaves.map((leave) => (\\n                  <div key={leave.id} className=\\\"p-5 flex flex-col md:flex-row md:items-center justify-between gap-4\\\">\\n                    <div className=\\\"space-y-1\\\">\\n                      <div className=\\\"flex items-center gap-2 text-sm\\\">\\n                        <span className=\\\"font-semibold text-stone-900 dark:text-stone-100\\\">\\n                          {leave.personName}\\n                        </span>\\n                        <span className=\\\"text-stone-400\\\">\302\267</span>\\n                        <span className={`text-xs font-semibold ${statusColor(leave.status)}`}>\\n                          {t(`common.${leave.status}`)}\\n                        </span>\\n                      </div>\\n                      <p className=\\\"text-xs font-mono text-stone-500\\\">\\n                        {formatDate(leave.fromDate)} \342\200\224 {formatDate(leave.toDate)}\\n                      </p>\\n                      <p className=\\\"text-sm text-stone-700 dark:text-stone-300\\\">{leave.reason}</p>\\n                      {leave.comment && (\\n                        <p className=\\\"text-xs text-stone-500 italic\\\">{leave.comment}</p>\\n                      )}\\n                    </div>\\n\\n                    {leave.status === \'pending\' && (\\n                      <div className=\\\"flex flex-col sm:flex-row items-stretch sm:items-center gap-2 shrink-0\\\">\\n                        <input\\n                          type=\\\"text\\\"\\n                          value={comments[leave.id] || \'\'}\\n                          onChange={(e) =>\\n                            setComments((prev) => ({ ...prev, [leave.id]: e.target.value }))\\n                          }\\n                          placeholder={t(\'leaves.commentPlaceholder\')}\\n                          className=\\\"rounded-xl border border-stone-300 dark:border-stone-700 bg-transparent px-3 py-2 text-xs w-full sm:w-44\\\"\\n                        />\\n                        <div className=\\\"flex items-center gap-2\\\">\\n                          <button\\n                            type=\\\"button\\\"\\n                            disabled={decidingId === leave.id}\\n                            onClick={() => handleDecision(leave, \'approved\')}\\n                            className=\\\"flex-1 sm:flex-none inline-flex items-center justify-center gap-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white px-3.5 py-2 text-xs font-medium\\\"\\n                          >\\n                            <Check className=\\\"w-3.5 h-3.5\\\" />\\n                            <span>{t(\'dashboard.approve\')}</span>\\n                          </button>\\n                          <button\\n                            type=\\\"button\\\"\\n                            disabled={decidingId === leave.id}\\n                            onClick={() => handleDecision(leave, \'rejected\')}\\n                            className=\\\"flex-1 sm:flex-none inline-flex items-center justify-center gap-1.5 rounded-xl border border-stone-300 dark:border-stone-700 text-stone-700 dark:text-stone-300 hover:text-red-600 px-3.5 py-2 text-xs font-medium\\\"\\n                          >\\n                            <X className=\\\"w-3.5 h-3.5\\\" />\\n                            <span>{t(\'dashboard.reject\')}</span>\\n                          </button>\\n                        </div>\\n                      </div>\\n                    )}\\n                  </div>\\n                ))}\\n              </div>\\n            )}\\n          </section>\\n        )}\\n\\n        {/* My Requests */}\\n        {profile?.role !== \'admin\' && (\\n          <section className=\\\"space-y-3\\\">\\n            <h2 className=\\\"text-lg font-semibold text-stone-900 dark:text-stone-100\\\">\\n              {t(\'leaves.myRequests\')}\\n            </h2>\\n\\n            {loading ? (\\n              <CardSkeleton rows={3} />\\n            ) : myLeaves.length === 0 ? (\\n              <EmptyState title={t(\'leaves.emptyTitle\')} description={t(\'leaves.emptyDesc\')} />\\n            ) : (\\n              <div className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] divide-y divide-stone-100 dark:divide-stone-800\\\">\\n                {myLeaves.map((leave) => (\\n                  <div key={leave.id} className=\\\"p-5 flex items-start justify-between gap-4\\\">\\n                    <div className=\\\"space-y-1\\\">\\n                      <p className=\\\"text-sm font-medium text-stone-900 dark:text-stone-100\\\">\\n                        {formatDate(leave.fromDate)} \342\200\224 {formatDate(leave.toDate)}\\n                      </p>\\n                      <p className=\\\"text-sm text-stone-600 dark:text-stone-400\\\">{leave.reason}</p>\\n                      {leave.comment && (\\n                        <p className=\\\"text-xs text-stone-500\\\">\\n                          {t(\'common.note\')}: {leave.comment}\\n                        </p>\\n                      )}\\n                    </div>\\n                    <span className={`text-xs font-semibold shrink-0 ${statusColor(leave.status)}`}>\\n                      {t(`common.${leave.status}`)}\\n                    </span>\\n                  </div>\\n                ))}\\n              </div>\\n            )}\\n          </section>\\n        )}\\n      </div>\\n    </Layout>\\n  );\\n};\\n\", \"Description\":\"Create LeavesPage for requesting leave and approving/rejecting requests with automatic attendance sync\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/LeavesPage.tsx\", \"toolAction\":\"Creating LeavesPage\", \"toolSummary\":\"Create LeavesPage.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_16405764573190887167"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useCallback, useEffect, useState } from \'react\';\\nimport { Trash2 } from \'lucide-react\';\\nimport { useAuth } from \'../context/AuthContext\';\\nimport { useTranslation } from \'../hooks/useTranslation\';\\nimport { useToast } from \'../context/ToastContext\';\\nimport type { Announcement } from \'../types\';\\nimport {\\n  deleteAnnouncement,\\n  fetchAnnouncements,\\n  postAnnouncement,\\n} from \'../services/communicationService\';\\nimport { fetchManagerMembers, fetchOrgUsers } from \'../services/userService\';\\nimport { getFirebaseErrorKey } from \'../utils/helpers\';\\nimport { Layout } from \'../components/Layout\';\\nimport { CardSkeleton, EmptyState } from \'../components/Skeletons\';\\n\\nexport const AnnouncementsPage: React.FC = () => {\\n  const { profile, org, getRoleLabel } = useAuth();\\n  const { t, formatTime } = useTranslation();\\n  const { showToast } = useToast();\\n\\n  const [loading, setLoading] = useState(true);\\n  const [items, setItems] = useState<Announcement[]>([]);\\n  const [text, setText] = useState(\'\');\\n  const [audience, setAudience] = useState<\'all\' | \'managers\' | \'members\'>(\'all\');\\n  const [posting, setPosting] = useState(false);\\n\\n  const canPost = profile?.role === \'admin\' || profile?.role === \'manager\';\\n\\n  const loadNotices = useCallback(async () => {\\n    if (!profile) return;\\n    setLoading(true);\\n    try {\\n      const list = await fetchAnnouncements(profile);\\n      setItems(list);\\n    } catch (err) {\\n      showToast(t(getFirebaseErrorKey(err)), \'error\');\\n    } finally {\\n      setLoading(false);\\n    }\\n  }, [profile, showToast, t]);\\n\\n  useEffect(() => {\\n    loadNotices();\\n  }, [loadNotices]);\\n\\n  const handlePost = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    if (!profile || !org || !text.trim()) return;\\n    setPosting(true);\\n    try {\\n      let recipientUids: string[] = [];\\n      if (profile.role === \'admin\') {\\n        const users = await fetchOrgUsers(\\n          org.id,\\n          audience === \'managers\' ? \'manager\' : undefined\\n        );\\n        recipientUids = users.filter((u) => u.status === \'active\').map((u) => u.uid);\\n      } else if (profile.role === \'manager\') {\\n        const members = await fetchManagerMembers(org.id, profile.uid);\\n        recipientUids = members.filter((u) => u.status === \'active\').map((u) => u.uid);\\n      }\\n\\n      await postAnnouncement({\\n        author: profile,\\n        audience: profile.role === \'manager\' ? \'members\' : audience,\\n        text,\\n        recipientUids,\\n      });\\n      setText(\'\');\\n      showToast(t(\'announcements.postedToast\'), \'success\');\\n      await loadNotices();\\n    } catch (err) {\\n      showToast(t(getFirebaseErrorKey(err)), \'error\');\\n    } finally {\\n      setPosting(false);\\n    }\\n  };\\n\\n  const handleDelete = async (id: string) => {\\n    try {\\n      await deleteAnnouncement(id);\\n      showToast(t(\'announcements.deletedToast\'), \'info\');\\n      setItems((prev) => prev.filter((a) => a.id !== id));\\n    } catch (err) {\\n      showToast(t(getFirebaseErrorKey(err)), \'error\');\\n    }\\n  };\\n\\n  return (\\n    <Layout title={t(\'announcements.title\')}>\\n      <div className=\\\"space-y-8 max-w-3xl\\\">\\n        {canPost && (\\n          <section className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5 sm:p-6\\\">\\n            <h2 className=\\\"text-base font-semibold text-stone-900 dark:text-stone-100 mb-4\\\">\\n              {t(\'announcements.postTitle\')}\\n            </h2>\\n            <form onSubmit={handlePost} className=\\\"space-y-4\\\">\\n              <textarea\\n                rows={3}\\n                required\\n                value={text}\\n                onChange={(e) => setText(e.target.value)}\\n                placeholder={t(\'announcements.placeholder\')}\\n                className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-transparent px-3.5 py-2.5 text-sm resize-none\\\"\\n              />\\n\\n              <div className=\\\"flex flex-wrap items-center justify-between gap-3\\\">\\n                {profile?.role === \'admin\' ? (\\n                  <div className=\\\"flex items-center gap-2 text-sm\\\">\\n                    <label className=\\\"text-xs text-stone-500\\\">\\n                      {t(\'announcements.audienceLabel\')}:\\n                    </label>\\n                    <select\\n                      value={audience}\\n                      onChange={(e) => setAudience(e.target.value as \'all\' | \'managers\')}\\n                      className=\\\"rounded-xl border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-900 px-3 py-1.5 text-xs\\\"\\n                    >\\n                      <option value=\\\"all\\\">{t(\'announcements.audienceAll\')}</option>\\n                      <option value=\\\"managers\\\">\\n                        {getRoleLabel(\'manager\')} ({t(\'announcements.audienceManagers\')})\\n                      </option>\\n                    </select>\\n                  </div>\\n                ) : (\\n                  <span className=\\\"text-xs text-stone-500\\\">\\n                    {t(\'announcements.audienceLabel\')}: {t(\'announcements.audienceMembers\')}\\n                  </span>\\n                )}\\n\\n                <button\\n                  type=\\\"submit\\\"\\n                  disabled={posting}\\n                  className=\\\"rounded-xl bg-[#C25E00] hover:bg-[#A84F00] disabled:opacity-60 text-white px-5 py-2 text-sm font-medium\\\"\\n                >\\n                  {posting ? t(\'common.saving\') : t(\'announcements.postBtn\')}\\n                </button>\\n              </div>\\n            </form>\\n          </section>\\n        )}\\n\\n        {loading ? (\\n          <CardSkeleton rows={4} />\\n        ) : items.length === 0 ? (\\n          <EmptyState\\n            title={t(\'announcements.emptyTitle\')}\\n            description={t(\'announcements.emptyDesc\')}\\n          />\\n        ) : (\\n          <div className=\\\"space-y-3\\\">\\n            {items.map((a) => (\\n              <article\\n                key={a.id}\\n                className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5\\\"\\n              >\\n                <div className=\\\"flex items-start justify-between gap-4\\\">\\n                  <p className=\\\"text-sm text-stone-900 dark:text-stone-100 leading-relaxed whitespace-pre-wrap\\\">\\n                    {a.text}\\n                  </p>\\n                  {(profile?.role === \'admin\' || a.fromUid === profile?.uid) && (\\n                    <button\\n                      type=\\\"button\\\"\\n                      onClick={() => handleDelete(a.id)}\\n                      aria-label={t(\'common.delete\')}\\n                      className=\\\"p-1.5 text-stone-400 hover:text-red-600 shrink-0\\\"\\n                    >\\n                      <Trash2 className=\\\"w-4 h-4\\\" />\\n                    </button>\\n                  )}\\n                </div>\\n                <div className=\\\"mt-3 flex items-center gap-2 text-xs text-stone-500 dark:text-stone-400\\\">\\n                  <span className=\\\"font-medium text-stone-700 dark:text-stone-300\\\">\\n                    {a.fromName}\\n                  </span>\\n                  <span>\302\267</span>\\n                  <span>{formatTime(a.createdAt?.toDate?.())}</span>\\n                  {a.isDemo && (\\n                    <>\\n                      <span>\302\267</span>\\n                      <span>{t(\'common.demo\')}</span>\\n                    </>\\n                  )}\\n                </div>\\n              </article>\\n            ))}\\n          </div>\\n        )}\\n      </div>\\n    </Layout>\\n  );\\n};\\n\", \"Description\":\"Create AnnouncementsPage for posting org/team notices with automatic notification dispatch\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/AnnouncementsPage.tsx\", \"toolAction\":\"Creating AnnouncementsPage\", \"toolSummary\":\"Create AnnouncementsPage.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_16405764573190887258"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useCallback, useEffect, useMemo, useState } from \'react\';\\nimport Papa from \'papaparse\';\\nimport jsPDF from \'jspdf\';\\nimport autoTable from \'jspdf-autotable\';\\nimport {\\n  ResponsiveContainer,\\n  BarChart,\\n  Bar,\\n  XAxis,\\n  YAxis,\\n  Tooltip,\\n  CartesianGrid,\\n} from \'recharts\';\\nimport { Download, FileText, Search } from \'lucide-react\';\\nimport { useAuth } from \'../context/AuthContext\';\\nimport { useTranslation } from \'../hooks/useTranslation\';\\nimport { useToast } from \'../context/ToastContext\';\\nimport type { AttendanceRecord, AttendanceStatus, UserProfile } from \'../types\';\\nimport {\\n  fetchAttendanceForManager,\\n  fetchAttendanceForOrg,\\n} from \'../services/attendanceService\';\\nimport { fetchManagerMembers, fetchOrgUsers } from \'../services/userService\';\\nimport { getFirebaseErrorKey, getOrgDateString, getPastDates } from \'../utils/helpers\';\\nimport { Layout } from \'../components/Layout\';\\nimport { CardSkeleton, EmptyState } from \'../components/Skeletons\';\\n\\nconst PAGE_SIZE = 15;\\n\\nexport const ReportsPage: React.FC = () => {\\n  const { profile, org } = useAuth();\\n  const { t, formatDate, formatNumber } = useTranslation();\\n  const { showToast } = useToast();\\n\\n  const today = useMemo(() => getOrgDateString(org?.timezone || \'Asia/Kolkata\'), [org?.timezone]);\\n  const defaultFrom = useMemo(() => getPastDates(30, org?.timezone || \'Asia/Kolkata\')[0], [org?.timezone]);\\n\\n  const [view, setView] = useState<\'records\' | \'summary\' | \'register\'>(\'records\');\\n  const [fromDate, setFromDate] = useState(defaultFrom);\\n  const [toDate, setToDate] = useState(today);\\n  const [registerMonth, setRegisterMonth] = useState(today.slice(0, 7)); // YYYY-MM\\n  const [personFilter, setPersonFilter] = useState(\'all\');\\n  const [statusFilter, setStatusFilter] = useState<\'all\' | AttendanceStatus>(\'all\');\\n  const [search, setSearch] = useState(\'\');\\n  const [sortBy, setSortBy] = useState<\'date\' | \'personName\'>(\'date\');\\n  const [page, setPage] = useState(1);\\n\\n  const [loading, setLoading] = useState(true);\\n  const [records, setRecords] = useState<AttendanceRecord[]>([]);\\n  const [people, setPeople] = useState<UserProfile[]>([]);\\n\\n  const loadReportData = useCallback(async () => {\\n    if (!org || !profile) return;\\n    setLoading(true);\\n    try {\\n      const effectiveFrom =\\n        view === \'register\' ? `${registerMonth}-01` : fromDate;\\n      const effectiveTo =\\n        view === \'register\' ? `${registerMonth}-31` : toDate;\\n\\n      if (profile.role === \'admin\') {\\n        const [allUsers, recs] = await Promise.all([\\n          fetchOrgUsers(org.id),\\n          fetchAttendanceForOrg(org.id, { fromDate: effectiveFrom, toDate: effectiveTo }),\\n        ]);\\n        setPeople(allUsers.filter((u) => u.role !== \'admin\'));\\n        setRecords(recs);\\n      } else {\\n        const [members, recs] = await Promise.all([\\n          fetchManagerMembers(org.id, profile.uid),\\n          fetchAttendanceForManager(org.id, profile.uid, {\\n            fromDate: effectiveFrom,\\n            toDate: effectiveTo,\\n          }),\\n        ]);\\n        setPeople(members);\\n        setRecords(recs);\\n      }\\n    } catch (err) {\\n      showToast(t(getFirebaseErrorKey(err)), \'error\');\\n    } finally {\\n      setLoading(false);\\n    }\\n  }, [org, profile, fromDate, toDate, registerMonth, view, showToast, t]);\\n\\n  useEffect(() => {\\n    loadReportData();\\n  }, [loadReportData]);\\n\\n  const filteredRecords = useMemo(() => {\\n    const q = search.trim().toLowerCase();\\n    return records\\n      .filter((r) => {\\n        if (personFilter !== \'all\' && r.personUid !== personFilter) return false;\\n        if (statusFilter !== \'all\' && r.status !== statusFilter) return false;\\n        if (!q) return true;\\n        return (\\n          r.personName.toLowerCase().includes(q) ||\\n          (r.personMemberId || \'\').toLowerCase().includes(q) ||\\n          r.date.includes(q)\\n        );\\n      })\\n      .sort((a, b) =>\\n        sortBy === \'date\'\\n          ? b.date.localeCompare(a.date)\\n          : a.personName.localeCompare(b.personName)\\n      );\\n  }, [records, personFilter, statusFilter, search, sortBy]);\\n\\n  useEffect(() => {\\n    setPage(1);\\n  }, [personFilter, statusFilter, search, sortBy, view]);\\n\\n  const totalPages = Math.max(1, Math.ceil(filteredRecords.length / PAGE_SIZE));\\n  const paginatedRecords = filteredRecords.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);\\n\\n  // Per-person summary\\n  const summaryRows = useMemo(() => {\\n    const map = new Map<\\n      string,\\n      {\\n        uid: string;\\n        name: string;\\n        memberId: string;\\n        present: number;\\n        late: number;\\n        absent: number;\\n        leave: number;\\n        total: number;\\n        pct: number;\\n      }\\n    >();\\n\\n    for (const p of people) {\\n      if (personFilter !== \'all\' && p.uid !== personFilter) continue;\\n      map.set(p.uid, {\\n        uid: p.uid,\\n        name: p.name,\\n        memberId: p.memberId || \'\342\200\224\',\\n        present: 0,\\n        late: 0,\\n        absent: 0,\\n        leave: 0,\\n        total: 0,\\n        pct: 0,\\n      });\\n    }\\n\\n    for (const r of filteredRecords) {\\n      const existing = map.get(r.personUid) || {\\n        uid: r.personUid,\\n        name: r.personName,\\n        memberId: r.personMemberId || \'\342\200\224\',\\n        present: 0,\\n        late: 0,\\n        absent: 0,\\n        leave: 0,\\n        total: 0,\\n        pct: 0,\\n      };\\n      existing.total++;\\n      if (r.status === \'present\') existing.present++;\\n      else if (r.status === \'late\') existing.late++;\\n      else if (r.status === \'absent\') existing.absent++;\\n      else if (r.status === \'leave\') existing.leave++;\\n      map.set(r.personUid, existing);\\n    }\\n\\n    const q = search.trim().toLowerCase();\\n    return Array.from(map.values())\\n      .map((row) => ({\\n        ...row,\\n        pct: row.total > 0 ? Math.round(((row.present + row.late) / row.total) * 100) : 0,\\n      }))\\n      .filter(\\n        (r) =>\\n          !q ||\\n          r.name.toLowerCase().includes(q) ||\\n          r.memberId.toLowerCase().includes(q)\\n      )\\n      .sort((a, b) => a.name.localeCompare(b.name));\\n  }, [people, filteredRecords, personFilter, search]);\\n\\n  // Chart data\\n  const chartData = useMemo(() => {\\n    const byDate = new Map<string, { present: number; late: number; absent: number; leave: number }>();\\n    for (const r of filteredRecords) {\\n      const b = byDate.get(r.date) || { present: 0, late: 0, absent: 0, leave: 0 };\\n      b[r.status]++;\\n      byDate.set(r.date, b);\\n    }\\n    return Array.from(byDate.entries())\\n      .sort(([a], [b]) => a.localeCompare(b))\\n      .slice(-21)\\n      .map(([date, counts]) => ({\\n        date: formatDate(date, { day: \'numeric\', month: \'short\' }),\\n        ...counts,\\n      }));\\n  }, [filteredRecords, formatDate]);\\n\\n  // Register sheet days (1..daysInMonth)\\n  const registerDays = useMemo(() => {\\n    const [y, m] = registerMonth.split(\'-\').map(Number);\\n    const total = new Date(y, m, 0).getDate();\\n    return Array.from({ length: total }, (_, i) => i + 1);\\n  }, [registerMonth]);\\n\\n  const registerLookup = useMemo(() => {\\n    const map = new Map<string, AttendanceStatus>();\\n    for (const r of records) {\\n      map.set(`${r.personUid}_${r.date}`, r.status);\\n    }\\n    return map;\\n  }, [records]);\\n\\n  // Export CSV\\n  const handleExportCsv = () => {\\n    let csv = \'\';\\n    if (view === \'summary\') {\\n      csv = Papa.unparse(\\n        summaryRows.map((s) => ({\\n          Name: s.name,\\n          ID: s.memberId,\\n          Present: s.present,\\n          Late: s.late,\\n          Absent: s.absent,\\n          Leave: s.leave,\\n          Total: s.total,\\n          Percentage: `${s.pct}%`,\\n        }))\\n      );\\n    } else if (view === \'register\') {\\n      csv = Papa.unparse(\\n        people.map((p) => {\\n          const row: Record<string, string | number> = {\\n            Name: p.name,\\n            ID: p.memberId || \'\',\\n          };\\n          let presentCount = 0;\\n          for (const d of registerDays) {\\n            const ds = `${registerMonth}-${String(d).padStart(2, \'0\')}`;\\n            const st = registerLookup.get(`${p.uid}_${ds}`);\\n            row[String(d)] =\\n              st === \'present\' ? \'P\' : st === \'late\' ? \'L\' : st === \'absent\' ? \'A\' : st === \'leave\' ? \'LV\' : \'\';\\n            if (st === \'present\' || st === \'late\') presentCount++;\\n          }\\n          row[\'Total P+L\'] = presentCount;\\n          return row;\\n        })\\n      );\\n    } else {\\n      csv = Papa.unparse(\\n        filteredRecords.map((r) => ({\\n          Date: r.date,\\n          Name: r.personName,\\n          ID: r.personMemberId || \'\',\\n          Status: r.status,\\n          Method: r.method,\\n          Note: r.note || \'\',\\n        }))\\n      );\\n    }\\n\\n    const blob = new Blob([csv], { type: \'text/csv;charset=utf-8;\' });\\n    const url = URL.createObjectURL(blob);\\n    const a = document.createElement(\'a\');\\n    a.href = url;\\n    a.download = `attendance_${view}_${view === \'register\' ? registerMonth : `${fromDate}_to_${toDate}`}.csv`;\\n    a.click();\\n    URL.revokeObjectURL(url);\\n  };\\n\\n  // Export PDF\\n  const handleExportPdf = () => {\\n    const doc = new jsPDF({ orientation: view === \'register\' ? \'landscape\' : \'portrait\' });\\n    doc.setFontSize(15);\\n    doc.text(`${org?.name || \'Smart Attendance\'} \342\200\224 Attendance Report`, 14, 16);\\n    doc.setFontSize(10);\\n    doc.setTextColor(110);\\n    doc.text(\\n      view === \'register\'\\n        ? `Monthly Register: ${registerMonth}`\\n        : `Period: ${fromDate} to ${toDate}`,\\n      14,\\n      23\\n    );\\n\\n    if (view === \'summary\') {\\n      autoTable(doc, {\\n        startY: 29,\\n        head: [[\'Name\', \'ID\', \'Present\', \'Late\', \'Absent\', \'Leave\', \'Total\', \'%\']],\\n        body: summaryRows.map((s) => [\\n          s.name,\\n          s.memberId,\\n          s.present,\\n          s.late,\\n          s.absent,\\n          s.leave,\\n          s.total,\\n          `${s.pct}%`,\\n        ]),\\n        styles: { fontSize: 9 },\\n        headStyles: { fillColor: [194, 94, 0] },\\n      });\\n    } else if (view === \'register\') {\\n      const head = [[\'Name\', ...registerDays.map(String), \'P+L\']];\\n      const body = people.map((p) => {\\n        let pCount = 0;\\n        const cells = registerDays.map((d) => {\\n          const ds = `${registerMonth}-${String(d).padStart(2, \'0\')}`;\\n          const st = registerLookup.get(`${p.uid}_${ds}`);\\n          if (st === \'present\' || st === \'late\') pCount++;\\n          return st === \'present\' ? \'P\' : st === \'late\' ? \'L\' : st === \'absent\' ? \'A\' : st === \'leave\' ? \'LV\' : \'-\';\\n        });\\n        return [p.name, ...cells, String(pCount)];\\n      });\\n      autoTable(doc, {\\n        startY: 29,\\n        head,\\n        body,\\n        styles: { fontSize: 6.5, cellPadding: 1.5 },\\n        headStyles: { fillColor: [194, 94, 0] },\\n      });\\n    } else {\\n      autoTable(doc, {\\n        startY: 29,\\n        head: [[\'Date\', \'Name\', \'ID\', \'Status\', \'Method\', \'Note\']],\\n        body: filteredRecords.map((r) => [\\n          r.date,\\n          r.personName,\\n          r.personMemberId || \'\',\\n          r.status,\\n          r.method,\\n          r.note || \'\',\\n        ]),\\n        styles: { fontSize: 9 },\\n        headStyles: { fillColor: [194, 94, 0] },\\n      });\\n    }\\n\\n    doc.save(`attendance_${view}_${today}.pdf`);\\n  };\\n\\n  return (\\n    <Layout title={t(\'reports.title\')}>\\n      <div className=\\\"space-y-6\\\">\\n        {/* Top Controls & Export Buttons */}\\n        <div className=\\\"flex flex-col md:flex-row md:items-center justify-between gap-4\\\">\\n          <div className=\\\"inline-flex p-1 rounded-xl bg-stone-100 dark:bg-stone-900 border border-stone-200 dark:border-stone-800 self-start\\\">\\n            {([\'records\', \'summary\', \'register\'] as const).map((tabKey) => (\\n              <button\\n                key={tabKey}\\n                type=\\\"button\\\"\\n                onClick={() => setView(tabKey)}\\n                className={`px-3.5 py-2 rounded-lg text-xs sm:text-sm font-medium transition-colors whitespace-nowrap ${\\n                  view === tabKey\\n                    ? \'bg-white dark:bg-stone-800 text-stone-900 dark:text-stone-100 shadow-xs\'\\n                    : \'text-stone-600 dark:text-stone-400\'\\n                }`}\\n              >\\n                {tabKey === \'records\'\\n                  ? t(\'reports.tabRecords\')\\n                  : tabKey === \'summary\'\\n                  ? t(\'reports.tabSummary\')\\n                  : t(\'reports.tabRegister\')}\\n              </button>\\n            ))}\\n          </div>\\n\\n          <div className=\\\"flex items-center gap-2.5\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={handleExportCsv}\\n              className=\\\"inline-flex items-center gap-2 rounded-xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] hover:bg-stone-50 dark:hover:bg-stone-800 px-3.5 py-2 text-sm font-medium\\\"\\n            >\\n              <Download className=\\\"w-4 h-4\\\" />\\n              <span>{t(\'reports.exportCsv\')}</span>\\n            </button>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={handleExportPdf}\\n              className=\\\"inline-flex items-center gap-2 rounded-xl bg-[#C25E00] hover:bg-[#A84F00] text-white px-3.5 py-2 text-sm font-medium\\\"\\n            >\\n              <FileText className=\\\"w-4 h-4\\\" />\\n              <span>{t(\'reports.exportPdf\')}</span>\\n            </button>\\n          </div>\\n        </div>\\n\\n        {/* Filter Bar */}\\n        <div className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-4 flex flex-wrap items-end gap-3\\\">\\n          {view === \'register\' ? (\\n            <div>\\n              <label className=\\\"block text-xs text-stone-500 mb-1\\\">{t(\'reports.month\')}</label>\\n              <input\\n                type=\\\"month\\\"\\n                value={registerMonth}\\n                onChange={(e) => setRegisterMonth(e.target.value)}\\n                className=\\\"rounded-xl border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-900 px-3 py-2 text-sm\\\"\\n              />\\n            </div>\\n          ) : (\\n            <>\\n              <div>\\n                <label className=\\\"block text-xs text-stone-500 mb-1\\\">{t(\'reports.from\')}</label>\\n                <input\\n                  type=\\\"date\\\"\\n                  value={fromDate}\\n                  onChange={(e) => setFromDate(e.target.value)}\\n                  className=\\\"rounded-xl border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-900 px-3 py-2 text-sm\\\"\\n                />\\n              </div>\\n              <div>\\n                <label className=\\\"block text-xs text-stone-500 mb-1\\\">{t(\'reports.to\')}</label>\\n                <input\\n                  type=\\\"date\\\"\\n                  value={toDate}\\n                  onChange={(e) => setToDate(e.target.value)}\\n                  className=\\\"rounded-xl border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-900 px-3 py-2 text-sm\\\"\\n                />\\n              </div>\\n              <div>\\n                <label className=\\\"block text-xs text-stone-500 mb-1\\\">{t(\'reports.person\')}</label>\\n                <select\\n                  value={personFilter}\\n                  onChange={(e) => setPersonFilter(e.target.value)}\\n                  className=\\\"rounded-xl border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-900 px-3 py-2 text-sm max-w-[180px]\\\"\\n                >\\n                  <option value=\\\"all\\\">{t(\'common.all\')}</option>\\n                  {people.map((p) => (\\n                    <option key={p.uid} value={p.uid}>\\n                      {p.name}\\n                    </option>\\n                  ))}\\n                </select>\\n              </div>\\n              <div>\\n                <label className=\\\"block text-xs text-stone-500 mb-1\\\">{t(\'common.status\')}</label>\\n                <select\\n                  value={statusFilter}\\n                  onChange={(e) => setStatusFilter(e.target.value as \'all\' | AttendanceStatus)}\\n                  className=\\\"rounded-xl border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-900 px-3 py-2 text-sm\\\"\\n                >\\n                  <option value=\\\"all\\\">{t(\'common.all\')}</option>\\n                  <option value=\\\"present\\\">{t(\'common.present\')}</option>\\n                  <option value=\\\"late\\\">{t(\'common.late\')}</option>\\n                  <option value=\\\"absent\\\">{t(\'common.absent\')}</option>\\n                  <option value=\\\"leave\\\">{t(\'common.leave\')}</option>\\n                </select>\\n              </div>\\n            </>\\n          )}\\n\\n          <div className=\\\"relative flex-1 min-w-[180px]\\\">\\n            <Search className=\\\"w-4 h-4 text-stone-400 absolute left-3 top-1/2 -translate-y-1/2\\\" />\\n            <input\\n              type=\\\"text\\\"\\n              value={search}\\n              onChange={(e) => setSearch(e.target.value)}\\n              placeholder={t(\'common.search\')}\\n              className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-transparent pl-9 pr-3 py-2 text-sm\\\"\\n            />\\n          </div>\\n        </div>\\n\\n        {/* Chart (Records & Summary views) */}\\n        {view !== \'register\' && chartData.length > 0 && (\\n          <section className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5\\\">\\n            <h3 className=\\\"text-sm font-semibold text-stone-900 dark:text-stone-100 mb-4\\\">\\n              {t(\'reports.chartTitle\')}\\n            </h3>\\n            <div className=\\\"h-56 w-full\\\">\\n              <ResponsiveContainer width=\\\"100%\\\" height=\\\"100%\\\">\\n                <BarChart data={chartData} margin={{ top: 4, right: 8, left: -20, bottom: 0 }}>\\n                  <CartesianGrid strokeDasharray=\\\"3 3\\\" stroke=\\\"#E7E5E4\\\" opacity={0.4} vertical={false} />\\n                  <XAxis dataKey=\\\"date\\\" tick={{ fontSize: 11, fill: \'#78716C\' }} axisLine={false} tickLine={false} />\\n                  <YAxis allowDecimals={false} tick={{ fontSize: 11, fill: \'#78716C\' }} axisLine={false} tickLine={false} />\\n                  <Tooltip contentStyle={{ borderRadius: \'12px\', border: \'1px solid #E7E5E4\', fontSize: \'12px\' }} />\\n                  <Bar dataKey=\\\"present\\\" name={t(\'common.present\')} stackId=\\\"a\\\" fill=\\\"#15803D\\\" />\\n                  <Bar dataKey=\\\"late\\\" name={t(\'common.late\')} stackId=\\\"a\\\" fill=\\\"#D97706\\\" />\\n                  <Bar dataKey=\\\"leave\\\" name={t(\'common.leave\')} stackId=\\\"a\\\" fill=\\\"#0284C7\\\" />\\n                  <Bar dataKey=\\\"absent\\\" name={t(\'common.absent\')} stackId=\\\"a\\\" fill=\\\"#DC2626\\\" radius={[4, 4, 0, 0]} />\\n                </BarChart>\\n              </ResponsiveContainer>\\n            </div>\\n          </section>\\n        )}\\n\\n        {/* Content Views */}\\n        {loading ? (\\n          <CardSkeleton rows={6} />\\n        ) : view === \'records\' ? (\\n          filteredRecords.length === 0 ? (\\n            <EmptyState title={t(\'reports.emptyTitle\')} description={t(\'reports.emptyDesc\')} />\\n          ) : (\\n            <div className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] overflow-hidden\\\">\\n              <div className=\\\"overflow-x-auto\\\">\\n                <table className=\\\"w-full text-left text-sm\\\">\\n                  <thead className=\\\"border-b border-stone-200 dark:border-stone-800 bg-stone-50/70 dark:bg-stone-900/50 text-xs text-stone-500\\\">\\n                    <tr>\\n                      <th className=\\\"py-3 px-4 font-medium\\\">\\n                        <button\\n                          type=\\\"button\\\"\\n                          onClick={() => setSortBy(\'date\')}\\n                          className=\\\"hover:text-stone-900 dark:hover:text-stone-100\\\"\\n                        >\\n                          {t(\'common.date\')} {sortBy === \'date\' ? \'\342\206\223\' : \'\'}\\n                        </button>\\n                      </th>\\n                      <th className=\\\"py-3 px-4 font-medium\\\">\\n                        <button\\n                          type=\\\"button\\\"\\n                          onClick={() => setSortBy(\'personName\')}\\n                          className=\\\"hover:text-stone-900 dark:hover:text-stone-100\\\"\\n                        >\\n                          {t(\'common.name\')} {sortBy === \'personName\' ? \'\342\206\223\' : \'\'}\\n                        </button>\\n                      </th>\\n                      <th className=\\\"py-3 px-4 font-medium\\\">{t(\'common.memberId\')}</th>\\n                      <th className=\\\"py-3 px-4 font-medium\\\">{t(\'common.status\')}</th>\\n                      <th className=\\\"py-3 px-4 font-medium\\\">{t(\'reports.method\')}</th>\\n                      <th className=\\\"py-3 px-4 font-medium\\\">{t(\'common.note\')}</th>\\n                    </tr>\\n                  </thead>\\n                  <tbody className=\\\"divide-y divide-stone-100 dark:divide-stone-800\\\">\\n                    {paginatedRecords.map((r) => (\\n                      <tr key={r.id}>\\n                        <td className=\\\"py-3 px-4 text-xs tabular-nums whitespace-nowrap\\\">\\n                          {formatDate(r.date)}\\n                        </td>\\n                        <td className=\\\"py-3 px-4 font-medium text-stone-900 dark:text-stone-100\\\">\\n                          {r.personName}\\n                        </td>\\n                        <td className=\\\"py-3 px-4 font-mono text-xs text-stone-500\\\">\\n                          {r.personMemberId || \'\342\200\224\'}\\n                        </td>\\n                        <td className=\\\"py-3 px-4 text-xs font-semibold\\\">\\n                          <span\\n                            className={\\n                              r.status === \'present\'\\n                                ? \'text-emerald-700 dark:text-emerald-400\'\\n                                : r.status === \'late\'\\n                                ? \'text-amber-700 dark:text-amber-400\'\\n                                : r.status === \'leave\'\\n                                ? \'text-sky-700 dark:text-sky-400\'\\n                                : \'text-red-700 dark:text-red-400\'\\n                            }\\n                          >\\n                            {t(`common.${r.status}`)}\\n                          </span>\\n                        </td>\\n                        <td className=\\\"py-3 px-4 text-xs text-stone-500\\\">\\n                          {t(`common.${r.method}`)}\\n                        </td>\\n                        <td className=\\\"py-3 px-4 text-xs text-stone-500 max-w-xs truncate\\\">\\n                          {r.note || \'\342\200\224\'}\\n                        </td>\\n                      </tr>\\n                    ))}\\n                  </tbody>\\n                </table>\\n              </div>\\n\\n              {totalPages > 1 && (\\n                <div className=\\\"px-4 py-3 border-t border-stone-200 dark:border-stone-800 flex items-center justify-between text-xs text-stone-500\\\">\\n                  <span className=\\\"tabular-nums\\\">\\n                    {t(\'common.page\')} {formatNumber(page)} {t(\'common.of\')}{\' \'}\\n                    {formatNumber(totalPages)}\\n                  </span>\\n                  <div className=\\\"flex items-center gap-2\\\">\\n                    <button\\n                      type=\\\"button\\\"\\n                      disabled={page <= 1}\\n                      onClick={() => setPage((p) => p - 1)}\\n                      className=\\\"rounded-lg border border-stone-200 dark:border-stone-700 px-3 py-1 disabled:opacity-40\\\"\\n                    >\\n                      {t(\'common.previous\')}\\n                    </button>\\n                    <button\\n                      type=\\\"button\\\"\\n                      disabled={page >= totalPages}\\n                      onClick={() => setPage((p) => p + 1)}\\n                      className=\\\"rounded-lg border border-stone-200 dark:border-stone-700 px-3 py-1 disabled:opacity-40\\\"\\n                    >\\n                      {t(\'common.next\')}\\n                    </button>\\n                  </div>\\n                </div>\\n              )}\\n            </div>\\n          )\\n        ) : view === \'summary\' ? (\\n          summaryRows.length === 0 ? (\\n            <EmptyState title={t(\'reports.emptyTitle\')} description={t(\'reports.emptyDesc\')} />\\n          ) : (\\n            <div className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] overflow-hidden\\\">\\n              <div className=\\\"overflow-x-auto\\\">\\n                <table className=\\\"w-full text-left text-sm\\\">\\n                  <thead className=\\\"border-b border-stone-200 dark:border-stone-800 bg-stone-50/70 dark:bg-stone-900/50 text-xs text-stone-500\\\">\\n                    <tr>\\n                      <th className=\\\"py-3 px-4 font-medium\\\">{t(\'common.name\')}</th>\\n                      <th className=\\\"py-3 px-4 font-medium\\\">{t(\'common.memberId\')}</th>\\n                      <th className=\\\"py-3 px-4 font-medium text-right\\\">{t(\'reports.presentDays\')}</th>\\n                      <th className=\\\"py-3 px-4 font-medium text-right\\\">{t(\'reports.lateDays\')}</th>\\n                      <th className=\\\"py-3 px-4 font-medium text-right\\\">{t(\'reports.absentDays\')}</th>\\n                      <th className=\\\"py-3 px-4 font-medium text-right\\\">{t(\'reports.leaveDays\')}</th>\\n                      <th className=\\\"py-3 px-4 font-medium text-right\\\">{t(\'reports.percentage\')}</th>\\n                    </tr>\\n                  </thead>\\n                  <tbody className=\\\"divide-y divide-stone-100 dark:divide-stone-800 tabular-nums\\\">\\n                    {summaryRows.map((s) => (\\n                      <tr key={s.uid}>\\n                        <td className=\\\"py-3 px-4 font-medium text-stone-900 dark:text-stone-100\\\">\\n                          {s.name}\\n                        </td>\\n                        <td className=\\\"py-3 px-4 font-mono text-xs text-stone-500\\\">{s.memberId}</td>\\n                        <td className=\\\"py-3 px-4 text-right text-emerald-700 dark:text-emerald-400\\\">\\n                          {formatNumber(s.present)}\\n                        </td>\\n                        <td className=\\\"py-3 px-4 text-right text-amber-700 dark:text-amber-400\\\">\\n                          {formatNumber(s.late)}\\n                        </td>\\n                        <td className=\\\"py-3 px-4 text-right text-red-700 dark:text-red-400\\\">\\n                          {formatNumber(s.absent)}\\n                        </td>\\n                        <td className=\\\"py-3 px-4 text-right text-sky-700 dark:text-sky-400\\\">\\n                          {formatNumber(s.leave)}\\n                        </td>\\n                        <td className=\\\"py-3 px-4 text-right font-semibold\\\">\\n                          <span\\n                            className={\\n                              s.total > 0 && s.pct < (org?.lowAttendanceThreshold ?? 75)\\n                                ? \'text-red-700 dark:text-red-400\'\\n                                : \'text-stone-900 dark:text-stone-100\'\\n                            }\\n                          >\\n                            {formatNumber(s.pct)}%\\n                          </span>\\n                        </td>\\n                      </tr>\\n                    ))}\\n                  </tbody>\\n                </table>\\n              </div>\\n            </div>\\n          )\\n        ) : (\\n          /* Monthly Register Sheet */\\n          people.length === 0 ? (\\n            <EmptyState title={t(\'reports.emptyTitle\')} description={t(\'reports.emptyDesc\')} />\\n          ) : (\\n            <div className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] overflow-hidden\\\">\\n              <div className=\\\"overflow-x-auto\\\">\\n                <table className=\\\"w-full text-left text-xs border-collapse\\\">\\n                  <thead className=\\\"border-b border-stone-200 dark:border-stone-800 bg-stone-50 dark:bg-stone-900 text-stone-500\\\">\\n                    <tr>\\n                      <th className=\\\"py-2.5 px-3 font-medium sticky left-0 bg-stone-50 dark:bg-stone-900 z-10 min-w-[150px]\\\">\\n                        {t(\'common.name\')}\\n                      </th>\\n                      {registerDays.map((d) => (\\n                        <th key={d} className=\\\"py-2.5 px-1.5 text-center font-mono font-medium\\\">\\n                          {d}\\n                        </th>\\n                      ))}\\n                      <th className=\\\"py-2.5 px-3 text-right font-medium\\\">P+L</th>\\n                    </tr>\\n                  </thead>\\n                  <tbody className=\\\"divide-y divide-stone-100 dark:divide-stone-800 tabular-nums\\\">\\n                    {people\\n                      .filter(\\n                        (p) =>\\n                          !search.trim() ||\\n                          p.name.toLowerCase().includes(search.trim().toLowerCase())\\n                      )\\n                      .map((p) => {\\n                        let attended = 0;\\n                        return (\\n                          <tr key={p.uid}>\\n                            <td className=\\\"py-2 px-3 font-medium text-stone-900 dark:text-stone-100 sticky left-0 bg-white dark:bg-[#161619] border-r border-stone-100 dark:border-stone-800 truncate max-w-[180px]\\\">\\n                              {p.name}\\n                            </td>\\n                            {registerDays.map((d) => {\\n                              const ds = `${registerMonth}-${String(d).padStart(2, \'0\')}`;\\n                              const st = registerLookup.get(`${p.uid}_${ds}`);\\n                              if (st === \'present\' || st === \'late\') attended++;\\n                              const symbol =\\n                                st === \'present\'\\n                                  ? \'P\'\\n                                  : st === \'late\'\\n                                  ? \'L\'\\n                                  : st === \'absent\'\\n                                  ? \'A\'\\n                                  : st === \'leave\'\\n                                  ? \'LV\'\\n                                  : \'\302\267\';\\n                              const cls =\\n                                st === \'present\'\\n                                  ? \'text-emerald-700 dark:text-emerald-400 font-semibold\'\\n                                  : st === \'late\'\\n                                  ? \'text-amber-700 dark:text-amber-400 font-semibold\'\\n                                  : st === \'absent\'\\n                                  ? \'text-red-600 dark:text-red-400 font-semibold\'\\n                                  : st === \'leave\'\\n                                  ? \'text-sky-600 dark:text-sky-400 font-semibold\'\\n                                  : \'text-stone-300 dark:text-stone-700\';\\n                              return (\\n                                <td key={d} className={`py-2 px-1 text-center ${cls}`}>\\n                                  {symbol}\\n                                </td>\\n                              );\\n                            })}\\n                            <td className=\\\"py-2 px-3 text-right font-semibold text-stone-900 dark:text-stone-100\\\">\\n                              {formatNumber(attended)}\\n                            </td>\\n                          </tr>\\n                        );\\n                      })}\\n                  </tbody>\\n                </table>\\n              </div>\\n            </div>\\n          )\\n        )}\\n      </div>\\n    </Layout>\\n  );\\n};\\n\", \"Description\":\"Create ReportsPage with Records, Per-person Summary, Monthly Register Sheet, Recharts chart, filters, CSV and PDF exports\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/ReportsPage.tsx\", \"toolAction\":\"Creating ReportsPage\", \"toolSummary\":\"Create ReportsPage.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_16405764573190887349"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useEffect, useState } from \'react\';\\nimport { Database, MapPin, QrCode, Trash2 } from \'lucide-react\';\\nimport { useAuth } from \'../context/AuthContext\';\\nimport { useTranslation } from \'../hooks/useTranslation\';\\nimport { useTheme } from \'../context/ThemeContext\';\\nimport { useToast } from \'../context/ToastContext\';\\nimport type { OrgType } from \'../types\';\\nimport { updateOrganization } from \'../services/orgService\';\\nimport { updateUserDetails } from \'../services/userService\';\\nimport { deleteDemoData, loadDemoData } from \'../services/demoService\';\\nimport { getCurrentPosition, getFirebaseErrorKey } from \'../utils/helpers\';\\nimport { Layout } from \'../components/Layout\';\\nimport { LanguageToggle } from \'../components/LanguageToggle\';\\nimport { PWAInstallButton } from \'../components/PWAInstallButton\';\\nimport { QRCardModal } from \'../components/QRCardModal\';\\n\\nconst ORG_TYPES: OrgType[] = [\'College\', \'School\', \'Coaching\', \'Company\', \'Other\'];\\nconst TIMEZONES = [\\n  \'Asia/Kolkata\',\\n  \'Asia/Dubai\',\\n  \'Asia/Singapore\',\\n  \'Europe/London\',\\n  \'America/New_York\',\\n  \'America/Los_Angeles\',\\n  \'UTC\',\\n];\\n\\nexport const SettingsPage: React.FC = () => {\\n  const { profile, org, getRoleLabel } = useAuth();\\n  const { t } = useTranslation();\\n  const { theme, setTheme } = useTheme();\\n  const { showToast } = useToast();\\n\\n  // Profile fields\\n  const [myName, setMyName] = useState(profile?.name || \'\');\\n  const [myPhone, setMyPhone] = useState(profile?.phone || \'\');\\n  const [myRoll, setMyRoll] = useState(profile?.rollNumber || \'\');\\n  const [savingProfile, setSavingProfile] = useState(false);\\n\\n  // Org fields (Admin only)\\n  const [orgName, setOrgName] = useState(org?.name || \'\');\\n  const [orgType, setOrgType] = useState<OrgType>(org?.type || \'College\');\\n  const [managerLabel, setManagerLabel] = useState(org?.roleLabels?.manager || \'Manager\');\\n  const [memberLabel, setMemberLabel] = useState(org?.roleLabels?.member || \'Member\');\\n  const [lateAfter, setLateAfter] = useState(org?.lateAfter || \'09:30\');\\n  const [timezone, setTimezone] = useState(org?.timezone || \'Asia/Kolkata\');\\n  const [lowThreshold, setLowThreshold] = useState(org?.lowAttendanceThreshold ?? 75);\\n  const [locEnabled, setLocEnabled] = useState(org?.location?.enabled ?? false);\\n  const [locRadius, setLocRadius] = useState(org?.location?.radius ?? 200);\\n  const [locLat, setLocLat] = useState(org?.location?.lat ?? 0);\\n  const [locLng, setLocLng] = useState(org?.location?.lng ?? 0);\\n  const [savingOrg, setSavingOrg] = useState(false);\\n  const [locating, setLocating] = useState(false);\\n\\n  // Demo data state\\n  const [demoBusy, setDemoBusy] = useState<\'loading\' | \'deleting\' | null>(null);\\n  const [showQr, setShowQr] = useState(false);\\n\\n  useEffect(() => {\\n    if (profile) {\\n      setMyName(profile.name);\\n      setMyPhone(profile.phone || \'\');\\n      setMyRoll(profile.rollNumber || \'\');\\n    }\\n  }, [profile]);\\n\\n  useEffect(() => {\\n    if (org) {\\n      setOrgName(org.name);\\n      setOrgType(org.type);\\n      setManagerLabel(org.roleLabels?.manager || \'Manager\');\\n      setMemberLabel(org.roleLabels?.member || \'Member\');\\n      setLateAfter(org.lateAfter || \'09:30\');\\n      setTimezone(org.timezone || \'Asia/Kolkata\');\\n      setLowThreshold(org.lowAttendanceThreshold ?? 75);\\n      setLocEnabled(org.location?.enabled ?? false);\\n      setLocRadius(org.location?.radius ?? 200);\\n      setLocLat(org.location?.lat ?? 0);\\n      setLocLng(org.location?.lng ?? 0);\\n    }\\n  }, [org]);\\n\\n  const handleSaveProfile = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    if (!profile) return;\\n    setSavingProfile(true);\\n    try {\\n      await updateUserDetails(profile.uid, {\\n        name: myName.trim(),\\n        phone: myPhone.trim(),\\n        rollNumber: myRoll.trim(),\\n      });\\n      showToast(t(\'settings.savedToast\'), \'success\');\\n    } catch (err) {\\n      showToast(t(getFirebaseErrorKey(err)), \'error\');\\n    } finally {\\n      setSavingProfile(false);\\n    }\\n  };\\n\\n  const handleSaveOrg = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    if (!org) return;\\n    setSavingOrg(true);\\n    try {\\n      await updateOrganization(org.id, org.orgCode, {\\n        name: orgName.trim(),\\n        type: orgType,\\n        roleLabels: {\\n          manager: managerLabel.trim() || \'Manager\',\\n          member: memberLabel.trim() || \'Member\',\\n        },\\n        lateAfter,\\n        timezone,\\n        lowAttendanceThreshold: Number(lowThreshold) || 75,\\n        location: {\\n          enabled: locEnabled,\\n          radius: Number(locRadius) || 200,\\n          lat: locLat,\\n          lng: locLng,\\n        },\\n      });\\n      showToast(t(\'settings.savedToast\'), \'success\');\\n    } catch (err) {\\n      showToast(t(getFirebaseErrorKey(err)), \'error\');\\n    } finally {\\n      setSavingOrg(false);\\n    }\\n  };\\n\\n  const handleSetCurrentLocation = async () => {\\n    setLocating(true);\\n    try {\\n      const pos = await getCurrentPosition();\\n      setLocLat(Number(pos.lat.toFixed(6)));\\n      setLocLng(Number(pos.lng.toFixed(6)));\\n      showToast(t(\'settings.locationSet\'), \'success\');\\n    } catch {\\n      showToast(t(\'attendance.locationDenied\'), \'error\');\\n    } finally {\\n      setLocating(false);\\n    }\\n  };\\n\\n  const handleLoadDemo = async () => {\\n    if (!org || !profile) return;\\n    setDemoBusy(\'loading\');\\n    try {\\n      await loadDemoData(org, profile);\\n      showToast(t(\'settings.demoLoadedToast\'), \'success\');\\n    } catch (err) {\\n      showToast(t(getFirebaseErrorKey(err)), \'error\');\\n    } finally {\\n      setDemoBusy(null);\\n    }\\n  };\\n\\n  const handleDeleteDemo = async () => {\\n    if (!org) return;\\n    setDemoBusy(\'deleting\');\\n    try {\\n      await deleteDemoData(org.id);\\n      showToast(t(\'settings.demoDeletedToast\'), \'info\');\\n    } catch (err) {\\n      showToast(t(getFirebaseErrorKey(err)), \'error\');\\n    } finally {\\n      setDemoBusy(null);\\n    }\\n  };\\n\\n  return (\\n    <Layout title={t(\'settings.title\')}>\\n      <div className=\\\"space-y-8 max-w-3xl\\\">\\n        {/* Profile */}\\n        <section className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5 sm:p-6\\\">\\n          <div className=\\\"flex items-center justify-between mb-4\\\">\\n            <h2 className=\\\"text-base font-semibold text-stone-900 dark:text-stone-100\\\">\\n              {t(\'settings.profileSection\')}\\n            </h2>\\n            {profile && profile.role !== \'admin\' && (\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setShowQr(true)}\\n                className=\\\"inline-flex items-center gap-1.5 text-xs font-medium text-[#C25E00] hover:underline\\\"\\n              >\\n                <QrCode className=\\\"w-4 h-4\\\" />\\n                <span>{t(\'dashboard.showQr\')}</span>\\n              </button>\\n            )}\\n          </div>\\n\\n          <form onSubmit={handleSaveProfile} className=\\\"space-y-4\\\">\\n            <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-4\\\">\\n              <div>\\n                <label className=\\\"block text-sm font-medium mb-1\\\">{t(\'common.name\')}</label>\\n                <input\\n                  type=\\\"text\\\"\\n                  required\\n                  value={myName}\\n                  onChange={(e) => setMyName(e.target.value)}\\n                  className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-transparent px-3.5 py-2 text-sm\\\"\\n                />\\n              </div>\\n              <div>\\n                <label className=\\\"block text-sm font-medium mb-1\\\">{t(\'common.email\')}</label>\\n                <input\\n                  type=\\\"email\\\"\\n                  disabled\\n                  value={profile?.email || \'\'}\\n                  className=\\\"w-full rounded-xl border border-stone-200 dark:border-stone-800 bg-stone-50 dark:bg-stone-900 px-3.5 py-2 text-sm text-stone-500\\\"\\n                />\\n              </div>\\n            </div>\\n\\n            <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-4\\\">\\n              <div>\\n                <label className=\\\"block text-sm font-medium mb-1\\\">{t(\'common.phone\')}</label>\\n                <input\\n                  type=\\\"tel\\\"\\n                  value={myPhone}\\n                  onChange={(e) => setMyPhone(e.target.value)}\\n                  className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-transparent px-3.5 py-2 text-sm\\\"\\n                />\\n              </div>\\n              <div>\\n                <label className=\\\"block text-sm font-medium mb-1\\\">{t(\'common.rollNumber\')}</label>\\n                <input\\n                  type=\\\"text\\\"\\n                  value={myRoll}\\n                  onChange={(e) => setMyRoll(e.target.value)}\\n                  className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-transparent px-3.5 py-2 text-sm\\\"\\n                />\\n              </div>\\n            </div>\\n\\n            <button\\n              type=\\\"submit\\\"\\n              disabled={savingProfile}\\n              className=\\\"rounded-xl bg-[#C25E00] hover:bg-[#A84F00] disabled:opacity-60 text-white px-5 py-2 text-sm font-medium\\\"\\n            >\\n              {savingProfile ? t(\'common.saving\') : t(\'common.save\')}\\n            </button>\\n          </form>\\n        </section>\\n\\n        {/* Preferences */}\\n        <section className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5 sm:p-6 space-y-5\\\">\\n          <h2 className=\\\"text-base font-semibold text-stone-900 dark:text-stone-100\\\">\\n            {t(\'settings.preferencesSection\')}\\n          </h2>\\n\\n          <div className=\\\"flex items-center justify-between gap-4\\\">\\n            <span className=\\\"text-sm text-stone-700 dark:text-stone-300\\\">\\n              {t(\'settings.languageLabel\')}\\n            </span>\\n            <LanguageToggle />\\n          </div>\\n\\n          <div className=\\\"flex items-center justify-between gap-4\\\">\\n            <span className=\\\"text-sm text-stone-700 dark:text-stone-300\\\">\\n              {t(\'settings.themeLabel\')}\\n            </span>\\n            <div className=\\\"inline-flex p-1 rounded-lg bg-stone-100 dark:bg-stone-900 border border-stone-200 dark:border-stone-800 text-xs font-medium\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setTheme(\'light\')}\\n                className={`px-3 py-1 rounded-md ${\\n                  theme === \'light\'\\n                    ? \'bg-white dark:bg-stone-800 text-stone-900 dark:text-stone-100 shadow-xs\'\\n                    : \'text-stone-500\'\\n                }`}\\n              >\\n                {t(\'settings.lightMode\')}\\n              </button>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setTheme(\'dark\')}\\n                className={`px-3 py-1 rounded-md ${\\n                  theme === \'dark\'\\n                    ? \'bg-white dark:bg-stone-800 text-stone-900 dark:text-stone-100 shadow-xs\'\\n                    : \'text-stone-500\'\\n                }`}\\n              >\\n                {t(\'settings.darkMode\')}\\n              </button>\\n            </div>\\n          </div>\\n\\n          <div>\\n            <PWAInstallButton />\\n          </div>\\n        </section>\\n\\n        {/* Admin Organization Settings */}\\n        {profile?.role === \'admin\' && org && (\\n          <>\\n            <section className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5 sm:p-6\\\">\\n              <h2 className=\\\"text-base font-semibold text-stone-900 dark:text-stone-100 mb-5\\\">\\n                {t(\'settings.orgSection\')}\\n              </h2>\\n\\n              <form onSubmit={handleSaveOrg} className=\\\"space-y-5\\\">\\n                <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-4\\\">\\n                  <div>\\n                    <label className=\\\"block text-sm font-medium mb-1\\\">\\n                      {t(\'settings.orgName\')}\\n                    </label>\\n                    <input\\n                      type=\\\"text\\\"\\n                      required\\n                      value={orgName}\\n                      onChange={(e) => setOrgName(e.target.value)}\\n                      className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-transparent px-3.5 py-2 text-sm\\\"\\n                    />\\n                  </div>\\n                  <div>\\n                    <label className=\\\"block text-sm font-medium mb-1\\\">\\n                      {t(\'settings.orgType\')}\\n                    </label>\\n                    <select\\n                      value={orgType}\\n                      onChange={(e) => setOrgType(e.target.value as OrgType)}\\n                      className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-900 px-3.5 py-2 text-sm\\\"\\n                    >\\n                      {ORG_TYPES.map((type) => (\\n                        <option key={type} value={type}>\\n                          {t(`auth.orgTypes.${type}`)}\\n                        </option>\\n                      ))}\\n                    </select>\\n                  </div>\\n                </div>\\n\\n                <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-4\\\">\\n                  <div>\\n                    <label className=\\\"block text-sm font-medium mb-1\\\">\\n                      {t(\'settings.managerLabel\')}\\n                    </label>\\n                    <input\\n                      type=\\\"text\\\"\\n                      value={managerLabel}\\n                      onChange={(e) => setManagerLabel(e.target.value)}\\n                      placeholder=\\\"Teacher / Team Lead\\\"\\n                      className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-transparent px-3.5 py-2 text-sm\\\"\\n                    />\\n                  </div>\\n                  <div>\\n                    <label className=\\\"block text-sm font-medium mb-1\\\">\\n                      {t(\'settings.memberLabel\')}\\n                    </label>\\n                    <input\\n                      type=\\\"text\\\"\\n                      value={memberLabel}\\n                      onChange={(e) => setMemberLabel(e.target.value)}\\n                      placeholder=\\\"Student / Employee\\\"\\n                      className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-transparent px-3.5 py-2 text-sm\\\"\\n                    />\\n                  </div>\\n                </div>\\n\\n                <div className=\\\"grid grid-cols-1 sm:grid-cols-3 gap-4\\\">\\n                  <div>\\n                    <label className=\\\"block text-sm font-medium mb-1\\\">\\n                      {t(\'settings.lateAfter\')}\\n                    </label>\\n                    <input\\n                      type=\\\"time\\\"\\n                      value={lateAfter}\\n                      onChange={(e) => setLateAfter(e.target.value)}\\n                      className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-900 px-3.5 py-2 text-sm\\\"\\n                    />\\n                    <p className=\\\"mt-1 text-[11px] text-stone-500\\\">{t(\'settings.lateAfterHint\')}</p>\\n                  </div>\\n                  <div>\\n                    <label className=\\\"block text-sm font-medium mb-1\\\">\\n                      {t(\'settings.timezone\')}\\n                    </label>\\n                    <select\\n                      value={timezone}\\n                      onChange={(e) => setTimezone(e.target.value)}\\n                      className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-900 px-3.5 py-2 text-sm\\\"\\n                    >\\n                      {TIMEZONES.map((tz) => (\\n                        <option key={tz} value={tz}>\\n                          {tz}\\n                        </option>\\n                      ))}\\n                    </select>\\n                  </div>\\n                  <div>\\n                    <label className=\\\"block text-sm font-medium mb-1\\\">\\n                      {t(\'settings.lowThreshold\')}\\n                    </label>\\n                    <input\\n                      type=\\\"number\\\"\\n                      min={10}\\n                      max={100}\\n                      value={lowThreshold}\\n                      onChange={(e) => setLowThreshold(Number(e.target.value))}\\n                      className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-transparent px-3.5 py-2 text-sm tabular-nums\\\"\\n                    />\\n                  </div>\\n                </div>\\n\\n                {/* Location Check */}\\n                <div className=\\\"pt-4 border-t border-stone-200 dark:border-stone-800 space-y-4\\\">\\n                  <div className=\\\"flex items-start justify-between gap-4\\\">\\n                    <div>\\n                      <h3 className=\\\"text-sm font-semibold text-stone-900 dark:text-stone-100\\\">\\n                        {t(\'settings.locationSection\')}\\n                      </h3>\\n                      <p className=\\\"text-xs text-stone-500 mt-0.5\\\">{t(\'settings.locationDesc\')}</p>\\n                    </div>\\n                    <input\\n                      type=\\\"checkbox\\\"\\n                      checked={locEnabled}\\n                      onChange={(e) => setLocEnabled(e.target.checked)}\\n                      aria-label={t(\'settings.enableLocation\')}\\n                      className=\\\"w-5 h-5 accent-[#C25E00] mt-0.5 cursor-pointer\\\"\\n                    />\\n                  </div>\\n\\n                  {locEnabled && (\\n                    <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-4 items-end\\\">\\n                      <div>\\n                        <label className=\\\"block text-xs font-medium mb-1\\\">\\n                          {t(\'settings.radiusMeters\')}\\n                        </label>\\n                        <input\\n                          type=\\\"number\\\"\\n                          min={20}\\n                          max={5000}\\n                          value={locRadius}\\n                          onChange={(e) => setLocRadius(Number(e.target.value))}\\n                          className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-transparent px-3.5 py-2 text-sm tabular-nums\\\"\\n                        />\\n                      </div>\\n\\n                      <div className=\\\"space-y-1.5\\\">\\n                        <button\\n                          type=\\\"button\\\"\\n                          disabled={locating}\\n                          onClick={handleSetCurrentLocation}\\n                          className=\\\"w-full inline-flex items-center justify-center gap-2 rounded-xl border border-stone-300 dark:border-stone-700 hover:bg-stone-50 dark:hover:bg-stone-800 px-3.5 py-2 text-sm font-medium\\\"\\n                        >\\n                          <MapPin className=\\\"w-4 h-4 text-[#C25E00]\\\" />\\n                          <span>\\n                            {locating ? t(\'common.loading\') : t(\'settings.setCurrentLocation\')}\\n                          </span>\\n                        </button>\\n                        <p className=\\\"text-[11px] font-mono text-stone-500\\\">\\n                          {locLat || locLng\\n                            ? `${locLat}, ${locLng}`\\n                            : t(\'settings.noLocationSaved\')}\\n                        </p>\\n                      </div>\\n                    </div>\\n                  )}\\n                </div>\\n\\n                <button\\n                  type=\\\"submit\\\"\\n                  disabled={savingOrg}\\n                  className=\\\"rounded-xl bg-[#C25E00] hover:bg-[#A84F00] disabled:opacity-60 text-white px-5 py-2.5 text-sm font-medium\\\"\\n                >\\n                  {savingOrg ? t(\'common.saving\') : t(\'common.save\')}\\n                </button>\\n              </form>\\n            </section>\\n\\n            {/* Demo Data Controls */}\\n            <section className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5 sm:p-6\\\">\\n              <h2 className=\\\"text-base font-semibold text-stone-900 dark:text-stone-100\\\">\\n                {t(\'settings.demoSection\')}\\n              </h2>\\n              <p className=\\\"mt-1.5 text-sm text-stone-600 dark:text-stone-400\\\">\\n                {t(\'settings.demoDesc\')}\\n              </p>\\n\\n              <div className=\\\"mt-5 flex flex-wrap items-center gap-3\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  disabled={demoBusy !== null}\\n                  onClick={handleLoadDemo}\\n                  className=\\\"inline-flex items-center gap-2 rounded-xl bg-stone-900 dark:bg-stone-100 text-white dark:text-stone-900 hover:opacity-90 disabled:opacity-50 px-4 py-2.5 text-sm font-medium\\\"\\n                >\\n                  <Database className=\\\"w-4 h-4\\\" />\\n                  <span>\\n                    {demoBusy === \'loading\'\\n                      ? t(\'settings.loadingDemo\')\\n                      : t(\'settings.loadDemoBtn\')}\\n                  </span>\\n                </button>\\n\\n                {org.hasDemoData && (\\n                  <button\\n                    type=\\\"button\\\"\\n                    disabled={demoBusy !== null}\\n                    onClick={handleDeleteDemo}\\n                    className=\\\"inline-flex items-center gap-2 rounded-xl border border-red-300 dark:border-red-900 text-red-700 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-950/30 disabled:opacity-50 px-4 py-2.5 text-sm font-medium\\\"\\n                  >\\n                    <Trash2 className=\\\"w-4 h-4\\\" />\\n                    <span>\\n                      {demoBusy === \'deleting\'\\n                        ? t(\'settings.deletingDemo\')\\n                        : t(\'settings.deleteDemoBtn\')}\\n                    </span>\\n                  </button>\\n                )}\\n              </div>\\n            </section>\\n          </>\\n        )}\\n      </div>\\n\\n      {showQr && profile && org && (\\n        <QRCardModal\\n          person={profile}\\n          org={org}\\n          roleLabel={getRoleLabel(profile.role === \'manager\' ? \'manager\' : \'member\')}\\n          onClose={() => setShowQr(false)}\\n        />\\n      )}\\n    </Layout>\\n  );\\n};\\n\", \"Description\":\"Create SettingsPage with profile editing, language/theme/PWA controls, org settings (role labels, late time, timezone, GPS location check), and Load/Delete Demo Data controls\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/SettingsPage.tsx\", \"toolAction\":\"Creating SettingsPage\", \"toolSummary\":\"Create SettingsPage.tsx\"}"
      original_name: "write_to_file"
    }
    thinking_duration {
      seconds: 175
      nanos: 687231066
