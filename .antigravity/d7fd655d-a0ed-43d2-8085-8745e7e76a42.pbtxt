    tool_calls {
      id: "call_12234253231292600134"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React from \'react\';\\nimport { useTranslation } from \'../hooks/useTranslation\';\\n\\nexport const LanguageToggle: React.FC = () => {\\n  const { language, setLanguage } = useTranslation();\\n\\n  return (\\n    <div\\n      role=\\\"group\\\"\\n      aria-label=\\\"Language\\\"\\n      className=\\\"inline-flex items-center rounded-lg border border-stone-200 dark:border-stone-800 bg-stone-100/70 dark:bg-stone-900 p-0.5 text-xs font-medium shrink-0\\\"\\n    >\\n      <button\\n        type=\\\"button\\\"\\n        onClick={() => setLanguage(\'en\')}\\n        className={`px-2 py-1 rounded-md transition-colors whitespace-nowrap ${\\n          language === \'en\'\\n            ? \'bg-white dark:bg-stone-800 text-stone-900 dark:text-stone-100 shadow-xs\'\\n            : \'text-stone-500 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-200\'\\n        }`}\\n      >\\n        EN\\n      </button>\\n      <button\\n        type=\\\"button\\\"\\n        onClick={() => setLanguage(\'hi\')}\\n        className={`px-2 py-1 rounded-md transition-colors whitespace-nowrap ${\\n          language === \'hi\'\\n            ? \'bg-white dark:bg-stone-800 text-stone-900 dark:text-stone-100 shadow-xs\'\\n            : \'text-stone-500 dark:text-stone-400 hover:text-stone-900 dark:hover:text-stone-200\'\\n        }`}\\n      >\\n        \340\244\271\340\244\277\340\244\202\\n      </button>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create EN | \340\244\271\340\244\277\340\244\202 segmented LanguageToggle component\", \"Overwrite\":true, \"TargetFile\":\"/src/components/LanguageToggle.tsx\", \"toolAction\":\"Creating LanguageToggle component\", \"toolSummary\":\"Create LanguageToggle.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_12234253231292597911"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React from \'react\';\\nimport { Moon, Sun } from \'lucide-react\';\\nimport { useTheme } from \'../context/ThemeContext\';\\n\\nexport const ThemeToggle: React.FC = () => {\\n  const { theme, toggleTheme } = useTheme();\\n\\n  return (\\n    <button\\n      type=\\\"button\\\"\\n      onClick={toggleTheme}\\n      aria-label={theme === \'dark\' ? \'Switch to light mode\' : \'Switch to dark mode\'}\\n      className=\\\"inline-flex items-center justify-center w-9 h-9 rounded-lg border border-stone-200 dark:border-stone-800 text-stone-600 dark:text-stone-300 hover:bg-stone-100 dark:hover:bg-stone-800 transition-colors shrink-0\\\"\\n    >\\n      {theme === \'dark\' ? <Sun className=\\\"w-4 h-4\\\" /> : <Moon className=\\\"w-4 h-4\\\" />}\\n    </button>\\n  );\\n};\\n\", \"Description\":\"Create ThemeToggle component for light/dark switching\", \"Overwrite\":true, \"TargetFile\":\"/src/components/ThemeToggle.tsx\", \"toolAction\":\"Creating ThemeToggle component\", \"toolSummary\":\"Create ThemeToggle.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_12234253231292599784"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport { Download, X } from \'lucide-react\';\\nimport { usePWAInstall } from \'../hooks/usePWAInstall\';\\nimport { useTranslation } from \'../hooks/useTranslation\';\\n\\ninterface PWAInstallButtonProps {\\n  compact?: boolean;\\n}\\n\\nexport const PWAInstallButton: React.FC<PWAInstallButtonProps> = ({ compact = false }) => {\\n  const { isInstallable, isInstalled, isIOS, install } = usePWAInstall();\\n  const { t } = useTranslation();\\n  const [showIOSGuide, setShowIOSGuide] = useState(false);\\n\\n  if (isInstalled) return null;\\n\\n  if (isInstallable) {\\n    return (\\n      <button\\n        type=\\\"button\\\"\\n        onClick={install}\\n        className={`inline-flex items-center gap-2 rounded-lg border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 text-stone-800 dark:text-stone-100 hover:bg-stone-50 dark:hover:bg-stone-800 transition-colors whitespace-nowrap shrink-0 ${\\n          compact ? \'px-2.5 py-1.5 text-xs font-medium\' : \'px-3.5 py-2 text-sm font-medium\'\\n        }`}\\n      >\\n        <Download className=\\\"w-4 h-4 text-[#C25E00]\\\" />\\n        <span>{t(\'common.installApp\')}</span>\\n      </button>\\n    );\\n  }\\n\\n  if (isIOS) {\\n    return (\\n      <>\\n        <button\\n          type=\\\"button\\\"\\n          onClick={() => setShowIOSGuide(true)}\\n          className={`inline-flex items-center gap-2 rounded-lg border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 text-stone-800 dark:text-stone-100 hover:bg-stone-50 dark:hover:bg-stone-800 transition-colors whitespace-nowrap shrink-0 ${\\n            compact ? \'px-2.5 py-1.5 text-xs font-medium\' : \'px-3.5 py-2 text-sm font-medium\'\\n          }`}\\n        >\\n          <Download className=\\\"w-4 h-4 text-[#C25E00]\\\" />\\n          <span>{t(\'common.installOnIOS\')}</span>\\n        </button>\\n\\n        {showIOSGuide && (\\n          <div className=\\\"fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4\\\">\\n            <div className=\\\"w-full max-w-sm rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 p-6 shadow-xl\\\">\\n              <div className=\\\"flex items-center justify-between mb-3\\\">\\n                <h3 className=\\\"text-base font-semibold text-stone-900 dark:text-stone-100\\\">\\n                  {t(\'common.installOnIOS\')}\\n                </h3>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setShowIOSGuide(false)}\\n                  aria-label={t(\'common.close\')}\\n                  className=\\\"text-stone-400 hover:text-stone-700 dark:hover:text-stone-200\\\"\\n                >\\n                  <X className=\\\"w-5 h-5\\\" />\\n                </button>\\n              </div>\\n              <ol className=\\\"space-y-2 text-sm text-stone-600 dark:text-stone-300 list-decimal list-inside\\\">\\n                <li>Tap the Share button in Safari.</li>\\n                <li>Scroll down and tap Add to Home Screen.</li>\\n                <li>Tap Add in the top right corner.</li>\\n              </ol>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setShowIOSGuide(false)}\\n                className=\\\"mt-5 w-full rounded-lg bg-stone-900 dark:bg-stone-100 text-white dark:text-stone-900 py-2 text-sm font-medium\\\"\\n              >\\n                {t(\'common.close\')}\\n              </button>\\n            </div>\\n          </div>\\n        )}\\n      </>\\n    );\\n  }\\n\\n  return null;\\n};\\n\", \"Description\":\"Create PWAInstallButton supporting native Chromium install prompt and iOS Safari instructions\", \"Overwrite\":true, \"TargetFile\":\"/src/components/PWAInstallButton.tsx\", \"toolAction\":\"Creating PWAInstallButton component\", \"toolSummary\":\"Create PWAInstallButton.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_12234253231292597561"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React from \'react\';\\nimport { WifiOff } from \'lucide-react\';\\nimport { useOnlineStatus } from \'../hooks/useOnlineStatus\';\\nimport { useTranslation } from \'../hooks/useTranslation\';\\n\\nexport const OfflineIndicator: React.FC = () => {\\n  const isOnline = useOnlineStatus();\\n  const { t } = useTranslation();\\n\\n  if (isOnline) return null;\\n\\n  return (\\n    <div\\n      role=\\\"alert\\\"\\n      className=\\\"fixed bottom-16 md:bottom-4 left-4 right-4 md:right-auto z-50 flex items-center gap-2.5 rounded-xl border border-amber-300 dark:border-amber-800 bg-amber-50 dark:bg-amber-950/90 px-4 py-2.5 text-xs font-medium text-amber-900 dark:text-amber-200 shadow-md\\\"\\n    >\\n      <WifiOff className=\\\"w-4 h-4 shrink-0\\\" />\\n      <span>{t(\'common.offlineBanner\')}</span>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create OfflineIndicator component displaying a calm translated offline banner\", \"Overwrite\":true, \"TargetFile\":\"/src/components/OfflineIndicator.tsx\", \"toolAction\":\"Creating OfflineIndicator component\", \"toolSummary\":\"Create OfflineIndicator.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_12234253231292599434"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React from \'react\';\\n\\nexport const CardSkeleton: React.FC<{ rows?: number }> = ({ rows = 3 }) => (\\n  <div className=\\\"space-y-3 animate-pulse\\\">\\n    {Array.from({ length: rows }).map((_, i) => (\\n      <div\\n        key={i}\\n        className=\\\"h-14 rounded-xl bg-stone-200/70 dark:bg-stone-800/70\\\"\\n      />\\n    ))}\\n  </div>\\n);\\n\\nexport const StatGridSkeleton: React.FC = () => (\\n  <div className=\\\"grid grid-cols-2 lg:grid-cols-4 gap-4 animate-pulse\\\">\\n    {[0, 1, 2, 3].map((i) => (\\n      <div\\n        key={i}\\n        className=\\\"h-28 rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 p-5\\\"\\n      >\\n        <div className=\\\"h-3.5 w-20 bg-stone-200 dark:bg-stone-800 rounded mb-4\\\" />\\n        <div className=\\\"h-8 w-16 bg-stone-200 dark:bg-stone-800 rounded\\\" />\\n      </div>\\n    ))}\\n  </div>\\n);\\n\\ninterface EmptyStateProps {\\n  title: string;\\n  description: string;\\n  actionLabel?: string;\\n  onAction?: () => void;\\n}\\n\\nexport const EmptyState: React.FC<EmptyStateProps> = ({\\n  title,\\n  description,\\n  actionLabel,\\n  onAction,\\n}) => (\\n  <div className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 px-6 py-12 text-center\\\">\\n    <h3 className=\\\"text-base font-semibold text-stone-900 dark:text-stone-100\\\">{title}</h3>\\n    <p className=\\\"mt-1.5 text-sm text-stone-500 dark:text-stone-400 max-w-md mx-auto\\\">\\n      {description}\\n    </p>\\n    {actionLabel && onAction && (\\n      <button\\n        type=\\\"button\\\"\\n        onClick={onAction}\\n        className=\\\"mt-5 inline-flex items-center justify-center rounded-lg bg-[#C25E00] hover:bg-[#A84F00] text-white px-4 py-2 text-sm font-medium transition-colors\\\"\\n      >\\n        {actionLabel}\\n      </button>\\n    )}\\n  </div>\\n);\\n\", \"Description\":\"Create loading skeleton components and calm EmptyState component\", \"Overwrite\":true, \"TargetFile\":\"/src/components/Skeletons.tsx\", \"toolAction\":\"Creating Skeleton and EmptyState components\", \"toolSummary\":\"Create Skeletons.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_12234253231292597211"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useRef } from \'react\';\\nimport { QRCodeCanvas } from \'qrcode.react\';\\nimport { Download, Printer, X } from \'lucide-react\';\\nimport type { Organization, UserProfile } from \'../types\';\\nimport { useTranslation } from \'../hooks/useTranslation\';\\n\\ninterface QRCardModalProps {\\n  person: UserProfile;\\n  org: Organization;\\n  roleLabel: string;\\n  onClose: () => void;\\n}\\n\\nexport const QRCardModal: React.FC<QRCardModalProps> = ({\\n  person,\\n  org,\\n  roleLabel,\\n  onClose,\\n}) => {\\n  const { t } = useTranslation();\\n  const canvasWrapRef = useRef<HTMLDivElement>(null);\\n\\n  const qrValue = JSON.stringify({\\n    orgId: org.id,\\n    uid: person.uid,\\n    memberId: person.memberId,\\n  });\\n\\n  const handleDownloadQR = () => {\\n    const sourceCanvas = canvasWrapRef.current?.querySelector(\'canvas\');\\n    if (!sourceCanvas) return;\\n\\n    // Build a clean printable PNG with org name, person name, member ID, and QR code\\n    const outCanvas = document.createElement(\'canvas\');\\n    const W = 560;\\n    const H = 700;\\n    outCanvas.width = W;\\n    outCanvas.height = H;\\n    const ctx = outCanvas.getContext(\'2d\');\\n    if (!ctx) return;\\n\\n    ctx.fillStyle = \'#FAF9F6\';\\n    ctx.fillRect(0, 0, W, H);\\n\\n    ctx.strokeStyle = \'#E7E5E4\';\\n    ctx.lineWidth = 4;\\n    ctx.strokeRect(16, 16, W - 32, H - 32);\\n\\n    ctx.fillStyle = \'#C25E00\';\\n    ctx.fillRect(16, 16, W - 32, 12);\\n\\n    ctx.fillStyle = \'#78716C\';\\n    ctx.font = \'600 18px Inter, sans-serif\';\\n    ctx.textAlign = \'center\';\\n    ctx.fillText(org.name, W / 2, 74);\\n\\n    ctx.fillStyle = \'#1C1917\';\\n    ctx.font = \'700 28px Inter, sans-serif\';\\n    ctx.fillText(person.name, W / 2, 118);\\n\\n    ctx.fillStyle = \'#57534E\';\\n    ctx.font = \'500 18px \\\"JetBrains Mono\\\", monospace\';\\n    ctx.fillText(`${person.memberId}  \302\267  ${roleLabel}`, W / 2, 152);\\n\\n    // Draw white frame behind QR\\n    const qrSize = 360;\\n    const qrX = (W - qrSize) / 2;\\n    const qrY = 190;\\n    ctx.fillStyle = \'#FFFFFF\';\\n    ctx.fillRect(qrX - 18, qrY - 18, qrSize + 36, qrSize + 36);\\n    ctx.drawImage(sourceCanvas, qrX, qrY, qrSize, qrSize);\\n\\n    ctx.fillStyle = \'#78716C\';\\n    ctx.font = \'400 16px Inter, sans-serif\';\\n    ctx.fillText(\'Smart Attendance System\', W / 2, H - 48);\\n\\n    const link = document.createElement(\'a\');\\n    link.download = `${person.memberId || person.name.replace(/\\\\s+/g, \'_\')}-QR.png`;\\n    link.href = outCanvas.toDataURL(\'image/png\');\\n    link.click();\\n  };\\n\\n  const handlePrintCard = () => {\\n    const sourceCanvas = canvasWrapRef.current?.querySelector(\'canvas\');\\n    const qrDataUrl = sourceCanvas ? sourceCanvas.toDataURL(\'image/png\') : \'\';\\n    const printArea = document.createElement(\'div\');\\n    printArea.className = \'print-only fixed inset-0 bg-white flex items-center justify-center p-8 z-[999]\';\\n    printArea.innerHTML = `\\n      <div style=\\\"width:320px;border:1px solid #d6d3d1;border-radius:16px;padding:24px;text-align:center;font-family:Inter,sans-serif;background:#fff;color:#1c1917;\\\">\\n        <div style=\\\"height:6px;background:#C25E00;border-radius:3px;margin-bottom:18px;\\\"></div>\\n        <div style=\\\"font-size:12px;color:#78716c;font-weight:600;margin-bottom:6px;\\\">${org.name}</div>\\n        <div style=\\\"font-size:20px;font-weight:700;margin-bottom:4px;\\\">${person.name}</div>\\n        <div style=\\\"font-size:13px;color:#57534e;font-family:monospace;margin-bottom:18px;\\\">${person.memberId} \302\267 ${roleLabel}</div>\\n        <img src=\\\"${qrDataUrl}\\\" style=\\\"width:210px;height:210px;margin:0 auto;display:block;\\\" alt=\\\"QR Code\\\" />\\n        ${person.rollNumber ? `<div style=\\\"font-size:12px;color:#78716c;margin-top:12px;\\\">Roll/Emp: ${person.rollNumber}</div>` : \'\'}\\n        <div style=\\\"font-size:11px;color:#a8a29e;margin-top:14px;\\\">Smart Attendance System</div>\\n      </div>\\n    `;\\n    document.body.appendChild(printArea);\\n    window.print();\\n    document.body.removeChild(printArea);\\n  };\\n\\n  return (\\n    <div className=\\\"fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4 no-print\\\">\\n      <div className=\\\"w-full max-w-sm rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 p-6 shadow-xl\\\">\\n        <div className=\\\"flex items-center justify-between mb-4\\\">\\n          <h3 className=\\\"text-base font-semibold text-stone-900 dark:text-stone-100\\\">\\n            {t(\'qr.title\')}\\n          </h3>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={onClose}\\n            aria-label={t(\'common.close\')}\\n            className=\\\"text-stone-400 hover:text-stone-700 dark:hover:text-stone-200 p-1\\\"\\n          >\\n            <X className=\\\"w-5 h-5\\\" />\\n          </button>\\n        </div>\\n\\n        <div className=\\\"rounded-xl border border-stone-200 dark:border-stone-800 bg-[#FAF9F6] dark:bg-stone-950 p-5 text-center\\\">\\n          <p className=\\\"text-xs font-medium text-stone-500 dark:text-stone-400\\\">{org.name}</p>\\n          <h4 className=\\\"mt-1 text-lg font-semibold text-stone-900 dark:text-stone-100\\\">\\n            {person.name}\\n          </h4>\\n          <p className=\\\"mt-0.5 text-xs font-mono text-stone-600 dark:text-stone-400\\\">\\n            {person.memberId || \'\342\200\224\'} \302\267 {roleLabel}\\n          </p>\\n\\n          <div\\n            ref={canvasWrapRef}\\n            className=\\\"mt-4 inline-flex items-center justify-center rounded-xl bg-white p-4 border border-stone-200\\\"\\n          >\\n            <QRCodeCanvas value={qrValue} size={200} level=\\\"M\\\" includeMargin={false} />\\n          </div>\\n\\n          <p className=\\\"mt-3 text-xs text-stone-500 dark:text-stone-400\\\">{t(\'qr.scanHint\')}</p>\\n        </div>\\n\\n        <div className=\\\"mt-5 grid grid-cols-2 gap-3\\\">\\n          <button\\n            type=\\\"button\\\"\\n            onClick={handleDownloadQR}\\n            className=\\\"inline-flex items-center justify-center gap-2 rounded-lg bg-[#C25E00] hover:bg-[#A84F00] text-white px-3.5 py-2.5 text-sm font-medium transition-colors\\\"\\n          >\\n            <Download className=\\\"w-4 h-4\\\" />\\n            <span>{t(\'qr.downloadQr\')}</span>\\n          </button>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={handlePrintCard}\\n            className=\\\"inline-flex items-center justify-center gap-2 rounded-lg border border-stone-200 dark:border-stone-700 bg-white dark:bg-stone-800 text-stone-800 dark:text-stone-100 hover:bg-stone-50 dark:hover:bg-stone-700 px-3.5 py-2.5 text-sm font-medium transition-colors\\\"\\n          >\\n            <Printer className=\\\"w-4 h-4\\\" />\\n            <span>{t(\'qr.printCard\')}</span>\\n          </button>\\n        </div>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create QRCardModal with QR generation, PNG download with formatted ID layout, and Print ID Card support\", \"Overwrite\":true, \"TargetFile\":\"/src/components/QRCardModal.tsx\", \"toolAction\":\"Creating QRCardModal component\", \"toolSummary\":\"Create QRCardModal.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_12234253231292599084"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React from \'react\';\\nimport { Navigate } from \'react-router-dom\';\\nimport { useAuth } from \'../context/AuthContext\';\\nimport type { UserRole } from \'../types\';\\n\\ninterface ProtectedRouteProps {\\n  allowedRoles?: UserRole[];\\n  allowPending?: boolean;\\n  children: React.ReactNode;\\n}\\n\\nexport function getHomePathForRole(role?: UserRole): string {\\n  if (role === \'admin\') return \'/admin\';\\n  if (role === \'manager\') return \'/manager\';\\n  if (role === \'member\') return \'/member\';\\n  return \'/login\';\\n}\\n\\nexport const ProtectedRoute: React.FC<ProtectedRouteProps> = ({\\n  allowedRoles,\\n  allowPending = false,\\n  children,\\n}) => {\\n  const { user, profile, loading } = useAuth();\\n\\n  if (loading) {\\n    return (\\n      <div className=\\\"min-h-screen flex items-center justify-center bg-[#FAF9F6] dark:bg-[#0F0F11]\\\">\\n        <div className=\\\"w-7 h-7 rounded-full border-2 border-stone-300 dark:border-stone-700 border-t-[#C25E00] animate-spin\\\" />\\n      </div>\\n    );\\n  }\\n\\n  if (!user || !profile) {\\n    return <Navigate to=\\\"/login\\\" replace />;\\n  }\\n\\n  if (profile.status === \'pending\' || profile.status === \'inactive\') {\\n    if (allowPending) return <>{children}</>;\\n    return <Navigate to=\\\"/pending\\\" replace />;\\n  }\\n\\n  if (allowPending && profile.status === \'active\') {\\n    return <Navigate to={getHomePathForRole(profile.role)} replace />;\\n  }\\n\\n  if (allowedRoles && !allowedRoles.includes(profile.role)) {\\n    return <Navigate to={getHomePathForRole(profile.role)} replace />;\\n  }\\n\\n  return <>{children}</>;\\n};\\n\", \"Description\":\"Create ProtectedRoute enforcing authentication, pending/inactive status redirects, and strict role-based routing\", \"Overwrite\":true, \"TargetFile\":\"/src/components/ProtectedRoute.tsx\", \"toolAction\":\"Creating ProtectedRoute component\", \"toolSummary\":\"Create ProtectedRoute.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_12234253231292596861"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useEffect, useRef, useState } from \'react\';\\nimport { Link, NavLink, useLocation, useNavigate } from \'react-router-dom\';\\nimport {\\n  BarChart3,\\n  Bell,\\n  CalendarClock,\\n  LayoutDashboard,\\n  LogOut,\\n  Megaphone,\\n  QrCode,\\n  ScanLine,\\n  Settings,\\n  Users,\\n  UserCog,\\n} from \'lucide-react\';\\nimport { useAuth } from \'../context/AuthContext\';\\nimport { useTranslation } from \'../hooks/useTranslation\';\\nimport type { AppNotification } from \'../types\';\\nimport {\\n  markAllNotificationsRead,\\n  markNotificationRead,\\n  subscribeNotifications,\\n} from \'../services/communicationService\';\\nimport { getInitials } from \'../utils/helpers\';\\nimport { Logo } from \'./Logo\';\\nimport { LanguageToggle } from \'./LanguageToggle\';\\nimport { ThemeToggle } from \'./ThemeToggle\';\\nimport { PWAInstallButton } from \'./PWAInstallButton\';\\n\\ninterface LayoutProps {\\n  title?: string;\\n  children: React.ReactNode;\\n}\\n\\ninterface NavItem {\\n  to: string;\\n  label: string;\\n  icon: React.FC<{ className?: string }>;\\n  mobile?: boolean;\\n}\\n\\nexport const Layout: React.FC<LayoutProps> = ({ title, children }) => {\\n  const { profile, org, logout, getRoleLabel } = useAuth();\\n  const { t, formatTime } = useTranslation();\\n  const navigate = useNavigate();\\n  const location = useLocation();\\n  const [notifications, setNotifications] = useState<AppNotification[]>([]);\\n  const [notifOpen, setNotifOpen] = useState(false);\\n  const notifRef = useRef<HTMLDivElement>(null);\\n\\n  useEffect(() => {\\n    if (!profile?.uid) return;\\n    return subscribeNotifications(profile.uid, setNotifications);\\n  }, [profile?.uid]);\\n\\n  useEffect(() => {\\n    const onClickOutside = (e: MouseEvent) => {\\n      if (notifRef.current && !notifRef.current.contains(e.target as Node)) {\\n        setNotifOpen(false);\\n      }\\n    };\\n    document.addEventListener(\'mousedown\', onClickOutside);\\n    return () => document.removeEventListener(\'mousedown\', onClickOutside);\\n  }, []);\\n\\n  const unreadCount = notifications.filter((n) => !n.read).length;\\n\\n  const managerLabel = getRoleLabel(\'manager\');\\n  const memberLabel = getRoleLabel(\'member\');\\n\\n  const navItems: NavItem[] = (() => {\\n    if (profile?.role === \'admin\') {\\n      return [\\n        { to: \'/admin\', label: t(\'nav.dashboard\'), icon: LayoutDashboard, mobile: true },\\n        { to: \'/attendance\', label: t(\'nav.markAttendance\'), icon: ScanLine, mobile: true },\\n        { to: \'/admin/managers\', label: managerLabel, icon: UserCog, mobile: true },\\n        { to: \'/admin/members\', label: memberLabel, icon: Users },\\n        { to: \'/reports\', label: t(\'nav.reports\'), icon: BarChart3, mobile: true },\\n        { to: \'/leaves\', label: t(\'nav.leaves\'), icon: CalendarClock },\\n        { to: \'/announcements\', label: t(\'nav.announcements\'), icon: Megaphone },\\n        { to: \'/settings\', label: t(\'nav.settings\'), icon: Settings, mobile: true },\\n      ];\\n    }\\n    if (profile?.role === \'manager\') {\\n      return [\\n        { to: \'/manager\', label: t(\'nav.dashboard\'), icon: LayoutDashboard, mobile: true },\\n        { to: \'/attendance\', label: t(\'nav.markAttendance\'), icon: ScanLine, mobile: true },\\n        { to: \'/manager/members\', label: memberLabel, icon: Users, mobile: true },\\n        { to: \'/reports\', label: t(\'nav.reports\'), icon: BarChart3, mobile: true },\\n        { to: \'/leaves\', label: t(\'nav.leaves\'), icon: CalendarClock },\\n        { to: \'/announcements\', label: t(\'nav.announcements\'), icon: Megaphone },\\n        { to: \'/settings\', label: t(\'nav.settings\'), icon: Settings, mobile: true },\\n      ];\\n    }\\n    return [\\n      { to: \'/member\', label: t(\'nav.myQr\'), icon: QrCode, mobile: true },\\n      { to: \'/leaves\', label: t(\'nav.leaves\'), icon: CalendarClock, mobile: true },\\n      { to: \'/announcements\', label: t(\'nav.announcements\'), icon: Megaphone, mobile: true },\\n      { to: \'/settings\', label: t(\'nav.settings\'), icon: Settings, mobile: true },\\n    ];\\n  })();\\n\\n  const mobileItems = navItems.filter((item) => item.mobile);\\n\\n  const handleLogout = async () => {\\n    await logout();\\n    navigate(\'/login\');\\n  };\\n\\n  const pageHeading =\\n    title || navItems.find((item) => item.to === location.pathname)?.label || t(\'nav.dashboard\');\\n\\n  return (\\n    <div className=\\\"min-h-screen bg-[#FAF9F6] dark:bg-[#0F0F11] text-stone-900 dark:text-stone-100 flex\\\">\\n      {/* Desktop Sidebar */}\\n      <aside className=\\\"hidden md:flex md:flex-col md:w-60 lg:w-64 border-r border-stone-200 dark:border-stone-800 bg-white dark:bg-[#141416] fixed inset-y-0 left-0 z-30 no-print\\\">\\n        <div className=\\\"h-16 px-5 flex items-center border-b border-stone-200 dark:border-stone-800\\\">\\n          <Link to={profile?.role === \'admin\' ? \'/admin\' : profile?.role === \'manager\' ? \'/manager\' : \'/member\'}>\\n            <Logo />\\n          </Link>\\n        </div>\\n\\n        {org && (\\n          <div className=\\\"px-5 py-3.5 border-b border-stone-100 dark:border-stone-800/80\\\">\\n            <p className=\\\"text-sm font-semibold text-stone-900 dark:text-stone-100 truncate\\\">\\n              {org.name}\\n            </p>\\n            <p className=\\\"text-xs text-stone-500 dark:text-stone-400 truncate mt-0.5\\\">\\n              {profile?.role === \'admin\'\\n                ? t(\'common.admin\')\\n                : profile?.role === \'manager\'\\n                ? managerLabel\\n                : memberLabel}\\n              {profile?.memberId ? ` \302\267 ${profile.memberId}` : \'\'}\\n            </p>\\n          </div>\\n        )}\\n\\n        <nav className=\\\"flex-1 overflow-y-auto px-3 py-4 space-y-1\\\">\\n          {(profile?.role === \'admin\' || profile?.role === \'manager\') && (\\n            <Link\\n              to=\\\"/attendance\\\"\\n              className=\\\"mb-3 flex items-center justify-center gap-2 rounded-xl bg-[#C25E00] hover:bg-[#A84F00] text-white px-4 py-2.5 text-sm font-medium transition-colors\\\"\\n            >\\n              <ScanLine className=\\\"w-4 h-4\\\" />\\n              <span className=\\\"whitespace-nowrap\\\">{t(\'nav.markAttendance\')}</span>\\n            </Link>\\n          )}\\n\\n          {navItems.map((item) => {\\n            const Icon = item.icon;\\n            return (\\n              <NavLink\\n                key={item.to}\\n                to={item.to}\\n                end={item.to === \'/admin\' || item.to === \'/manager\' || item.to === \'/member\'}\\n                className={({ isActive }) =>\\n                  `flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition-colors ${\\n                    isActive\\n                      ? \'bg-stone-100 dark:bg-stone-800/90 text-stone-900 dark:text-stone-100\'\\n                      : \'text-stone-600 dark:text-stone-400 hover:bg-stone-50 dark:hover:bg-stone-800/50 hover:text-stone-900 dark:hover:text-stone-100\'\\n                  }`\\n                }\\n              >\\n                <Icon className=\\\"w-4 h-4 shrink-0\\\" />\\n                <span className=\\\"truncate\\\">{item.label}</span>\\n              </NavLink>\\n            );\\n          })}\\n        </nav>\\n\\n        <div className=\\\"p-3 border-t border-stone-200 dark:border-stone-800 space-y-2\\\">\\n          <div className=\\\"flex items-center gap-2.5 px-2 py-1.5\\\">\\n            <div className=\\\"w-8 h-8 rounded-full bg-stone-200 dark:bg-stone-800 text-stone-700 dark:text-stone-200 flex items-center justify-center text-xs font-semibold shrink-0\\\">\\n              {getInitials(profile?.name || \'\')}\\n            </div>\\n            <div className=\\\"min-w-0 flex-1\\\">\\n              <p className=\\\"text-sm font-medium text-stone-900 dark:text-stone-100 truncate\\\">\\n                {profile?.name}\\n              </p>\\n              <p className=\\\"text-xs text-stone-500 dark:text-stone-400 truncate\\\">\\n                {profile?.email}\\n              </p>\\n            </div>\\n          </div>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={handleLogout}\\n            className=\\\"w-full flex items-center gap-2.5 rounded-lg px-3 py-2 text-sm text-stone-600 dark:text-stone-400 hover:bg-stone-100 dark:hover:bg-stone-800 hover:text-stone-900 dark:hover:text-stone-100 transition-colors\\\"\\n          >\\n            <LogOut className=\\\"w-4 h-4\\\" />\\n            <span>{t(\'common.logout\')}</span>\\n          </button>\\n        </div>\\n      </aside>\\n\\n      {/* Main Content Area */}\\n      <div className=\\\"flex-1 flex flex-col md:pl-60 lg:pl-64 min-w-0\\\">\\n        {/* Top Header */}\\n        <header className=\\\"sticky top-0 z-20 h-14 md:h-16 border-b border-stone-200 dark:border-stone-800 bg-[#FAF9F6]/90 dark:bg-[#0F0F11]/90 backdrop-blur-md px-4 md:px-8 flex items-center justify-between gap-4 no-print\\\">\\n          <div className=\\\"flex items-center gap-3 min-w-0\\\">\\n            <div className=\\\"md:hidden\\\">\\n              <Logo compact />\\n            </div>\\n            <h1 className=\\\"text-base md:text-lg font-semibold tracking-tight text-stone-900 dark:text-stone-100 truncate\\\">\\n              {pageHeading}\\n            </h1>\\n          </div>\\n\\n          <div className=\\\"flex items-center gap-2 shrink-0\\\">\\n            <div className=\\\"hidden sm:block\\\">\\n              <PWAInstallButton compact />\\n            </div>\\n            <LanguageToggle />\\n            <ThemeToggle />\\n\\n            {/* Notification Bell */}\\n            <div ref={notifRef} className=\\\"relative\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setNotifOpen((o) => !o)}\\n                aria-label={t(\'notifications.title\')}\\n                className=\\\"relative inline-flex items-center justify-center w-9 h-9 rounded-lg border border-stone-200 dark:border-stone-800 text-stone-600 dark:text-stone-300 hover:bg-stone-100 dark:hover:bg-stone-800 transition-colors\\\"\\n              >\\n                <Bell className=\\\"w-4 h-4\\\" />\\n                {unreadCount > 0 && (\\n                  <span className=\\\"absolute -top-1 -right-1 min-w-[18px] h-[18px] px-1 rounded-full bg-[#C25E00] text-white text-[10px] font-semibold flex items-center justify-center tabular-nums\\\">\\n                    {unreadCount > 9 ? \'9+\' : unreadCount}\\n                  </span>\\n                )}\\n              </button>\\n\\n              {notifOpen && (\\n                <div className=\\\"absolute right-0 mt-2 w-80 max-w-[calc(100vw-2rem)] rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 shadow-xl overflow-hidden z-40\\\">\\n                  <div className=\\\"flex items-center justify-between px-4 py-3 border-b border-stone-100 dark:border-stone-800\\\">\\n                    <span className=\\\"text-sm font-semibold text-stone-900 dark:text-stone-100\\\">\\n                      {t(\'notifications.title\')}\\n                    </span>\\n                    {unreadCount > 0 && (\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() => markAllNotificationsRead(notifications)}\\n                        className=\\\"text-xs font-medium text-[#C25E00] hover:underline\\\"\\n                      >\\n                        {t(\'notifications.markAllRead\')}\\n                      </button>\\n                    )}\\n                  </div>\\n                  <div className=\\\"max-h-80 overflow-y-auto divide-y divide-stone-100 dark:divide-stone-800\\\">\\n                    {notifications.length === 0 ? (\\n                      <p className=\\\"px-4 py-8 text-center text-xs text-stone-500 dark:text-stone-400\\\">\\n                        {t(\'notifications.empty\')}\\n                      </p>\\n                    ) : (\\n                      notifications.map((item) => (\\n                        <button\\n                          key={item.id}\\n                          type=\\\"button\\\"\\n                          onClick={() => {\\n                            if (!item.read) markNotificationRead(item.id);\\n                          }}\\n                          className={`w-full text-left px-4 py-3 text-xs transition-colors hover:bg-stone-50 dark:hover:bg-stone-800/60 ${\\n                            !item.read ? \'bg-amber-50/50 dark:bg-amber-950/20\' : \'\'\\n                          }`}\\n                        >\\n                          <p\\n                            className={`leading-relaxed ${\\n                              !item.read\\n                                ? \'font-medium text-stone-900 dark:text-stone-100\'\\n                                : \'text-stone-600 dark:text-stone-400\'\\n                            }`}\\n                          >\\n                            {item.text}\\n                          </p>\\n                          <p className=\\\"mt-1 text-[11px] text-stone-400\\\">\\n                            {formatTime(item.createdAt?.toDate?.())}\\n                          </p>\\n                        </button>\\n                      ))\\n                    )}\\n                  </div>\\n                </div>\\n              )}\\n            </div>\\n          </div>\\n        </header>\\n\\n        {/* Main Viewport */}\\n        <main className=\\\"flex-1 w-full max-w-6xl mx-auto px-4 md:px-8 py-6 pb-24 md:py-8 md:pb-10\\\">\\n          {children}\\n        </main>\\n      </div>\\n\\n      {/* Mobile Bottom Navigation */}\\n      <nav\\n        aria-label=\\\"Primary\\\"\\n        className=\\\"md:hidden fixed bottom-0 inset-x-0 z-30 h-16 border-t border-stone-200 dark:border-stone-800 bg-white/95 dark:bg-[#141416]/95 backdrop-blur-md flex items-center justify-around px-1 no-print\\\"\\n      >\\n        {mobileItems.map((item) => {\\n          const Icon = item.icon;\\n          return (\\n            <NavLink\\n              key={item.to}\\n              to={item.to}\\n              end={item.to === \'/admin\' || item.to === \'/manager\' || item.to === \'/member\'}\\n              className={({ isActive }) =>\\n                `flex flex-col items-center justify-center gap-0.5 min-w-[56px] py-1.5 rounded-lg text-[11px] font-medium transition-colors ${\\n                  isActive\\n                    ? \'text-[#C25E00]\'\\n                    : \'text-stone-500 dark:text-stone-400\'\\n                }`\\n              }\\n            >\\n              <Icon className=\\\"w-5 h-5\\\" />\\n              <span className=\\\"truncate max-w-[68px]\\\">{item.label}</span>\\n            </NavLink>\\n          );\\n        })}\\n      </nav>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create responsive Layout shell with desktop sidebar, mobile bottom nav, language & theme toggles, and realtime notification bell\", \"Overwrite\":true, \"TargetFile\":\"/src/components/Layout.tsx\", \"toolAction\":\"Creating responsive Layout component\", \"toolSummary\":\"Create Layout.tsx\"}"
