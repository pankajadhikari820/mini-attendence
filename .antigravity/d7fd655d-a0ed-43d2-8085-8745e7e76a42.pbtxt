      thinking_signature: "\022\275\022\n\272\022\001i\024}\023\312\341s\316\301\361\363\214\374\247\270\231B9\314\t\224\306\357b\212{@\351\304\237\274\v\216\035\322\257B\272\276\312\217]\036\177\370N\202\236\301\303\224\371\311\312\344\331\261\311\234\244\341\0050\240d\273\\\347\351\\}x\244.\362?+\216\367\037*F\212\331\327s5R\234\364\270\310O\220\377\323:\303\253\334D\343\020\216{\275\3133\257\221\021\303U\302\005\033\3119\246\340\a\230\227\266 \215\253Z\325\341]c\0240b&\003\220UV,c\243m\022\300\347;\203$0\346\347P\240f\341A\2039\303\211\204a\254g\375\215\261i\365)\277.\251q\233\342_\234\2670wA\273\313\a\360\260Id\372\364\226*\226\357\215\3241\237\262M\344\271\214\303Y\303\301\272>~\323\0060\277k>\336\027\273\365\216\265\312\001\367\016\266\270\351L\005)N\316\361\342\234\310\303\252\'\200\264\247\023H\245\306\251E\b\2116%@G9\t\247\264\222\235U\304lC\220\370\246\353\344~\344\375\307\222\024\265\227\361d\317;\311Z\234+;\3079\027\340>\236\240=\236\314K\306\357\23436\347G\034\t5\031\246Ld\265{IP\253\212c\367\370\346\223x\362\033\267\356\016i\357\213%a\3209 \0216\327/U\025\237\251\315\231C\264%\016,\246\213\263\216\272\213\022\262\244\352\005\357\315k\3347\247kk\3332\330\373\245 \266kHNd\000\335\325\332\201\331\223/\333\a\031\220\272\364\246\237[kb[\372,\244\313\0059\000\230\365!P\2025/3P\312\'\313\344\272W\344hd\347\252\330\223\231;\274\266\226\v\333s\306\264\034\303]T\203\231v\257\374Y`;\003\346\242+K\356\316\264\270\030ad\204\332\313\354Y\bZ\2000\237\264\254\272K\024\232\344\224\230\307X\301\312\f\301P\243_\a\224\371\302\260\fk\365^\333\335\335\001n\350\034\346\366\320\374`\205\230\222ws\235\334\322Tx\2529\342+\346V\251/k\203}\240c\006Z;Zi\304\t\242\307cY\217M1\345\307\354:#\225\243\220x\217\203\366\210\245\233\253\377\006\341R\356\316s\357\341i\\X\302+S\356\336R\310[\300\355j\246>\353\371\375!L\245\255kbu\a\347\000+\254\272\235\205\276\377.\372\276-\376\330\245\036\024q\235\266\006e\0163\347K\202U\223xH\314+\023\030\225wA\b\260\343:\235\001o\312Vr|\220\232\320\244\3