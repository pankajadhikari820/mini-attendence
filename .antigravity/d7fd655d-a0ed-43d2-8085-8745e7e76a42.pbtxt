      name: "multi_replace_file_content"
      arguments_json: "{\"Description\":\"Add default session duration, default radius (20-500m), Location check toggle (default ON), and display 6-char ID in SettingsPage\", \"Instruction\":\"Update SettingsPage state, save payload, profile section (show 6-char ID + QR for all roles), and Organization Settings section for live session defaults & location check.\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":55, \"ReplacementContent\":\"  const [lowThreshold, setLowThreshold] = useState(org?.lowAttendanceThreshold ?? 75);\\n  const [defaultDuration, setDefaultDuration] = useState(org?.defaultSessionDuration ?? 30);\\n  const [locEnabled, setLocEnabled] = useState(org?.location?.enabled ?? true);\\n  const [locRadius, setLocRadius] = useState(org?.location?.radius ?? 50);\\n  const [locLat, setLocLat] = useState(org?.location?.lat ?? 0);\\n  const [locLng, setLocLng] = useState(org?.location?.lng ?? 0);\\n  const [savingOrg, setSavingOrg] = useState(false);\\n  const [locating, setLocating] = useState(false);\", \"StartLine\":47, \"TargetContent\":\"  const [lowThreshold, setLowThreshold] = useState(org?.lowAttendanceThreshold ?? 75);\\n  const [locEnabled, setLocEnabled] = useState(org?.location?.enabled ?? false);\\n  const [locRadius, setLocRadius] = useState(org?.location?.radius ?? 200);\\n  const [locLat, setLocLat] = useState(org?.location?.lat ?? 0);\\n  const [locLng, setLocLng] = useState(org?.location?.lng ?? 0);\\n  const [savingOrg, setSavingOrg] = useState(false);\\n  const [locating, setLocating] = useState(false);\"}, {\"AllowMultiple\":false, \"EndLine\":82, \"ReplacementContent\":\"      setLowThreshold(org.lowAttendanceThreshold ?? 75);\\n      setDefaultDuration(org.defaultSessionDuration ?? 30);\\n      setLocEnabled(org.location?.enabled ?? true);\\n      setLocRadius(Math.min(500, Math.max(20, org.location?.radius ?? 50)));\\n      setLocLat(org.location?.lat ?? 0);\\n      setLocLng(org.location?.lng ?? 0);\\n    }\\n  }, [org