f\263Ty\2537WdX\302\341\317@\220s\310\331\301y\272\210\261\2229zy\363\322\346IR\241\326\352\232\374\320s4R:\370\273\326]8r\374*;k_\275\035\217\315\223\016\024fQe\355\321`\322\202{x\322\204\002\222|\247{\372$\334h\001\277\377pN\357\313^\r\336\237\372\345J\177t\203b\204\235\253\321\365\023Z\204{\236\213\023V\337A\314\033\351m~\021\306\336\310\017 \337z\033*\340i\343&K\225-\320Ph\316\314\261\227\206\333VL\233\230U\365\337pZ\213\025\355\003%\331xM\265C\240\270<\373T@\305+\276\310\303{N\313\243\r\b=\335\356k\313X\277\340\276\277\323\247\376\216\3552@\255\272\202$\v76E\263@\215\3347V\n]\260\020\v\265\v\232:\334\025\343\376\016\221*\211w\200\217+0\031\321\346U\267/\364\321\337\003\b\273&<\324\330\b\020J\321\245 \035\360\024\005\3153\205TM\256WY\b8\260\026\237\267\032\214}\367\344G\340\324\325\024\3255\334\214\237\230[\242\244|\036\260\266U\000AQ\302Cu\332\257\2535pj\250(\343\275\272\322~\314\210_>\266\204\304!\263\336q\n\272\355\301\321\367\024\tH\273\006\3777k\235\001\2470\\\022\002\314\207\303\300\244\311i\2112\276\257\201;=\270(3\217>\005n\021\340\020\250\311}\344q\314mN&\003\321\203Ua\253\213F\324K\3667z\216\031\221\222W\306@\031\327\213h\231I\272\204\253\3273Z\250\021\275AX\a\217:\321\250\251\257\305U\317\232\3238k\265O\207\351\3476\005\t\215\317C\240\307\"\266\035\320}.]m\240,V\020\205\243X|-\r\rX \346b\274\224\311\324\004\375(O\246*\025\225\214=\033\177\230P\364\360A0Y\3413~/\243\000\362\375<\234\"/\314IQo`o-\224\347\317\026p\036\356\341\004&\030\353\367I\t\226=\362\2364u\2638}\232\352\331Jaa]\210\005Z\\\210\206\232&\006O\v\031m\2334s!\364\024\003\244<g\355\234+\005e\211\025V[\2130L\245M\337\364\241\354\235 \210\257\227\245\'\006\334$\261;\334#ddJ\360\316<!P\325\237\272\230w\343K\024\241l\227\330d\261\234>\256\326N/\307#\003\257\177\300\376%;\361\337%0>\276NPN\316\215\267Lk\233\247Q\2168\311>\223\374\337\355F\347\252\240\245\274\323y\240\200\264l\247\026\352\262\335\312y9\323\t\375\210\323\227j\342*F@\333\277\247\005\035\324\232\234\246\310y\355(\222{x\245\225\332j\t`\261\330\357 \300`\375W\377U\267\301\202\357\306\275A\343\205\330\275\316\364\230z)\270T\354=R&\305/\313\341V\271\nt-\371\016\367B\275\334D\305\201\370\362qoM\203h\367\330{\251\206\253\374\a\363\031\254\206>`\033\363P\030\355\346w\2623_Mb\326,\277M\330\020~htu\245\212\340\275)\300\\3\340\321\336}\325\250\031\026}+q\236\244W\360|WE\221f\241z(m\017\377Q\323f\346\361\246\207Raw\0321\257\237#\212\342{\225\360\246\\\0206\274\363[\345\354\026\367\241\2217\222\260R\353\316A\230\001\207v\250m#D\243%\032Wj\206\231/\272\374\2149\331<\223\263\270\216\004%\240\275\377h\220U\270;Y\337\334u\371\023\366\340\346\367\252\347\240=\303Z\027.\3205\312KZ\000\375\235\000.\"-\262\355\215e\335\245L\026\356m\004x\020#\255\000wYX\361\342qo\366$\320I=!+\031n`m\337\313\006E\250\255\002\257\325n\345G\235\256\314&\317\024\350\004\321M\377\275\2123\313\346r\261Y\251\000\252\336\335@\016\317{\0173\016\3312\237L\300\262\345\223\375\204<|\033\300>\362m\2300\230\223\345\304CJF\\\rW\223\231\357Q\273\215\004\306G\247\320oD\244\377X\367\357#\257TZ\247\314\345e#\376\234cP\r-\371DZ\267\377\003:2<\233\226\374\327\205\267\033o[G\252h\206Kn\244\321\241\2618\306\233\333a\213\2111N\316\3578B\305\230(\222g\323\205\\\345\vq\364\020L\t\211\033\177\364\370\315 \365\372\v\250\335)<\302\260\257 `\230\a6z\254\233\224\3723\fC\337f\367R\"g\265\000\3705\357H\364!O\266\322\021\315\227\342\313\316\206u\355\323\371\303\26618\351\305\333\246J\260\246oo\251M\214\016\353|\260\340\020\325\320\277;\005\233\2524:D\233K\304\026t\306<\3300\275AgCd\000\223\037P\313t\232\226ZU\307\213\352\030<\323\205\030\v\324$\325\347~F\274m\032)\b*D\350\vsL\362\3164S73\215\244\272t\255j\215\204\356\'\026\351\366r\204k\343\353\301\034\370f*\224\032]+\332\\\371\022\177\031:\nVa\022{\322\r\rzT\304M\024\253ls\246\241\242\235\235lwd9\222S\216;\300\346\2621\272\021\217\234\371\370u\274\316Sp6T\274w\250M\236\374\207;\324\336:+\213=\336\0338m\356\303l\304\341\313\300o\226\024\031>:\334\336\000\202h\353\363\f4JC\'\036\276\234|\326\205\202\324L\233\367\256H]\310\311\037\365\314YB\330Q\345!\203\001\222\033c\265\224\331N\275\311d%\235\271uN\366\243\024O\345{\035u\363\243\357\2753\223\220*%\202e\307\'\355\251\262\021*%\352\340\2051&\274\243\213\326\317\227\264\311\3052B\350\242?7l\t\355[\230\240\223\325\265\356e\325\367x\245\256\001\3539x\220\003m!\263\275a\215\223\370.\333\265i\2647_\232>B0e\305\274\333\024\035Rq\316\360\317\002\032F\031\032\331\327\026\373\366\335\227\355\260(\031\225u\255;5\207U\260|\360)\327\322g,\363\371\035\235\356<`^\262\360E\213\347<\337`#(\020\327\371\350\037O\357Kk\236\2300\3106\2031r\027\021Uc\342\022dx\t1Mb\'\t\2339|"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_5957389601397912084"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useCallback, useEffect, useMemo, useRef, useState } from \'react\';\\nimport { useSearchParams } from \'react-router-dom\';\\nimport { Html5Qrcode } from \'html5-qrcode\';\\nimport {\\n  AlertCircle,\\n  Camera,\\n  CameraOff,\\n  CheckCircle2,\\n  Crosshair,\\n  Loader2,\\n  MapPin,\\n  RefreshCw,\\n  WifiOff,\\n  ShieldAlert,\\n} from \'lucide-react\';\\nimport { useAuth } from \'../context/AuthContext\';\\nimport { useTranslation } from \'../hooks/useTranslation\';\\nimport { useToast } from \'../context/ToastContext\';\\nimport type { AttendanceSession, LiveSessionQRPayload } from \'../types\';\\nimport {\\n  findEligibleLiveSessions,\\n  resolveScannedSession,\\n  submitSelfAttendance,\\n  subscribeEligibleLiveSessions,\\n  type SelfMarkResult,\\n  type SessionStreamError,\\n} from \'../services/sessionService\';\\nimport {\\n  getCurrentPosition,\\n  getFlatEarthDistanceMeters,\\n  playBeep,\\n  triggerVibration,\\n} from \'../utils/helpers\';\\nimport { Layout } from \'../components/Layout\';\\n\\nexport const MarkYourAttendancePage: React.FC = () => {\\n  const { profile, org } = useAuth();\\n  const { t, formatNumber } = useTranslation();\\n  const { showToast } = useToast();\\n  const [searchParams, setSearchParams] = useSearchParams();\\n\\n  const initialTab = searchParams.get(\'tab\') === \'code\' ? \'code\' : \'scan\';\\n  const paramSessionId = searchParams.get(\'sessionId\') || \'\';\\n  const [tab, setTab] = useState<\'scan\' | \'code\'>(initialTab);\\n\\n  // Active eligible live sessions (real-time synced across all teachers assigned to student\'s class)\\n  const [loadingSession, setLoadingSession] = useState(true);\\n  const [sessions, setSessions] = useState<AttendanceSession[]>([]);\\n  const [selectedSessionId, setSelectedSessionId] = useState<string>(paramSessionId);\\n  const [streamError, setStreamError] = useState<SessionStreamError | null>(null);\\n  const [rechecking, setRechecking] = useState(false);\\n\\n  // Step 1: GPS state\\n  const [readingGps, setReadingGps] = useState(false);\\n  const [gps, setGps] = useState<{ lat: number; lng: number; accuracy: number } | null>(null);\\n  const [gpsError, setGpsError] = useState<\'denied\' | \'low_accuracy\' | null>(null);\\n\\n  // Step 2A: QR scanner state\\n  const [cameraRunning, setCameraRunning] = useState(false);\\n  const [facingMode, setFacingMode] = useState<\'environment\' | \'user\'>(\'environment\');\\n  const [cameraError, setCameraError] = useState(\'\');\\n  const scannerRef = useRef<Html5Qrcode | null>(null);\\n  const scanBusyRef = useRef(false);\\n\\n  // Step 2B: Enter ID + Live Code state\\n  const [enteredId, setEnteredId] = useState(\'\');\\n  const [liveCode, setLiveCode] = useState(\'\');\\n\\n  // Submission & outcome state\\n  const [submitting, setSubmitting] = useState(false);\\n  const [errorMessage, setErrorMessage] = useState(\'\');\\n  const [successResult, setSuccessResult] = useState<SelfMarkResult | null>(null);\\n\\n  // Selected active session (auto-defaults to first open session or ?sessionId=)\\n  const session = useMemo(() => {\\n    if (sessions.length === 0) return null;\\n    if (selectedSessionId) {\\n      const found = sessions.find((s) => s.id === selectedSessionId);\\n      if (found) return found;\\n    }\\n    return sessions[0];\\n  }, [sessions, selectedSessionId]);\\n\\n  useEffect(() => {\\n    if (sessions.length > 0 && (!selectedSessionId || !sessions.some((s) => s.id === selectedSessionId))) {\\n      setSelectedSessionId(sessions[0].id);\\n    }\\n  }, [sessions, selectedSessionId]);\\n\\n  // Step 1: Read high-accuracy GPS\\n  const readGpsLocation = useCallback(async () => {\\n    setReadingGps(true);\\n    setGpsError(null);\\n    try {\\n      const pos = await getCurrentPosition();\\n      setGps(pos);\\n      if (pos.accuracy > 100) {\\n        setGpsError(\'low_accuracy\');\\n      }\\n    } catch {\\n      setGps(null);\\n      setGpsError(\'denied\');\\n    } finally {\\n      setReadingGps(false);\\n    }\\n  }, []);\\n\\n  useEffect(() => {\\n    readGpsLocation();\\n  }, [readGpsLocation]);\\n\\n  // Manual \\\"Check again\\\" handler: refreshes both Firestore query AND GPS\\n  const refreshActiveSession = useCallback(async () => {\\n    if (!profile || !org) return;\\n    setRechecking(true);\\n    setErrorMessage(\'\');\\n    try {\\n      const res = await findEligibleLiveSessions(profile, org);\\n      setSessions(res.sessions);\\n      setStreamError(res.error);\\n      if (res.sessions.length > 0) {\\n        setSelectedSessionId((prev) =>\\n          res.sessions.some((s) => s.id === prev) ? prev : res.sessions[0].id\\n        );\\n      }\\n      readGpsLocation();\\n    } finally {\\n      setRechecking(false);\\n      setLoadingSession(false);\\n    }\\n  }, [profile, org, readGpsLocation]);\\n\\n  // Real-time subscription to ALL eligible live sessions\\n  useEffect(() => {\\n    if (!profile || !org) return;\\n    setLoadingSession(true);\\n    setStreamError(null);\\n\\n    const unsub = subscribeEligibleLiveSessions(\\n      profile,\\n      org,\\n      (list) => {\\n        setSessions(list);\\n        setStreamError(null);\\n        setLoadingSession(false);\\n      },\\n      (err) => {\\n        setStreamError(err);\\n        setLoadingSession(false);\\n      }\\n    );\\n\\n    return () => unsub();\\n  }, [profile, org]);\\n\\n  // Auto-prune expired sessions in real time while screen stays open\\n  useEffect(() => {\\n    if (sessions.length === 0) return;\\n    const interval = window.setInterval(() => {\\n      const now = Date.now();\\n      setSessions((prev) =>\\n        prev.filter((s) => !s.endsAt || s.endsAt.toMillis() > now)\\n      );\\n    }, 5000);\\n    return () => window.clearInterval(interval);\\n  }, [sessions.length]);\\n\\n  const distanceMeters = useMemo(() => {\\n    if (!session || !gps) return null;\\n    return getFlatEarthDistanceMeters(\\n      gps.lat,\\n      gps.lng,\\n      session.location.lat,\\n      session.location.lng,\\n      session.location.cosLat\\n    );\\n  }, [session, gps]);\\n\\n  const locationRequired = session ? session.locationCheckEnabled : org?.location?.enabled ?? true;\\n  const locationOk = useMemo(() => {\\n    if (!locationRequired) return true;\\n    if (!gps || gpsError) return false;\\n    if (distanceMeters === null || !session) return false;\\n    return distanceMeters <= session.location.radius;\\n  }, [locationRequired, gps, gpsError, distanceMeters, session]);\\n\\n  const stopCamera = useCallback(async () => {\\n    const inst = scannerRef.current;\\n    scannerRef.current = null;\\n    if (inst) {\\n      try {\\n        if (inst.isScanning) await inst.stop();\\n        inst.clear();\\n      } catch {\\n        // Ignore stop cleanup errors\\n      }\\n    }\\n    setCameraRunning(false);\\n  }, []);\\n\\n  const reportError = useCallback(\\n    (msg: string) => {\\n      playBeep(false);\\n      triggerVibration(false);\\n      setErrorMessage(msg);\\n      showToast(msg, \'error\');\\n    },\\n    [showToast]\\n  );\\n\\n  const handleSubmitTokenOrCode = useCallback(\\n    async (mode: \'live_qr\' | \'live_code\', value: string, scannedSessionId?: string) => {\\n      if (!org || !profile) return;\\n      setErrorMessage(\'\');\\n\\n      let targetSession: AttendanceSession | null = session;\\n\\n      if (mode === \'live_qr\' && scannedSessionId) {\\n        const matchedFromList = sessions.find((s) => s.id === scannedSessionId) || null;\\n        if (matchedFromList) {\\n          targetSession = matchedFromList;\\n          setSelectedSessionId(matchedFromList.id);\\n        } else {\\n          setSubmitting(true);\\n          const resolved = await resolveScannedSession(scannedSessionId, profile, org);\\n          if (resolved.status !== \'ok\') {\\n            setSubmitting(false);\\n            if (resolved.status === \'closed\') {\\n              reportError(t(\'mark.errSessionClosed\'));\\n            } else if (resolved.status === \'unauthorized\') {\\n              reportError(t(\'mark.errUnauthorized\'));\\n            } else if (resolved.status === \'network\') {\\n              reportError(t(\'mark.errNetwork\'));\\n            } else {\\n              reportError(t(\'attendance.invalidQr\'));\\n            }\\n            return;\\n          }\\n          targetSession = resolved.session;\\n          setSessions((prev) =>\\n            prev.some((s) => s.id === resolved.session.id)\\n              ? prev\\n              : [resolved.session, ...prev]\\n          );\\n          setSelectedSessionId(resolved.session.id);\\n        }\\n      }\\n\\n      if (!targetSession) {\\n        reportError(t(\'mark.errSessionClosed\'));\\n        return;\\n      }\\n\\n      const needsGps = targetSession.locationCheckEnabled;\\n      if (needsGps) {\\n        if (!gps) {\\n          reportError(t(\'mark.locationDenied\'));\\n          return;\\n        }\\n        if (gps.accuracy > 100) {\\n          reportError(t(\'mark.lowAccuracy\'));\\n          return;\\n        }\\n      }\\n\\n      setSubmitting(true);\\n      try {\\n        const res = await submitSelfAttendance({\\n          org,\\n          profile,\\n          session: targetSession,\\n          method: mode,\\n          token: mode === \'live_qr\' ? value : undefined,\\n          code: mode === \'live_code\' ? value : undefined,\\n          lat: gps?.lat ?? 0,\\n          lng: gps?.lng ?? 0,\\n          accuracy: gps?.accuracy ?? 0,\\n        });\\n\\n        if (res.ok) {\\n          playBeep(true);\\n          triggerVibration(true);\\n          await stopCamera();\\n          setSuccessResult(res);\\n          showToast(t(\'mark.successTitle\'), \'success\');\\n        } else {\\n          const key = res.errorCode === \'generic\' ? \'errors.generic\' : `mark.${res.errorCode}`;\\n          reportError(t(key));\\n        }\\n      } finally {\\n        setSubmitting(false);\\n      }\\n    },\\n    [org, profile, session, sessions, gps, stopCamera, showToast, reportError, t]\\n  );\\n\\n  const handleDecodedLiveQR = useCallback(\\n    async (raw: string) => {\\n      if (scanBusyRef.current) return;\\n      let parsed: LiveSessionQRPayload;\\n      try {\\n        const obj = JSON.parse(raw);\\n        if (\\n          !obj ||\\n          typeof obj.s !== \'string\' ||\\n          obj.s.trim().length < 4 ||\\n          typeof obj.t !== \'string\' ||\\n          obj.t.trim().length < 16\\n        ) {\\n          scanBusyRef.current = true;\\n          reportError(t(\'attendance.invalidQr\'));\\n          window.setTimeout(() => {\\n            scanBusyRef.current = false;\\n          }, 1500);\\n          return;\\n        }\\n        parsed = { s: obj.s.trim(), t: obj.t.trim() };\\n      } catch {\\n        scanBusyRef.current = true;\\n        reportError(t(\'attendance.invalidQr\'));\\n        window.setTimeout(() => {\\n          scanBusyRef.current = false;\\n        }, 1500);\\n        return;\\n      }\\n\\n      scanBusyRef.current = true;\\n      await handleSubmitTokenOrCode(\'live_qr\', parsed.t, parsed.s);\\n      window.setTimeout(() => {\\n        scanBusyRef.current = false;\\n      }, 1500);\\n    },\\n    [handleSubmitTokenOrCode, reportError, t]\\n  );\\n\\n  const startCamera = useCallback(\\n    async (mode: \'environment\' | \'user\' = facingMode) => {\\n      setCameraError(\'\');\\n      await stopCamera();\\n\\n      if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {\\n        setCameraError(t(\'attendance.cameraPermissionDesc\'));\\n        return;\\n      }\\n\\n      const scannerConfig = {\\n        fps: 12,\\n        qrbox: { width: 220, height: 220 },\\n        aspectRatio: 1,\\n      };\\n\\n      const onScanSuccess = (text: string) => {\\n        handleDecodedLiveQR(text);\\n      };\\n\\n      try {\\n        const scanner = new Html5Qrcode(\'mark-qr-reader\');\\n        scannerRef.current = scanner;\\n        await scanner.start({ facingMode: mode }, scannerConfig, onScanSuccess, () => {});\\n        setCameraRunning(true);\\n      } catch {\\n        try {\\n          const cameras = await Html5Qrcode.getCameras();\\n          if (cameras && cameras.length > 0) {\\n            const scanner = new Html5Qrcode(\'mark-qr-reader\');\\n            scannerRef.current = scanner;\\n            const preferred =\\n              mode === \'environment\'\\n                ? cameras.find((c) => /back|rear|environment/i.test(c.label)) || cameras[0]\\n                : cameras.find((c) => /front|user/i.test(c.label)) || cameras[0];\\n            await scanner.start(preferred.id, scannerConfig, onScanSuccess, () => {});\\n            setCameraRunning(true);\\n            return;\\n          }\\n        } catch {\\n          // Fall through\\n        }\\n\\n        setCameraError(t(\'attendance.cameraPermissionDesc\'));\\n        setCameraRunning(false);\\n      }\\n    },\\n    [facingMode, stopCamera, handleDecodedLiveQR, t]\\n  );\\n\\n  const handleSwitchCamera = async () => {\\n    const next = facingMode === \'environment\' ? \'user\' : \'environment\';\\n    setFacingMode(next);\\n    if (cameraRunning) await startCamera(next);\\n  };\\n\\n  useEffect(() => {\\n    if (tab !== \'scan\' && cameraRunning) {\\n      stopCamera();\\n    }\\n  }, [tab, cameraRunning, stopCamera]);\\n\\n  useEffect(() => {\\n    return () => {\\n      stopCamera();\\n    };\\n  }, [stopCamera]);\\n\\n  const handleCodeFormSubmit = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    setErrorMessage(\'\');\\n\\n    const cleanId = enteredId.trim().toUpperCase();\\n    const myId = (profile?.memberId || \'\').trim().toUpperCase();\\n    if (!cleanId || cleanId !== myId) {\\n      reportError(t(\'mark.idMismatch\'));\\n      return;\\n    }\\n\\n    const cleanCode = liveCode.replace(/\\\\s+/g, \'\');\\n    if (!/^\\\\d{6}$/.test(cleanCode)) {\\n      reportError(t(\'mark.errInvalidCode\'));\\n      return;\\n    }\\n\\n    await handleSubmitTokenOrCode(\'live_code\', cleanCode);\\n  };\\n\\n  const handleTabSwitch = (next: \'scan\' | \'code\') => {\\n    setTab(next);\\n    setErrorMessage(\'\');\\n    setSearchParams({ tab: next }, { replace: true });\\n  };\\n\\n  return (\\n    <Layout title={t(\'mark.title\')}>\\n      <div className=\\\"max-w-xl mx-auto space-y-6\\\">\\n        <div>\\n          <h2 className=\\\"text-2xl font-bold tracking-tight text-stone-900 dark:text-stone-50\\\">\\n            {t(\'mark.title\')}\\n          </h2>\\n          <p className=\\\"mt-1 text-sm text-stone-500 dark:text-stone-400\\\">\\n            {t(\'mark.subtitle\')}\\n          </p>\\n        </div>\\n\\n        {/* SUCCESS SCREEN (Strictly PRESENT) */}\\n        {successResult ? (\\n          <div className=\\\"rounded-2xl border border-emerald-300 dark:border-emerald-800 bg-emerald-50/70 dark:bg-emerald-950/30 p-8 text-center space-y-4\\\">\\n            <div className=\\\"w-16 h-16 rounded-full bg-emerald-600 text-white mx-auto flex items-center justify-center\\\">\\n              <CheckCircle2 className=\\\"w-9 h-9\\\" />\\n            </div>\\n            <div>\\n              <h3 className=\\\"text-2xl font-bold text-emerald-900 dark:text-emerald-200\\\">\\n                {t(\'mark.successTitle\')}\\n              </h3>\\n              <p className=\\\"mt-1.5 text-base font-semibold text-stone-900 dark:text-stone-100\\\">\\n                {profile?.name} \302\267 <span className=\\\"font-mono\\\">{profile?.memberId}</span>\\n              </p>\\n              {successResult.subjectName && (\\n                <p className=\\\"mt-1 text-sm font-medium text-emerald-800 dark:text-emerald-300\\\">\\n                  {successResult.subjectName}\\n                </p>\\n              )}\\n            </div>\\n\\n            <div className=\\\"flex items-center justify-center gap-4 text-sm text-emerald-900/80 dark:text-emerald-300 tabular-nums pt-2\\\">\\n              <span className=\\\"font-semibold uppercase\\\">{t(\'common.present\')}</span>\\n              <span>\302\267</span>\\n              <span>{successResult.timeStr}</span>\\n              {successResult.distanceMeters !== undefined && locationRequired && (\\n                <>\\n                  <span>\302\267</span>\\n                  <span>\\n                    {formatNumber(successResult.distanceMeters)} {t(\'common.meters\')}\\n                  </span>\\n                </>\\n              )}\\n            </div>\\n\\n            {sessions.length > 1 && (\\n              <div className=\\\"pt-2\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => {\\n                    setSuccessResult(null);\\n                    setLiveCode(\'\');\\n                  }}\\n                  className=\\\"rounded-xl border border-emerald-400 dark:border-emerald-700 px-4 py-2 text-xs font-medium text-emerald-900 dark:text-emerald-200 hover:bg-emerald-100 dark:hover:bg-emerald-900/40\\\"\\n                >\\n                  {t(\'mark.markAnotherSession\')}\\n                </button>\\n              </div>\\n            )}\\n          </div>\\n        ) : (\\n          <>\\n            {/* Live Session Discovery Card \342\200\224 explicitly differentiates loading, errors, empty, and active sessions */}\\n            <section className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5 space-y-4\\\">\\n              {loadingSession ? (\\n                <div className=\\\"flex items-center gap-2.5 text-sm text-stone-500\\\">\\n                  <Loader2 className=\\\"w-4 h-4 animate-spin text-[#C25E00]\\\" />\\n                  <span>{t(\'mark.findingSession\')}</span>\\n                </div>\\n              ) : streamError && sessions.length === 0 ? (\\n                <div className=\\\"flex items-start justify-between gap-3\\\">\\n                  <div className=\\\"flex items-start gap-2.5\\\">\\n                    {streamError.code === \'network\' ? (\\n                      <WifiOff className=\\\"w-4 h-4 text-red-600 shrink-0 mt-0.5\\\" />\\n                    ) : (\\n                      <ShieldAlert className=\\\"w-4 h-4 text-amber-600 shrink-0 mt-0.5\\\" />\\n                    )}\\n                    <div>\\n                      <p className=\\\"text-sm font-semibold text-stone-900 dark:text-stone-100\\\">\\n                        {streamError.code === \'permission-denied\'\\n                          ? t(\'mark.sessionPermErrorTitle\')\\n                          : streamError.code === \'index-required\'\\n                          ? t(\'mark.sessionIndexErrorTitle\')\\n                          : t(\'mark.sessionNetworkErrorTitle\')}\\n                      </p>\\n                      <p className=\\\"mt-0.5 text-xs text-stone-500 dark:text-stone-400\\\">\\n                        {streamError.message}\\n                      </p>\\n                    </div>\\n                  </div>\\n                  <button\\n                    type=\\\"button\\\"\\n                    disabled={rechecking}\\n                    onClick={refreshActiveSession}\\n                    className=\\\"inline-flex items-center gap-1.5 rounded-lg border border-stone-300 dark:border-stone-700 hover:bg-stone-50 dark:hover:bg-stone-800 px-3 py-1.5 text-xs font-medium shrink-0\\\"\\n                  >\\n                    <RefreshCw className={`w-3.5 h-3.5 ${rechecking ? \'animate-spin\' : \'\'}`} />\\n                    <span>{t(\'mark.refreshSession\')}</span>\\n                  </button>\\n                </div>\\n              ) : sessions.length > 0 && session ? (\\n                <div className=\\\"space-y-3\\\">\\n                  <div className=\\\"flex flex-wrap items-center justify-between gap-2\\\">\\n                    <div className=\\\"flex items-center gap-2.5 min-w-0\\\">\\n                      <span className=\\\"inline-flex items-center gap-1.5 rounded-md bg-emerald-600/12 dark:bg-emerald-500/20 border border-emerald-600/30 px-2 py-0.5 text-[11px] font-bold tracking-wider text-emerald-700 dark:text-emerald-300 uppercase shrink-0\\\">\\n                        <span className=\\\"w-1.5 h-1.5 rounded-full bg-emerald-600 dark:bg-emerald-400 animate-pulse\\\" />\\n                        {t(\'session.liveBadge\')}\\n                      </span>\\n                      <span className=\\\"font-semibold text-stone-900 dark:text-stone-100 text-sm truncate\\\">\\n                        {session.subjectName || session.title || session.ownerName}\\n                      </span>\\n                    </div>\\n                    <span className=\\\"font-mono text-xs text-stone-500 dark:text-stone-400\\\">\\n                      {t(\'common.memberId\')}: {profile?.memberId}\\n                    </span>\\n                  </div>\\n\\n                  <p className=\\\"text-xs text-stone-500 dark:text-stone-400\\\">\\n                    {session.teacherName || session.ownerName}\\n                    {session.className ? ` \302\267 ${session.className}` : \'\'}\\n                    {session.classroom ? ` \302\267 ${session.classroom}` : \'\'}\\n                  </p>\\n\\n                  {/* If multiple teachers have active sessions concurrently, let student pick */}\\n                  {sessions.length > 1 && (\\n                    <div className=\\\"pt-2 border-t border-stone-100 dark:border-stone-800 space-y-2\\\">\\n                      <p className=\\\"text-xs font-medium text-stone-600 dark:text-stone-300\\\">\\n                        {t(\'mark.multipleLiveSessions\')} ({formatNumber(sessions.length)})\\n                      </p>\\n                      <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-2\\\">\\n                        {sessions.map((s) => {\\n                          const isSelected = s.id === session.id;\\n                          return (\\n                            <button\\n                              key={s.id}\\n                              type=\\\"button\\\"\\n                              onClick={() => setSelectedSessionId(s.id)}\\n                              className={`rounded-xl border px-3 py-2 text-left text-xs transition-colors ${\\n                                isSelected\\n                                  ? \'border-[#C25E00] bg-amber-50/70 dark:bg-amber-950/30 text-stone-900 dark:text-stone-100\'\\n                                  : \'border-stone-200 dark:border-stone-800 text-stone-600 dark:text-stone-400 hover:bg-stone-50 dark:hover:bg-stone-800/50\'\\n                              }`}\\n                            >\\n                              <p className=\\\"font-semibold truncate\\\">\\n                                {s.subjectName || s.title}\\n                              </p>\\n                              <p className=\\\"text-[11px] text-stone-500 truncate mt-0.5\\\">\\n                                {s.teacherName || s.ownerName}\\n                              </p>\\n                            </button>\\n                          );\\n                        })}\\n                      </div>\\n                    </div>\\n                  )}\\n                </div>\\n              ) : (\\n                <div className=\\\"flex items-start justify-between gap-3\\\">\\n                  <div>\\n                    <p className=\\\"text-sm font-semibold text-stone-900 dark:text-stone-100\\\">\\n                      {t(\'mark.noActiveSession\')}\\n                    </p>\\n                    <p className=\\\"mt-0.5 text-xs text-stone-500 dark:text-stone-400\\\">\\n                      {t(\'mark.noActiveSessionHint\')}\\n                    </p>\\n                  </div>\\n                  <button\\n                    type=\\\"button\\\"\\n                    disabled={rechecking}\\n                    onClick={refreshActiveSession}\\n                    className=\\\"inline-flex items-center gap-1.5 rounded-lg border border-stone-300 dark:border-stone-700 hover:bg-stone-50 dark:hover:bg-stone-800 px-3 py-1.5 text-xs font-medium shrink-0\\\"\\n                  >\\n                    <RefreshCw className={`w-3.5 h-3.5 ${rechecking ? \'animate-spin\' : \'\'}`} />\\n                    <span>{t(\'mark.refreshSession\')}</span>\\n                  </button>\\n                </div>\\n              )}\\n\\n              {/* Step 1: GPS Distance Banner */}\\n              {!locationRequired ? (\\n                <div className=\\\"rounded-xl border border-stone-200 dark:border-stone-800 bg-stone-50 dark:bg-stone-900/50 px-4 py-3 text-xs text-stone-600 dark:text-stone-400\\\">\\n                  {t(\'mark.locationCheckDisabled\')}\\n                </div>\\n              ) : readingGps ? (\\n                <div className=\\\"rounded-xl border border-stone-200 dark:border-stone-800 bg-stone-50 dark:bg-stone-900/50 px-4 py-3 flex items-center gap-2.5 text-sm text-stone-600 dark:text-stone-300\\\">\\n                  <Crosshair className=\\\"w-4 h-4 animate-spin text-[#C25E00]\\\" />\\n                  <span>{t(\'mark.readingGps\')}</span>\\n                </div>\\n              ) : gpsError === \'low_accuracy\' ? (\\n                <div className=\\\"rounded-xl border border-amber-300 dark:border-amber-800 bg-amber-50 dark:bg-amber-950/30 px-4 py-3 flex items-start justify-between gap-3\\\">\\n                  <p className=\\\"text-xs text-amber-900 dark:text-amber-200 leading-relaxed\\\">\\n                    {t(\'mark.lowAccuracy\')} (\302\261{gps?.accuracy} {t(\'common.meters\')})\\n                  </p>\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={readGpsLocation}\\n                    className=\\\"shrink-0 rounded-lg bg-amber-700 text-white px-3 py-1.5 text-xs font-medium\\\"\\n                  >\\n                    {t(\'mark.retryGps\')}\\n                  </button>\\n                </div>\\n              ) : gpsError === \'denied\' || !gps ? (\\n                <div className=\\\"rounded-xl border border-red-200 dark:border-red-900 bg-red-50 dark:bg-red-950/30 px-4 py-3 flex items-start justify-between gap-3\\\">\\n                  <p className=\\\"text-xs text-red-800 dark:text-red-300 leading-relaxed\\\">\\n                    {t(\'mark.locationDenied\')}\\n                  </p>\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={readGpsLocation}\\n                    className=\\\"shrink-0 rounded-lg bg-red-600 text-white px-3 py-1.5 text-xs font-medium\\\"\\n                  >\\n                    {t(\'mark.retryGps\')}\\n                  </button>\\n                </div>\\n              ) : session ? (\\n                <div\\n                  className={`rounded-xl border px-4 py-3 flex items-center justify-between gap-3 ${\\n                    locationOk\\n                      ? \'border-emerald-200 dark:border-emerald-800 bg-emerald-50/70 dark:bg-emerald-950/30 text-emerald-900 dark:text-emerald-200\'\\n                      : \'border-red-200 dark:border-red-900 bg-red-50/70 dark:bg-red-950/30 text-red-900 dark:text-red-200\'\\n                  }`}\\n                >\\n                  <div className=\\\"flex items-center gap-2.5 text-sm font-medium tabular-nums\\\">\\n                    <MapPin className=\\\"w-4 h-4 shrink-0\\\" />\\n                    <span>\\n                      {(locationOk ? t(\'mark.withinRadius\') : t(\'mark.outsideRadius\')).replace(\\n                        \'{distance}\',\\n                        formatNumber(distanceMeters ?? 0)\\n                      )}\\n                    </span>\\n                  </div>\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={readGpsLocation}\\n                    aria-label={t(\'mark.retryGps\')}\\n                    className=\\\"p-1.5 rounded-lg hover:bg-black/5 dark:hover:bg-white/10\\\"\\n                  >\\n                    <RefreshCw className=\\\"w-4 h-4\\\" />\\n                  </button>\\n                </div>\\n              ) : null}\\n            </section>\\n\\n            {/* Step 2: Two Tabs (Scan QR | Enter ID) */}\\n            <section className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5 sm:p-6 space-y-5\\\">\\n              <div className=\\\"grid grid-cols-2 gap-1 p-1 rounded-xl bg-stone-100 dark:bg-stone-900 border border-stone-200 dark:border-stone-800\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => handleTabSwitch(\'scan\')}\\n                  className={`py-2.5 rounded-lg text-sm font-medium transition-colors ${\\n                    tab === \'scan\'\\n                      ? \'bg-white dark:bg-stone-800 text-stone-900 dark:text-stone-100 shadow-xs\'\\n                      : \'text-stone-600 dark:text-stone-400\'\\n                  }`}\\n                >\\n                  {t(\'mark.tabScanQr\')}\\n                </button>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => handleTabSwitch(\'code\')}\\n                  className={`py-2.5 rounded-lg text-sm font-medium transition-colors ${\\n                    tab === \'code\'\\n                      ? \'bg-white dark:bg-stone-800 text-stone-900 dark:text-stone-100 shadow-xs\'\\n                      : \'text-stone-600 dark:text-stone-400\'\\n                  }`}\\n                >\\n                  {t(\'mark.tabEnterId\')}\\n                </button>\\n              </div>\\n\\n              {errorMessage && (\\n                <div\\n                  role=\\\"alert\\\"\\n                  className=\\\"rounded-xl border border-red-200 dark:border-red-900 bg-red-50 dark:bg-red-950/40 px-4 py-3 flex items-start gap-2.5 text-sm text-red-800 dark:text-red-300\\\"\\n                >\\n                  <AlertCircle className=\\\"w-4 h-4 shrink-0 mt-0.5\\\" />\\n                  <span>{errorMessage}</span>\\n                </div>\\n              )}\\n\\n              {tab === \'scan\' ? (\\n                <div className=\\\"space-y-4\\\">\\n                  <div className=\\\"relative overflow-hidden rounded-xl bg-stone-950 min-h-[290px] sm:min-h-[320px] flex items-center justify-center\\\">\\n                    <div id=\\\"mark-qr-reader\\\" className=\\\"w-full\\\" />\\n\\n                    {cameraRunning && (\\n                      <div className=\\\"pointer-events-none absolute inset-0 flex flex-col items-center justify-center\\\">\\n                        <div className=\\\"relative w-52 h-52 sm:w-56 sm:h-56\\\">\\n                          <span className=\\\"absolute top-0 left-0 w-7 h-7 border-t-[3px] border-l-[3px] border-[#C25E00] rounded-tl-lg\\\" />\\n                          <span className=\\\"absolute top-0 right-0 w-7 h-7 border-t-[3px] border-r-[3px] border-[#C25E00] rounded-tr-lg\\\" />\\n                          <span className=\\\"absolute bottom-0 left-0 w-7 h-7 border-b-[3px] border-l-[3px] border-[#C25E00] rounded-bl-lg\\\" />\\n                          <span className=\\\"absolute bottom-0 right-0 w-7 h-7 border-b-[3px] border-r-[3px] border-[#C25E00] rounded-br-lg\\\" />\\n                        </div>\\n                        <p className=\\\"mt-4 px-3 py-1 rounded-lg bg-black/60 text-white text-xs font-medium\\\">\\n                          {submitting ? t(\'mark.submitting\') : t(\'mark.scanFrameHint\')}\\n                        </p>\\n                      </div>\\n                    )}\\n\\n                    {!cameraRunning && (\\n                      <div className=\\\"absolute inset-0 flex flex-col items-center justify-center p-6 text-center bg-stone-100 dark:bg-stone-900\\\">\\n                        <Camera className=\\\"w-9 h-9 text-stone-400 mb-3\\\" />\\n                        <p className=\\\"text-sm text-stone-700 dark:text-stone-300 max-w-xs\\\">\\n                          {cameraError || t(\'attendance.cameraActiveHint\')}\\n                        </p>\\n                        <button\\n                          type=\\\"button\\\"\\n                          onClick={() => startCamera(facingMode)}\\n                          className=\\\"mt-4 inline-flex items-center gap-2 rounded-xl bg-[#C25E00] hover:bg-[#A84F00] text-white px-5 py-2.5 text-sm font-medium\\\"\\n                        >\\n                          <Camera className=\\\"w-4 h-4\\\" />\\n                          <span>{t(\'attendance.startCamera\')}</span>\\n                        </button>\\n                      </div>\\n                    )}\\n                  </div>\\n\\n                  {cameraError && !cameraRunning && (\\n                    <div className=\\\"rounded-xl border border-amber-200 dark:border-amber-900 bg-amber-50 dark:bg-amber-950/30 p-3.5 text-xs text-amber-900 dark:text-amber-200\\\">\\n                      <p className=\\\"font-semibold\\\">{t(\'attendance.cameraPermissionTitle\')}</p>\\n                      <p className=\\\"mt-1\\\">{t(\'attendance.cameraPermissionDesc\')}</p>\\n                    </div>\\n                  )}\\n\\n                  <div className=\\\"grid grid-cols-2 gap-3\\\">\\n                    {cameraRunning ? (\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={stopCamera}\\n                        className=\\\"inline-flex items-center justify-center gap-2 rounded-xl border border-stone-300 dark:border-stone-700 py-3 text-sm font-medium hover:bg-stone-50 dark:hover:bg-stone-800\\\"\\n                      >\\n                        <CameraOff className=\\\"w-4 h-4\\\" />\\n                        <span>{t(\'attendance.stopCamera\')}</span>\\n                      </button>\\n                    ) : (\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() => startCamera(facingMode)}\\n                        className=\\\"inline-flex items-center justify-center gap-2 rounded-xl bg-[#C25E00] hover:bg-[#A84F00] text-white py-3 text-sm font-medium\\\"\\n                      >\\n                        <Camera className=\\\"w-4 h-4\\\" />\\n                        <span>{t(\'attendance.startCamera\')}</span>\\n                      </button>\\n                    )}\\n\\n                    <button\\n                      type=\\\"button\\\"\\n                      onClick={handleSwitchCamera}\\n                      className=\\\"inline-flex items-center justify-center gap-2 rounded-xl border border-stone-300 dark:border-stone-700 py-3 text-sm font-medium hover:bg-stone-50 dark:hover:bg-stone-800\\\"\\n                    >\\n                      <RefreshCw className=\\\"w-4 h-4\\\" />\\n                      <span>{t(\'attendance.switchCamera\')}</span>\\n                    </button>\\n                  </div>\\n                </div>\\n              ) : (\\n                <form onSubmit={handleCodeFormSubmit} className=\\\"space-y-4\\\">\\n                  <div>\\n                    <label className=\\\"block text-sm font-medium text-stone-700 dark:text-stone-300 mb-1.5\\\">\\n                      {t(\'mark.yourIdLabel\')}\\n                    </label>\\n                    <input\\n                      type=\\\"text\\\"\\n                      required\\n                      maxLength={6}\\n                      value={enteredId}\\n                      onChange={(e) => setEnteredId(e.target.value.toUpperCase())}\\n                      placeholder={profile?.memberId || t(\'mark.yourIdPlaceholder\')}\\n                      className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-transparent px-4 py-3 text-base font-mono uppercase tracking-[0.2em] focus:outline-none focus:ring-2 focus:ring-[#C25E00]/30 focus:border-[#C25E00]\\\"\\n                    />\\n                  </div>\\n\\n                  <div>\\n                    <label className=\\\"block text-sm font-medium text-stone-700 dark:text-stone-300 mb-1.5\\\">\\n                      {t(\'mark.liveCodeLabel\')}\\n                    </label>\\n                    <input\\n                      type=\\\"text\\\"\\n                      inputMode=\\\"numeric\\\"\\n                      required\\n                      maxLength={6}\\n                      value={liveCode}\\n                      onChange={(e) => setLiveCode(e.target.value.replace(/\\\\D/g, \'\').slice(0, 6))}\\n                      placeholder={t(\'mark.liveCodePlaceholder\')}\\n                      className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-transparent px-4 py-3 text-2xl font-mono tracking-[0.3em] text-center tabular-nums focus:outline-none focus:ring-2 focus:ring-[#C25E00]/30 focus:border-[#C25E00]\\\"\\n                    />\\n                  </div>\\n\\n                  <button\\n                    type=\\\"submit\\\"\\n                    disabled={submitting || !session}\\n                    className=\\\"w-full rounded-xl bg-[#C25E00] hover:bg-[#A84F00] disabled:opacity-60 text-white py-3 text-sm font-medium transition-colors\\\"\\n                  >\\n                    {submitting ? t(\'mark.submitting\') : t(\'mark.submitBtn\')}\\n                  </button>\\n                </form>\\n              )}\\n            </section>\\n          </>\\n        )}\\n      </div>\\n    </Layout>\\n  );\\n};\\n\", \"Description\":\"Fix live session real-time discovery, multi-session selection, explicit error handling, and remove LATE from MarkYourAttendancePage\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/MarkYourAttendancePage.tsx\", \"toolAction\":\"Updating MarkYourAttendancePage.tsx\", \"toolSummary\":\"Update MarkYourAttendancePage.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_5957389601397913371"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useCallback, useEffect, useMemo, useRef, useState } from \'react\';\\nimport { Link } from \'react-router-dom\';\\nimport { Html5Qrcode } from \'html5-qrcode\';\\nimport {\\n  AlertCircle,\\n  ArrowLeft,\\n  BookOpen,\\n  Camera,\\n  CameraOff,\\n  CheckCircle2,\\n  MapPin,\\n  RefreshCw,\\n  Search,\\n  CheckSquare,\\n  Square,\\n} from \'lucide-react\';\\nimport { useAuth } from \'../context/AuthContext\';\\nimport { useTranslation } from \'../hooks/useTranslation\';\\nimport { useToast } from \'../context/ToastContext\';\\nimport type {\\n  AttendanceRecord,\\n  AttendanceStatus,\\n  FacultyAssignment,\\n  UserProfile,\\n} from \'../types\';\\nimport {\\n  bulkMarkAttendance,\\n  fetchAttendanceForManager,\\n  fetchAttendanceForOrg,\\n  markAttendanceManual,\\n  markAttendanceViaQR,\\n  type QRScanResult,\\n} from \'../services/attendanceService\';\\nimport { subscribeFacultyAssignments } from \'../services/academicService\';\\nimport { fetchManagerMembers, fetchOrgUsers, fetchUsersByClass } from \'../services/userService\';\\nimport {\\n  getFirebaseErrorKey,\\n  getInitials,\\n  getOrgDateString,\\n  playBeep,\\n  triggerVibration,\\n} from \'../utils/helpers\';\\nimport { Layout } from \'../components/Layout\';\\nimport { CardSkeleton, EmptyState } from \'../components/Skeletons\';\\n\\n// Strictly ONLY 3 statuses: PRESENT, ABSENT, LEAVE\\nconst STATUSES: AttendanceStatus[] = [\'present\', \'absent\', \'leave\'];\\n\\nexport const MarkAttendancePage: React.FC = () => {\\n  const { profile, org, getRoleLabel } = useAuth();\\n  const { t, formatNumber } = useTranslation();\\n  const { showToast } = useToast();\\n\\n  const isAdmin = profile?.role === \'admin\' || profile?.role === \'super_admin\';\\n  const today = useMemo(() => getOrgDateString(org?.timezone || \'Asia/Kolkata\'), [org?.timezone]);\\n  const [tab, setTab] = useState<\'scan\' | \'manual\'>(\'scan\');\\n\\n  // Assigned classes & subjects for subject-wise backup marking\\n  const [assignments, setAssignments] = useState<FacultyAssignment[]>([]);\\n  const [selectedAssignmentId, setSelectedAssignmentId] = useState<string>(\'\');\\n\\n  // Scanner state\\n  const [cameraRunning, setCameraRunning] = useState(false);\\n  const [facingMode, setFacingMode] = useState<\'environment\' | \'user\'>(\'environment\');\\n  const [cameraError, setCameraError] = useState(\'\');\\n  const [lastResult, setLastResult] = useState<QRScanResult | null>(null);\\n  const [scannedTodayCount, setScannedTodayCount] = useState(0);\\n  const [processingScan, setProcessingScan] = useState(false);\\n\\n  const scannerRef = useRef<Html5Qrcode | null>(null);\\n  const cooldownMapRef = useRef<Map<string, number>>(new Map());\\n  const busyScanRef = useRef(false);\\n\\n  // Manual state\\n  const [selectedDate, setSelectedDate] = useState(today);\\n  const [people, setPeople] = useState<UserProfile[]>([]);\\n  const [dateRecords, setDateRecords] = useState<Map<string, AttendanceRecord>>(new Map());\\n  const [loadingManual, setLoadingManual] = useState(true);\\n  const [searchQuery, setSearchQuery] = useState(\'\');\\n  const [notesByUid, setNotesByUid] = useState<Record<string, string>>({});\\n  const [checkedUids, setCheckedUids] = useState<Set<string>>(new Set());\\n  const [savingUid, setSavingUid] = useState<string | null>(null);\\n  const [bulkSaving, setBulkSaving] = useState(false);\\n\\n  const canEditSelectedDate = isAdmin || selectedDate === today;\\n\\n  useEffect(() => {\\n    if (!org || !profile) return;\\n    return subscribeFacultyAssignments(\\n      org.id,\\n      (list) => {\\n        setAssignments(list);\\n        if (!selectedAssignmentId && list.length > 0 && !isAdmin) {\\n          setSelectedAssignmentId(list[0].id);\\n        }\\n      },\\n      isAdmin ? undefined : profile.uid\\n    );\\n  }, [org, profile, isAdmin, selectedAssignmentId]);\\n\\n  const selectedAssignment = useMemo(\\n    () => assignments.find((a) => a.id === selectedAssignmentId) || null,\\n    [assignments, selectedAssignmentId]\\n  );\\n\\n  // Load subordinates/class students and attendance for selectedDate & subject\\n  const loadManualData = useCallback(async () => {\\n    if (!org || !profile) return;\\n    setLoadingManual(true);\\n    try {\\n      let directPeople: UserProfile[] = [];\\n      let recs: AttendanceRecord[] = [];\\n\\n      if (selectedAssignment) {\\n        [directPeople, recs] = await Promise.all([\\n          fetchUsersByClass(org.id, selectedAssignment.classId),\\n          isAdmin\\n            ? fetchAttendanceForOrg(org.id, {\\n                date: selectedDate,\\n                classId: selectedAssignment.classId,\\n                subjectId: selectedAssignment.subjectId,\\n              })\\n            : fetchAttendanceForManager(org.id, profile.uid, {\\n                date: selectedDate,\\n                subjectId: selectedAssignment.subjectId,\\n              }),\\n        ]);\\n      } else if (isAdmin) {\\n        [directPeople, recs] = await Promise.all([\\n          fetchOrgUsers(org.id, \'manager\'),\\n          fetchAttendanceForOrg(org.id, { date: selectedDate }),\\n        ]);\\n      } else {\\n        [directPeople, recs] = await Promise.all([\\n          fetchManagerMembers(org.id, profile.uid),\\n          fetchAttendanceForManager(org.id, profile.uid, { date: selectedDate }),\\n        ]);\\n      }\\n\\n      const activeDirect = directPeople.filter((p) => p.status === \'active\');\\n      setPeople(activeDirect);\\n\\n      const map = new Map<string, AttendanceRecord>();\\n      const notes: Record<string, string> = {};\\n      for (const r of recs) {\\n        if (selectedAssignment && r.subjectId && r.subjectId !== selectedAssignment.subjectId) {\\n          continue;\\n        }\\n        map.set(r.personUid, r);\\n        if (r.note) notes[r.personUid] = r.note;\\n      }\\n      setDateRecords(map);\\n      setNotesByUid(notes);\\n\\n      if (selectedDate === today) {\\n        const directUidSet = new Set(activeDirect.map((p) => p.uid));\\n        const todayCount = Array.from(map.values()).filter(\\n          (r) => directUidSet.has(r.personUid) && r.status === \'present\'\\n        ).length;\\n        setScannedTodayCount(todayCount);\\n      }\\n    } catch (err) {\\n      showToast(t(getFirebaseErrorKey(err)), \'error\');\\n    } finally {\\n      setLoadingManual(false);\\n    }\\n  }, [org, profile, isAdmin, selectedAssignment, selectedDate, today, showToast, t]);\\n\\n  useEffect(() => {\\n    loadManualData();\\n  }, [loadManualData]);\\n\\n  const stopCamera = useCallback(async () => {\\n    const instance = scannerRef.current;\\n    scannerRef.current = null;\\n    if (instance) {\\n      try {\\n        if (instance.isScanning) await instance.stop();\\n        instance.clear();\\n      } catch {\\n        // Ignore\\n      }\\n    }\\n    setCameraRunning(false);\\n  }, []);\\n\\n  const handleDecodedQR = useCallback(\\n    async (decodedText: string) => {\\n      if (!org || !profile) return;\\n      const now = Date.now();\\n      const lastTime = cooldownMapRef.current.get(decodedText) || 0;\\n      if (now - lastTime < 2000) return;\\n      if (busyScanRef.current) return;\\n\\n      cooldownMapRef.current.set(decodedText, now);\\n      busyScanRef.current = true;\\n      setProcessingScan(true);\\n\\n      try {\\n        const res = await markAttendanceViaQR({\\n          rawText: decodedText,\\n          org,\\n          marker: profile,\\n          subjectMeta: selectedAssignment\\n            ? {\\n                departmentId: selectedAssignment.departmentId || null,\\n                departmentName: selectedAssignment.departmentName || \'\',\\n                classId: selectedAssignment.classId,\\n                className: selectedAssignment.className,\\n                subjectId: selectedAssignment.subjectId,\\n                subjectName: selectedAssignment.subjectName,\\n                subjectCode: selectedAssignment.subjectCode || \'\',\\n              }\\n            : undefined,\\n        });\\n        setLastResult(res);\\n        if (res.ok) {\\n          playBeep(true);\\n          triggerVibration(true);\\n          setScannedTodayCount((c) => c + 1);\\n          if (selectedDate === today) {\\n            loadManualData();\\n          }\\n        } else {\\n          playBeep(false);\\n          triggerVibration(false);\\n        }\\n      } catch {\\n        playBeep(false);\\n        triggerVibration(false);\\n        setLastResult({ ok: false, code: \'invalidQr\' });\\n      } finally {\\n        busyScanRef.current = false;\\n        setProcessingScan(false);\\n      }\\n    },\\n    [org, profile, selectedAssignment, selectedDate, today, loadManualData]\\n  );\\n\\n  const startCamera = useCallback(\\n    async (mode: \'environment\' | \'user\' = facingMode) => {\\n      setCameraError(\'\');\\n      await stopCamera();\\n\\n      if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {\\n        setCameraError(t(\'attendance.cameraPermissionDesc\'));\\n        return;\\n      }\\n\\n      try {\\n        const scanner = new Html5Qrcode(\'qr-reader\');\\n        scannerRef.current = scanner;\\n        await scanner.start(\\n          { facingMode: mode },\\n          { fps: 10, qrbox: { width: 240, height: 240 }, aspectRatio: 1 },\\n          (decodedText) => {\\n            handleDecodedQR(decodedText);\\n          },\\n          () => {}\\n        );\\n        setCameraRunning(true);\\n      } catch {\\n        setCameraError(t(\'attendance.cameraPermissionDesc\'));\\n        setCameraRunning(false);\\n      }\\n    },\\n    [facingMode, stopCamera, handleDecodedQR, t]\\n  );\\n\\n  const handleSwitchCamera = async () => {\\n    const next = facingMode === \'environment\' ? \'user\' : \'environment\';\\n    setFacingMode(next);\\n    if (cameraRunning) await startCamera(next);\\n  };\\n\\n  useEffect(() => {\\n    if (tab !== \'scan\' && cameraRunning) stopCamera();\\n  }, [tab, cameraRunning, stopCamera]);\\n\\n  useEffect(() => {\\n    return () => {\\n      stopCamera();\\n    };\\n  }, [stopCamera]);\\n\\n  const filteredPeople = useMemo(() => {\\n    const q = searchQuery.trim().toLowerCase();\\n    if (!q) return people;\\n    return people.filter(\\n      (p) =>\\n        p.name.toLowerCase().includes(q) ||\\n        (p.memberId || \'\').toLowerCase().includes(q) ||\\n        (p.rollNumber || \'\').toLowerCase().includes(q) ||\\n        (p.enrollmentNumber || \'\').toLowerCase().includes(q)\\n    );\\n  }, [people, searchQuery]);\\n\\n  const subjectMeta = selectedAssignment\\n    ? {\\n        departmentId: selectedAssignment.departmentId || null,\\n        departmentName: selectedAssignment.departmentName || \'\',\\n        classId: selectedAssignment.classId,\\n        className: selectedAssignment.className,\\n        subjectId: selectedAssignment.subjectId,\\n        subjectName: selectedAssignment.subjectName,\\n        subjectCode: selectedAssignment.subjectCode || \'\',\\n      }\\n    : undefined;\\n\\n  const handleSingleMark = async (person: UserProfile, status: AttendanceStatus) => {\\n    if (!org || !profile || !canEditSelectedDate) return;\\n    setSavingUid(person.uid);\\n    try {\\n      await markAttendanceManual({\\n        org,\\n        marker: profile,\\n        person,\\n        date: selectedDate,\\n        status,\\n        note: notesByUid[person.uid] || \'\',\\n        subjectMeta,\\n      });\\n      showToast(t(\'attendance.savedToast\'), \'success\');\\n      await loadManualData();\\n    } catch (err) {\\n      showToast(t(getFirebaseErrorKey(err)), \'error\');\\n    } finally {\\n      setSavingUid(null);\\n    }\\n  };\\n\\n  const handleSelectAllPresent = () => {\\n    if (checkedUids.size === filteredPeople.length) {\\n      setCheckedUids(new Set());\\n    } else {\\n      setCheckedUids(new Set(filteredPeople.map((p) => p.uid)));\\n    }\\n  };\\n\\n  const toggleCheck = (uid: string) => {\\n    setCheckedUids((prev) => {\\n      const next = new Set(prev);\\n      if (next.has(uid)) next.delete(uid);\\n      else next.add(uid);\\n      return next;\\n    });\\n  };\\n\\n  const handleSaveBulkPresent = async () => {\\n    if (!org || !profile || !canEditSelectedDate || checkedUids.size === 0) return;\\n    setBulkSaving(true);\\n    try {\\n      const entries = people\\n        .filter((p) => checkedUids.has(p.uid))\\n        .map((person) => ({\\n          person,\\n          status: \'present\' as AttendanceStatus,\\n          note: notesByUid[person.uid] || \'\',\\n        }));\\n      await bulkMarkAttendance({\\n        org,\\n        marker: profile,\\n        entries,\\n        date: selectedDate,\\n        subjectMeta,\\n      });\\n      showToast(t(\'attendance.bulkSavedToast\'), \'success\');\\n      setCheckedUids(new Set());\\n      await loadManualData();\\n    } catch (err) {\\n      showToast(t(getFirebaseErrorKey(err)), \'error\');\\n    } finally {\\n      setBulkSaving(false);\\n    }\\n  };\\n\\n  const targetRoleLabel = selectedAssignment\\n    ? `${selectedAssignment.subjectName} \302\267 ${selectedAssignment.className}`\\n    : isAdmin\\n    ? getRoleLabel(\'manager\')\\n    : getRoleLabel(\'member\');\\n\\n  return (\\n    <Layout title={t(\'attendance.title\')}>\\n      <div className=\\\"space-y-6\\\">\\n        {/* Backup Mode Banner */}\\n        <div className=\\\"rounded-2xl border border-amber-200 dark:border-amber-900/70 bg-amber-50/70 dark:bg-amber-950/30 px-4 py-3.5 flex flex-col sm:flex-row sm:items-center justify-between gap-3\\\">\\n          <p className=\\\"text-xs sm:text-sm text-amber-900 dark:text-amber-200\\\">\\n            {t(\'attendance.backupNotice\')}\\n          </p>\\n          <Link\\n            to=\\\"/attendance\\\"\\n            className=\\\"inline-flex items-center gap-1.5 text-xs sm:text-sm font-semibold text-[#C25E00] hover:underline whitespace-nowrap shrink-0\\\"\\n          >\\n            <ArrowLeft className=\\\"w-4 h-4\\\" />\\n            <span>{t(\'attendance.backToLive\')}</span>\\n          </Link>\\n        </div>\\n\\n        {/* Header & Mode Switch */}\\n        <div className=\\\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\\\">\\n          <div>\\n            <h2 className=\\\"text-2xl font-bold tracking-tight text-stone-900 dark:text-stone-50\\\">\\n              {t(\'attendance.title\')}\\n            </h2>\\n            <p className=\\\"mt-1 text-xs text-stone-500 dark:text-stone-400 flex flex-wrap items-center gap-2\\\">\\n              <span>{targetRoleLabel}</span>\\n              <span>\302\267</span>\\n              <span className=\\\"tabular-nums\\\">\\n                {t(\'attendance.scannedToday\')}:{\' \'}\\n                <strong className=\\\"text-stone-900 dark:text-stone-100\\\">\\n                  {formatNumber(scannedTodayCount)}\\n                </strong>\\n              </span>\\n              {org?.location?.enabled && (\\n                <>\\n                  <span>\302\267</span>\\n                  <span className=\\\"inline-flex items-center gap-1 text-[#C25E00]\\\">\\n                    <MapPin className=\\\"w-3.5 h-3.5\\\" />\\n                    GPS\\n                  </span>\\n                </>\\n              )}\\n            </p>\\n          </div>\\n\\n          <div className=\\\"inline-flex p-1 rounded-xl bg-stone-100 dark:bg-stone-900 border border-stone-200 dark:border-stone-800 self-start\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => setTab(\'scan\')}\\n              className={`px-4 py-2 rounded-lg text-sm font-medium transition-colors whitespace-nowrap ${\\n                tab === \'scan\'\\n                  ? \'bg-white dark:bg-stone-800 text-stone-900 dark:text-stone-100 shadow-xs\'\\n                  : \'text-stone-600 dark:text-stone-400\'\\n              }`}\\n            >\\n              {t(\'attendance.tabScan\')}\\n            </button>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => setTab(\'manual\')}\\n              className={`px-4 py-2 rounded-lg text-sm font-medium transition-colors whitespace-nowrap ${\\n                tab === \'manual\'\\n                  ? \'bg-white dark:bg-stone-800 text-stone-900 dark:text-stone-100 shadow-xs\'\\n                  : \'text-stone-600 dark:text-stone-400\'\\n              }`}\\n            >\\n              {t(\'attendance.tabManual\')}\\n            </button>\\n          </div>\\n        </div>\\n\\n        {/* Assigned Class / Subject Selector */}\\n        {assignments.length > 0 && (\\n          <div className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-4 flex flex-col sm:flex-row sm:items-center gap-3\\\">\\n            <label className=\\\"text-xs font-semibold text-stone-600 dark:text-stone-300 flex items-center gap-1.5 whitespace-nowrap\\\">\\n              <BookOpen className=\\\"w-4 h-4 text-[#C25E00]\\\" />\\n              <span>{t(\'session.selectAssignedSubject\')}:</span>\\n            </label>\\n            <select\\n              value={selectedAssignmentId}\\n              onChange={(e) => setSelectedAssignmentId(e.target.value)}\\n              className=\\\"flex-1 rounded-xl border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-900 px-3 py-2 text-sm\\\"\\n            >\\n              {isAdmin && <option value=\\\"\\\">{t(\'session.generalStaffSession\')}</option>}\\n              {assignments.map((a) => (\\n                <option key={a.id} value={a.id}>\\n                  {a.subjectName} ({a.subjectCode || \'\342\200\224\'}) \342\200\224 {a.className}\\n                </option>\\n              ))}\\n            </select>\\n          </div>\\n        )}\\n\\n        {/* SCAN QR TAB */}\\n        {tab === \'scan\' && (\\n          <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-start\\\">\\n            <div className=\\\"lg:col-span-7 rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-5 sm:p-6\\\">\\n              <div className=\\\"relative overflow-hidden rounded-xl bg-stone-950 min-h-[290px] sm:min-h-[340px] flex items-center justify-center\\\">\\n                <div id=\\\"qr-reader\\\" className=\\\"w-full\\\" />\\n                {!cameraRunning && (\\n                  <div className=\\\"absolute inset-0 flex flex-col items-center justify-center p-6 text-center bg-stone-100 dark:bg-stone-900\\\">\\n                    <Camera className=\\\"w-10 h-10 text-stone-400 mb-3\\\" />\\n                    <p className=\\\"text-sm font-medium text-stone-800 dark:text-stone-200 max-w-xs\\\">\\n                      {cameraError || t(\'attendance.cameraActiveHint\')}\\n                    </p>\\n                    <button\\n                      type=\\\"button\\\"\\n                      onClick={() => startCamera(facingMode)}\\n                      className=\\\"mt-5 inline-flex items-center gap-2 rounded-xl bg-[#C25E00] hover:bg-[#A84F00] text-white px-6 py-3 text-base font-medium transition-colors\\\"\\n                    >\\n                      <Camera className=\\\"w-5 h-5\\\" />\\n                      <span>{t(\'attendance.startCamera\')}</span>\\n                    </button>\\n                  </div>\\n                )}\\n              </div>\\n\\n              {cameraError && !cameraRunning && (\\n                <div className=\\\"mt-4 rounded-xl border border-amber-200 dark:border-amber-900 bg-amber-50 dark:bg-amber-950/30 p-4 text-xs text-amber-900 dark:text-amber-200\\\">\\n                  <p className=\\\"font-semibold\\\">{t(\'attendance.cameraPermissionTitle\')}</p>\\n                  <p className=\\\"mt-1\\\">{t(\'attendance.cameraPermissionDesc\')}</p>\\n                </div>\\n              )}\\n\\n              <div className=\\\"mt-4 grid grid-cols-2 gap-3\\\">\\n                {cameraRunning ? (\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={stopCamera}\\n                    className=\\\"inline-flex items-center justify-center gap-2 rounded-xl border border-stone-300 dark:border-stone-700 py-3.5 text-sm font-medium text-stone-800 dark:text-stone-100 hover:bg-stone-50 dark:hover:bg-stone-800\\\"\\n                  >\\n                    <CameraOff className=\\\"w-4 h-4\\\" />\\n                    <span>{t(\'attendance.stopCamera\')}</span>\\n                  </button>\\n                ) : (\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={() => startCamera(facingMode)}\\n                    className=\\\"inline-flex items-center justify-center gap-2 rounded-xl bg-[#C25E00] hover:bg-[#A84F00] text-white py-3.5 text-sm font-medium\\\"\\n                  >\\n                    <Camera className=\\\"w-4 h-4\\\" />\\n                    <span>{t(\'attendance.startCamera\')}</span>\\n                  </button>\\n                )}\\n\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={handleSwitchCamera}\\n                  className=\\\"inline-flex items-center justify-center gap-2 rounded-xl border border-stone-300 dark:border-stone-700 py-3.5 text-sm font-medium text-stone-800 dark:text-stone-100 hover:bg-stone-50 dark:hover:bg-stone-800\\\"\\n                >\\n                  <RefreshCw className=\\\"w-4 h-4\\\" />\\n                  <span>{t(\'attendance.switchCamera\')}</span>\\n                </button>\\n              </div>\\n            </div>\\n\\n            <div className=\\\"lg:col-span-5 space-y-4\\\">\\n              <div className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-6\\\">\\n                <div className=\\\"flex items-center justify-between\\\">\\n                  <span className=\\\"text-xs font-medium text-stone-500 dark:text-stone-400\\\">\\n                    {t(\'attendance.scannedToday\')}\\n                  </span>\\n                  <span className=\\\"text-2xl font-bold tabular-nums text-[#C25E00]\\\">\\n                    {formatNumber(scannedTodayCount)}\\n                  </span>\\n                </div>\\n              </div>\\n\\n              {processingScan && (\\n                <div className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-6 text-center text-sm text-stone-500\\\">\\n                  {t(\'common.loading\')}\\n                </div>\\n              )}\\n\\n              {lastResult && !processingScan && (\\n                <div\\n                  role=\\\"status\\\"\\n                  className={`rounded-2xl border p-6 ${\\n                    lastResult.ok\\n                      ? \'border-emerald-300 dark:border-emerald-800 bg-emerald-50/70 dark:bg-emerald-950/30\'\\n                      : \'border-red-300 dark:border-red-800 bg-red-50/70 dark:bg-red-950/30\'\\n                  }`}\\n                >\\n                  <div className=\\\"flex items-center gap-4\\\">\\n                    <div\\n                      className={`w-14 h-14 rounded-2xl flex items-center justify-center text-lg font-bold shrink-0 ${\\n                        lastResult.ok ? \'bg-emerald-600 text-white\' : \'bg-red-600 text-white\'\\n                      }`}\\n                    >\\n                      {lastResult.personName ? (\\n                        getInitials(lastResult.personName)\\n                      ) : lastResult.ok ? (\\n                        <CheckCircle2 className=\\\"w-7 h-7\\\" />\\n                      ) : (\\n                        <AlertCircle className=\\\"w-7 h-7\\\" />\\n                      )}\\n                    </div>\\n\\n                    <div className=\\\"min-w-0 flex-1\\\">\\n                      <p\\n                        className={`text-sm font-semibold ${\\n                          lastResult.ok\\n                            ? \'text-emerald-800 dark:text-emerald-300\'\\n                            : \'text-red-800 dark:text-red-300\'\\n                        }`}\\n                      >\\n                        {t(`attendance.${lastResult.code}`)}\\n                      </p>\\n                      {lastResult.personName && (\\n                        <p className=\\\"mt-0.5 text-lg font-bold text-stone-900 dark:text-stone-100 truncate\\\">\\n                          {lastResult.personName}\\n                        </p>\\n                      )}\\n                      <p className=\\\"mt-0.5 text-xs text-stone-600 dark:text-stone-400 font-mono tabular-nums\\\">\\n                        {lastResult.memberId ? `${lastResult.memberId}` : \'\'}\\n                        {lastResult.timeStr ? ` \302\267 ${lastResult.timeStr}` : \'\'}\\n                        {lastResult.distance !== undefined ? ` \302\267 ${lastResult.distance}m` : \'\'}\\n                      </p>\\n                    </div>\\n                  </div>\\n                </div>\\n              )}\\n            </div>\\n          </div>\\n        )}\\n\\n        {/* MANUAL TAB (Strictly PRESENT / ABSENT / LEAVE) */}\\n        {tab === \'manual\' && (\\n          <div className=\\\"space-y-4\\\">\\n            <div className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] p-4 sm:p-5 flex flex-col lg:flex-row lg:items-center justify-between gap-4\\\">\\n              <div className=\\\"flex flex-col sm:flex-row gap-3 flex-1\\\">\\n                <div className=\\\"relative flex-1\\\">\\n                  <Search className=\\\"w-4 h-4 text-stone-400 absolute left-3.5 top-1/2 -translate-y-1/2\\\" />\\n                  <input\\n                    type=\\\"text\\\"\\n                    value={searchQuery}\\n                    onChange={(e) => setSearchQuery(e.target.value)}\\n                    placeholder={t(\'attendance.manualSearchPlaceholder\')}\\n                    className=\\\"w-full rounded-xl border border-stone-300 dark:border-stone-700 bg-transparent pl-10 pr-4 py-2 text-sm\\\"\\n                  />\\n                </div>\\n\\n                <div className=\\\"flex items-center gap-2\\\">\\n                  <label className=\\\"text-xs text-stone-500 whitespace-nowrap\\\">\\n                    {t(\'attendance.selectDate\')}\\n                  </label>\\n                  <input\\n                    type=\\\"date\\\"\\n                    value={selectedDate}\\n                    max={today}\\n                    disabled={!isAdmin}\\n                    onChange={(e) => setSelectedDate(e.target.value)}\\n                    className=\\\"rounded-xl border border-stone-300 dark:border-stone-700 bg-white dark:bg-stone-900 px-3 py-2 text-sm disabled:opacity-60\\\"\\n                  />\\n                </div>\\n              </div>\\n\\n              {canEditSelectedDate && filteredPeople.length > 0 && (\\n                <div className=\\\"flex flex-wrap items-center gap-2.5\\\">\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={handleSelectAllPresent}\\n                    className=\\\"inline-flex items-center gap-2 rounded-xl border border-stone-300 dark:border-stone-700 px-3.5 py-2 text-sm font-medium hover:bg-stone-50 dark:hover:bg-stone-800\\\"\\n                  >\\n                    {checkedUids.size === filteredPeople.length ? (\\n                      <CheckSquare className=\\\"w-4 h-4 text-[#C25E00]\\\" />\\n                    ) : (\\n                      <Square className=\\\"w-4 h-4 text-stone-400\\\" />\\n                    )}\\n                    <span>{t(\'attendance.markAllPresent\')}</span>\\n                  </button>\\n\\n                  {checkedUids.size > 0 && (\\n                    <button\\n                      type=\\\"button\\\"\\n                      disabled={bulkSaving}\\n                      onClick={handleSaveBulkPresent}\\n                      className=\\\"rounded-xl bg-[#C25E00] hover:bg-[#A84F00] disabled:opacity-60 text-white px-4 py-2 text-sm font-medium\\\"\\n                    >\\n                      {bulkSaving\\n                        ? t(\'common.saving\')\\n                        : `${t(\'attendance.markSelectedBtn\')} (${checkedUids.size})`}\\n                    </button>\\n                  )}\\n                </div>\\n              )}\\n            </div>\\n\\n            <p className=\\\"text-xs text-stone-500 dark:text-stone-400\\\">\\n              {isAdmin\\n                ? t(\'attendance.adminCanCorrectAny\')\\n                : canEditSelectedDate\\n                ? t(\'attendance.canCorrectToday\')\\n                : t(\'attendance.cannotCorrectPast\')}\\n            </p>\\n\\n            {loadingManual ? (\\n              <CardSkeleton rows={5} />\\n            ) : filteredPeople.length === 0 ? (\\n              <EmptyState\\n                title={t(\'attendance.noActivePeople\')}\\n                description={t(\'people.emptyDesc\')}\\n              />\\n            ) : (\\n              <div className=\\\"rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-[#161619] divide-y divide-stone-100 dark:divide-stone-800\\\">\\n                {filteredPeople.map((person) => {\\n                  const rec = dateRecords.get(person.uid);\\n                  const isChecked = checkedUids.has(person.uid);\\n                  return (\\n                    <div\\n                      key={person.uid}\\n                      className=\\\"p-4 flex flex-col lg:flex-row lg:items-center justify-between gap-3\\\"\\n                    >\\n                      <div className=\\\"flex items-start gap-3 min-w-0\\\">\\n                        {canEditSelectedDate && (\\n                          <button\\n                            type=\\\"button\\\"\\n                            onClick={() => toggleCheck(person.uid)}\\n                            aria-label={`Select ${person.name}`}\\n                            className=\\\"mt-0.5 text-stone-400 hover:text-[#C25E00]\\\"\\n                          >\\n                            {isChecked ? (\\n                              <CheckSquare className=\\\"w-5 h-5 text-[#C25E00]\\\" />\\n                            ) : (\\n                              <Square className=\\\"w-5 h-5\\\" />\\n                            )}\\n                          </button>\\n                        )}\\n                        <div className=\\\"min-w-0\\\">\\n                          <p className=\\\"text-sm font-semibold text-stone-900 dark:text-stone-100 truncate\\\">\\n                            {person.name}\\n                          </p>\\n                          <p className=\\\"text-xs font-mono text-stone-500 dark:text-stone-400\\\">\\n                            {person.memberId}\\n                            {rec ? ` \302\267 ${t(`common.${rec.status}`)} (${t(`common.${rec.method}`)})` : \'\'}\\n                          </p>\\n                        </div>\\n                      </div>\\n\\n                      <div className=\\\"flex flex-col sm:flex-row sm:items-center gap-2\\\">\\n                        <input\\n                          type=\\\"text\\\"\\n                          value={notesByUid[person.uid] || \'\'}\\n                          onChange={(e) =>\\n                            setNotesByUid((prev) => ({ ...prev, [person.uid]: e.target.value }))\\n                          }\\n                          placeholder={t(\'attendance.notePlaceholder\')}\\n                          disabled={!canEditSelectedDate}\\n                          className=\\\"rounded-lg border border-stone-200 dark:border-stone-800 bg-transparent px-3 py-1.5 text-xs w-full sm:w-40\\\"\\n                        />\\n\\n                        <div className=\\\"grid grid-cols-3 gap-1.5\\\">\\n                          {STATUSES.map((st) => {\\n                            const active = rec?.status === st;\\n                            const activeStyle =\\n                              st === \'present\'\\n                                ? \'bg-emerald-600 text-white border-emerald-600\'\\n                                : st === \'absent\'\\n                                ? \'bg-red-600 text-white border-red-600\'\\n                                : \'bg-sky-600 text-white border-sky-600\';\\n                            return (\\n                              <button\\n                                key={st}\\n                                type=\\\"button\\\"\\n                                disabled={!canEditSelectedDate || savingUid === person.uid}\\n                                onClick={() => handleSingleMark(person, st)}\\n                                className={`px-3 py-2 rounded-lg border text-xs font-medium transition-colors whitespace-nowrap ${\\n                                  active\\n                                    ? activeStyle\\n                                    : \'border-stone-200 dark:border-stone-700 text-stone-600 dark:text-stone-300 hover:bg-stone-50 dark:hover:bg-stone-800\'\\n                                }`}\\n                              >\\n                                {t(`common.${st}`)}\\n                              </button>\\n                            );\\n                          })}\\n                        </div>\\n                      </div>\\n                    </div>\\n                  );\\n                })}\\n              </div>\\n            )}\\n          </div>\\n        )}\\n      </div>\\n    </Layout>\\n  );\\n};\\n\", \"Description\":\"Remove LATE status from MarkAttendancePage and add subject-wise class backup marking\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/MarkAttendancePage.tsx\", \"toolAction\":\"Updating MarkAttendancePage.tsx\", \"toolSummary\":\"Update MarkAttendancePage.tsx\"}"
